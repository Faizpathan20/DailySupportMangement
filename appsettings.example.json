{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER,1433;Database=YOUR_DATABASE;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;Connect Timeout=15;"
  },

  "FtpStorage": {
    "Host": "YOUR_FTP_HOST",
    "Port": 21,
    "User": "YOUR_FTP_USER",
    "Password": "YOUR_FTP_PASSWORD",
    "UseTls": false,
    "AcceptAnyCertificate": false,
    "RootPath": "/",
    "PublicBaseUrl": "https://your-domain.example/files",
    "CacheSeconds": 120,
    "PageSize": 120,
    "ScanParallelism": 4,
    "ScanTimeoutMinutes": 20,
    "MaxFolders": 20000,
    "MaxFiles": 250000
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
