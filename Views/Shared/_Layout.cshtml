
@using System.Security.Claims

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - MANAGEMENT
    </title>

    <link rel="stylesheet"
          href="~/css/site.css?v=59" />

    <link rel="stylesheet"
          href="~/css/dashboard.css?v=4" />

    @* Page-specific stylesheets (e.g. Tailwind build).
       Iske baad site.css/dashboard.css se content load hota
       hai, isliye page wali classes unko override kar sakti hain. *@
    @RenderSection("Styles", required: false)

    <!-- SheetJS reads the .xlsx / .xls / .csv file in
         the browser. It is served from wwwroot so the
         Import page keeps working on a machine with no
         internet; the CDN is only a fallback for when
         the local copy is missing. -->
    <script defer
            src="~/js/xlsx.full.min.js?v=1"
            onerror="var s=document.createElement('script');s.src='https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js';document.head.appendChild(s);"></script>

</head>


@{
    // Pages can opt into a page-specific body class
    // (e.g. the New Ticket page uses a grey canvas).
    var bodyClass = ViewData["BodyClass"] as string ?? "";
}

<body class="@bodyClass">

    <div class="layout">


        <!-- Mobile menu button -->
        <button type="button" class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Open menu" aria-expanded="false">
            <span class="mobile-menu-bars"></span>
            <span class="mobile-menu-bars"></span>
            <span class="mobile-menu-bars"></span>
        </button>

        <!-- Sidebar backdrop for mobile -->
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>


        <!-- ================= SIDEBAR ================= -->

        <aside class="sidebar" id="appSidebar">

            <div class="sidebar-top">

                <div class="sidebar-logo">

                    <h2>
                      MANAGEMENT
                    </h2>

                </div>

                <button type="button"
                        id="sidebarToggle"
                        class="sidebar-toggle"
                        title="Toggle sidebar"
                        aria-label="Toggle sidebar">

                    ☰

                </button>

            </div>


            <div class="user-info">

                <span>
                    Logged in as
                </span>

                <strong>
                    @User.Identity?.Name
                </strong>

            </div>


            <nav class="sidebar-menu">


                <!-- ============ DASHBOARD (collapsible) ============ -->

                <div class="menu-group menu-group-parent"
                     id="dashboardGroup">

                    <button type="button"
                            class="menu-group-toggle"
                            id="dashboardToggle"
                            title="Dashboard"
                            aria-expanded="false"
                            aria-controls="dashboardSubmenu">

                        <span class="menu-group-icon"
                              aria-hidden="true">

                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <rect x="3" y="3" width="7" height="7" rx="1.5" />
                                <rect x="14" y="3" width="7" height="7" rx="1.5" />
                                <rect x="14" y="14" width="7" height="7" rx="1.5" />
                                <rect x="3" y="14" width="7" height="7" rx="1.5" />
                            </svg>

                        </span>

                        <span class="menu-group-label">
                            Dashboard
                        </span>

                        <span class="menu-arrow">&#9656;</span>

                    </button>

                    <div class="menu-submenu"
                         id="dashboardSubmenu">

                        <a asp-controller="Dashboard"
                           asp-action="Index"
                           class="menu-item menu-item-sub">

                            <span class="menu-icon">🏠</span>

                            <span class="menu-text">
                                Home
                            </span>

                        </a>

                    </div>

                </div>


                <!-- ============ OPERATIONS (collapsible) ============ -->

                <div class="menu-group menu-group-parent"
                     id="operationsGroup">

                    <button type="button"
                            class="menu-group-toggle"
                            id="operationsToggle"
                            title="Operations"
                            aria-expanded="false"
                            aria-controls="operationsSubmenu">

                        <span class="menu-group-icon"
                              aria-hidden="true">

                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                            </svg>

                        </span>

                        <span class="menu-group-label">
                            Operations
                        </span>

                        <span class="menu-arrow">&#9656;</span>

                    </button>

                    <div class="menu-submenu"
                         id="operationsSubmenu">

                        <a asp-controller="DailySupport"
                           asp-action="Index"
                           class="menu-item menu-item-sub">

                            <span class="menu-icon">🛠️</span>

                            <span class="menu-text">
                                Daily Support
                            </span>

                            <span class="menu-badge"
                                  id="navSupportBadge"
                                  title="Unread notifications"
                                  hidden></span>

                        </a>

                        <a asp-controller="ClientVisiting"
                           asp-action="Index"
                           class="menu-item menu-item-sub">

                            <span class="menu-icon">📍</span>

                            <span class="menu-text">
                                Client Visiting
                            </span>

                        </a>

                    </div>

                </div>


@* ===== OLD CRM (hidden - pages URL se accessible) =====
                <div class="menu-group">

                    <span class="menu-group-label">
                        CRM
                    </span>

                    <a asp-controller="CrmDashboard"
                       asp-action="Index"
                       class="menu-item">

                        <span class="menu-icon">📈</span>

                        <span class="menu-text">
                            CRM Dashboard
                        </span>

                    </a>

                    <a asp-controller="CrmLead"
                       asp-action="Index"
                       class="menu-item">

                        <span class="menu-icon">🎯</span>

                        <span class="menu-text">
                            Lead Master
                        </span>

                    </a>

                    <a asp-controller="CrmFollowUp"
                       asp-action="Index"
                       class="menu-item">

                        <span class="menu-icon">📞</span>

                        <span class="menu-text">
                            Daily Follow-up
                        </span>

                        <span class="menu-badge"
                              id="navFollowUpBadge"
                              title="Due today or overdue"
                              hidden></span>

                    </a>

                    <a asp-controller="CrmLeadHistory"
                       asp-action="Index"
                       class="menu-item">

                        <span class="menu-icon">🧾</span>

                        <span class="menu-text">
                            Lead History
                        </span>

                    </a>

                </div>
                =====*@


                <!-- ============ CRM (collapsible) ============ -->

                <div class="menu-group menu-group-parent"
                     id="crmGroup">

                    <button type="button"
                            class="menu-group-toggle"
                            id="crmToggle"
                            title="CRM"
                            aria-expanded="false"
                            aria-controls="crmSubmenu">

                        <span class="menu-group-icon"
                              aria-hidden="true">

                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <polyline points="22 7 13.5 15.5 8.5 10.5 2 17" />
                                <polyline points="16 7 22 7 22 13" />
                            </svg>

                        </span>

                        <span class="menu-group-label">
                            CRM
                        </span>

                        <span class="menu-arrow">&#9656;</span>

                    </button>

                    <div class="menu-submenu"
                         id="crmSubmenu">

                        <a asp-controller="NewCrmDashboard"
                           asp-action="Index"
                           class="menu-item menu-item-sub">

                            <span class="menu-icon">🚀</span>

                            <span class="menu-text">
                                Dashboard
                            </span>

                        </a>

                        <a asp-controller="NewCrmLead"
                           asp-action="Index"
                           class="menu-item menu-item-sub">

                            <span class="menu-icon">💼</span>

                            <span class="menu-text">
                                Leads
                            </span>

                        </a>

                        <a asp-controller="NewCrmFollowUp"
                           asp-action="Index"
                           class="menu-item menu-item-sub"
                           id="navFollowUps">

                            <span class="menu-icon">📞</span>

                            <span class="menu-text">
                                Follow-ups
                            </span>

                            <span class="menu-badge"
                                  id="navFollowUpsBadge"
                                  title="Due today or overdue"
                                  hidden></span>

                        </a>

                        <a asp-controller="NewCrmReport"
                           asp-action="Index"
                           class="menu-item menu-item-sub">

                            <span class="menu-icon">📊</span>

                            <span class="menu-text">
                                Reports
                            </span>

                        </a>

                        <a asp-controller="NewCrmTimeLog"
                           asp-action="Index"
                           class="menu-item menu-item-sub"
                           id="navTimeLog">

                            <span class="menu-icon">⏱</span>

                            <span class="menu-text">
                                Time Log
                            </span>

                            <span class="menu-badge"
                                  id="navTimeLogBadge"
                                  title="Live meeting running"
                                  hidden></span>

                        </a>

                    </div>

                </div>


                <!-- ============ MASTERS (collapsible) ============ -->

                <div class="menu-group menu-group-parent"
                     id="mastersGroup">

                    <button type="button"
                            class="menu-group-toggle"
                            id="mastersToggle"
                            title="Masters"
                            aria-expanded="false"
                            aria-controls="mastersSubmenu">

                        <span class="menu-group-icon"
                              aria-hidden="true">

                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <polygon points="12 2 2 7 12 12 22 7 12 2" />
                                <polyline points="2 17 12 22 22 17" />
                                <polyline points="2 12 12 17 22 12" />
                            </svg>

                        </span>

                        <span class="menu-group-label">
                            Masters
                        </span>

                        <span class="menu-arrow">&#9656;</span>

                    </button>

                    <div class="menu-submenu"
                         id="mastersSubmenu">

                        <a asp-controller="Users"
                           asp-action="Index"
                           class="menu-item menu-item-sub">

                            <span class="menu-icon">👤</span>

                            <span class="menu-text">
                                User Master
                            </span>

                        </a>

                        <a asp-controller="States"
                           asp-action="Index"
                           class="menu-item menu-item-sub">

                            <span class="menu-icon">🗺️</span>

                            <span class="menu-text">
                                State Master
                            </span>

                        </a>

                        <a asp-controller="Clients"
                           asp-action="Index"
                           class="menu-item menu-item-sub">

                            <span class="menu-icon">🏢</span>

                            <span class="menu-text">
                                Client Master
                            </span>

                        </a>

                        <a asp-controller="StepMaster"
                           asp-action="Index"
                           class="menu-item menu-item-sub">

                            <span class="menu-icon">🪜</span>

                            <span class="menu-text">
                                Step Master
                            </span>

                        </a>

                        <a asp-controller="MstChannel"
                           asp-action="Index"
                           class="menu-item menu-item-sub">

                            <span class="menu-icon">📞</span>

                            <span class="menu-text">
                                Channel Master
                            </span>

                        </a>

                        <a asp-controller="MstCallType"
                           asp-action="Index"
                           class="menu-item menu-item-sub">

                            <span class="menu-icon">📋</span>

                            <span class="menu-text">
                                Call Type Master
                            </span>

                        </a>

                        <a asp-controller="MstCategory"
                           asp-action="Index"
                           class="menu-item menu-item-sub">

                            <span class="menu-icon">🗂️</span>

                            <span class="menu-text">
                                Category Master
                            </span>

                        </a>

                        <a asp-controller="MstSubCategory"
                           asp-action="Index"
                           class="menu-item menu-item-sub">

                            <span class="menu-icon">🧩</span>

                            <span class="menu-text">
                                Sub Category Master
                            </span>

                        </a>

                        <a asp-controller="MstPriority"
                           asp-action="Index"
                           class="menu-item menu-item-sub">

                            <span class="menu-icon">⚡</span>

                            <span class="menu-text">
                                Priority Master
                            </span>

                        </a>

                        <a asp-controller="MstStatus"
                           asp-action="Index"
                           class="menu-item menu-item-sub">

                            <span class="menu-icon">🚦</span>

                            <span class="menu-text">
                                Status Master
                            </span>

                        </a>

                    </div>

                </div>


                <!-- ============ TOOLS (collapsible) ============ -->

                <div class="menu-group menu-group-parent"
                     id="toolsGroup">

                    <button type="button"
                            class="menu-group-toggle"
                            id="toolsToggle"
                            title="Tools"
                            aria-expanded="false"
                            aria-controls="toolsSubmenu">

                        <span class="menu-group-icon"
                              aria-hidden="true">

                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                <polyline points="7 10 12 15 17 10" />
                                <line x1="12" y1="15" x2="12" y2="3" />
                            </svg>

                        </span>

                        <span class="menu-group-label">
                            Tools
                        </span>

                        <span class="menu-arrow">&#9656;</span>

                    </button>

                    <div class="menu-submenu"
                         id="toolsSubmenu">

                        <a asp-controller="Import"
                           asp-action="Index"
                           class="menu-item menu-item-sub">

                            <span class="menu-icon">📥</span>

                            <span class="menu-text">
                                Import Excel / CSV
                            </span>

                        </a>

                    </div>

                </div>


                <!-- ============ REPORTS (collapsible) ============ -->

                <div class="menu-group menu-group-parent"
                     id="reportsGroup">

                    <button type="button"
                            class="menu-group-toggle"
                            id="reportsToggle"
                            title="Reports"
                            aria-expanded="false"
                            aria-controls="reportsSubmenu">

                        <span class="menu-group-icon"
                              aria-hidden="true">

                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <line x1="12" y1="20" x2="12" y2="10" />
                                <line x1="18" y1="20" x2="18" y2="4" />
                                <line x1="6" y1="20" x2="6" y2="16" />
                            </svg>

                        </span>

                        <span class="menu-group-label">
                            Reports
                        </span>

                        <span class="menu-arrow">&#9656;</span>

                    </button>

                    <div class="menu-submenu"
                         id="reportsSubmenu">

                        <a asp-controller="Reports"
                           asp-action="Index"
                           class="menu-item menu-item-sub">

                            <span class="menu-icon">📊</span>

                            <span class="menu-text">
                                Reports
                            </span>

                        </a>

                    </div>

                </div>


            </nav>

            <!-- ============ LOGOUT (pinned to the sidebar bottom) ============ -->

            <div class="sidebar-footer">

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="menu-item logout-btn"
                            title="Logout">

                        <span class="menu-icon"
                              aria-hidden="true">

                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                                <polyline points="16 17 21 12 16 7" />
                                <line x1="21" y1="12" x2="9" y2="12" />
                            </svg>

                        </span>

                        <span class="menu-text">
                            Logout
                        </span>

                    </button>

                </form>

            </div>

        </aside>


        <!-- ================= MAIN ================= -->

        <main class="main-content">

            @RenderBody()

        </main>


    </div>


    <script src="~/js/site.js?v=17">
    </script>


    @RenderSection(
        "Scripts",
        required: false)


    <!-- ================= APP LOADER ================= -->

    <div class="app-loader"
         id="appLoader">

        <div class="app-loader-card">

            <div class="app-loader-spinner"></div>

            <div class="app-loader-text">
                Loading<span class="loading-dots"></span>
            </div>

        </div>

    </div>


</body>

</html>

