
@using System.Security.Claims

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - MANAGEMENT
    </title>

    <link rel="stylesheet"
          href="~/css/site.css?v=30" />

    <link rel="stylesheet"
          href="~/css/dashboard.css?v=4" />

    <!-- SheetJS reads the .xlsx / .xls / .csv file in
         the browser. It is served from wwwroot so the
         Import page keeps working on a machine with no
         internet; the CDN is only a fallback for when
         the local copy is missing. -->
    <script defer
            src="~/js/xlsx.full.min.js?v=1"
            onerror="var s=document.createElement('script');s.src='https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js';document.head.appendChild(s);"></script>

</head>


<body>

    <div class="layout">


        <!-- ================= SIDEBAR ================= -->

        <aside class="sidebar" id="appSidebar">

            <div class="sidebar-top">

                <div class="sidebar-logo">

                    <h2>
                      MANAGEMENT
                    </h2>

                </div>

                <button type="button"
                        id="sidebarToggle"
                        class="sidebar-toggle"
                        title="Toggle sidebar"
                        aria-label="Toggle sidebar">

                    ☰

                </button>

            </div>


            <div class="user-info">

                <span>
                    Logged in as
                </span>

                <strong>
                    @User.Identity?.Name
                </strong>

            </div>


            <nav class="sidebar-menu">


                <div class="menu-group">

                    <span class="menu-group-label">
                        Dashboard
                    </span>

                    <a asp-controller="Dashboard"
                       asp-action="Index"
                       class="menu-item">

                        <span class="menu-icon">🏠</span>

                        <span class="menu-text">
                            Home
                        </span>

                    </a>

                </div>


                <div class="menu-group">

                    <span class="menu-group-label">
                        Operations
                    </span>

                    <a asp-controller="DailySupport"
                       asp-action="Index"
                       class="menu-item">

                        <span class="menu-icon">🛠️</span>

                        <span class="menu-text">
                            Daily Support
                        </span>

                    </a>

                    <a asp-controller="ClientVisiting"
                       asp-action="Index"
                       class="menu-item">

                        <span class="menu-icon">📍</span>

                        <span class="menu-text">
                            Client Visiting
                        </span>

                    </a>

                </div>


@* ===== OLD CRM (hidden - pages URL se accessible) =====
                <div class="menu-group">

                    <span class="menu-group-label">
                        CRM
                    </span>

                    <a asp-controller="CrmDashboard"
                       asp-action="Index"
                       class="menu-item">

                        <span class="menu-icon">📈</span>

                        <span class="menu-text">
                            CRM Dashboard
                        </span>

                    </a>

                    <a asp-controller="CrmLead"
                       asp-action="Index"
                       class="menu-item">

                        <span class="menu-icon">🎯</span>

                        <span class="menu-text">
                            Lead Master
                        </span>

                    </a>

                    <a asp-controller="CrmFollowUp"
                       asp-action="Index"
                       class="menu-item">

                        <span class="menu-icon">📞</span>

                        <span class="menu-text">
                            Daily Follow-up
                        </span>

                        <span class="menu-badge"
                              id="navFollowUpBadge"
                              title="Due today or overdue"
                              hidden></span>

                    </a>

                    <a asp-controller="CrmLeadHistory"
                       asp-action="Index"
                       class="menu-item">

                        <span class="menu-icon">🧾</span>

                        <span class="menu-text">
                            Lead History
                        </span>

                    </a>

                </div>
                =====*@


                <div class="menu-group">

                    <span class="menu-group-label">
                        CRM
                    </span>

                    <a asp-controller="NewCrmDashboard"
                       asp-action="Index"
                       class="menu-item">

                        <span class="menu-icon">🚀</span>

                        <span class="menu-text">
                            Dashboard
                        </span>

                    </a>

                    <a asp-controller="NewCrmLead"
                       asp-action="Index"
                       class="menu-item">

                        <span class="menu-icon">💼</span>

                        <span class="menu-text">
                            Leads
                        </span>

                    </a>

                    <a asp-controller="NewCrmFollowUp"
                       asp-action="Index"
                       class="menu-item"
                       id="navFollowUps">

                        <span class="menu-icon">📞</span>

                        <span class="menu-text">
                            Follow-ups
                        </span>

                        <span class="menu-badge"
                              id="navFollowUpsBadge"
                              title="Due today or overdue"
                              hidden></span>

                    </a>

                    <a asp-controller="NewCrmReport"
                       asp-action="Index"
                       class="menu-item">

                        <span class="menu-icon">📊</span>

                        <span class="menu-text">
                            Reports
                        </span>

                    </a>

                    <a asp-controller="NewCrmTimeLog"
                       asp-action="Index"
                       class="menu-item"
                       id="navTimeLog">

                        <span class="menu-icon">⏱</span>

                        <span class="menu-text">
                            Time Log
                        </span>

                        <span class="menu-badge"
                              id="navTimeLogBadge"
                              title="Live meeting running"
                              hidden></span>

                    </a>

                </div>


                <!-- ============ MASTERS (collapsible) ============ -->

                <div class="menu-group menu-group-parent"
                     id="mastersGroup">

                    <button type="button"
                            class="menu-group-toggle"
                            id="mastersToggle"
                            aria-expanded="false"
                            aria-controls="mastersSubmenu">

                        <span class="menu-group-label">
                            Masters
                        </span>

                        <span class="menu-arrow">&#9656;</span>

                    </button>

                    <div class="menu-submenu"
                         id="mastersSubmenu">

                        <a asp-controller="Users"
                           asp-action="Index"
                           class="menu-item menu-item-sub">

                            <span class="menu-icon">👤</span>

                            <span class="menu-text">
                                User Master
                            </span>

                        </a>

                        <a asp-controller="States"
                           asp-action="Index"
                           class="menu-item menu-item-sub">

                            <span class="menu-icon">🗺️</span>

                            <span class="menu-text">
                                State Master
                            </span>

                        </a>

                        <a asp-controller="Clients"
                           asp-action="Index"
                           class="menu-item menu-item-sub">

                            <span class="menu-icon">🏢</span>

                            <span class="menu-text">
                                Client Master
                            </span>

                        </a>

                        <a asp-controller="StepMaster"
                           asp-action="Index"
                           class="menu-item menu-item-sub">

                            <span class="menu-icon">🪜</span>

                            <span class="menu-text">
                                Step Master
                            </span>

                        </a>

                    </div>

                </div>


                <div class="menu-group">

                    <span class="menu-group-label">
                        Tools
                    </span>

                    <a asp-controller="Import"
                       asp-action="Index"
                       class="menu-item">

                        <span class="menu-icon">📥</span>

                        <span class="menu-text">
                            Import Excel / CSV
                        </span>

                    </a>

                </div>


                <div class="menu-group">

                    <span class="menu-group-label">
                        Reports
                    </span>

                    <a asp-controller="Reports"
                       asp-action="Index"
                       class="menu-item">

                        <span class="menu-icon">📊</span>

                        <span class="menu-text">
                            Reports
                        </span>

                    </a>

                </div>


                <div class="menu-group">

                    <span class="menu-group-label">
                        Logout
                    </span>

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="menu-item logout-btn">

                            <span class="menu-icon">🚪</span>

                            <span class="menu-text">
                                Logout
                            </span>

                        </button>

                    </form>

                </div>

            </nav>

        </aside>


        <!-- ================= MAIN ================= -->

        <main class="main-content">

            @RenderBody()

        </main>


    </div>


    @RenderSection(
        "Scripts",
        required: false)


    <!-- ================= APP LOADER ================= -->

    <div class="app-loader"
         id="appLoader">

        <div class="app-loader-card">

            <div class="app-loader-spinner"></div>

            <div class="app-loader-text">
                Loading<span class="loading-dots"></span>
            </div>

        </div>

    </div>


    <script src="~/js/site.js?v=13">
    </script>

</body>

</html>

