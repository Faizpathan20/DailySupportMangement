@model Master.Models.CrmKpiViewModel

@{
    string icon = Model.Icon switch
    {
        "users" => "<path d=\"M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"M23 21v-2a4 4 0 0 0-3-3.87\"></path><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"></path>",

        "target" => "<circle cx=\"12\" cy=\"12\" r=\"10\"></circle><circle cx=\"12\" cy=\"12\" r=\"6\"></circle><circle cx=\"12\" cy=\"12\" r=\"2\"></circle>",

        "spark" => "<path d=\"M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83\"></path>",

        "phone" => "<path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z\"></path>",

        "check" => "<path d=\"M22 11.08V12a10 10 0 1 1-5.93-9.14\"></path><polyline points=\"22 4 12 14.01 9 11.01\"></polyline>",

        "trophy" => "<path d=\"M6 9H4.5a2.5 2.5 0 0 1 0-5H6\"></path><path d=\"M18 9h1.5a2.5 2.5 0 0 0 0-5H18\"></path><path d=\"M4 22h16\"></path><path d=\"M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22\"></path><path d=\"M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22\"></path><path d=\"M18 2H6v7a6 6 0 0 0 12 0V2z\"></path>",

        "x" => "<circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"15\" y1=\"9\" x2=\"9\" y2=\"15\"></line><line x1=\"9\" y1=\"9\" x2=\"15\" y2=\"15\"></line>",

        "calendar" => "<rect x=\"3\" y=\"4\" width=\"18\" height=\"18\" rx=\"2\"></rect><line x1=\"16\" y1=\"2\" x2=\"16\" y2=\"6\"></line><line x1=\"8\" y1=\"2\" x2=\"8\" y2=\"6\"></line><line x1=\"3\" y1=\"10\" x2=\"21\" y2=\"10\"></line>",

        "clock" => "<circle cx=\"12\" cy=\"12\" r=\"10\"></circle><polyline points=\"12 6 12 12 16 14\"></polyline>",

        "alert" => "<path d=\"M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z\"></path><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"></line><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"></line>",

        "history" => "<path d=\"M3 3v5h5\"></path><path d=\"M3.05 13A9 9 0 1 0 6 5.3L3 8\"></path><path d=\"M12 7v5l4 2\"></path>",

        _ => "<line x1=\"18\" y1=\"20\" x2=\"18\" y2=\"10\"></line><line x1=\"12\" y1=\"20\" x2=\"12\" y2=\"4\"></line><line x1=\"6\" y1=\"20\" x2=\"6\" y2=\"14\"></line>"
    };
}

@{
    var content =
        "<span class=\"crm-kpi-icon\">"
        + "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" "
        + "stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" "
        + "width=\"18\" height=\"18\" aria-hidden=\"true\">" + icon + "</svg>"
        + "</span>";

    // Only emit the refresh key when one is provided, so empty keys
    // cannot collide with each other during an in-place refresh.
    string kpiAttr = string.IsNullOrWhiteSpace(Model.Kpi)
        ? ""
        : $" data-kpi=\"{Model.Kpi}\"";
}

@if (!string.IsNullOrWhiteSpace(Model.Href))
{
    <a class="crm-kpi crm-kpi-link"
       href="@Model.Href"
       style="--kpi-color:@Model.Accent;--kpi-soft:@Model.Soft;">
        <div class="crm-kpi-top">
            @Html.Raw(content)
            <p class="crm-kpi-label">@Model.Label</p>
        </div>
        <h3 class="crm-kpi-value"@Html.Raw(kpiAttr)>@Model.Value</h3>
    </a>
}
else
{
    <div class="crm-kpi"
         style="--kpi-color:@Model.Accent;--kpi-soft:@Model.Soft;">
        <div class="crm-kpi-top">
            @Html.Raw(content)
            <p class="crm-kpi-label">@Model.Label</p>
        </div>
        <h3 class="crm-kpi-value"@Html.Raw(kpiAttr)>@Model.Value</h3>
    </div>
}
