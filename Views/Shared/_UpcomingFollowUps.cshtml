@model DashboardUpcomingFollowUpsViewModel

<!-- Upcoming Follow-ups (COMPONENT 9).
     DailySupport rows with an upcoming FollowUpDate (not Cancelled),
     behind the shared DashboardFilter. Client resolves via ClientMaster,
     assigned user via LoginUsers. Status pills reuse the existing
     .status-pill + .badge-* styles. -->

<div class="state-section followups-panel">

    <div class="support-analytics-header">

        <h3>
            Upcoming Follow-ups
        </h3>

        <span class="support-analytics-total">
            @Model.TotalUpcoming upcoming
        </span>

    </div>


    @if (Model.Items.Count > 0)
    {
        <table class="followups-table">

            <thead>

                <tr>

                    <th class="sortable col-client"
                        data-sort="text"
                        onclick="sortDashboardTable(this)">

                        <span class="th-text">
                            Client
                        </span>

                        <span class="sort-indicator">
                            <span class="sort-up"></span>
                            <span class="sort-down"></span>
                        </span>

                    </th>

                    <th class="sortable col-date"
                        data-sort="date"
                        onclick="sortDashboardTable(this)">

                        <span class="th-text">
                            Follow-up Date
                        </span>

                        <span class="sort-indicator">
                            <span class="sort-up"></span>
                            <span class="sort-down"></span>
                        </span>

                    </th>

                    <th class="sortable col-type"
                        data-sort="text"
                        onclick="sortDashboardTable(this)">

                        <span class="th-text">
                            Support Type
                        </span>

                        <span class="sort-indicator">
                            <span class="sort-up"></span>
                            <span class="sort-down"></span>
                        </span>

                    </th>

                    <th class="sortable col-subject"
                        data-sort="text"
                        onclick="sortDashboardTable(this)">

                        <span class="th-text">
                            Subject
                        </span>

                        <span class="sort-indicator">
                            <span class="sort-up"></span>
                            <span class="sort-down"></span>
                        </span>

                    </th>

                    <th class="sortable col-status"
                        data-sort="status"
                        onclick="sortDashboardTable(this)">

                        <span class="th-text">
                            Status
                        </span>

                        <span class="sort-indicator">
                            <span class="sort-up"></span>
                            <span class="sort-down"></span>
                        </span>

                    </th>

                    <th class="sortable col-user"
                        data-sort="text"
                        onclick="sortDashboardTable(this)">

                        <span class="th-text">
                            User
                        </span>

                        <span class="sort-indicator">
                            <span class="sort-up"></span>
                            <span class="sort-down"></span>
                        </span>

                    </th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model.Items)
                {
                    <tr>

                        <td class="col-client">
                            @item.ClientName
                        </td>

                        <td class="col-date">
                            @item.FollowUpDateText
                        </td>

                        <td class="col-type">
                            @item.SupportType
                        </td>

                        <td class="col-subject">
                            @item.Subject
                        </td>

                        <td class="col-status">

                            <span class="status-pill @item.StatusClass">
                                @item.Status
                            </span>

                        </td>

                        <td class="col-user">
                            @item.UserName
                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }
    else
    {
        <p class="followups-empty">
            No Records Found on this filter.
        </p>
    }

</div>