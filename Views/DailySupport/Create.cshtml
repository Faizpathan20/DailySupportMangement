@model Master.Models.DailySupportViewModel

@{
    ViewData["Title"] = "Add Support";

    var staticOptions = ViewBag.StaticOptions as Dictionary<string, string[]>
        ?? new Dictionary<string, string[]>();

    var dropdowns = ViewBag.Dropdowns as Dictionary<string, List<LookupOptionViewModel>>
        ?? new Dictionary<string, List<LookupOptionViewModel>>();

    string GetVal(string name)
        => Model.GetFormValue(name);

    string GetErr(string name)
        => Model.FieldError(name);

    var placeholders = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["Subject"] = "Short subject",
        ["Description"] = "Client problem / request",
        ["Remarks"] = "Voice to text - click Mic and speak..."
    };
}


<div class="page-header">

    <a href="@Url.Action("Index", "DailySupport")"
       class="back-link">

        &larr; Back to Daily Support

    </a>

    <div>

        <h1>
            Add Support
        </h1>

        <p>
            New daily support record
        </p>

    </div>

</div>


<!-- ================= MESSAGES ================= -->

@if (TempData["Success"] != null)
{
    <div class="success-message">

        @TempData["Success"]

    </div>
}


@if (TempData["Error"] != null)
{
    <div class="error-message">

        @Html.Raw(TempData["Error"])

    </div>
}


<!-- ================= ADD SUPPORT FORM ================= -->

<div class="state-section">

    <form method="post"
          id="supportCreateForm"
          action="@Url.Action("Create", "DailySupport")"
          novalidate>

        @Html.AntiForgeryToken()

        <div class="form-grid">

            @foreach (var field in Model.FormFields)
            {
                var options = field.Type == "options"
                    && staticOptions.TryGetValue(
                        field.Name,
                        out var opts)
                    ? opts
                    : Array.Empty<string>();

                var hasOther = options.Contains(
                    "Other",
                    StringComparer.OrdinalIgnoreCase);

                string fullClass =
                    field.Control == "textarea"
                        ? "form-group form-group-full"
                        : "form-group";

                var placeholder =
                    placeholders.TryGetValue(
                        field.Name,
                        out var ph)
                    ? ph
                    : "";

                if (field.Type == "options")
                {
                    string onChangeAttr =
                        hasOther
                            ? "toggleOtherField(this)"
                            : "";

                    <div class="@fullClass">

                        <label>
                            @field.Display
                        </label>

                        <select name="@field.Name"
                                id="edit_@field.Name"
                                onchange="@onChangeAttr"
                                @(field.Required ? "required" : null)>

                            <option value=""
                                    disabled
                                    selected="@(string.IsNullOrWhiteSpace(GetVal(field.Name)))">
                                -- Select @field.Display --
                            </option>

                            @foreach (var option in options)
                            {
                                <option value="@option"
                                        selected="@(GetVal(field.Name) == option)">
                                    @option
                                </option>
                            }

                        </select>

                        @if (!string.IsNullOrWhiteSpace(GetErr(field.Name)))
                        {
                            <span class="field-error">
                                @GetErr(field.Name)
                            </span>
                        }

                        @if (hasOther)
                        {
                            <div id="other@(field.Name)Group"
                                 style="@(GetVal(field.Name) == "Other" ? "" : "display:none")">

                                <label class="sub-label">
                                    Other @field.Display
                                </label>

                                <input type="text"
                                       name="Other@(field.Name)"
                                       id="edit_Other@(field.Name)"
                                       maxlength="92"
                                       placeholder="Specify other @field.Display.ToLower()"
                                       value="@GetVal("Other" + field.Name)"
                                       @(GetVal(field.Name) == "Other" ? "required" : null) />

                                @if (!string.IsNullOrWhiteSpace(GetErr("Other" + field.Name)))
                                {
                                    <span class="field-error">
                                        @GetErr("Other" + field.Name)
                                    </span>
                                }

                            </div>
                        }

                    </div>
                }
                else if (field.Control == "select")
                {
                    var lookupOptions =
                        field.LookupKey != null
                        && dropdowns.TryGetValue(
                            field.LookupKey,
                            out var lopts)
                        ? lopts
                        : new List<LookupOptionViewModel>();

                    <div class="@fullClass">

                        <label>
                            @field.Display
                        </label>

                        <select name="@field.Name"
                                id="edit_@field.Name"
                                data-searchable
                                @(field.Required ? "required" : null)>

                            <option value=""
                                    disabled
                                    selected="@(string.IsNullOrWhiteSpace(GetVal(field.Name)))">
                                -- Select @field.Display --
                            </option>

                            @foreach (var option in lookupOptions)
                            {
                                <option value="@option.Id"
                                        selected="@(GetVal(field.Name) == option.Id.ToString())">
                                    @option.Name
                                </option>
                            }

                        </select>

                        @if (!string.IsNullOrWhiteSpace(GetErr(field.Name)))
                        {
                            <span class="field-error">
                                @GetErr(field.Name)
                            </span>
                        }

                    </div>
                }
                else if (field.Control == "textarea")
                {
                    <div class="@fullClass">

                        <label>
                            @field.Display
                        </label>

                        <textarea id="edit_@field.Name"
                                  name="@field.Name"
                                  rows="2"
                                  placeholder="@placeholder"
                                  @(field.Required ? "required" : null)>@GetVal(field.Name)</textarea>

                        @if (!string.IsNullOrWhiteSpace(GetErr(field.Name)))
                        {
                            <span class="field-error">
                                @GetErr(field.Name)
                            </span>
                        }

                        @if (field.Name == "Remarks")
                        {
                            <div class="voice-controls">

                                <button type="button"
                                        class="voice-btn mic-btn"
                                        id="voiceMicBtn"
                                        onclick="startVoice()">

                                    Mic

                                </button>

                                <button type="button"
                                        class="voice-btn voice-stop"
                                        onclick="stopVoice()">

                                    Stop

                                </button>

                                <button type="button"
                                        class="voice-btn voice-reset"
                                        onclick="resetRemarks()">

                                    Reset

                                </button>

                            </div>

                            <span class="voice-status"
                                  id="voiceStatus"></span>

                            <span class="voice-hint">
                                Voice to Text: Mic se bolen, text Remarks ke end me jude ga. Mic tab tak open rahega jab tak Stop nahi click karte.
                            </span>
                        }

                    </div>
                }
                else
                {
                    var inputValue =
                        field.InputType == "date"
                        && field.Required
                        && string.IsNullOrWhiteSpace(
                            GetVal(field.Name))
                        ? DateTime.Today.ToString(
                            "yyyy-MM-dd")
                        : GetVal(field.Name);

                    <div class="@fullClass">

                        <label>
                            @field.Display
                        </label>

                        <input type="@field.InputType"
                               id="edit_@field.Name"
                               name="@field.Name"
                               value="@inputValue"
                               placeholder="@placeholder"
                               @(field.Required ? "required" : null) />

                        @if (!string.IsNullOrWhiteSpace(GetErr(field.Name)))
                        {
                            <span class="field-error">
                                @GetErr(field.Name)
                            </span>
                        }

                    </div>
                }
            }

        </div>


        <span class="voice-hint auto-time-hint">
            Status rules: Open = optional fields. In Progress = Start Time required. Pending = Start + Remarks required, End Time blank. Completed = Start + End + Remarks required. Cancelled = Remarks required.
        </span>


        <div class="modal-actions">

            <button type="submit"
                    class="save-btn">

                Save

            </button>

            <a href="@Url.Action("Index", "DailySupport")"
               class="cancel-btn">

                Cancel

            </a>

        </div>

    </form>

</div>


@section Scripts
{
    <script>

        // ==========================================
        // VOICE TO TEXT - REMARKS
        // ==========================================

        var recognition = null;
        var isRecording = false;
        var speechBaseText = "";
        var speechFinal = "";


        function speechSupported() {

            return (
                "webkitSpeechRecognition" in window
                || "SpeechRecognition" in window
            );

        }


        function setListening(on) {

            var micBtn =
                document.getElementById(
                    "voiceMicBtn"
                );

            var status =
                document.getElementById(
                    "voiceStatus"
                );


            if (micBtn) {

                if (on) {
                    micBtn.classList.add(
                        "is-recording"
                    );
                } else {
                    micBtn.classList.remove(
                        "is-recording"
                    );
                }

            }


            if (status) {

                if (on) {
                    status.innerText =
                        "● Listening... Stop click karne tak mic open rahega";
                    status.classList.add("visible");
                } else {
                    status.classList.remove("visible");
                }

            }

        }


        function applySpeechText(textarea, interim) {

            var parts = [];

            if (speechBaseText.length > 0) {
                parts.push(speechBaseText);
            }

            if (speechFinal.trim().length > 0) {
                parts.push(speechFinal.trim());
            }

            if (interim.trim().length > 0) {
                parts.push(interim.trim());
            }

            textarea.value = parts.join(" ");

        }


        function toggleOtherField(select) {

            var name = select.id.replace(
                /^edit_/,
                ""
            );

            var group =
                document.getElementById(
                    "other" + name + "Group"
                );

            var input =
                document.getElementById(
                    "edit_Other" + name
                );

            var isOther =
                select !== null
                && select.value === "Other";

            if (group) {

                group.style.display =
                    isOther ? "" : "none";

            }

            if (input) {

                input.required = isOther ? true : false;

            }

        }


        function startVoice() {

            var textarea =
                document.getElementById(
                    "edit_Remarks"
                );


            if (!speechSupported()) {

                alert(
                    "Speech Recognition is not supported in this browser. " +
                    "Please use Google Chrome."
                );

                return;

            }


            var SpeechRecognition =
                window.SpeechRecognition
                || window.webkitSpeechRecognition;

            recognition =
                new SpeechRecognition();

            recognition.lang = "en-IN";

            recognition.interimResults = true;

            recognition.continuous = true;

            recognition.maxAlternatives = 1;


            recognition.onstart = function () {

                isRecording = true;

                speechBaseText =
                    textarea.value.trim();

                speechFinal = "";

                setListening(true);

                textarea.focus();

            };


            recognition.onresult = function (event) {

                var interimText = "";


                for (
                    var i = event.resultIndex;
                    i < event.results.length;
                    i++
                ) {

                    var result = event.results[i];

                    if (result.isFinal) {
                        speechFinal +=
                            " " + result[0].transcript;
                    } else {
                        interimText +=
                            result[0].transcript;
                    }

                }


                applySpeechText(
                    textarea,
                    interimText
                );

            };


            recognition.onerror = function (event) {

                if (
                    event.error === "not-allowed"
                    || event.error ===
                        "service-not-allowed"
                ) {

                    alert(
                        "Microphone permission denied. " +
                        "Please allow microphone access."
                    );

                } else if (
                    event.error === "no-speech"
                ) {

                    alert(
                        "No speech detected. " +
                        "Please try again."
                    );

                } else {

                    alert(
                        "Speech recognition error: "
                        + event.error
                    );

                }

                isRecording = false;

                setListening(false);

            };


            recognition.onend = function () {

                isRecording = false;

                setListening(false);

            };


            try {

                recognition.start();

            } catch (error) {

                alert(
                    "Could not start speech recognition: "
                    + error.message
                );

            }

        }


        function stopVoice() {

            if (recognition) {

                recognition.stop();

            }

            isRecording = false;

            setListening(false);

        }


        function resetRemarks() {

            if (
                !confirm(
                    "Are you sure you want to clear remarks?"
                )
            ) {
                return;
            }

            // Speech bhi stop ho jaye
            if (recognition) {

                recognition.stop();

            }

            isRecording = false;

            setListening(false);

            speechBaseText = "";
            speechFinal = "";

            document.getElementById(
                "edit_Remarks"
            ).value = "";

        }


        document.addEventListener(
            "DOMContentLoaded",
            function () {

                var form =
                    document.getElementById(
                        "supportCreateForm"
                    );

                if (!form) {
                    return;
                }

                form.addEventListener(
                    "submit",
                    function (event) {

                        event.preventDefault();

                        masterAjaxPost(
                            this,
                            function (result) {

                                masterShowToast(
                                    result.message,
                                    "success"
                                );

                                setTimeout(function () {

                                    window.location.href =
                                        "@Url.Action("Index", "DailySupport")";

                                }, 700);

                            }
                        );

                    }
                );

            }
        );

    </script>
}