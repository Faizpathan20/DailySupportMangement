@model Master.Models.DailySupportViewModel
@using System.Text.Json
@using System.Text.Encodings.Web

@{
    ViewData["Title"] = "Add Support";

    var staticOptions = ViewBag.StaticOptions as Dictionary<string, string[]>
        ?? new Dictionary<string, string[]>();

    var dropdowns = ViewBag.Dropdowns as Dictionary<string, List<LookupOptionViewModel>>
        ?? new Dictionary<string, List<LookupOptionViewModel>>();

    var clientsWithMobile = ViewBag.ClientsWithMobile as List<LookupOptionViewModel>
        ?? new List<LookupOptionViewModel>();

    string GetVal(string name)
        => Model.GetFormValue(name);

    string GetErr(string name)
        => Model.FieldError(name);

    var placeholders = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["Subject"] = "Short subject (Issue)",
        ["Description"] = "Client problem / request details"
    };

    string ticketNo = ViewBag.TicketNo as string ?? string.Empty;
    string currentUserId = ViewBag.CurrentUserId as string ?? string.Empty;
    string todayDate = DateTime.Today.ToString("yyyy-MM-dd");
    string todayDisplay = DateTime.Today.ToString("dd/MM/yyyy");

    string[] statusOptions = staticOptions.TryGetValue("Status", out var sOpts) ? sOpts : new[] { "Open", "In Progress", "On Hold", "Pending", "Closed" };
    string[] priorityOptions = staticOptions.TryGetValue("Priority", out var pOpts) ? pOpts : new[] { "Low", "Medium", "High", "Urgent" };
    string[] channelOptions = staticOptions.TryGetValue("Channel", out var chOpts) ? chOpts : new[] { "Phone", "WhatsApp", "Email", "Walk-in / Service" };
    string[] callTypeOptions = staticOptions.TryGetValue("CallType", out var ctOpts) ? ctOpts : new[] { "Inquiry", "Complaint", "Service", "New Requirement" };
    string[] categoryOptions = staticOptions.TryGetValue("Category", out var catOpts) ? catOpts : new[] { "Hardware", "Software", "Networking", "Billing", "Printer" };
    var usersList = dropdowns.TryGetValue("LoginUsers", out var uList) ? uList : new List<LookupOptionViewModel>();
}

<div class="page-header">
    <a href="@Url.Action("Index", "DailySupport")" class="back-link">&larr; Back to Daily Support</a>
    <div>
        <h1>Add Support</h1>
        <p>New daily support record</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="success-message">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="error-message">@Html.Raw(TempData["Error"])</div>
}

<div class="state-section">
    <form method="post" id="supportCreateForm" action="@Url.Action("Create", "DailySupport")" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" name="SupportType" value="Client Query" />
        <input type="hidden" name="SupportDate" id="hiddenSupportDate" value="@todayDate" />
        <input type="hidden" name="TicketNo" id="hiddenTicketNo" value="@ticketNo" />

        <div class="call-form-section">
            <div class="form-section-title">TICKET DETAILS</div>
            <div class="form-grid">
                <div class="form-group">
                    <label>Ticket No</label>
                    <input type="text" class="ticket-input" value="@ticketNo" readonly />
                </div>
                <div class="form-group">
                    <label>Status</label>
                    <select name="Status" id="edit_Status" required>
                        @foreach (var opt in statusOptions)
                        {
                            <option value="@opt" selected="@(string.IsNullOrWhiteSpace(GetVal("Status")) ? opt=="Open" : GetVal("Status")==opt)">@opt</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Priority</label>
                    <select name="Priority" id="edit_Priority" required>
                        @foreach (var opt in priorityOptions)
                        {
                            <option value="@opt" selected="@(string.IsNullOrWhiteSpace(GetVal("Priority")) ? opt=="Medium" : GetVal("Priority")==opt)">@opt</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Call Date</label>
                    <input type="text" class="call-date-input" value="@todayDisplay" readonly />
                </div>
            </div>
        </div>

        <div class="call-form-section">
            <div class="form-section-title">CUSTOMER DETAILS</div>
            <div class="form-grid">
                <div class="form-group mobile-search-wrap">
                    <label>Search Mobile No</label>
                    <div class="mobile-search-row">
                        <input type="text" id="searchMobile" placeholder="Enter mobile number or name" />
                        <button type="button" class="mobile-search-btn" id="searchMobileBtn">Search</button>
                    </div>
                    <div class="suggestion-box" id="mobileSuggestions"></div>
                </div>
                <div class="form-group client-select-wrapper">
                    <label>Select Client</label>
                    <input type="hidden" name="ClientId" id="clientIdField" />
                    <input type="text" id="clientSearchInput" placeholder="Type to search client (Name - Mobile)" autocomplete="off" />
                    <div class="select-dropdown" id="clientDropdown"></div>
                    <select id="customerSelect" style="display:none">
                        <option value="">-- Select Client --</option>
                        @foreach (var c in clientsWithMobile)
                        {
                            string mobileText = string.IsNullOrWhiteSpace(c.Mobile) ? "" : c.Mobile;
                            string displayText = string.IsNullOrWhiteSpace(mobileText) ? c.Name : $"{c.Name} - {mobileText}";
                            <option value="@c.Id" data-name="@c.Name" data-mobile="@mobileText">@displayText</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Mobile</label>
                    <input type="text" name="Mobile" id="mobileField" maxlength="20" placeholder="Mobile No." />
                </div>
                <div class="form-group">
                    <label>Caller Name</label>
                    <input type="text" name="CallerName" id="callerNameField" maxlength="150" placeholder="Caller Name" />
                </div>
                <div class="form-group">
                    <label>Channel</label>
                    <select name="Channel" id="edit_Channel">
                        <option value="">-- Select Channel --</option>
                        @foreach (var opt in channelOptions)
                        {
                            <option value="@opt" selected="@(GetVal("Channel")==opt)">@opt</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Call Type</label>
                    <select name="CallType" id="edit_CallType">
                        <option value="">-- Select Call Type --</option>
                        @foreach (var opt in callTypeOptions)
                        {
                            <option value="@opt" selected="@(GetVal("CallType")==opt)">@opt</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Category</label>
                    <select name="Category" id="edit_Category">
                        <option value="">-- Select Category --</option>
                        @foreach (var opt in categoryOptions)
                        {
                            <option value="@opt" selected="@(GetVal("Category")==opt)">@opt</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Assign To</label>
                    <select name="UserId" id="edit_UserId" required>
                        <option value="">-- Select Assign To --</option>
                        @foreach (var u in usersList)
                        {
                            string sel = (!string.IsNullOrWhiteSpace(GetVal("UserId")) && GetVal("UserId")==u.Id.ToString()) ? "selected" : "";
                            if (string.IsNullOrWhiteSpace(sel) && !string.IsNullOrWhiteSpace(currentUserId) && currentUserId==u.Id.ToString()) sel = "selected";
                            <option value="@u.Id" selected="@sel">@u.Name</option>
                        }
                    </select>
                </div>
                <div class="form-group form-group-full">
                    <label>Issue</label>
                    <input type="text" name="Subject" id="edit_Subject" maxlength="200" placeholder="@placeholders["Subject"]" value="@GetVal("Subject")" required />
                </div>
                <div class="form-group form-group-full">
                    <label>Description</label>
                    <textarea name="Description" id="edit_Description" rows="3" placeholder="@placeholders["Description"]" required>@GetVal("Description")</textarea>

                    <div class="voice-controls ds-voice-controls">

                        <button type="button"
                                class="voice-btn mic-btn"
                                id="voiceMicBtn_Description"
                                title="Start voice input"
                                aria-label="Start voice input"
                                onclick="startVoice('Description')">

                            <svg viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z" />
                                <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
                                <line x1="12" y1="19" x2="12" y2="23" />
                            </svg>

                        </button>

                        <button type="button"
                                class="voice-btn voice-stop"
                                id="voiceStopBtn_Description"
                                title="Stop recording"
                                aria-label="Stop recording"
                                disabled
                                onclick="stopVoice()">

                            <svg viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <rect x="6" y="6" width="12" height="12" rx="2" />
                            </svg>

                        </button>

                        <button type="button"
                                class="voice-btn voice-reset"
                                title="Clear field"
                                aria-label="Clear field"
                                onclick="resetVoice('Description')">

                            <svg viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M3 12a9 9 0 1 0 3-6.7L3 8" />
                                <polyline points="3 3 3 8 8 8" />
                            </svg>

                        </button>

                    </div>

                    <span class="voice-status"
                          id="voiceStatus_Description"></span>

                    <span class="voice-hint">
                        Voice to Text: speak into the mic; the text is appended to the end of Description. The mic stays open until you click Stop.
                    </span>
                </div>
            </div>
        </div>

        <div class="modal-actions">
            <button type="button" class="cancel-btn" id="clearFormBtn">Clear</button>
            <button type="submit" class="save-btn">Save Call</button>
        </div>
    </form>
</div>

@section Styles
{
    <style>
        /* Icon-only voice controls (Daily Support create page only). */
        .ds-voice-controls {
            gap: 6px;
        }

        .ds-voice-controls .voice-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 30px;
            height: 30px;
            padding: 0;
            border: 1px solid #dbe3ec;
            border-radius: 8px;
            background: #fff;
            color: #475569;
            box-shadow: 0 1px 2px rgba(15, 23, 42, .04);
            transition: all .15s ease;
        }

        .ds-voice-controls .voice-btn svg {
            width: 14px;
            height: 14px;
            pointer-events: none;
        }

        .ds-voice-controls .mic-btn {
            background: #eff6ff;
            border-color: #dbeafe;
            color: #1d4ed8;
        }

        .ds-voice-controls .mic-btn:hover {
            background: #dbeafe;
            border-color: #bfdbfe;
        }

        .ds-voice-controls .mic-btn.is-recording {
            background: #dc2626;
            border-color: #dc2626;
            color: #fff;
            animation: voicePulse 1.2s infinite;
        }

        .ds-voice-controls .voice-stop {
            background: #fff1f2;
            border-color: #fecdd3;
            color: #be123c;
        }

        .ds-voice-controls .voice-stop:hover:not(:disabled) {
            background: #ffe4e6;
            border-color: #fda4af;
        }

        .ds-voice-controls .voice-stop:disabled {
            opacity: .45;
            cursor: not-allowed;
        }

        .ds-voice-controls .voice-reset {
            background: #f8fafc;
            border-color: #e2e8f0;
            color: #475569;
        }

        .ds-voice-controls .voice-reset:hover {
            background: #f1f5f9;
            color: #0f172a;
        }

        .ds-voice-controls .voice-btn:focus-visible {
            outline: 2px solid #2563eb;
            outline-offset: 2px;
        }

        .ds-voice-controls ~ .voice-status.visible::before {
            content: "";
            display: inline-block;
            width: 7px;
            height: 7px;
            border-radius: 999px;
            background: #dc2626;
            animation: dsVoiceDot 1.1s ease-in-out infinite;
        }

        @@keyframes dsVoiceDot {
            0%, 100% { opacity: 1; }
            50% { opacity: .25; }
        }
    </style>
}

@section Scripts
{
    <script>
        var clients = [];
        var mobileTimer = null;

        function initClients() {
            var sel = document.getElementById('customerSelect');
            if (!sel) return;
            for (var i = 1; i < sel.options.length; i++) {
                var o = sel.options[i];
                clients.push({ id: parseInt(o.value), name: o.getAttribute('data-name') || '', mobile: o.getAttribute('data-mobile') || '' });
            }
        }

        function setClient(id, name, mobile) {
            var clientIdField = document.getElementById('clientIdField');
            var clientSearchInput = document.getElementById('clientSearchInput');
            var mobileField = document.getElementById('mobileField');
            var callerNameField = document.getElementById('callerNameField');
            if (clientIdField) clientIdField.value = id || '';
            if (clientSearchInput) clientSearchInput.value = name ? (mobile ? name + ' - ' + mobile : name) : '';
            if (mobileField && mobile) mobileField.value = mobile;
            if (callerNameField && name) {
                if (!callerNameField.value) callerNameField.value = name;
            }
            hideClientDropdown();
            hideSuggestions();
        }

        function renderClientDropdown(matches) {
            var dd = document.getElementById('clientDropdown');
            if (!dd) return;
            if (!matches || matches.length === 0) { dd.style.display = 'none'; dd.innerHTML = ''; return; }
            var html = '';
            for (var i = 0; i < matches.length; i++) {
                var m = matches[i];
                var txt = m.mobile ? m.name + ' - ' + m.mobile : m.name;
                html += '<div class="select-option" data-id="' + m.id + '" data-name="' + m.name + '" data-mobile="' + m.mobile + '">' + txt + '</div>';
            }
            dd.innerHTML = html;
            dd.style.display = 'block';
            var opts = dd.querySelectorAll('.select-option');
            for (var j = 0; j < opts.length; j++) {
                opts[j].addEventListener('click', function () {
                    setClient(this.getAttribute('data-id'), this.getAttribute('data-name'), this.getAttribute('data-mobile'));
                });
            }
        }

        function hideClientDropdown() {
            var dd = document.getElementById('clientDropdown');
            if (dd) { dd.style.display = 'none'; dd.innerHTML = ''; }
        }

        function filterClients(term) {
            if (!term) return clients.slice(0, 20);
            var t = term.toLowerCase();
            var res = [];
            for (var i = 0; i < clients.length; i++) {
                var c = clients[i];
                if ((c.name && c.name.toLowerCase().indexOf(t) >= 0) || (c.mobile && c.mobile.toLowerCase().indexOf(t) >= 0)) res.push(c);
                if (res.length > 50) break;
            }
            return res;
        }

        function renderSuggestions(list) {
            var box = document.getElementById('mobileSuggestions');
            if (!box) return;
            if (!list || list.length === 0) { box.style.display = 'none'; box.innerHTML = ''; return; }
            var html = '';
            for (var i = 0; i < list.length; i++) {
                var s = list[i];
                var txt = (s.ClientName || s.name || '') + ' - ' + (s.MobileNo || s.mobile || '');
                html += '<div class="suggestion-item" data-id="' + (s.ClientId || s.id || '') + '" data-name="' + (s.ClientName || s.name || '') + '" data-mobile="' + (s.MobileNo || s.mobile || '') + '">' + txt + '</div>';
            }
            box.innerHTML = html;
            box.style.display = 'block';
            var items = box.querySelectorAll('.suggestion-item');
            for (var j = 0; j < items.length; j++) {
                items[j].addEventListener('click', function () {
                    setClient(this.getAttribute('data-id'), this.getAttribute('data-name'), this.getAttribute('data-mobile'));
                });
            }
        }

        function hideSuggestions() {
            var box = document.getElementById('mobileSuggestions');
            if (box) { box.style.display = 'none'; box.innerHTML = ''; }
        }

        function searchMobileServer(q) {
            if (!q || q.length < 3) return;
            fetch('@Url.Action("SearchClientByMobile","DailySupport")?q=' + encodeURIComponent(q), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.json())
                .then(data => {
                    var list = (data && data.clients) ? data.clients : [];
                    renderSuggestions(list);
                });
        }

        document.addEventListener('DOMContentLoaded', function () {
            initClients();
            var clientSearchInput = document.getElementById('clientSearchInput');
            if (clientSearchInput) {
                clientSearchInput.addEventListener('input', function () {
                    var t = this.value;
                    renderClientDropdown(filterClients(t));
                });
                clientSearchInput.addEventListener('focus', function () {
                    renderClientDropdown(filterClients(this.value));
                });
            }
            document.addEventListener('click', function (e) {
                var dd = document.getElementById('clientDropdown');
                var box = document.getElementById('mobileSuggestions');
                var sm = document.getElementById('searchMobile');
                if (clientSearchInput && !clientSearchInput.contains(e.target) && dd && !dd.contains(e.target)) hideClientDropdown();
                if (sm && box && !sm.contains(e.target) && !box.contains(e.target)) hideSuggestions();
            });
            var searchMobile = document.getElementById('searchMobile');
            if (searchMobile) {
                searchMobile.addEventListener('input', function () {
                    var q = this.value.trim();
                    clearTimeout(mobileTimer);
                    mobileTimer = setTimeout(function () {
                        var matches = clients.filter(function (c) {
                            var m = (c.mobile || '');
                            var n = (c.name || '');
                            return m.indexOf(q) >= 0 || n.toLowerCase().indexOf(q.toLowerCase()) >= 0;
                        }).slice(0, 5);
                        renderSuggestions(matches.map(function (x) { return { ClientId: x.id, ClientName: x.name, MobileNo: x.mobile }; }));
                        searchMobileServer(q);
                    }, 250);
                });
            }
            var searchMobileBtn = document.getElementById('searchMobileBtn');
            if (searchMobileBtn) {
                searchMobileBtn.addEventListener('click', function () {
                    var q = searchMobile ? searchMobile.value.trim() : '';
                    if (q) searchMobileServer(q);
                });
            }
            var clearBtn = document.getElementById('clearFormBtn');
            if (clearBtn) {
                clearBtn.addEventListener('click', function () {
                    var form = document.getElementById('supportCreateForm');
                    if (form) form.reset();
                    document.getElementById('clientIdField').value = '';
                    document.getElementById('clientSearchInput').value = '';
                    document.getElementById('mobileField').value = '';
                    document.getElementById('callerNameField').value = '';
                    hideClientDropdown();
                    hideSuggestions();
                });
            }
            var form = document.getElementById('supportCreateForm');
            if (form) {
                form.addEventListener('submit', function (event) {
                    event.preventDefault();
                    var clientId = document.getElementById('clientIdField').value;
                    var subject = document.getElementById('edit_Subject').value.trim();
                    var desc = document.getElementById('edit_Description').value.trim();
                    var userId = document.getElementById('edit_UserId').value;
                    if (!clientId) { masterShowToast('Please select a valid Client.', 'error'); return; }
                    if (!userId) { masterShowToast('Please select Assign To.', 'error'); return; }
                    if (!subject) { masterShowToast('Issue (Subject) is required.', 'error'); return; }
                    if (!desc) { masterShowToast('Description is required.', 'error'); return; }
                    masterAjaxPost(this, function (result) {
                        masterShowToast(result.message, result.success ? 'success' : 'error');
                        if (result.success) {
                            setTimeout(function () { window.location.href = '@Url.Action("Index","DailySupport")'; }, 700);
                        }
                    });
                });
            }
        });

        // ==========================================
        // VOICE TO TEXT - DESCRIPTION
        // ==========================================
        var recognition = null;
        var isRecording = false;
        var speechBaseText = "";
        var speechFinal = "";
        var voiceField = "Description";

        function speechSupported() {
            return ("webkitSpeechRecognition" in window || "SpeechRecognition" in window);
        }

        function setListening(on) {
            var micBtn = document.getElementById("voiceMicBtn_" + voiceField);
            var stopBtn = document.getElementById("voiceStopBtn_" + voiceField);
            var status = document.getElementById("voiceStatus_" + voiceField);
            if (micBtn) {
                if (on) micBtn.classList.add("is-recording");
                else micBtn.classList.remove("is-recording");
            }
            if (stopBtn) stopBtn.disabled = !on;
            if (status) {
                if (on) {
                    status.innerText = "Listening... the mic stays open until you click Stop";
                    status.classList.add("visible");
                } else {
                    status.classList.remove("visible");
                }
            }
        }

        function applySpeechText(textarea, interim) {
            var parts = [];
            if (speechBaseText.length > 0) parts.push(speechBaseText);
            if (speechFinal.trim().length > 0) parts.push(speechFinal.trim());
            if (interim.trim().length > 0) parts.push(interim.trim());
            textarea.value = parts.join(" ");
        }

        function startVoice(fieldName) {
            if (fieldName) voiceField = fieldName;
            var textarea = document.getElementById("edit_" + voiceField);
            if (!speechSupported()) {
                alert("Speech Recognition is not supported in this browser. Please use Google Chrome.");
                return;
            }
            var SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            recognition = new SpeechRecognition();
            recognition.lang = "en-IN";
            recognition.interimResults = true;
            recognition.continuous = true;
            recognition.maxAlternatives = 1;

            recognition.onstart = function () {
                isRecording = true;
                speechBaseText = textarea.value.trim();
                speechFinal = "";
                setListening(true);
                textarea.focus();
            };

            recognition.onresult = function (event) {
                var interimText = "";
                for (var i = event.resultIndex; i < event.results.length; i++) {
                    var result = event.results[i];
                    if (result.isFinal) speechFinal += " " + result[0].transcript;
                    else interimText += result[0].transcript;
                }
                applySpeechText(textarea, interimText);
            };

            recognition.onerror = function (event) {
                if (event.error === "not-allowed" || event.error === "service-not-allowed") {
                    alert("Microphone permission denied. Please allow microphone access.");
                } else if (event.error === "no-speech") {
                    alert("No speech detected. Please try again.");
                } else {
                    alert("Speech recognition error: " + event.error);
                }
                isRecording = false;
                setListening(false);
            };

            recognition.onend = function () {
                isRecording = false;
                setListening(false);
            };

            try {
                recognition.start();
            } catch (error) {
                alert("Could not start speech recognition: " + error.message);
            }
        }

        function stopVoice() {
            if (recognition) recognition.stop();
            isRecording = false;
            setListening(false);
        }

        function resetVoice(fieldName) {
            if (fieldName) voiceField = fieldName;
            if (!confirm("Are you sure you want to clear " + voiceField + "?")) return;
            if (recognition) recognition.stop();
            isRecording = false;
            setListening(false);
            speechBaseText = "";
            speechFinal = "";
            document.getElementById("edit_" + voiceField).value = "";
        }
    </script>
}