@model Master.Models.DailySupportViewModel

@{
    ViewData["Title"] = "Daily Support";

    // Premium page look (New Ticket page jaisa): gray canvas
    // + floating white cards.
    ViewData["BodyClass"] = "tkt-page-body";

    int totalRecords = Model.TotalRecords;

    var staticOptions = ViewBag.StaticOptions as Dictionary<string, string[]>
        ?? new Dictionary<string, string[]>();

    var dropdowns = ViewBag.Dropdowns as Dictionary<string, List<LookupOptionViewModel>>
        ?? new Dictionary<string, List<LookupOptionViewModel>>();

    var gridColumns = Model.Fields
        .Where(f => f.ShowInTable)
        .Select(f => new
        {
            f.Name,
            f.Display,
            f.Control,
            f.MaxLength,
            f.SortType,
            f.InputType,
            Sort = f.InputType == "time" ? "time" : f.SortType,
            Nowrap = !(f.Control == "textarea" || (f.MaxLength ?? 0) > 150)
        })
        .ToArray();

    string GetVal(string name)
        => Model.GetFormValue(name);

    string GetErr(string name)
        => Model.FieldError(name);

    // Time part of EntryOn (used by the "Date & Time" column,
    // because SupportDate itself is a plain date).
    string TimePart(string value)
    {
        return DateTime.TryParse(value, out DateTime parsed)
            ? parsed.ToString("hh:mm tt")
            : "";
    }

    string PriorityPillClass(string priority)
    {
        return priority == "Urgent"
            ? "prio-urgent"
            : priority == "High"
                ? "prio-high"
                : priority == "Medium"
                    ? "prio-medium"
                    : priority == "Low"
                        ? "prio-low"
                        : "prio-default";
    }

    var placeholders = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["Subject"] = "Short subject",
        ["Description"] = "Client problem / request",
        ["Remarks"] = "Voice to text - click Mic and speak..."
    };

    // Placeholders ViewBag me daalte hain taake field
    // renderer (@functions) unhe parh sake.
    ViewBag.Placeholders = placeholders;

    // ---- Edit form: fields 3 premium cards me group ----
    var editGroups = new[]
    {
        new
        {
            Key = "ticket",
            Title = "Ticket Info",
            Names = new[] { "Mobile", "CallerName", "Channel", "Category" }
        },
        new
        {
            Key = "assign",
            Title = "Assignment & Status",
            Names = new[] { "Priority", "UserId", "Status" }
        },
        new
        {
            Key = "details",
            Title = "Details",
            Names = new[] { "Subject", "Description" }
        }
    };

    // Koi field agar groups me na ho to "Other Details"
    // card me chala jayega (koi data lost na ho).
    var groupedFieldNames =
        editGroups.SelectMany(g => g.Names).ToArray();

    var remainingFields =
        Model.FormFields
            .Where(f => !groupedFieldNames.Contains(
                f.Name,
                StringComparer.OrdinalIgnoreCase))
            .ToList();

    // ---- Active filters (FILTERS header ke chips) ----

    var activeStatusName = Model.FilterStatusId.HasValue
        ? Model.StatusOptions
            .FirstOrDefault(s => s.Id == Model.FilterStatusId.Value)?.Name
        : null;

    var activePriorityName = Model.FilterPriorityId.HasValue
        ? Model.PriorityOptions
            .FirstOrDefault(p => p.Id == Model.FilterPriorityId.Value)?.Name
        : null;

    // Assigned-To sirf admin ke liye chip banta hai: baaki users
    // ke liye ye hamesha apna hi Id hota hai (implicit filter).
    var activeUserName = Model.IsAdmin && Model.FilterAssignedTo.HasValue
        ? Model.UserOptions
            .FirstOrDefault(u => u.Id == Model.FilterAssignedTo.Value)?.Name
        : null;

    string? activeViewName = Model.FilterView switch
    {
        "open" => "Open",
        "inprogress" => "In Progress",
        "onhold" => "On Hold",
        "resolvedToday" => "Resolved Today",
        _ => null
    };

    int activeFilterCount =
        (activeStatusName != null ? 1 : 0)
        + (activePriorityName != null ? 1 : 0)
        + (activeUserName != null ? 1 : 0)
        + (activeViewName != null ? 1 : 0);
}


@functions {

    // Status pill ka CSS class (table + modal dono).
    string StatusPillClass(string status)
    {
        return status switch
        {
            "Closed" => "badge-completed",
            "Resolved" => "badge-resolved",
            "Open" => "badge-open",
            "In Progress" => "badge-inprogress",
            "On Hold" => "badge-onhold",
            "Cancelled" => "badge-cancelled",
            _ => "badge-default"
        };
    }


    // Ek group ke fields (view ke order me).
    List<MasterColumnViewModel> GroupFields(string[] names)
    {
        var list = new List<MasterColumnViewModel>();

        foreach (var name in names)
        {
            var field = Model.FormFields.FirstOrDefault(
                f => string.Equals(
                    f.Name,
                    name,
                    StringComparison.OrdinalIgnoreCase));

            if (field != null)
            {
                list.Add(field);
            }
        }

        return list;
    }


    // Ek field ka poora markup (label + control + error).
    // Markup wala method async Task hona zaroori hai.
    async Task RenderEditField(MasterColumnViewModel field)
    {
        var staticOptions =
            ViewBag.StaticOptions as Dictionary<string, string[]>
            ?? new Dictionary<string, string[]>();

        var dropdowns =
            ViewBag.Dropdowns
            as Dictionary<string, List<LookupOptionViewModel>>
            ?? new Dictionary<string, List<LookupOptionViewModel>>();

        var placeholders =
            ViewBag.Placeholders as Dictionary<string, string>
            ?? new Dictionary<string, string>();

        var options =
            field.Type == "options"
            && staticOptions.TryGetValue(field.Name, out var opts)
                ? opts
                : Array.Empty<string>();

        var hasOther = options.Contains(
            "Other",
            StringComparer.OrdinalIgnoreCase);

        string fullClass =
            field.Control == "textarea"
                ? "form-group form-group-full"
                : "form-group";

        var placeholder =
            placeholders.TryGetValue(field.Name, out var ph)
                ? ph
                : "";

        string GetVal(string name) => Model.GetFormValue(name);

        string GetErr(string name) => Model.FieldError(name);

        if (field.Type == "options")
        {
            var onChange = new List<string>();

            if (hasOther)
            {
                onChange.Add("toggleOtherField(this)");
            }

            if (field.Name == "Status")
            {
                onChange.Add("updateCurrentStatus()");
            }

            string onChangeAttr = string.Join("; ", onChange);

            <div class="@fullClass">

                <label class="tkt-field-label">
                    @field.Display
                    @if (field.Required)
                    {
                        <span class="tkt-req">*</span>
                    }
                </label>

                <select name="@field.Name"
                        id="edit_@field.Name"
                        class="tkt-input"
                        onchange="@onChangeAttr"
                        @(field.Required ? "required" : null)>

                    <option value=""
                            disabled
                            selected="@(string.IsNullOrWhiteSpace(GetVal(field.Name)))">
                        -- Select @field.Display --
                    </option>

                    @foreach (var option in options)
                    {
                        <option value="@option"
                                selected="@(GetVal(field.Name) == option)">
                            @option
                        </option>
                    }

                </select>

                @if (!string.IsNullOrWhiteSpace(GetErr(field.Name)))
                {
                    <span class="field-error">
                        @GetErr(field.Name)
                    </span>
                }

                @if (hasOther)
                {
                    <div id="other@(field.Name)Group"
                         style="@(GetVal(field.Name) == "Other" ? "" : "display:none")">

                        <label class="sub-label">
                            Other @field.Display
                        </label>

                        <input type="text"
                               class="tkt-input"
                               name="Other@(field.Name)"
                               id="edit_Other@(field.Name)"
                               maxlength="92"
                               placeholder="Specify other @field.Display.ToLower()"
                               value="@GetVal("Other" + field.Name)"
                               @(GetVal(field.Name) == "Other" ? "required" : null) />

                        @if (!string.IsNullOrWhiteSpace(GetErr("Other" + field.Name)))
                        {
                            <span class="field-error">
                                @GetErr("Other" + field.Name)
                            </span>
                        }

                    </div>
                }

                @if (field.Name == "Status")
                {
                    <div class="tkt-status-block">

                        <div class="tkt-stepper"
                             id="statusStepper">

                            <div class="tkt-step"
                                 data-status="Open">

                                <span class="tkt-step-dot">
                                    <svg class="tkt-step-check"
                                         viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="3"
                                         stroke-linecap="round"
                                         stroke-linejoin="round"
                                         aria-hidden="true">
                                        <polyline points="20 6 9 17 4 12" />
                                    </svg>
                                    <span class="tkt-step-num">1</span>
                                </span>

                                <span class="tkt-step-text">Open</span>
                            </div>

                            <div class="tkt-step"
                                 data-status="In Progress">

                                <span class="tkt-step-dot">
                                    <svg class="tkt-step-check"
                                         viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="3"
                                         stroke-linecap="round"
                                         stroke-linejoin="round"
                                         aria-hidden="true">
                                        <polyline points="20 6 9 17 4 12" />
                                    </svg>
                                    <span class="tkt-step-num">2</span>
                                </span>

                                <span class="tkt-step-text">In Progress</span>
                            </div>

                            <div class="tkt-step"
                                 data-status="On Hold">

                                <span class="tkt-step-dot">
                                    <svg class="tkt-step-check"
                                         viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="3"
                                         stroke-linecap="round"
                                         stroke-linejoin="round"
                                         aria-hidden="true">
                                        <polyline points="20 6 9 17 4 12" />
                                    </svg>
                                    <span class="tkt-step-num">3</span>
                                </span>

                                <span class="tkt-step-text">On Hold</span>
                            </div>

                            <div class="tkt-step"
                                 data-status="Closed">

                                <span class="tkt-step-dot">
                                    <svg class="tkt-step-check"
                                         viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="3"
                                         stroke-linecap="round"
                                         stroke-linejoin="round"
                                         aria-hidden="true">
                                        <polyline points="20 6 9 17 4 12" />
                                    </svg>
                                    <span class="tkt-step-num">4</span>
                                </span>

                                <span class="tkt-step-text">Closed</span>
                            </div>

                        </div>

                        <div class="tkt-status-legend">

                            <span class="tkt-status-legend-item">

                                <span class="status-tracker-label">
                                    Previous
                                </span>

                                <span id="prevStatusBadge"
                                      class="status-pill @StatusPillClass(Model.EditPreviousStatus)">
                                    @(string.IsNullOrWhiteSpace(Model.EditPreviousStatus) ? "—" : Model.EditPreviousStatus)
                                </span>

                            </span>

                            <span class="tkt-status-legend-item">

                                <span class="status-tracker-label">
                                    Current
                                </span>

                                <span id="curStatusBadge"
                                      class="status-pill @StatusPillClass(GetVal("Status"))">
                                    @(string.IsNullOrWhiteSpace(GetVal("Status")) ? "—" : GetVal("Status"))
                                </span>

                            </span>

                        </div>

                    </div>
                }

            </div>
        }
        else if (field.Control == "select")
        {
            var lookupOptions =
                field.LookupKey != null
                && dropdowns.TryGetValue(
                    field.LookupKey,
                    out var lopts)
                    ? lopts
                    : new List<LookupOptionViewModel>();

            <div class="@fullClass">

                <label class="tkt-field-label">
                    @field.Display
                    @if (field.Required)
                    {
                        <span class="tkt-req">*</span>
                    }
                </label>

                <select name="@field.Name"
                        id="edit_@field.Name"
                        class="tkt-input"
                        @(field.Required ? "required" : null)>

                    <option value=""
                            disabled
                            selected="@(string.IsNullOrWhiteSpace(GetVal(field.Name)))">
                        -- Select @field.Display --
                    </option>

                    @foreach (var option in lookupOptions)
                    {
                        <option value="@option.Id"
                                selected="@(GetVal(field.Name) == option.Id.ToString())">
                            @option.Name
                        </option>
                    }

                </select>

                @if (!string.IsNullOrWhiteSpace(GetErr(field.Name)))
                {
                    <span class="field-error">
                        @GetErr(field.Name)
                    </span>
                }

            </div>
        }
        else if (field.Control == "textarea")
        {
            <div class="@fullClass">

                <label class="tkt-field-label">
                    @field.Display
                    @if (field.Required)
                    {
                        <span class="tkt-req">*</span>
                    }
                </label>

                <textarea id="edit_@field.Name"
                          class="tkt-input tkt-textarea"
                          name="@field.Name"
                          rows="3"
                          placeholder="@placeholder"
                          @(field.Required ? "required" : null)>@GetVal(field.Name)</textarea>

                @if (!string.IsNullOrWhiteSpace(GetErr(field.Name)))
                {
                    <span class="field-error">
                        @GetErr(field.Name)
                    </span>
                }

                @if (field.Name == "Description" || field.Name == "Remarks")
                {
                    <div class="voice-controls">

                        <button type="button"
                                class="voice-btn mic-btn"
                                id="voiceMicBtn_@field.Name"
                                title="Start voice input"
                                aria-label="Start voice input"
                                onclick="startVoice('@field.Name')">

                            <svg viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z" />
                                <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
                                <line x1="12" y1="19" x2="12" y2="23" />
                            </svg>

                        </button>

                        <button type="button"
                                class="voice-btn voice-stop"
                                id="voiceStopBtn_@field.Name"
                                title="Stop recording"
                                aria-label="Stop recording"
                                disabled
                                onclick="stopVoice()">

                            <svg viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <rect x="6" y="6" width="12" height="12" rx="2" />
                            </svg>

                        </button>

                        <button type="button"
                                class="voice-btn voice-reset"
                                title="Clear field"
                                aria-label="Clear field"
                                onclick="resetVoice('@field.Name')">

                            <svg viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round"
                                 aria-hidden="true">
                                <path d="M3 12a9 9 0 1 0 3-6.7L3 8" />
                                <polyline points="3 3 3 8 8 8" />
                            </svg>

                        </button>

                    </div>

                    <span class="voice-status"
                          id="voiceStatus_@field.Name"></span>

                    <span class="voice-hint">
                        Voice to Text: speak into the mic; the text is appended to the end of @field.Display. The mic stays open until you click Stop.
                    </span>
                }

            </div>
        }
        else
        {
            <div class="@fullClass">

                <label class="tkt-field-label">
                    @field.Display
                    @if (field.Required)
                    {
                        <span class="tkt-req">*</span>
                    }
                </label>

                <input type="@(field.InputType == "date" ? "date" : field.InputType == "time" ? "time" : "text")"
                       class="tkt-input"
                       id="edit_@field.Name"
                       name="@field.Name"
                       value="@GetVal(field.Name)"
                       placeholder="@placeholder"
                       @(field.Required ? "required" : null) />

                @if (!string.IsNullOrWhiteSpace(GetErr(field.Name)))
                {
                    <span class="field-error">
                        @GetErr(field.Name)
                    </span>
                }

            </div>
        }
    }
}


<div class="page-header tkt-page-head">

    <div>

        <h1>
            Daily Support
        </h1>

        <p>
            Manage daily support tickets
        </p>

    </div>

    <div class="tkt-head-meta">

        <span class="tkt-head-chip">

            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round" aria-hidden="true">
                <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" />
            </svg>

            @totalRecords tickets

        </span>

    </div>

</div>


<!-- ================= KPI CARDS (clickable, top) ================= -->

<div class="dashboard-cards">


    <a href="@Url.Action("Index", "DailySupport", new { view = "open", assignedTo = Model.FilterAssignedTo, priorityId = Model.FilterPriorityId })"
       class="dashboard-card tkt-kpi-link tkt-kpi-blue @(Model.FilterView == "open" ? "tkt-kpi-active" : "")">

        <div class="card-content">

            <p>
                Open
            </p>

            <h2 data-kpi="open">
                @Model.OpenCalls
            </h2>

            <span class="kpi-sub">
                Need action
            </span>

        </div>

        <div class="card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round" aria-hidden="true">
                <polyline points="22 12 16 12 14 15 10 15 8 12 2 12" />
                <path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" />
            </svg>
        </div>

    </a>


    <a href="@Url.Action("Index", "DailySupport", new { view = "inprogress", assignedTo = Model.FilterAssignedTo, priorityId = Model.FilterPriorityId })"
       class="dashboard-card tkt-kpi-link tkt-kpi-amber @(Model.FilterView == "inprogress" ? "tkt-kpi-active" : "")">

        <div class="card-content">

            <p>
                In Progress
            </p>

            <h2 data-kpi="inprogress">
                @Model.PendingCount
            </h2>

            <span class="kpi-sub">
                Being worked on
            </span>

        </div>

        <div class="card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round" aria-hidden="true">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
            </svg>
        </div>

    </a>


    <a href="@Url.Action("Index", "DailySupport", new { view = "onhold", assignedTo = Model.FilterAssignedTo, priorityId = Model.FilterPriorityId })"
       class="dashboard-card tkt-kpi-link tkt-kpi-slate @(Model.FilterView == "onhold" ? "tkt-kpi-active" : "")">

        <div class="card-content">

            <p>
                On Hold
            </p>

            <h2 data-kpi="onhold">
                @Model.OnHoldCount
            </h2>

            <span class="kpi-sub">
                Waiting on client
            </span>

        </div>

        <div class="card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <line x1="10" y1="15" x2="10" y2="9" />
                <line x1="14" y1="15" x2="14" y2="9" />
            </svg>
        </div>

    </a>


    <a href="@Url.Action("Index", "DailySupport", new { view = "resolvedToday", assignedTo = Model.FilterAssignedTo, priorityId = Model.FilterPriorityId })"
       class="dashboard-card tkt-kpi-link tkt-kpi-green @(Model.FilterView == "resolvedToday" ? "tkt-kpi-active" : "")">

        <div class="card-content">

            <p>
                Resolved Today
            </p>

            <h2 data-kpi="resolvedtoday">
                @Model.ClosedToday
            </h2>

            <span class="kpi-sub">
                Aaj solve hua
            </span>

        </div>

        <div class="card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round" aria-hidden="true">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                <polyline points="22 4 12 14.01 9 11.01" />
            </svg>
        </div>

    </a>


</div>


<!-- ================= NOTIFICATIONS (collapsed card, below KPI cards) ================= -->

<div class="state-section tkt-notif-card tkt-collapsible collapsed"
     id="tktNotifCard">

    <div class="form-section-title tkt-notif-head"
         id="tktNotifHead"
         role="button"
         tabindex="0"
         aria-expanded="false"
         aria-controls="tktNotifBody">

        <span class="tkt-notif-head-icon"
              aria-hidden="true">

            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round">
                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
                <path d="M13.73 21a2 2 0 0 1-3.46 0" />
            </svg>

        </span>

        <span>
            Notifications
        </span>

        <span class="tkt-notif-count"
              id="notifCountBadge"
              hidden>0</span>

        <button type="button"
                class="tkt-notif-mark"
                onclick="markAllNotifsRead(event)">
            Mark all read
        </button>

        <button type="button"
                class="tkt-sec-toggle"
                id="tktNotifToggle"
                title="Expand / collapse notifications"
                aria-expanded="false"
                aria-controls="tktNotifBody"
                onclick="toggleNotifCard(event)">

            +

        </button>

    </div>

    <div class="tkt-notif-body"
         id="tktNotifBody">

        <!-- Unread / History tabs -->
        <div class="tkt-notif-tabs">

            <button type="button"
                    class="tkt-notif-tab active"
                    id="notifTabUnread"
                    onclick="switchNotifTab('unread')">

                Unread
                <span class="tkt-notif-tab-count" id="notifTabUnreadCount">0</span>

            </button>

            <button type="button"
                    class="tkt-notif-tab"
                    id="notifTabHistory"
                    onclick="switchNotifTab('history')">

                History

            </button>

        </div>

        <div id="pageNotifGrid" class="tkt-notif-rows">
            <div class="tkt-notif-empty">Loading&hellip;</div>
        </div>

        <div id="pageNotifHistory"
             class="tkt-notif-rows"
             hidden>
        </div>

    </div>

</div>


<!-- ================= FILTER BAR ================= -->

<div class="state-section tkt-filter-bar tkt-collapsible"
     id="tktFilterCard">

    <form method="get"
          id="ticketFilterForm"
          action="@Url.Action("Index", "DailySupport")">

        <input type="hidden" name="view" id="filterView"
               value="@Model.FilterView" />

        <div class="tkt-filter-head"
             id="tktFilterHead">

            <div class="form-section-title">
                FILTERS

                @if (activeFilterCount > 0)
                {
                    <span class="tkt-filter-count"
                          title="@activeFilterCount active filter(s)">
                        @activeFilterCount
                    </span>
                }
            </div>

            <!-- Active filter chips (collapsed bar me bhi visible) -->
            @if (activeFilterCount > 0)
            {
                <div class="tkt-filter-chips">

                    @if (activeViewName != null)
                    {
                        <a class="tkt-chip"
                           href="@Url.Action("Index", "DailySupport", new { statusId = Model.FilterStatusId, assignedTo = Model.FilterAssignedTo, priorityId = Model.FilterPriorityId, search = Model.Search })"
                           title="Remove this filter">

                            View: <b>@activeViewName</b>
                            <span class="x" aria-hidden="true">&times;</span>

                        </a>
                    }

                    @if (activeStatusName != null)
                    {
                        <a class="tkt-chip"
                           href="@Url.Action("Index", "DailySupport", new { view = Model.FilterView, assignedTo = Model.FilterAssignedTo, priorityId = Model.FilterPriorityId, search = Model.Search })"
                           title="Remove this filter">

                            Status: <b>@activeStatusName</b>
                            <span class="x" aria-hidden="true">&times;</span>

                        </a>
                    }

                    @if (activePriorityName != null)
                    {
                        <a class="tkt-chip"
                           href="@Url.Action("Index", "DailySupport", new { view = Model.FilterView, statusId = Model.FilterStatusId, assignedTo = Model.FilterAssignedTo, search = Model.Search })"
                           title="Remove this filter">

                            Priority: <b>@activePriorityName</b>
                            <span class="x" aria-hidden="true">&times;</span>

                        </a>
                    }

                    @if (activeUserName != null)
                    {
                        <a class="tkt-chip"
                           href="@Url.Action("Index", "DailySupport", new { view = Model.FilterView, statusId = Model.FilterStatusId, priorityId = Model.FilterPriorityId, search = Model.Search })"
                           title="Remove this filter">

                            Assigned: <b>@activeUserName</b>
                            <span class="x" aria-hidden="true">&times;</span>

                        </a>
                    }

                    <a class="tkt-chip tkt-chip-clear"
                       href="@Url.Action("Index", "DailySupport")">

                        Clear all

                    </a>

                </div>
            }

            <!-- Quick selection pills (one-click status filter) -->
            <div class="tkt-quick-pills">

                <a href="@Url.Action("Index", "DailySupport", new { assignedTo = Model.FilterAssignedTo, priorityId = Model.FilterPriorityId, search = Model.Search })"
                   class="tkt-pill @(string.IsNullOrEmpty(Model.FilterView) && !Model.FilterStatusId.HasValue ? "active" : "")">

                    All

                </a>

                @foreach (var s in Model.StatusOptions)
                {
                    var isActive = Model.FilterStatusId == s.Id;

                    <a href="@Url.Action("Index", "DailySupport", new { statusId = s.Id, assignedTo = Model.FilterAssignedTo, priorityId = Model.FilterPriorityId, search = Model.Search })"
                       class="tkt-pill @(isActive ? "active" : "")">

                        @s.Name

                    </a>
                }

            </div>

            <!-- Maximize / minimize the whole filter bar (top-right) -->
            <button type="button"
                    class="tkt-sec-toggle"
                    id="tktFilterToggle"
                    title="Maximize / minimize filters"
                    aria-expanded="true"
                    aria-controls="ticketFilterForm">

                +

            </button>

        </div>

        <!-- Filter dropdowns (Assigned To sirf admin ko) -->
        <div class="tkt-filter-row">

            <div class="tkt-filter-field">

                <label>
                    Status
                </label>

                <select name="statusId"
                        id="filterStatusId"
                        data-ds-cascade="1">

                    <option value="">
                        All Statuses
                    </option>

                    @foreach (var s in Model.StatusOptions)
                    {
                        <option value="@s.Id"
                                data-with-user="@string.Join(",", Model.UsersByStatus.TryGetValue(s.Id, out var ubs) ? ubs : new List<int>())"
                                data-with-priority="@string.Join(",", Model.PrioritiesByStatus.TryGetValue(s.Id, out var pbs) ? pbs : new List<int>())"
                                selected="@(Model.FilterStatusId == s.Id)">

                            @s.Name

                        </option>
                    }

                </select>

            </div>

            @if (Model.IsAdmin)
            {
                <div class="tkt-filter-field">

                    <label>
                        Assigned To
                    </label>

                    <select name="assignedTo"
                            id="filterAssignedTo"
                            data-ds-cascade="1">

                        <option value="">
                            All Users
                        </option>

                        @foreach (var u in Model.UserOptions)
                        {
                            <option value="@u.Id"
                                    data-with-status="@string.Join(",", Model.StatusesByUser.TryGetValue(u.Id, out var sbu) ? sbu : new List<int>())"
                                    data-with-priority="@string.Join(",", Model.PrioritiesByUser.TryGetValue(u.Id, out var pbu) ? pbu : new List<int>())"
                                    selected="@(Model.FilterAssignedTo == u.Id)">

                                @u.Name

                            </option>
                        }

                    </select>

                </div>
            }

            <div class="tkt-filter-field">

                <label>
                    Priority
                </label>

                <select name="priorityId"
                        id="filterPriorityId"
                        data-ds-cascade="1">

                    <option value="">
                        All Priorities
                    </option>

                    @foreach (var p in Model.PriorityOptions)
                    {
                        <option value="@p.Id"
                                data-with-status="@string.Join(",", Model.StatusesByPriority.TryGetValue(p.Id, out var sbp) ? sbp : new List<int>())"
                                data-with-user="@string.Join(",", Model.UsersByPriority.TryGetValue(p.Id, out var ubp) ? ubp : new List<int>())"
                                selected="@(Model.FilterPriorityId == p.Id)">

                            @p.Name

                        </option>
                    }

                </select>

            </div>

            <!-- Apply / Reset sit in the same row, right of the fields -->
            <div class="tkt-filter-footer">

                <button type="submit"
                        class="primary-btn">

                    Apply

                </button>

                <a href="@Url.Action("Index", "DailySupport")"
                   class="cancel-btn"
                   style="text-decoration:none; display:inline-block;">

                    Reset

                </a>

            </div>

        </div>

    </form>

</div>


<!-- ================= MESSAGES ================= -->

@if (TempData["Success"] != null)
{
    <div class="success-message" role="status">

        <span class="toast-icon" aria-hidden="true">

            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.4" stroke-linecap="round"
                 stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12" />
            </svg>

        </span>

        <div class="toast-body">
            @TempData["Success"]
        </div>

        <button type="button"
                class="toast-close"
                aria-label="Dismiss"
                onclick="this.closest('.success-message, .error-message').remove()">

            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.6" stroke-linecap="round"
