}


@if (TempData["Error"] != null)
{
    <div class="error-message" role="alert">

        <span class="toast-icon" aria-hidden="true">

            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.2" stroke-linecap="round"
                 stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" />
                <line x1="12" y1="8" x2="12" y2="13" />
                <line x1="12" y1="16.5" x2="12" y2="16.5" />
            </svg>

        </span>

        <div class="toast-body">
            @Html.Raw(TempData["Error"])
        </div>

        <button type="button"
                class="toast-close"
                aria-label="Dismiss"
                onclick="this.closest('.success-message, .error-message').remove()">

            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.6" stroke-linecap="round"
                 stroke-linejoin="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
            </svg>

        </button>

    </div>
}


<!-- ================= SUPPORT SECTION ================= -->

<div class="state-section">




    <!-- ================= TABLE TOOLBAR ================= -->

    <div class="table-toolbar">

        <div class="toolbar-left">

            <select id="recordsPerPage"
                    onchange="changeRecordsPerPage()">

                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>

            </select>

            <span class="toolbar-label">
                records per page
            </span>

            <!-- Mobile-only sort control: the table header is
                 hidden on phones, so sorting moves here. -->
            <select id="mobileSort"
                    class="mobile-sort"
                    onchange="mobileSortTable()">

                <option value="">Sort: Default</option>

                @for (int i = 0; i < gridColumns.Length; i++)
                {
                    <option value="@i">Sort: @gridColumns[i].Display</option>
                }

            </select>

        </div>


        <div class="toolbar-center">

            <button type="button"
                    class="export-btn excel-btn"
                    onclick="exportExcel()">

                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <path d="M3 9h18M3 15h18M9 3v18M15 3v18" />
                </svg>

                Excel

            </button>

            <button type="button"
                    class="export-btn csv-btn"
                    onclick="exportCSV()">

                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <path d="M8 13h8M8 17h5" />
                </svg>

                CSV

            </button>

            <button type="button"
                    class="export-btn print-btn"
                    onclick="printTable()">

                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true">
                    <polyline points="6 9 6 2 18 2 18 9" />
                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
                    <rect x="6" y="14" width="12" height="8" />
                </svg>

                Print

            </button>

        </div>


        <div class="toolbar-right">

            <div class="tkt-search">

                <span class="tkt-search-icon"
                      aria-hidden="true">

                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round">
                        <circle cx="11" cy="11" r="7" />
                        <path d="m20 20-3.5-3.5" />
                    </svg>

                </span>

                <input type="text"
                       id="tableSearch"
                       placeholder="Ticket no, client, subject… search"
                       aria-label="Search tickets"
                       autocomplete="off"
                       oninput="filterTableDebounced()"
                       onkeydown="if (event.key === 'Enter') { event.preventDefault(); filterTable(); }" />

                <button type="button"
                        class="tkt-search-clear"
                        id="tableSearchClear"
                        title="Clear search"
                        aria-label="Clear search"
                        onclick="clearTableSearch()"
                        hidden>

                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.4" stroke-linecap="round"
                         stroke-linejoin="round" aria-hidden="true">
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                    </svg>

                </button>

                <span class="tkt-search-key"
                      aria-hidden="true">
                    /
                </span>

            </div>

            <span class="tkt-search-count"
                  id="searchCount"
                  title="Matching rows">
                0 / 0
            </span>

            <div class="tkt-head-actions">

                <a href="@Url.Action("NewTicket", "DailySupport")"
                   class="primary-btn tkt-btn tkt-btn-primary">

                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.5" stroke-linecap="round"
                         stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 5v14M5 12h14" />
                    </svg>

                    Add Ticket
                </a>

                <a href="@Url.Action("Create", "Clients", new { returnUrl = Url.Action("Index", "DailySupport") })"
                   class="primary-btn tkt-btn tkt-btn-ghost">

                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.5" stroke-linecap="round"
                         stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 5v14M5 12h14" />
                    </svg>

                    Add Customer
                </a>

            </div>

        </div>

    </div>


    <!-- ================= TABLE ================= -->

    <div class="table-container support-table">

        <table id="dataTable">


            <thead>

                <tr>

                    @for (int i = 0; i < gridColumns.Length; i++)
                    {
                        var col = gridColumns[i];

                        string colClass =
                            col.Nowrap
                                ? "col-nowrap"
                                : "col-wrap";

                        <th class="sortable @colClass"
                            data-sort="@col.Sort"
                            onclick="sortTable(this)">

                            <span class="th-text">
                                @col.Display
                            </span>

                            <span class="sort-indicator">
                                <span class="sort-up"></span>
                                <span class="sort-down"></span>
                            </span>

                        </th>
                    }

                    <th class="actions-col">
                        Actions
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (Model.Supports.Count == 0)
                {
                    <tr class="no-data-row"
                        data-search="">

                        <td colspan="@(gridColumns.Length + 1)"
                            class="empty-state">

                            <span class="empty-icon" aria-hidden="true">

                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.8" stroke-linecap="round"
                                     stroke-linejoin="round">
                                    <circle cx="11" cy="11" r="7" />
                                    <path d="m20 20-3.5-3.5" />
                                </svg>

                            </span>

                            <span class="empty-title">
                                No tickets found
                            </span>

                            <span class="empty-sub">
                                Is filter ke liye koi record nahi hai. Filter change karke dobara try karein.
                            </span>

                            <a class="primary-btn empty-action"
                               href="@Url.Action("Index", "DailySupport")">

                                Clear filters

                            </a>

                        </td>

                    </tr>
                }
                else
                {
                    @foreach (var support in Model.Supports)
                    {
                        var searchText = string.Join(
                            " ",
                            gridColumns.Select(
                                c => support.Get(c.Name)));

                        var statusValue = support.Get("Status");

                        string statusClass =
                            StatusPillClass(statusValue);

                        <tr data-search="@searchText"
                            class="tkt-row-link"
                            data-href="@Url.Action("Detail", "DailySupport", new { id = support.Get("Id") })">

                            @foreach (var col in gridColumns)
                            {
                                string tdClass =
                                    col.Nowrap
                                        ? "col-nowrap"
                                        : "col-wrap";

                                <td class="@tdClass" data-label="@col.Display">

                                    <span class="cell-value">

                                    @if (col.Name == "Status")
                                    {
                                        <span class="status-pill @statusClass">
                                            @support.Get(col.Name)
                                        </span>
                                    }
                                    else if (col.Name == "ClientId")
                                    {
                                        @support.Get(col.Name)

                                        @if (!string.IsNullOrWhiteSpace(
                                                support.Get("ClientId_key")))
                                        {
                                            <small class="cell-sub">
                                                [ID: @support.Get("ClientId_key")]
                                            </small>
                                        }
                                    }
                                    else if (col.Name == "SupportDate")
                                    {
                                        @support.Get("SupportDate")

                                        @if (!string.IsNullOrWhiteSpace(
                                                TimePart(support.Get("EntryOn"))))
                                        {
                                            <small class="cell-sub">
                                                @TimePart(support.Get("EntryOn"))
                                            </small>
                                        }
                                    }
                                    else if (col.Name == "Priority")
                                    {
                                        <span class="priority-pill @PriorityPillClass(support.Get("Priority"))">
                                            @support.Get(col.Name)
                                        </span>
                                    }
                                    else if (col.Name == "TicketNo")
                                    {
                                        var cellText = support.Get(col.Name);

                                        <span class="tkt-no-wrap tkt-ticket-no">

                                            <span class="cell-clamp"
                                                  title="@cellText">@cellText</span>

                                            @{
                                                string pill = "";

                                                if (int.TryParse(
                                                        support.Get("Id"),
                                                        out int pillId))
                                                {
                                                    Model.ReviewPills
                                                        .TryGetValue(
                                                            pillId,
                                                            out string? foundPill);

                                                    pill = foundPill ?? "";
                                                }
                                            }

                                            @if (!string.IsNullOrWhiteSpace(pill))
                                            {
                                                var pillTitle = pill switch
                                                {
                                                    "pending" => "Review pending with admin",
                                                    "approved" => "Review approved",
                                                    "rejected" => "Review rejected",
                                                    _ => pill
                                                };

                                                <span class="tkt-review-pill @pill"
                                                      title="@pillTitle">
                                                    @pill
                                                </span>
                                            }

                                        </span>
                                    }
                                    else if (col.Name == "UserId")
                                    {
                                        var assignee = support.Get(col.Name);

                                        if (!string.IsNullOrWhiteSpace(assignee))
                                        {
                                            var parts = assignee.Split(
                                                ' ',
                                                StringSplitOptions.RemoveEmptyEntries);

                                            var initials = parts.Length >= 2
                                                ? parts[0].Substring(0, 1)
                                                  + parts[1].Substring(0, 1)
                                                : parts[0].Substring(0, 1);

                                            <span class="tkt-assignee"
                                                  data-initials="@initials.ToUpperInvariant()">
                                                @assignee
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        var cellText = support.Get(col.Name);

                                        if (!string.IsNullOrWhiteSpace(cellText))
                                        {
                                            <span class="cell-clamp"
                                                  title="@cellText">
                                                @cellText
                                            </span>
                                        }
                                    }

                                    </span>

                                </td>
                            }

                            <td class="actions-col-cell" data-label="Actions">

                                <div class="action-cell">

                                    @{
                                        var rowJson =
                                            System.Text.Json
                                                .JsonSerializer
                                                .Serialize(
                                                    support.Values);

                                        var rowId =
                                            support.Get("Id");
                                    }

                                    <a href="@Url.Action("Detail", "DailySupport", new { id = rowId })"
                                       class="action-btn act-view"
                                       title="View Ticket">

                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2" stroke-linecap="round"
                                             stroke-linejoin="round" aria-hidden="true">
                                            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" />
                                            <circle cx="12" cy="12" r="3" />
                                        </svg>

                                    </a>

                                    <button type="button"
                                            class="edit-btn action-btn act-edit"
                                            title="Edit"
                                            data-json="@rowJson"
                                            onclick="openEditModal(this)">

                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2" stroke-linecap="round"
                                             stroke-linejoin="round" aria-hidden="true">
                                            <path d="M12 20h9" />
                                            <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                                        </svg>

                                    </button>

                                    <form asp-controller="DailySupport"
                                          asp-action="Delete"
                                          method="post"
                                          onsubmit="return masterConfirmAndSubmit(
                                              this,
                                              'Are you sure you want to delete this support record?'
                                          );">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@support.Get("Id")" />

                                        <button type="submit"
                                                class="delete-btn action-btn act-delete"
                                                title="Delete">

                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="2" stroke-linecap="round"
                                                 stroke-linejoin="round" aria-hidden="true">
                                                <polyline points="3 6 5 6 21 6" />
                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                            </svg>

                                        </button>

                                    </form>


                                </div>

                            </td>

                        </tr>
                    }
                }

                <!-- Client-side empty row: shown when the
                     search filter matches no rows. -->
                <tr id="noRecordsRow"
                    class="no-data-row"
                    data-search=""
                    style="display: none;">

                    <td colspan="@(gridColumns.Length + 1)"
                        class="empty-state">

                        <span class="empty-icon" aria-hidden="true">

                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.8" stroke-linecap="round"
                                 stroke-linejoin="round">
                                <circle cx="11" cy="11" r="7" />
                                <path d="m20 20-3.5-3.5" />
                            </svg>

                        </span>

                        <span class="empty-title" id="noRecordsTitle">
                            No tickets found
                        </span>

                        <span class="empty-sub" id="noRecordsSub">
                            Is filter ke liye koi record nahi hai.
                        </span>

                        <button type="button"
                                class="primary-btn empty-action"
                                id="noRecordsAction"
                                onclick="resetEmptyState()">

                            Clear filters

                        </button>

                    </td>

                </tr>

            </tbody>

        </table>

    </div>


    <!-- ================= TABLE FOOTER ================= -->

    <div class="table-footer">

        <div class="footer-left"
             id="tableInfo">

            Showing 1 to 10 of @totalRecords entries

        </div>


        <div class="footer-right"
             id="pagination">

        </div>

    </div>

</div>


<!-- ================= ADD / EDIT MODAL ================= -->

<div id="supportModal"
     class="modal">

    <div class="modal-content modal-wide tkt-modal">


        <!-- ============ MODAL HEADER (sticky) ============ -->

        <div class="tkt-modal-head">

            <div class="tkt-modal-head-main">

                <span class="tkt-modal-head-icon"
                      aria-hidden="true">

                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round">
                        <path d="M12 20h9" />
                        <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                    </svg>

                </span>

                <div class="tkt-modal-head-text">

                    <h2 id="modalTitle">
                        Edit Support
                    </h2>

                    <p class="tkt-modal-sub">

                        <span id="modalTicketNo">
                            Ticket
                        </span>

                        <span class="tkt-modal-sub-sep">
                            &bull;
                        </span>

                        <span id="modalClientName">
                            &mdash;
                        </span>

                    </p>

                </div>

            </div>

            <div class="tkt-modal-head-right">

                <span id="modalStatusPill"
                      class="status-pill badge-default">
                    &mdash;
                </span>

                <button type="button"
                        class="modal-close tkt-modal-close"
                        onclick="closeModal()"
                        aria-label="Close">

                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" aria-hidden="true">
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                    </svg>

                </button>

            </div>

        </div>


        <form id="supportForm"
              method="post"
              action="@Url.Action("Create", "DailySupport")"
              novalidate>

            @Html.AntiForgeryToken()

            <input type="hidden"
                   id="editId"
                   name="id"
                   value="@GetVal("Id")" />


            <div class="tkt-modal-body">

                <div class="tkt-form-cards">

                    @foreach (var group in editGroups)
                    {
                        var groupFields = GroupFields(group.Names);

                        if (groupFields.Count == 0)
                        {
                            continue;
                        }

                        <section class="tkt-form-card">

                            <div class="tkt-form-card-head">

                                <span class="tkt-form-card-icon"
                                      aria-hidden="true">

