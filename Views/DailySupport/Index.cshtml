@model Master.Models.DailySupportViewModel

@{
    ViewData["Title"] = "Daily Support";
    int totalRecords = Model.TotalRecords;

    var nowrapCols = new HashSet<string>
    {
        "Id",
        "SupportDate",
        "ClientName",
        "SupportType",
        "Priority",
        "UserName",
        "StartTime",
        "EndTime",
        "EntryOn",
        "Status"
    };

    var gridColumns = new[]
    {
        new { Name = "Id",         Display = "ID",           Width = 5,  Sort = "num" },
        new { Name = "SupportDate",Display = "Support Date",  Width = 9,  Sort = "date" },
        new { Name = "ClientName", Display = "Client",        Width = 12, Sort = "text" },
        new { Name = "SupportType",Display = "Support Type",  Width = 9,  Sort = "text" },
        new { Name = "Subject",    Display = "Subject",       Width = 12, Sort = "text" },
        new { Name = "Status",     Display = "Status",        Width = 8,  Sort = "status" },
        new { Name = "Priority",   Display = "Priority",      Width = 8,  Sort = "text" },
        new { Name = "UserName",   Display = "User",          Width = 9,  Sort = "text" },
        new { Name = "StartTime",  Display = "Start Time",    Width = 8,  Sort = "time" },
        new { Name = "EndTime",    Display = "End Time",      Width = 8,  Sort = "time" },
        new { Name = "Remarks",    Display = "Remarks",       Width = 14, Sort = "text" },
        new { Name = "EntryOn",    Display = "Entry On",      Width = 10, Sort = "date" }
    }
        .Where(col =>
            col.Name == "ClientName"
            || col.Name == "UserName"
            || Model.AvailableColumns.Contains(col.Name))
        .ToArray();

    string[] statuses =
    {
        "Open",
        "In Progress",
        "Pending",
        "Completed",
        "Cancelled"
    };

    string[] priorities =
    {
        "Low",
        "Medium",
        "High",
        "Urgent"
    };

    string[] supportTypes =
    {
        "Software Support",
        "Installation",
        "Configuration",
        "Client Query",
        "Training",
        "Data/Report",
        "Technical Issue",
        "Other"
    };

    string GetVal(string name)
        => Model.GetFormValue(name);

    string GetErr(string name)
        => Model.FieldError(name);

    bool showOtherSupportType =
        GetVal("SupportType") == "Other";

    string StatusPillClass(string status)
    {
        return status == "Completed"
            ? "badge-completed"
            : status == "Open"
                ? "badge-open"
                : status == "In Progress"
                    ? "badge-inprogress"
                    : status == "Pending"
                        ? "badge-pending"
                        : status == "Cancelled"
                            ? "badge-cancelled"
                            : "badge-default";
    }
}


<div class="page-header">

    <div>

        <h1>
            Daily Support
        </h1>

        <p>
            Manage daily support records
        </p>

    </div>

</div>


<!-- ================= KPI CARDS ================= -->

<div class="dashboard-cards">


    <div class="dashboard-card">

        <div class="card-content">

            <p>
                Total Records
            </p>

            <h2 data-kpi="total">
                @Model.TotalRecords
            </h2>

        </div>

        <div class="card-icon">
            📊
        </div>

    </div>


    <div class="dashboard-card">

        <div class="card-content">

            <p>
                Open
            </p>

            <h2 data-kpi="open">
                @Model.OpenCount
            </h2>

        </div>

        <div class="card-icon">
            🔄
        </div>

    </div>


    <div class="dashboard-card">

        <div class="card-content">

            <p>
                In Progress
            </p>

            <h2 data-kpi="in-progress">
                @Model.InProgressCount
            </h2>

        </div>

        <div class="card-icon">
            ⏳
        </div>

    </div>


    <div class="dashboard-card">

        <div class="card-content">

            <p>
                Completed
            </p>

            <h2 data-kpi="completed">
                @Model.CompletedCount
            </h2>

        </div>

        <div class="card-icon">
            ✅
        </div>

    </div>


</div>


<!-- ================= MESSAGES ================= -->

@if (TempData["Success"] != null)
{
    <div class="success-message">

        @TempData["Success"]

    </div>
}


@if (TempData["Error"] != null)
{
    <div class="error-message">

        @Html.Raw(TempData["Error"])

    </div>
}


<!-- ================= SUPPORT SECTION ================= -->

<div class="state-section">




    <!-- ================= TABLE TOOLBAR ================= -->

    <div class="table-toolbar">

        <div class="toolbar-left">

            <select id="recordsPerPage"
                    onchange="changeRecordsPerPage()">

                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>

            </select>

            <span class="toolbar-label">
                records per page
            </span>

        </div>


        <div class="toolbar-center">

            <button type="button"
                    class="export-btn excel-btn"
                    onclick="exportExcel()">

                Excel

            </button>

            <button type="button"
                    class="export-btn csv-btn"
                    onclick="exportCSV()">

                CSV

            </button>

            <button type="button"
                    class="export-btn print-btn"
                    onclick="printTable()">

                Print

            </button>

        </div>


        <div class="toolbar-right">

            <span class="toolbar-label">
                Search:
            </span>

            <input type="text"
                   id="tableSearch"
                   placeholder="Search..."
                   oninput="filterTable()" />

            <a href="@Url.Action("Create", "DailySupport")"
                   class="primary-btn">

                + Add Support

            </a>

        </div>

    </div>


    <!-- ================= TABLE ================= -->

    <div class="table-container support-table">

        <table id="dataTable">


            <thead>

                <tr>

                    @for (int i = 0; i < gridColumns.Length; i++)
                    {
                        var col = gridColumns[i];

                        string colClass =
                            nowrapCols.Contains(col.Name)
                                ? "col-nowrap"
                                : "col-wrap";

                        <th class="sortable @colClass"
                            data-sort="@col.Sort"
                            onclick="sortTable(this)">

                            <span class="th-text">
                                @col.Display
                            </span>

                            <span class="sort-indicator">
                                <span class="sort-up"></span>
                                <span class="sort-down"></span>
                            </span>

                        </th>
                    }

                    <th class="actions-col">
                        Actions
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (Model.Supports.Count == 0)
                {
                    <tr class="no-data-row"
                        data-search="">

                        <td colspan="@(gridColumns.Length + 1)"
                            class="empty-state">

                            No Records Found on this filter.

                        </td>

                    </tr>
                }
                else
                {
                    @foreach (var support in Model.Supports)
                    {
                        var searchText = string.Join(
                            " ",
                            gridColumns.Select(
                                c => support.Get(c.Name)));

                        var statusValue = support.Get("Status");

                        string statusClass =
                            statusValue == "Completed"
                                ? "badge-completed"
                                : statusValue == "Open"
                                    ? "badge-open"
                                    : statusValue == "In Progress"
                                        ? "badge-inprogress"
                                        : statusValue == "Pending"
                                            ? "badge-pending"
                                            : statusValue == "Cancelled"
                                                ? "badge-cancelled"
                                                : "badge-default";

                        <tr data-search="@searchText">

                            @foreach (var col in gridColumns)
                            {
                                string tdClass =
                                    nowrapCols.Contains(col.Name)
                                        ? "col-nowrap"
                                        : "col-wrap";

                                <td class="@tdClass">

                                    @if (col.Name == "Status")
                                    {
                                        <span class="status-pill @statusClass">
                                            @support.Get(col.Name)
                                        </span>
                                    }
                                    else
                                    {
                                        @support.Get(col.Name)
                                    }

                                </td>
                            }

                            <td>

                                <div class="action-cell">

                                    @{
                                        var rowJson =
                                            System.Text.Json
                                                .JsonSerializer
                                                .Serialize(
                                                    support.Values);
                                    }

                                    <button type="button"
                                            class="edit-btn action-btn"
                                            title="Edit"
                                            data-json="@rowJson"
                                            onclick="openEditModal(this)">

                                        ✎

                                    </button>

                                    <form asp-controller="DailySupport"
                                          asp-action="Delete"
                                          method="post"
                                          onsubmit="return masterConfirmAndSubmit(
                                              this,
                                              'Are you sure you want to delete this support record?'
                                          );">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@support.Get("Id")" />

                                        <button type="submit"
                                                class="delete-btn action-btn"
                                                title="Delete">

                                            ✕

                                        </button>

                                    </form>


                                </div>

                            </td>

                        </tr>
                    }
                }

                <!-- Client-side empty row: shown when the
                     search filter matches no rows. -->
                <tr id="noRecordsRow"
                    class="no-data-row"
                    data-search=""
                    style="display: none;">

                    <td colspan="@(gridColumns.Length + 1)"
                        class="empty-state">

                        No Records Found on this filter.

                    </td>

                </tr>

            </tbody>

        </table>

    </div>


    <!-- ================= TABLE FOOTER ================= -->

    <div class="table-footer">

        <div class="footer-left"
             id="tableInfo">

            Showing 1 to 10 of @totalRecords entries

        </div>


        <div class="footer-right"
             id="pagination">

        </div>

    </div>

</div>


<!-- ================= ADD / EDIT MODAL ================= -->

<div id="supportModal"
     class="modal">

    <div class="modal-content modal-wide">


        <div class="modal-header">

            <h2 id="modalTitle">
                Edit Support
            </h2>


            <button type="button"
                    class="modal-close"
                    onclick="closeModal()">

                &times;

            </button>

        </div>


        <form id="supportForm"
              method="post"
              action="@Url.Action("Create", "DailySupport")"
              novalidate>

            @Html.AntiForgeryToken()

            <input type="hidden"
                   id="editId"
                   name="id"
                   value="@GetVal("Id")" />


            <div class="form-grid">

                @if (Model.AvailableColumns.Contains("SupportDate"))
                {
                <div class="form-group">

                    <label>
                        Support Date
                    </label>

                    <input type="date"
                           id="edit_SupportDate"
                           name="SupportDate"
                           value="@GetVal("SupportDate")"
                           required />

                    @if (!string.IsNullOrWhiteSpace(GetErr("SupportDate")))
                    {
                        <span class="field-error">
                            @GetErr("SupportDate")
                        </span>
                    }

                </div>
                }

                @if (Model.AvailableColumns.Contains("ClientId"))
                {
                <div class="form-group">

                    <label>
                        Client
                    </label>

                    <select name="ClientId"
                            id="edit_ClientId"
                            required>

                        <option value=""
                                disabled
                                selected="@(string.IsNullOrWhiteSpace(GetVal("ClientId")))">
                            -- Select Client --
                        </option>

                        @foreach (var client in Model.Clients)
                        {
                            <option value="@client.Id"
                                    selected="@(GetVal("ClientId") == client.Id.ToString())">
                                @client.Name
                            </option>
                        }

                    </select>

                    @if (!string.IsNullOrWhiteSpace(GetErr("ClientId")))
                    {
                        <span class="field-error">
                            @GetErr("ClientId")
                        </span>
                    }

                </div>
                }

                @if (Model.AvailableColumns.Contains("SupportType"))
                {
                <div class="form-group">

                    <label>
                        Support Type
                    </label>

                    <select name="SupportType"
                            id="edit_SupportType"
                            onchange="toggleOtherSupportType()"
                            required>

                        <option value=""
                                disabled
                                selected="@(string.IsNullOrWhiteSpace(GetVal("SupportType")))">
                            -- Select Support Type --
                        </option>

                        @foreach (var supportType in supportTypes)
                        {
                            <option value="@supportType"
                                    selected="@(GetVal("SupportType") == supportType)">
                                @supportType
                            </option>
                        }

                    </select>

                    @if (!string.IsNullOrWhiteSpace(GetErr("SupportType")))
                    {
                        <span class="field-error">
                            @GetErr("SupportType")
                        </span>
                    }

                    <div id="otherSupportTypeGroup"
                         style="@(showOtherSupportType ? "" : "display:none")">

                        <label class="sub-label">
                            Other Support Type
                        </label>

                        <input type="text"
                               name="OtherSupportType"
                               id="edit_OtherSupportType"
                               maxlength="92"
                               placeholder="Specify other support type"
                               value="@GetVal("OtherSupportType")"
                               @(showOtherSupportType ? "required" : null) />

                        @if (!string.IsNullOrWhiteSpace(GetErr("OtherSupportType")))
                        {
                            <span class="field-error">
                                @GetErr("OtherSupportType")
                            </span>
                        }

                    </div>

                </div>
                }

                @if (Model.AvailableColumns.Contains("Subject"))
                {
                <div class="form-group">

                    <label>
                        Subject
                    </label>

                    <input type="text"
                           id="edit_Subject"
                           name="Subject"
                           value="@GetVal("Subject")"
                           placeholder="Short subject"
                           required />

                    @if (!string.IsNullOrWhiteSpace(GetErr("Subject")))
                    {
                        <span class="field-error">
                            @GetErr("Subject")
                        </span>
                    }

                </div>
                }

                @if (Model.AvailableColumns.Contains("Description"))
                {
                <div class="form-group form-group-full">

                    <label>
                        Description
                    </label>

                    <textarea id="edit_Description"
                              name="Description"
                              rows="2"
                              placeholder="Client problem / request"
                              required>@GetVal("Description")</textarea>

                    @if (!string.IsNullOrWhiteSpace(GetErr("Description")))
                    {
                        <span class="field-error">
                            @GetErr("Description")
                        </span>
                    }

                </div>
                }

                @if (Model.AvailableColumns.Contains("ActionTaken"))
                {
                <div class="form-group form-group-full">

                    <label>
                        Action Taken
                    </label>

                    <textarea id="edit_ActionTaken"
                              name="ActionTaken"
                              rows="2"
                              placeholder="Action taken by support team">@GetVal("ActionTaken")</textarea>

                </div>
                }

                @if (Model.AvailableColumns.Contains("Status"))
                {
                <div class="form-group">

                    <label>
                        Status
                    </label>

                    <select name="Status"
                            id="edit_Status"
                            onchange="updateCurrentStatus()"
                            required>

                        <option value=""
                                disabled
                                selected="@(string.IsNullOrWhiteSpace(GetVal("Status")))">
                            -- Select Status --
                        </option>

                        @foreach (var status in statuses)
                        {
                            <option value="@status"
                                    selected="@(GetVal("Status") == status)">
                                @status
                            </option>
                        }

                    </select>

                    <div class="status-tracker">

                        <div class="status-tracker-row">

                            <span class="status-tracker-label">
                                Previous Status
                            </span>

                            <span id="prevStatusBadge"
                                  class="status-pill @StatusPillClass(Model.EditPreviousStatus)">
                                @(string.IsNullOrWhiteSpace(Model.EditPreviousStatus) ? "—" : Model.EditPreviousStatus)
                            </span>

                        </div>

                        <div class="status-tracker-row">

                            <span class="status-tracker-label">
                                Current Status
                            </span>

                            <span id="curStatusBadge"
                                  class="status-pill @StatusPillClass(GetVal("Status"))">
                                @(string.IsNullOrWhiteSpace(GetVal("Status")) ? "—" : GetVal("Status"))
                            </span>

                        </div>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(GetErr("Status")))
                    {
                        <span class="field-error">
                            @GetErr("Status")
                        </span>
                    }

                </div>
                }

                @if (Model.AvailableColumns.Contains("Priority"))
                {
                <div class="form-group">

                    <label>
                        Priority
                    </label>

                    <select name="Priority"
                            id="edit_Priority"
                            required>

                        <option value=""
                                disabled
                                selected="@(string.IsNullOrWhiteSpace(GetVal("Priority")))">
                            -- Select Priority --
                        </option>

                        @foreach (var priority in priorities)
                        {
                            <option value="@priority"
                                    selected="@(GetVal("Priority") == priority)">
                                @priority
                            </option>
                        }

                    </select>

                    @if (!string.IsNullOrWhiteSpace(GetErr("Priority")))
                    {
                        <span class="field-error">
                            @GetErr("Priority")
                        </span>
                    }

                </div>
                }

                @if (Model.AvailableColumns.Contains("StartTime"))
                {
                <div class="form-group">

                    <label>
                        Start Time
                    </label>

                    <input type="time"
                           id="edit_StartTime"
                           name="StartTime"
                           value="@GetVal("StartTime")" />

                    @if (!string.IsNullOrWhiteSpace(GetErr("StartTime")))
                    {
                        <span class="field-error">
                            @GetErr("StartTime")
                        </span>
                    }

                </div>
                }

                @if (Model.AvailableColumns.Contains("EndTime"))
                {
                <div class="form-group">

                    <label>
                        End Time
                    </label>

                    <input type="time"
                           id="edit_EndTime"
                           name="EndTime"
                           value="@GetVal("EndTime")" />

                    @if (!string.IsNullOrWhiteSpace(GetErr("EndTime")))
                    {
                        <span class="field-error">
                            @GetErr("EndTime")
                        </span>
                    }

                </div>
                }

                @if (Model.AvailableColumns.Contains("FollowUpDate"))
                {
                <div class="form-group">

                    <label>
                        Follow Up Date
                    </label>

                    <input type="date"
                           id="edit_FollowUpDate"
                           name="FollowUpDate"
                           value="@GetVal("FollowUpDate")" />

                    @if (!string.IsNullOrWhiteSpace(GetErr("FollowUpDate")))
                    {
                        <span class="field-error">
                            @GetErr("FollowUpDate")
                        </span>
                    }

                </div>
                }

                @if (Model.AvailableColumns.Contains("Remarks"))
                {
                <div class="form-group form-group-full">

                    <label>
                        Remarks
                    </label>

                    <textarea id="edit_Remarks"
                              name="Remarks"
                              rows="3"
                              placeholder="Voice to text - click Mic and speak...">@GetVal("Remarks")</textarea>

                    <div class="voice-controls">

                        <button type="button"
                                class="voice-btn mic-btn"
                                id="voiceMicBtn"
                                onclick="startVoice()">

                            Mic

                        </button>

                        <button type="button"
                                class="voice-btn voice-stop"
                                onclick="stopVoice()">

                            Stop

                        </button>

                        <button type="button"
                                class="voice-btn voice-reset"
                                onclick="resetRemarks()">

                            Reset

                        </button>

                    </div>

                    <span class="voice-status"
                          id="voiceStatus"></span>

                    <span class="voice-hint">
                        Voice to Text: Mic se bolen, text Remarks ke end me jude ga. Mic tab tak open rahega jab tak Stop nahi click karte.
                    </span>

                    @if (!string.IsNullOrWhiteSpace(GetErr("Remarks")))
                    {
                        <span class="field-error">
                            @GetErr("Remarks")
                        </span>
                    }

                </div>
                }

            </div>


            <span class="voice-hint auto-time-hint">
                Status rules: Open = optional fields. In Progress = Start Time required. Pending = Start + Remarks required, End Time blank. Completed = Start + End + Remarks required. Cancelled = Remarks required.
            </span>


            <div class="modal-actions">

                <button type="submit"
                        id="btnSubmit"
                        class="save-btn">

                    Save

                </button>

                <button type="button"
                        class="cancel-btn"
                        onclick="closeModal()">

                    Cancel

                </button>

            </div>

        </form>

    </div>

</div>


@if (Model.OpenEditModal)
{
    <script>

        // Modal ko server-side rendered values
        // + field errors ke saath auto open karo
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                var form =
                    document.getElementById(
                        "supportForm"
                    );

                form.action = editUrl;

                document.getElementById(
                    "modalTitle"
                ).innerText = "Edit Support";

                document.getElementById(
                    "btnSubmit"
                ).innerText = "Update";

                document.getElementById(
                    "supportModal"
                ).style.display = "flex";

            }
        );

    </script>
}


@section Scripts
{
    <script>

        // ==========================================
        // DAILY SUPPORT
        // ==========================================

        var currentPage = 1;
        var recordsPerPage = 10;
        var totalRecords = @totalRecords;

        var editUrl =
            "@Url.Action("Edit", "DailySupport")";


        // ==========================================
        // FILTER TABLE
        // ==========================================

        function filterTable() {

            currentPage = 1;

            renderTable();

        }


        // ==========================================
        // CHANGE RECORDS PER PAGE
        // ==========================================

        function changeRecordsPerPage() {

            recordsPerPage = parseInt(
                document.getElementById(
                    "recordsPerPage"
                ).value
            );

            currentPage = 1;

            renderTable();

        }


        // ==========================================
        // GO TO PAGE
        // ==========================================

        function goToPage(page) {

            currentPage = page;

            renderTable();

        }


        // ==========================================
        // RENDER TABLE
        // ==========================================

        function renderTable() {

            var searchValue =
                document.getElementById(
                    "tableSearch"
                ).value
                .toLowerCase()
                .trim();


            var rows =
                document.querySelectorAll(
                    "#dataTable tbody tr"
                );


            var filteredRows = [];


            for (var i = 0; i < rows.length; i++) {

                // Skip the "no records" placeholder rows;
                // they are never real data rows.
                if (
                    rows[i].classList.contains(
                        "no-data-row"
                    )
                ) {
                    continue;
                }

                var searchData =
                    rows[i]
                        .getAttribute(
                            "data-search"
                        )
                        .toLowerCase();


                if (
                    searchData.indexOf(
                        searchValue
                    ) !== -1
                ) {
                    filteredRows.push(rows[i]);
                }

            }


            totalRecords = filteredRows.length;


            var totalPages =
                Math.ceil(
                    totalRecords / recordsPerPage
                );


            if (currentPage > totalPages) {
                currentPage =
                    totalPages > 0
                        ? totalPages
                        : 1;
            }


            var startIndex =
                (currentPage - 1)
                * recordsPerPage;


            var endIndex =
                startIndex + recordsPerPage;


            if (endIndex > totalRecords) {
                endIndex = totalRecords;
            }


            for (var j = 0; j < rows.length; j++) {
                rows[j].style.display = "none";
            }


            for (
                var k = startIndex;
                k < endIndex;
                k++
            ) {
                filteredRows[k].style.display = "";
            }


            // "No Records Found on this filter" message
            // when the search filter matches nothing.

            var noRecordsRow =
                document.getElementById(
                    "noRecordsRow"
                );

            if (noRecordsRow) {

                noRecordsRow.style.display =
                    filteredRows.length === 0
                        ? ""
                        : "none";

            }


            updateTableInfo(
                startIndex + 1,
                endIndex,
                totalRecords
            );


            renderPagination(totalPages);

        }


        // ==========================================
        // UPDATE TABLE INFO
        // ==========================================

        function updateTableInfo(
            start,
            end,
            total
        ) {

            var infoElement =
                document.getElementById(
                    "tableInfo"
                );


            if (total === 0) {
                infoElement.innerText =
                    "Showing 0 to 0 of 0 entries";
            } else {
                infoElement.innerText =
                    "Showing "
                    + start
                    + " to "
                    + end
                    + " of "
                    + total
                    + " entries";
            }

        }


        // ==========================================
        // RENDER PAGINATION
        // ==========================================

        function renderPagination(
            totalPages
        ) {

            var paginationElement =
                document.getElementById(
                    "pagination"
                );


            var html = "";


            // PREVIOUS BUTTON

            if (currentPage === 1) {
                html +=
                    '<button class="page-btn" disabled>← Previous</button>';
            } else {
                html +=
                    '<button class="page-btn" onclick="goToPage('
                    + (currentPage - 1)
                    + ')">← Previous</button>';
            }


            // PAGE NUMBERS

            for (
                var i = 1;
                i <= totalPages;
                i++
            ) {

                if (i === currentPage) {
                    html +=
                        '<button class="page-btn active">'
                        + i
                        + '</button>';
                } else {
                    html +=
                        '<button class="page-btn" onclick="goToPage('
                        + i
                        + ')">'
                        + i
                        + '</button>';
                }

            }


            // NEXT BUTTON

            if (
                currentPage === totalPages
                || totalPages === 0
            ) {
                html +=
                    '<button class="page-btn" disabled>Next →</button>';
            } else {
                html +=
                    '<button class="page-btn" onclick="goToPage('
                    + (currentPage + 1)
                    + ')">Next →</button>';
            }


            paginationElement.innerHTML = html;

        }


        // ==========================================
        // SORT TABLE
        // ==========================================

        var sortColumn = -1;
        var sortDirection = "asc";


        function timeToMinutes(value) {

            var match =
                value.match(
                    /^(\d{1,2}):(\d{2})\s*([AP]M)$/i
                );

            if (!match) {
                return 0;
            }

            var hours =
                parseInt(match[1], 10) % 12;

            if (/pm/i.test(match[3])) {
                hours += 12;
            }

            return hours * 60 + parseInt(match[2], 10);

        }


        function sortTable(th) {

            var headers =
                Array.from(
                    th.parentNode.children
                );

            var colIndex =
                headers.indexOf(th);

            var type =
                th.getAttribute("data-sort")
                || "text";


            if (sortColumn === colIndex) {
                sortDirection =
                    sortDirection === "asc"
                        ? "desc"
                        : "asc";
            } else {
                sortDirection = "asc";
                sortColumn = colIndex;
            }


            var tbody =
                document.querySelector(
                    "#dataTable tbody"
                );


            var rows =
                Array.from(tbody.querySelectorAll("tr"));


            rows.sort(function (a, b) {

                var aVal =
                    a.querySelectorAll("td")[
                        colIndex
                    ].innerText.trim();

                var bVal =
                    b.querySelectorAll("td")[
                        colIndex
                    ].innerText.trim();


                var aNum, bNum;


                if (type === "num") {

                    aNum =
                        parseInt(aVal) || 0;
                    bNum =
                        parseInt(bVal) || 0;

                    return sortDirection === "asc"
                        ? aNum - bNum
                        : bNum - aNum;

                } else if (type === "time") {

                    aNum = timeToMinutes(aVal);
                    bNum = timeToMinutes(bVal);

                    return sortDirection === "asc"
                        ? aNum - bNum
                        : bNum - aNum;

                } else if (type === "date") {

                    aNum =
                        new Date(aVal).getTime() || 0;
                    bNum =
                        new Date(bVal).getTime() || 0;

                    return sortDirection === "asc"
                        ? aNum - bNum
                        : bNum - aNum;

                } else if (type === "status") {

                    aNum =
                        aVal === "Active" ? 1 : 0;
                    bNum =
                        bVal === "Active" ? 1 : 0;

                    return sortDirection === "asc"
                        ? aNum - bNum
                        : bNum - aNum;

                } else {

                    return sortDirection === "asc"
                        ? aVal.localeCompare(bVal)
                        : bVal.localeCompare(aVal);

                }

            });


            for (
                var i = 0;
                i < rows.length;
                i++
            ) {
                tbody.appendChild(rows[i]);
            }


            updateSortArrows(colIndex);


            currentPage = 1;

            renderTable();

        }


        function updateSortArrows(colIndex) {

            var headers =
                document.querySelectorAll(
                    "#dataTable th"
                );


            for (
                var i = 0;
                i < headers.length;
                i++
            ) {

                headers[i].classList.remove(
                    "sort-asc",
                    "sort-desc"
                );

            }


            headers[colIndex].classList.add(
                sortDirection === "asc"
                    ? "sort-asc"
                    : "sort-desc"
            );

        }


        // ==========================================
        // INIT
        // ==========================================

        document.addEventListener(
            "DOMContentLoaded",
            function () {
                renderTable();
            }
        );


        // ==========================================
        // EXPORT EXCEL
        // ==========================================

        function exportExcel() {

            var table =
                document.getElementById(
                    "dataTable"
                );

            var rows =
                table.querySelectorAll("tr");

            var data = [];


            for (var i = 0; i < rows.length; i++) {

                if (
                    rows[i].style.display === "none"
                ) {
                    continue;
                }


                var cells =
                    rows[i].querySelectorAll(
                        "th, td"
                    );

                var rowData = [];


                for (
                    var j = 0;
                    j < cells.length;
                    j++
                ) {

                    if (
                        j === cells.length - 1
                    ) {
                        continue;
                    }


                    rowData.push(
                        cells[j].innerText.trim()
                    );

                }


                if (rowData.length > 0) {
                    data.push(rowData);
                }

            }


            var worksheet =
                XLSX.utils.aoa_to_sheet(data);


            var workbook =
                XLSX.utils.book_new();


            XLSX.utils.book_append_sheet(
                workbook,
                worksheet,
                "Supports"
            );


            XLSX.writeFile(
                workbook,
                "Supports_Data.xlsx"
            );

        }


        // ==========================================
        // EXPORT CSV
        // ==========================================

        function exportCSV() {

            var table =
                document.getElementById(
                    "dataTable"
                );

            var rows =
                table.querySelectorAll("tr");

            var csvContent = "";


            for (var i = 0; i < rows.length; i++) {

                if (
                    rows[i].style.display === "none"
                ) {
                    continue;
                }


                var cells =
                    rows[i].querySelectorAll(
                        "th, td"
                    );

                var rowData = [];


                for (
                    var j = 0;
                    j < cells.length;
                    j++
                ) {

                    if (
                        j === cells.length - 1
                    ) {
                        continue;
                    }


                    var text =
                        cells[j].innerText
                            .trim();

                    text = text.replace(
                        /"/g,
                        '""'
                    );

                    rowData.push(
                        '"' + text + '"'
                    );

                }


                if (rowData.length > 0) {
                    csvContent +=
                        rowData.join(",")
                        + "\r\n";
                }

            }


            var blob = new Blob(
                [csvContent],
                {
                    type:
                        "text/csv;charset=utf-8;"
                }
            );


            var link =
                document.createElement("a");


            link.href =
                URL.createObjectURL(blob);


            link.download =
                "Supports_Data.csv";


            link.click();

        }


        // ==========================================
        // PRINT TABLE
        // ==========================================

        function printTable() {

            var table =
                document.getElementById(
                    "dataTable"
                );


            var printWindow =
                window.open("", "_blank");


            printWindow.document.write(
                '<html><head>'
                + '<title>Daily Support Data</title>'
                + '<style>'
                + 'body { font-family: Arial, sans-serif; padding: 20px; }'
                + 'h1 { font-size: 22px; margin-bottom: 15px; }'
                + 'table { width: 100%; border-collapse: collapse; }'
                + 'th, td { padding: 10px; text-align: left; border-bottom: 1px solid #ddd; }'
                + 'th { background: #f3f4f6; font-size: 13px; }'
                + 'td { font-size: 13px; }'
                + '</style>'
                + '</head><body>'
            );


            printWindow.document.write(
                '<h1>Daily Support Data</h1>'
            );


            printWindow.document.write(
                '<table>'
            );


            // THEAD

            var thead =
                table.querySelector("thead");


            if (thead) {

                printWindow.document.write(
                    "<thead>"
                    + thead.innerHTML
                    + "</thead>"
                );

            }


            // TBODY - only visible rows

            printWindow.document.write(
                "<tbody>"
            );


            var tbodyRows =
                table.querySelectorAll(
                    "tbody tr"
                );


            for (
                var i = 0;
                i < tbodyRows.length;
                i++
            ) {

                if (
                    tbodyRows[i].style.display
                    !== "none"
                ) {

                    var cells =
                        tbodyRows[i]
                            .querySelectorAll("td");

                    var filteredCells = [];


                    for (
                        var j = 0;
                        j < cells.length;
                        j++
                    ) {

                        var cellButtons =
                            cells[j]
                                .querySelector(
                                    "button"
                                );


                        if (
                            cellButtons === null
                        ) {
                            filteredCells.push(
                                "<td>"
                                + cells[j]
                                    .innerHTML
                                + "</td>"
                            );
                        }

                    }


                    printWindow.document.write(
                        "<tr>"
                        + filteredCells
                            .join("")
                        + "</tr>"
                    );

                }

            }


            printWindow.document.write(
                "</tbody></table>"
            );


            printWindow.document.write(
                "</body></html>"
            );


            printWindow.document.close();


            printWindow.print();

        }


        // ==========================================
        // AUTO DISMISS MESSAGES
        // ==========================================

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                var messages =
                    document.querySelectorAll(
                        ".success-message, .error-message"
                    );


                for (
                    var i = 0;
                    i < messages.length;
                    i++
                ) {

                    (function (message) {

                        setTimeout(
                            function () {

                                message.style.transition =
                                    "opacity 0.5s ease";

                                message.style.opacity = "0";


                                setTimeout(
                                    function () {
                                        message.remove();
                                    },
                                    500
                                );

                            },
                            3000
                        );

                    })(messages[i]);

                }

            }
        );


        // ==========================================
        // VOICE TO TEXT - REMARKS
        // ==========================================

        var recognition = null;
        var isRecording = false;
        var speechBaseText = "";
        var speechFinal = "";


        function speechSupported() {

            return (
                "webkitSpeechRecognition" in window
                || "SpeechRecognition" in window
            );

        }


        function setListening(on) {

            var micBtn =
                document.getElementById(
                    "voiceMicBtn"
                );

            var status =
                document.getElementById(
                    "voiceStatus"
                );


            if (micBtn) {

                if (on) {
                    micBtn.classList.add(
                        "is-recording"
                    );
                } else {
                    micBtn.classList.remove(
                        "is-recording"
                    );
                }

            }


            if (status) {

                if (on) {
                    status.innerText =
                        "● Listening... Stop click karne tak mic open rahega";
                    status.classList.add("visible");
                } else {
                    status.classList.remove("visible");
                }

            }

        }


        function statusPillClass(status) {

            switch (status) {

                case "Completed":
                    return "badge-completed";

                case "Open":
                    return "badge-open";

                case "In Progress":
                    return "badge-inprogress";

                case "Pending":
                    return "badge-pending";

                case "Cancelled":
                    return "badge-cancelled";

                default:
                    return "badge-default";

            }

        }


        function setStatusBadge(el, status) {

            if (!el) {
                return;
            }

            el.className =
                "status-pill " + statusPillClass(status);

            el.innerText =
                (status && status.length > 0)
                    ? status
                    : "—";

        }


        function updateCurrentStatus() {

            var select =
                document.getElementById("edit_Status");

            var badge =
                document.getElementById("curStatusBadge");

            if (!select || !badge) {
                return;
            }

            setStatusBadge(badge, select.value || "");

        }


        function toggleOtherSupportType() {

            var select =
                document.getElementById(
                    "edit_SupportType"
                );

            var group =
                document.getElementById(
                    "otherSupportTypeGroup"
                );

            var input =
                document.getElementById(
                    "edit_OtherSupportType"
                );

            var isOther =
                select !== null
                    && select.value === "Other";

            if (group) {

                group.style.display =
                    isOther ? "" : "none";

            }

            if (input) {

                input.required = isOther ? true : false;

            }

        }


        function applySpeechText(textarea, interim) {

            var parts = [];

            if (speechBaseText.length > 0) {
                parts.push(speechBaseText);
            }

            if (speechFinal.trim().length > 0) {
                parts.push(speechFinal.trim());
            }

            if (interim.trim().length > 0) {
                parts.push(interim.trim());
            }

            textarea.value = parts.join(" ");

        }


        function startVoice() {

            var textarea =
                document.getElementById(
                    "edit_Remarks"
                );


            if (!speechSupported()) {

                alert(
                    "Speech Recognition is not supported in this browser. " +
                    "Please use Google Chrome."
                );

                return;

            }


            var SpeechRecognition =
                window.SpeechRecognition
                || window.webkitSpeechRecognition;

            recognition =
                new SpeechRecognition();

            recognition.lang = "en-IN";

            recognition.interimResults = true;

            recognition.continuous = true;

            recognition.maxAlternatives = 1;


            recognition.onstart = function () {

                isRecording = true;

                speechBaseText =
                    textarea.value.trim();

                speechFinal = "";

                setListening(true);

                textarea.focus();

            };


            recognition.onresult = function (event) {

                var interimText = "";


                for (
                    var i = event.resultIndex;
                    i < event.results.length;
                    i++
                ) {

                    var result = event.results[i];

                    if (result.isFinal) {
                        speechFinal +=
                            " " + result[0].transcript;
                    } else {
                        interimText +=
                            result[0].transcript;
                    }

                }


                applySpeechText(
                    textarea,
                    interimText
                );

            };


            recognition.onerror = function (event) {

                if (
                    event.error === "not-allowed"
                    || event.error ===
                        "service-not-allowed"
                ) {

                    alert(
                        "Microphone permission denied. " +
                        "Please allow microphone access."
                    );

                } else if (
                    event.error === "no-speech"
                ) {

                    alert(
                        "No speech detected. " +
                        "Please try again."
                    );

                } else {

                    alert(
                        "Speech recognition error: "
                        + event.error
                    );

                }

                isRecording = false;

                setListening(false);

            };


            recognition.onend = function () {

                isRecording = false;

                setListening(false);

            };


            try {

                recognition.start();

            } catch (error) {

                alert(
                    "Could not start speech recognition: "
                    + error.message
                );

            }

        }


        function stopVoice() {

            if (recognition) {

                recognition.stop();

            }

            isRecording = false;

            setListening(false);

        }


        function resetRemarks() {

            if (
                !confirm(
                    "Are you sure you want to clear remarks?"
                )
            ) {
                return;
            }

            // Speech bhi stop ho jaye
            if (recognition) {

                recognition.stop();

            }

            isRecording = false;

            setListening(false);

            speechBaseText = "";
            speechFinal = "";

            document.getElementById(
                "edit_Remarks"
            ).value = "";

        }


        // ==========================================
        // MODAL
        // ==========================================

        function toDateInputValue(value) {

            if (!value) {
                return "";
            }

            var trimmed = String(value).trim();

            if (/^\d{4}-\d{2}-\d{2}$/.test(trimmed)) {
                return trimmed;
            }

            var match =
                trimmed.match(
                    /^(\d{2})\/(\d{2})\/(\d{4})/
                );

            return match
                ? match[3] + "-" + match[2] + "-" + match[1]
                : "";

        }


        function toTimeInputValue(value) {

            var match =
                value.match(
                    /^(\d{1,2}):(\d{2})\s*([AP]M)$/i
                );

            if (!match) {
                return "";
            }

            var hours =
                parseInt(match[1], 10) % 12;

            if (/pm/i.test(match[3])) {
                hours += 12;
            }

            return (
                (hours < 10 ? "0" + hours : hours)
                + ":"
                + match[2]
            );

        }


        function openEditModal(btn) {

            var data =
                JSON.parse(
                    btn.getAttribute("data-json")
                );


            document.getElementById(
                "modalTitle"
            ).innerText = "Edit Support";


            document.getElementById(
                "btnSubmit"
            ).innerText = "Update";


            var form =
                document.getElementById(
                    "supportForm"
                );

            form.action = editUrl;

            form.reset();


            var elements =
                form.querySelectorAll(
                    "input[name], select[name], textarea[name]"
                );


            for (
                var i = 0;
                i < elements.length;
                i++
            ) {

                var element = elements[i];

                var name =
                    element.getAttribute(
                        "name"
                    );

                if (!name) {
                    continue;
                }


                var key = null;

                for (var fieldName in data) {

                    if (
                        data.hasOwnProperty(fieldName)
                        && fieldName.toLowerCase()
                           === name.toLowerCase()
                    ) {
                        key = fieldName;
                        break;
                    }

                }


                if (!key) {
                    continue;
                }

                var rawValue = data[key];


                if (name.toLowerCase() === "supporttype") {

                    var otherValue = "";
                    var otherPrefix = "Other - ";

                    if (
                        rawValue.indexOf(otherPrefix) === 0
                    ) {

                        otherValue =
                            rawValue.substring(
                                otherPrefix.length
                            );

                        rawValue = "Other";

                    } else {

                        var knownOption = false;
                        var option;

                        for (
                            option = 0;
                            option < element.options.length;
                            option++
                        ) {

                            if (
                                element.options[option].value
                                    === rawValue
                            ) {
                                knownOption = true;
                                break;
                            }

                        }

                        if (!knownOption
                            && rawValue.length > 0) {

                            otherValue = rawValue;

                            rawValue = "Other";

                        }

                    }

                    element.value = rawValue;

                    document.getElementById(
                        "edit_OtherSupportType"
                    ).value = otherValue;

                    toggleOtherSupportType();

                    continue;

                }


                if (element.type === "date") {

                    var isoRaw = rawValue;

                    for (var f in data) {

                        if (
                            data.hasOwnProperty(f)
                            && f.toLowerCase()
                               === name.toLowerCase() + "iso"
                        ) {
                            isoRaw = data[f];
                            break;
                        }

                    }

                    element.value =
                        toDateInputValue(isoRaw);

                } else if (element.type === "time") {

                    element.value =
                        toTimeInputValue(rawValue);

                } else {

                    element.value = rawValue;

                }

            }


            setStatusBadge(
                document.getElementById(
                    "prevStatusBadge"
                ),
                data["Status"] || ""
            );

            updateCurrentStatus();

            document.getElementById(
                "supportModal"
            ).style.display = "flex";

        }


        function closeModal() {

            stopVoice();

            document.getElementById(
                "supportModal"
            ).style.display = "none";

        }


        window.onclick = function (event) {

            const modal =
                document.getElementById(
                    "supportModal"
                );


            if (event.target === modal) {

                closeModal();

            }

        };


        masterBindModalSubmit(
            "supportForm",
            closeModal
        );

    </script>
}