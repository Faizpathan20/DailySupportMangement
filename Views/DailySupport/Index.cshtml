@section Styles
{
    @* Premium look (gray canvas + white cards + SVG icons).
       Sirf is page par; baaki pages safe rahen. *@
    <link rel="stylesheet"
          href="~/css/dailysupport.css?v=3" />
}

@section Scripts
{
    <script>

        // ==========================================
        // DAILY SUPPORT
        // ==========================================

        var currentPage = 1;
        var recordsPerPage = 10;
        var totalRecords = @totalRecords;

        var editUrl =
            "@Url.Action("Edit", "DailySupport")";

        var supportBaseUrl =
            "@Url.Action("Index", "DailySupport")";


        // ==========================================
        // ROW CLICK -> TICKET DETAIL
        // ==========================================

        document.addEventListener('click', function (e) {

            var row = e.target.closest('tr.tkt-row-link');

            if (!row) return;

            // Action buttons / links chhodo.
            if (e.target.closest('a, button, input, form')) return;

            var href = row.getAttribute('data-href');

            if (href) window.location.href = href;
        });


        // ==========================================
        // FILTER TABLE
        // ==========================================

        function filterTable() {

            currentPage = 1;

            renderTable();

        }


        // ==========================================
        // SEARCH (debounced + clear + count)
        // ==========================================

        var searchDebounceTimer = null;


        function filterTableDebounced() {

            if (searchDebounceTimer) {
                clearTimeout(searchDebounceTimer);
            }

            searchDebounceTimer = setTimeout(
                filterTable,
                120
            );

            // Clear button turant dikhe/hide ho.
            var input =
                document.getElementById(
                    "tableSearch"
                );

            var clearBtn =
                document.getElementById(
                    "tableSearchClear"
                );

            if (input && clearBtn) {
                clearBtn.hidden = !input.value;
            }

        }


        function clearTableSearch() {

            var input =
                document.getElementById(
                    "tableSearch"
                );

            if (!input) {
                return;
            }

            input.value = "";

            var clearBtn =
                document.getElementById(
                    "tableSearchClear"
                );

            if (clearBtn) {
                clearBtn.hidden = true;
            }

            filterTable();

            input.focus();

        }


        // "/" se search focus, "Esc" se clear.
        document.addEventListener(
            "keydown",
            function (event) {

                var input =
                    document.getElementById(
                        "tableSearch"
                    );

                if (!input) {
                    return;
                }

                var tag =
                    (event.target.tagName || "")
                        .toLowerCase();

                var typing =
                    tag === "input" ||
                    tag === "textarea" ||
                    tag === "select";

                if (event.key === "/" &&
                    !typing &&
                    !event.ctrlKey &&
                    !event.metaKey) {

                    event.preventDefault();

                    input.focus();
                    input.select();

                    return;

                }

                if (event.key === "Escape" &&
                    document.activeElement === input) {

                    if (input.value) {
                        clearTableSearch();
                    } else {
                        input.blur();
                    }

                }

            }
        );


        // ==========================================
        // CHANGE RECORDS PER PAGE
        // ==========================================

        function changeRecordsPerPage() {

            recordsPerPage = parseInt(
                document.getElementById(
                    "recordsPerPage"
                ).value
            );

            currentPage = 1;

            renderTable();

        }


        // ==========================================
        // GO TO PAGE
        // ==========================================

        function goToPage(page) {

            currentPage = page;

            renderTable();

        }


        // ==========================================
        // RENDER TABLE
        // ==========================================

        function renderTable() {

            var searchValue =
                document.getElementById(
                    "tableSearch"
                ).value
                .toLowerCase()
                .trim();


            var rows =
                document.querySelectorAll(
                    "#dataTable tbody tr"
                );


            var filteredRows = [];


            for (var i = 0; i < rows.length; i++) {

                // Skip the "no records" placeholder rows;
                // they are never real data rows.
                if (
                    rows[i].classList.contains(
                        "no-data-row"
                    )
                ) {
                    continue;
                }

                var searchData =
                    rows[i]
                        .getAttribute(
                            "data-search"
                        )
                        .toLowerCase();


                if (
                    searchData.indexOf(
                        searchValue
                    ) !== -1
                ) {
                    filteredRows.push(rows[i]);
                }

            }


            totalRecords = filteredRows.length;


            // ---- Search count chip + clear button state ----

            var countChip =
                document.getElementById(
                    "searchCount"
                );

            if (countChip) {

                var dataRowCount = 0;

                for (var c = 0; c < rows.length; c++) {

                    if (!rows[c].classList.contains(
                            "no-data-row")) {

                        dataRowCount++;

                    }

                }

                countChip.innerText =
                    filteredRows.length +
                    " / " +
                    dataRowCount;

            }

            var searchClear =
                document.getElementById(
                    "tableSearchClear"
                );

            if (searchClear) {

                searchClear.hidden = !searchValue;

            }


            var totalPages =
                Math.ceil(
                    totalRecords / recordsPerPage
                );


            if (currentPage > totalPages) {
                currentPage =
                    totalPages > 0
                        ? totalPages
                        : 1;
            }


            var startIndex =
                (currentPage - 1)
                * recordsPerPage;


            var endIndex =
                startIndex + recordsPerPage;


            if (endIndex > totalRecords) {
                endIndex = totalRecords;
            }


            for (var j = 0; j < rows.length; j++) {
                rows[j].style.display = "none";
            }


            for (
                var k = startIndex;
                k < endIndex;
                k++
            ) {
                filteredRows[k].style.display = "";
            }


            // "No Records Found on this filter" message
            // when the search filter matches nothing.

            var noRecordsRow =
                document.getElementById(
                    "noRecordsRow"
                );

            if (noRecordsRow) {

                noRecordsRow.style.display =
                    filteredRows.length === 0
                        ? ""
                        : "none";

            }


            // ---- Empty-state message: search vs filter ----

            var noRecordsTitle =
                document.getElementById(
                    "noRecordsTitle"
                );

            var noRecordsSub =
                document.getElementById(
                    "noRecordsSub"
                );

            var noRecordsAction =
                document.getElementById(
                    "noRecordsAction"
                );

            if (noRecordsTitle) {

                if (searchValue) {

                    noRecordsTitle.textContent =
                        "No matching tickets";

                    if (noRecordsSub) {
                        noRecordsSub.textContent =
                            "Search se koi ticket match nahi hua. Spelling check karein ya search clear karein.";
                    }

                    if (noRecordsAction) {
                        noRecordsAction.textContent =
                            "Clear search";
                    }

                } else {

                    noRecordsTitle.textContent =
                        "No tickets found";

                    if (noRecordsSub) {
                        noRecordsSub.textContent =
                            "Is filter ke liye koi record nahi hai.";
                    }

                    if (noRecordsAction) {
                        noRecordsAction.textContent =
                            "Clear filters";
                    }

                }

            }


            // ---- Highlight search matches in visible rows ----

            highlightSearch(searchValue);


            updateTableInfo(
                startIndex + 1,
                endIndex,
                totalRecords
            );


            renderPagination(totalPages);

        }


        // ==========================================
        // UPDATE TABLE INFO
        // ==========================================

        function updateTableInfo(
            start,
            end,
            total
        ) {

            var infoElement =
                document.getElementById(
                    "tableInfo"
                );


            if (total === 0) {
                infoElement.innerText =
                    "Showing 0 to 0 of 0 entries";
            } else {
                infoElement.innerText =
                    "Showing "
                    + start
                    + " to "
                    + end
                    + " of "
                    + total
                    + " entries";
            }

        }


        // ==========================================
        // RENDER PAGINATION
        // ==========================================

        function renderPagination(
            totalPages
        ) {

            var paginationElement =
                document.getElementById(
                    "pagination"
                );

            if (!paginationElement) {
                return;
            }


            var isPhone =
                window.matchMedia(
                    "(max-width: 700px)"
                ).matches;


            var html = "";


            // PREVIOUS BUTTON

            if (currentPage <= 1) {
                html +=
                    '<button class="page-btn" disabled>← Prev</button>';
            } else {
                html +=
                    '<button class="page-btn" onclick="goToPage('
                    + (currentPage - 1)
                    + ')">← Prev</button>';
            }


            // PAGE NUMBERS (windowed: 1 … 4 5 6 … 20)

            if (isPhone) {

                html +=
                    '<span class="page-info">'
                    + (totalPages === 0 ? 0 : currentPage)
                    + ' / '
                    + totalPages
                    + '</span>';

            } else {

                var pages =
                    windowedPages(
                        currentPage,
                        totalPages
                    );

                for (
                    var i = 0;
                    i < pages.length;
                    i++
                ) {

                    var page = pages[i];

                    if (page === "...") {

                        html +=
                            '<span class="page-gap">…</span>';

                    } else if (page === currentPage) {

                        html +=
                            '<button class="page-btn active">'
                            + page
                            + '</button>';

                    } else {

                        html +=
                            '<button class="page-btn" onclick="goToPage('
                            + page
                            + ')">'
                            + page
                            + '</button>';

                    }

                }

            }


            // NEXT BUTTON

            if (
                totalPages === 0
                || currentPage >= totalPages
            ) {
                html +=
                    '<button class="page-btn" disabled>Next →</button>';
            } else {
                html +=
                    '<button class="page-btn" onclick="goToPage('
                    + (currentPage + 1)
                    + ')">Next →</button>';
            }


            paginationElement.innerHTML = html;

        }


        // Page numbers ke beech ellipsis (bade page counts ke liye).
        function windowedPages(current, total) {

            var out = [];

            if (total <= 7) {

                for (var i = 1; i <= total; i++) {
                    out.push(i);
                }

                return out;

            }

            out.push(1);

            var start = Math.max(2, current - 1);

            var end = Math.min(total - 1, current + 1);

            if (start > 2) {
                out.push("...");
            }

            for (var j = start; j <= end; j++) {
                out.push(j);
            }

            if (end < total - 1) {
                out.push("...");
            }

            out.push(total);

            return out;

        }


        // ==========================================
        // EMPTY STATE ACTION
        // ==========================================

        function resetEmptyState() {

            var input =
                document.getElementById(
                    "tableSearch"
                );

            if (input && input.value) {

                clearTableSearch();

                return;

            }

            window.location.href = supportBaseUrl;

        }


        // ==========================================
        // SEARCH MATCH HIGHLIGHT
        // ==========================================

        function clearSearchHighlights() {

            var marks =
                document.querySelectorAll(
                    "#dataTable mark.search-hit"
                );

            for (var i = 0; i < marks.length; i++) {

                var mark = marks[i];

                var parent = mark.parentNode;

                if (!parent) {
                    continue;
                }

                parent.replaceChild(
                    document.createTextNode(
                        mark.textContent),
                    mark);

                parent.normalize();

            }

        }


        function highlightSearch(term) {

            clearSearchHighlights();

            if (!term) {
                return;
            }

            var needle = term.toLowerCase();

            var rows =
                document.querySelectorAll(
                    "#dataTable tbody tr:not(.no-data-row)"
                );

            for (var r = 0; r < rows.length; r++) {

                if (rows[r].style.display === "none") {
                    continue;
                }

                var cells =
                    rows[r].querySelectorAll("td");

                for (var c = 0; c < cells.length; c++) {

                    highlightNode(cells[c], needle);

                }

            }

        }


        function highlightNode(root, needle) {

            if (!root || needle.length === 0) {
                return;
            }

            var walker =
                document.createTreeWalker(
                    root,
                    NodeFilter.SHOW_TEXT,
                    {
                        acceptNode: function (node) {

                            if (!node.nodeValue
                                || !node.nodeValue.trim()) {

                                return NodeFilter.FILTER_REJECT;

                            }

                            var tag = node.parentNode
                                ? node.parentNode.nodeName
                                : "";

                            if (tag === "MARK"
                                || tag === "SCRIPT"
                                || tag === "STYLE") {

                                return NodeFilter.FILTER_REJECT;

                            }

                            return NodeFilter.FILTER_ACCEPT;

                        }
                    },
                    false
                );

            var nodes = [];

            while (walker.nextNode()) {
                nodes.push(walker.currentNode);
            }

            for (var i = 0; i < nodes.length; i++) {

                var node = nodes[i];

                var text = node.nodeValue;

                var index =
                    text.toLowerCase().indexOf(needle);

                if (index === -1) {
                    continue;
                }

                var range = document.createRange();

                range.setStart(node, index);
                range.setEnd(node, index + needle.length);

                var mark = document.createElement("mark");

                mark.className = "search-hit";

                try {
                    range.surroundContents(mark);
                } catch (e) {
                    // Kuch nodes (split text) safe taur par skip.
                }

            }

        }


        // ==========================================
        // KPI COUNT-UP
        // ==========================================

        function animateKpiCounters() {

            if (window.matchMedia(
                    "(prefers-reduced-motion: reduce)"
                ).matches) {

                return;

            }

            var nodes =
                document.querySelectorAll("[data-kpi]");

            for (var i = 0; i < nodes.length; i++) {

                (function (node) {

                    var target = parseInt(
                        (node.textContent || "")
                            .replace(/[^\d-]/g, ""),
                        10
                    );

                    if (isNaN(target) || target <= 0) {
                        return;
                    }

                    var start = null;

                    var duration = 850;

                    node.textContent = "0";

                    function step(now) {

                        if (start === null) {
                            start = now;
                        }

                        var progress =
                            Math.min(
                                1,
                                (now - start) / duration
                            );

                        var eased =
                            1 - Math.pow(1 - progress, 3);

                        node.textContent =
                            Math.round(target * eased);

                        if (progress < 1) {
                            requestAnimationFrame(step);
                        }

                    }

                    requestAnimationFrame(step);

                })(nodes[i]);

            }

        }


        // ==========================================
        // SORT TABLE
        // ==========================================

        function sortTable(th) {

            masterSortTable(th);

            currentPage = 1;

            renderTable();

        }


        // ==========================================
        // MOBILE SORT (header is hidden on phones)
        // ==========================================

        function mobileSortTable() {

            var select =
                document.getElementById("mobileSort");

            if (!select || select.value === "") {
                return;
            }

            var index = parseInt(select.value);

            var headers =
                document.querySelectorAll(
                    "#dataTable thead th.sortable"
                );

            if (headers[index]) {

                masterSortTable(headers[index]);

                currentPage = 1;

                renderTable();

            }

        }


        // ==========================================
        // INIT
        // ==========================================

        document.addEventListener(
            "DOMContentLoaded",
            function () {
                renderTable();
                animateKpiCounters();
            }
        );

        // Phone <-> desktop breakpoint par pagination ka format badalta
        // hai (numbers vs "Page x / y"), isliye resize par re-render.
        var resizeTimer = null;

        window.addEventListener("resize", function () {

            if (resizeTimer) {
                clearTimeout(resizeTimer);
            }

            resizeTimer = setTimeout(
                function () {
                    renderTable();
                },
                150
            );

        });


        // ==========================================
        // EXPORT EXCEL
        // ==========================================

        function exportExcel() {

            var table =
                document.getElementById(
                    "dataTable"
                );

            var rows =
                table.querySelectorAll("tr");

            var data = [];


            for (var i = 0; i < rows.length; i++) {

                if (
                    rows[i].style.display === "none"
                ) {
                    continue;
                }


                var cells =
                    rows[i].querySelectorAll(
                        "th, td"
                    );

                var rowData = [];


                for (
                    var j = 0;
                    j < cells.length;
                    j++
                ) {

                    if (
                        j === cells.length - 1
                    ) {
                        continue;
                    }


                    rowData.push(
                        cells[j].innerText.trim()
                    );

                }


                if (rowData.length > 0) {
                    data.push(rowData);
                }

            }


            var worksheet =
                XLSX.utils.aoa_to_sheet(data);


            var workbook =
                XLSX.utils.book_new();


            XLSX.utils.book_append_sheet(
                workbook,
                worksheet,
                "Supports"
            );


            XLSX.writeFile(
                workbook,
                "Supports_Data.xlsx"
            );

        }


        // ==========================================
        // EXPORT CSV
        // ==========================================

        function exportCSV() {

            var table =
                document.getElementById(
                    "dataTable"
                );

            var rows =
                table.querySelectorAll("tr");

            var csvContent = "";


            for (var i = 0; i < rows.length; i++) {

                if (
                    rows[i].style.display === "none"
                ) {
                    continue;
                }


                var cells =
                    rows[i].querySelectorAll(
                        "th, td"
                    );

                var rowData = [];


                for (
                    var j = 0;
                    j < cells.length;
                    j++
                ) {

                    if (
                        j === cells.length - 1
                    ) {
                        continue;
                    }


                    var text =
                        cells[j].innerText
                            .trim();

                    text = text.replace(
                        /"/g,
                        '""'
                    );

                    rowData.push(
                        '"' + text + '"'
                    );

                }


                if (rowData.length > 0) {
                    csvContent +=
                        rowData.join(",")
                        + "\r\n";
                }

            }


            var blob = new Blob(
                [csvContent],
                {
                    type:
                        "text/csv;charset=utf-8;"
                }
            );


            var link =
                document.createElement("a");


            link.href =
                URL.createObjectURL(blob);


            link.download =
                "Supports_Data.csv";


            link.click();

        }


        // ==========================================
        // PRINT TABLE
        // ==========================================

        function printTable() {

            var table =
                document.getElementById(
                    "dataTable"
                );


            var printWindow =
                window.open("", "_blank");


            printWindow.document.write(
                '<html><head>'
                + '<title>Daily Support Data</title>'
                + '<style>'
                + 'body { font-family: Arial, sans-serif; padding: 20px; }'
                + 'h1 { font-size: 22px; margin-bottom: 15px; }'
                + 'table { width: 100%; border-collapse: collapse; }'
                + 'th, td { padding: 10px; text-align: left; border-bottom: 1px solid #ddd; }'
                + 'th { background: #f3f4f6; font-size: 13px; }'
                + 'td { font-size: 13px; }'
                + '</style>'
                + '</head><body>'
            );


            printWindow.document.write(
                '<h1>Daily Support Data</h1>'
            );


            printWindow.document.write(
                '<table>'
            );


            // THEAD

            var thead =
                table.querySelector("thead");


            if (thead) {

                printWindow.document.write(
                    "<thead>"
                    + thead.innerHTML
                    + "</thead>"
                );

            }


            // TBODY - only visible rows

            printWindow.document.write(
                "<tbody>"
            );


            var tbodyRows =
                table.querySelectorAll(
                    "tbody tr"
                );


            for (
                var i = 0;
                i < tbodyRows.length;
                i++
            ) {

                if (
                    tbodyRows[i].style.display
                    !== "none"
                ) {

                    var cells =
                        tbodyRows[i]
                            .querySelectorAll("td");

                    var filteredCells = [];


                    for (
                        var j = 0;
                        j < cells.length;
                        j++
                    ) {

                        var cellButtons =
                            cells[j]
                                .querySelector(
                                    "button"
                                );


                        if (
                            cellButtons === null
                        ) {
                            filteredCells.push(
                                "<td>"
                                + cells[j]
                                    .innerHTML
                                + "</td>"
                            );
                        }

                    }


                    printWindow.document.write(
                        "<tr>"
                        + filteredCells
                            .join("")
                        + "</tr>"
                    );

                }

            }


            printWindow.document.write(
                "</tbody></table>"
            );


            printWindow.document.write(
                "</body></html>"
            );


            printWindow.document.close();


            printWindow.print();

        }


        // ==========================================
        // AUTO DISMISS MESSAGES
        // ==========================================

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                var messages =
                    document.querySelectorAll(
                        ".success-message, .error-message"
                    );


                for (
                    var i = 0;
                    i < messages.length;
                    i++
                ) {

                    (function (message) {

                        setTimeout(
                            function () {

                                message.style.transition =
                                    "opacity 0.5s ease";

                                message.style.opacity = "0";


                                setTimeout(
                                    function () {
                                        message.remove();
                                    },
                                    500
                                );

                            },
                            3000
                        );

                    })(messages[i]);

                }

            }
        );


        // ==========================================
        // VOICE TO TEXT - DESCRIPTION / REMARKS
        // ==========================================

        var recognition = null;
        var isRecording = false;
        var speechBaseText = "";
        var speechFinal = "";
        var voiceField = "Description";


        function speechSupported() {

            return (
                "webkitSpeechRecognition" in window
                || "SpeechRecognition" in window
            );

        }


        function setListening(on) {

            var micBtn =
                document.getElementById(
                    "voiceMicBtn_" + voiceField
                );

            var status =
                document.getElementById(
                    "voiceStatus_" + voiceField
                );

            var stopBtn =
                document.getElementById(
                    "voiceStopBtn_" + voiceField
                );


            if (micBtn) {

                if (on) {
                    micBtn.classList.add(
                        "is-recording"
                    );
                } else {
                    micBtn.classList.remove(
                        "is-recording"
                    );
                }

            }

            if (stopBtn) {
                stopBtn.disabled = !on;
            }


            if (status) {

                if (on) {
                    status.innerText =
                        "Listening... the mic stays open until you click Stop";
                    status.classList.add("visible");
                } else {
                    status.classList.remove("visible");
                }

            }

        }


        function statusPillClass(status) {

            switch (status) {

                case "Closed":
                    return "badge-completed";

                case "Open":
                    return "badge-open";

                case "In Progress":
                    return "badge-inprogress";

                case "On Hold":
                    return "badge-onhold";

                case "Pending":
                    return "badge-pending";

                case "Cancelled":
                    return "badge-cancelled";

                default:
                    return "badge-default";

            }

        }


        function setStatusBadge(el, status) {

            if (!el) {
                return;
            }

            el.className =
                "status-pill " + statusPillClass(status);

            el.innerText =
                (status && status.length > 0)
                    ? status
                    : "—";

        }


        function updateCurrentStatus() {

            var select =
                document.getElementById("edit_Status");

            var badge =
                document.getElementById("curStatusBadge");

            if (!select || !badge) {
                return;
            }

            setStatusBadge(badge, select.value || "");

            // Modal header ka status pill + stepper bhi update.
            setStatusBadge(
                document.getElementById(
                    "modalStatusPill"
                ),
                select.value || ""
            );

            updateStatusStepper(select.value || "");

        }


        // ==========================================
        // STATUS STEPPER
        // Open -> In Progress -> On Hold -> Closed
        // ==========================================

        function statusStepIndex(status) {

            var s = (status || "").toLowerCase();

            if (!s) {
                return -1;
            }

            if (s.indexOf("open") !== -1) {
                return 0;
            }

            if (s.indexOf("progress") !== -1) {
                return 1;
            }

            if (s.indexOf("hold") !== -1 ||
                s.indexOf("pending") !== -1) {
                return 2;
            }

            if (s.indexOf("clos") !== -1 ||
                s.indexOf("resolv") !== -1) {
                return 3;
            }

            return -1;
        }


        function updateStatusStepper(status) {

            var stepper =
                document.getElementById(
                    "statusStepper"
                );

            if (!stepper) {
                return;
            }

            var steps =
                stepper.querySelectorAll(".tkt-step");

            var current = statusStepIndex(status);

            for (var i = 0; i < steps.length; i++) {

                steps[i].classList.remove(
                    "done", "current");

                if (current < 0) {
                    continue;
                }

                if (i < current) {
                    steps[i].classList.add("done");
                } else if (i === current) {
                    steps[i].classList.add("current");
                }

            }

        }


        // ==========================================
        // GENERIC "OTHER" OPTION TOGGLES
        // ==========================================

        function hasOtherOption(element) {

            for (
                var i = 0;
                i < element.options.length;
                i++
            ) {

                if (
                    element.options[i].value === "Other"
                ) {
                    return true;
                }

            }

            return false;

        }


        function toggleOtherField(select) {

            var name = select.id.replace(
                /^edit_/,
                ""
            );

            var group =
                document.getElementById(
                    "other" + name + "Group"
                );

            var input =
                document.getElementById(
                    "edit_Other" + name
                );

            var isOther =
                select !== null
                && select.value === "Other";

            if (group) {

                group.style.display =
                    isOther ? "" : "none";

            }

            if (input) {

                input.required = isOther ? true : false;

            }

        }


        function fillOtherOption(element, rawValue) {

            var otherValue = "";
            var otherPrefix = "Other - ";

            if (
                rawValue.indexOf(otherPrefix) === 0
            ) {

                otherValue =
                    rawValue.substring(
                        otherPrefix.length
                    );

                rawValue = "Other";

            } else {

                var knownOption = false;

                for (
                    var i = 0;
                    i < element.options.length;
                    i++
                ) {

                    if (
                        element.options[i].value
                            === rawValue
                    ) {
                        knownOption = true;
                        break;
                    }

                }

                if (!knownOption
                    && rawValue.length > 0) {

                    otherValue = rawValue;

                    rawValue = "Other";

                }

            }

            element.value = rawValue;

            var name = element.id.replace(
                /^edit_/,
                ""
            );

            var otherInput =
                document.getElementById(
                    "edit_Other" + name
                );

            if (otherInput) {

                otherInput.value = otherValue;

            }

            toggleOtherField(element);

        }


        function applySpeechText(textarea, interim) {

            var parts = [];

            if (speechBaseText.length > 0) {
                parts.push(speechBaseText);
            }

            if (speechFinal.trim().length > 0) {
                parts.push(speechFinal.trim());
            }

            if (interim.trim().length > 0) {
                parts.push(interim.trim());
            }

            textarea.value = parts.join(" ");

        }


        function startVoice(fieldName) {

            if (fieldName) {
                voiceField = fieldName;
            }

            var textarea =
                document.getElementById(
                    "edit_" + voiceField
                );


            if (!speechSupported()) {

                alert(
                    "Speech Recognition is not supported in this browser. " +
                    "Please use Google Chrome."
                );

                return;

            }


            var SpeechRecognition =
                window.SpeechRecognition
                || window.webkitSpeechRecognition;

            recognition =
                new SpeechRecognition();

            recognition.lang = "en-IN";

            recognition.interimResults = true;

            recognition.continuous = true;

            recognition.maxAlternatives = 1;


            recognition.onstart = function () {

                isRecording = true;

                speechBaseText =
                    textarea.value.trim();

                speechFinal = "";

                setListening(true);

                textarea.focus();

            };


            recognition.onresult = function (event) {

                var interimText = "";


                for (
                    var i = event.resultIndex;
                    i < event.results.length;
                    i++
                ) {

                    var result = event.results[i];

                    if (result.isFinal) {
                        speechFinal +=
                            " " + result[0].transcript;
                    } else {
                        interimText +=
                            result[0].transcript;
                    }

                }


                applySpeechText(
                    textarea,
                    interimText
                );

            };


            recognition.onerror = function (event) {

                if (
                    event.error === "not-allowed"
                    || event.error ===
                        "service-not-allowed"
                ) {

                    alert(
                        "Microphone permission denied. " +
                        "Please allow microphone access."
                    );

                } else if (
                    event.error === "no-speech"
                ) {

                    alert(
                        "No speech detected. " +
                        "Please try again."
                    );

                } else {

                    alert(
                        "Speech recognition error: "
                        + event.error
                    );

                }

                isRecording = false;

                setListening(false);

            };


            recognition.onend = function () {

                isRecording = false;

                setListening(false);

            };


            try {

                recognition.start();

            } catch (error) {

                alert(
                    "Could not start speech recognition: "
                    + error.message
                );

            }

        }


        function stopVoice() {

            if (recognition) {

                recognition.stop();

            }

            isRecording = false;

            setListening(false);

        }


        function resetVoice(fieldName) {

            if (fieldName) {
                voiceField = fieldName;
            }

            if (
                !confirm(
                    "Are you sure you want to clear " + voiceField + "?"
                )
            ) {
                return;
            }

            // Speech bhi stop ho jaye
            if (recognition) {

                recognition.stop();

            }

            isRecording = false;

            setListening(false);

            speechBaseText = "";
            speechFinal = "";

            document.getElementById(
                "edit_" + voiceField
            ).value = "";

        }


        // ==========================================
        // MODAL
        // ==========================================

        function toDateInputValue(value) {

            if (!value) {
                return "";
            }

            var trimmed = String(value).trim();

            if (/^\d{4}-\d{2}-\d{2}$/.test(trimmed)) {
                return trimmed;
            }

            var match =
                trimmed.match(
                    /^(\d{2})\/(\d{2})\/(\d{4})/
                );

            return match
                ? match[3] + "-" + match[2] + "-" + match[1]
                : "";

        }


        function toTimeInputValue(value) {

            var match =
                value.match(
                    /^(\d{1,2}):(\d{2})\s*([AP]M)$/i
                );

            if (!match) {
                return "";
            }

            var hours =
                parseInt(match[1], 10) % 12;

            if (/pm/i.test(match[3])) {
                hours += 12;
            }

            return (
                (hours < 10 ? "0" + hours : hours)
                + ":"
                + match[2]
            );

        }


        function openEditModal(btn) {

            var data =
                JSON.parse(
                    btn.getAttribute("data-json")
                );


            document.getElementById(
                "modalTitle"
            ).innerText = "Edit Support";


            document.getElementById(
                "btnSubmitLabel"
            ).innerText = "Update";


            var form =
                document.getElementById(
                    "supportForm"
                );

            form.action = editUrl;

            form.reset();


            var elements =
                form.querySelectorAll(
                    "input[name], select[name], textarea[name]"
                );


            for (
                var i = 0;
                i < elements.length;
                i++
            ) {

                var element = elements[i];

                var name =
                    element.getAttribute(
                        "name"
                    );

                if (!name) {
                    continue;
                }


                var key = null;

                for (var fieldName in data) {

                    if (
                        data.hasOwnProperty(fieldName)
                        && fieldName.toLowerCase()
                           === name.toLowerCase()
                    ) {
                        key = fieldName;
                        break;
                    }

                }


                if (!key) {
                    continue;
                }

                var rawValue = data[key];


                // Selects expose the raw id as a *_key value;
                // prefer it over the joined display name.
                if (element.tagName === "SELECT") {

                    var keyVariant = name.toLowerCase() + "_key";

                    for (var f in data) {

                        if (
                            data.hasOwnProperty(f)
                            && f.toLowerCase()
                               === keyVariant
                        ) {
                            rawValue = data[f];
                            break;
                        }

                    }

                }


                if (
                    element.tagName === "SELECT"
                    && hasOtherOption(element)
                ) {

                    fillOtherOption(
                        element,
                        rawValue
                    );

                    continue;

                }


                if (element.type === "date") {

                    element.value =
                        toDateInputValue(rawValue);

                } else if (element.type === "time") {

                    element.value =
                        toTimeInputValue(rawValue);

                } else {

                    element.value = rawValue;

                }

            }


            setStatusBadge(
                document.getElementById(
                    "prevStatusBadge"
                ),
                data["Status"] || ""
            );


            // ---- Modal header: ticket no + client name ----

            var ticketNo = data["TicketNo"] || "";

            var clientName = data["ClientId"] || "";

            var ticketLabel =
                document.getElementById("modalTicketNo");

            var clientLabel =
                document.getElementById("modalClientName");

            if (ticketLabel) {
                ticketLabel.innerText =
                    ticketNo
                        ? "Ticket #" + ticketNo
                        : "Ticket";
            }

            if (clientLabel) {
                clientLabel.innerText =
                    clientName || "—";
            }


            updateCurrentStatus();

            document.getElementById(
                "supportModal"
            ).style.display = "flex";

        }


        function closeModal() {

            stopVoice();

            document.getElementById(
                "supportModal"
            ).style.display = "none";

        }


        window.onclick = function (event) {

            const modal =
                document.getElementById(
                    "supportModal"
                );


            if (event.target === modal) {

                closeModal();

            }

        };


        document.addEventListener('DOMContentLoaded', function () {

            masterBindModalSubmit(
                "supportForm",
                closeModal
            );

        });


        // ---- Filter bar maximize / minimize ----
        // Whole header row is clickable (pills + toggle button excluded).
        document.addEventListener('DOMContentLoaded', function () {

            var card = document.getElementById('tktFilterCard');
            var head = document.getElementById('tktFilterHead');
            var toggle = document.getElementById('tktFilterToggle');

            if (!card || !toggle) {
                return;
            }

            if (card.dataset.toggleBound === '1') {
                return;
            }

            card.dataset.toggleBound = '1';

            function sync() {

                var collapsed = card.classList.contains('collapsed');

                toggle.textContent = collapsed ? '+' : '\u2212';

                toggle.setAttribute(
                    'aria-expanded',
                    collapsed ? 'false' : 'true');
            }

            function flip() {

                card.classList.toggle('collapsed');

                sync();
            }

            toggle.addEventListener('click', function (e) {

                e.preventDefault();
                e.stopPropagation();

                flip();
            });

            if (head) {
                head.addEventListener('click', function (e) {

                    // Pills, chips aur links apna kaam karein.
                    if (e.target.closest('.tkt-quick-pills')
                        || e.target.closest('.tkt-filter-chips')
                        || e.target.closest('a, button, select, input')) {
                        return;
                    }

                    flip();
                });
            }

            // Phone / chhote tablet: filters collapsed start hote hain,
            // active filter chips header me phir bhi dikhte hain.
            if (window.matchMedia('(max-width: 900px)').matches) {
                card.classList.add('collapsed');
            }

            sync();

        });


        // ==========================================================
        // FILTER CASCADE — Status <-> Assigned To <-> Priority
        //
        // Teeno dropdown aapas me connected hain:
        //   • User chuno      -> Status/Priority sirf us user ke
        //   • Priority chuno  -> User/Status sirf us priority ke
        //   • Status chuno    -> User/Priority sirf us status ke
        //
        // Data server se aata hai (real tickets ke combos,
        // data-with-* attributes me). "All" (value="") hamesha
        // available rehta hai. Options delete nahi hote, sirf
        // hide hote hain — taake filter hataane par poora list
        // wapas aa jaaye.
        //
        // Design: ek hi delegated 'change' listener (document pe),
        // jo har baar live DOM se selects re-query karta hai.
        // Isse soft-navigation ke baad bhi kaam karta hai aur
        // purane elements ka stale closure nahi rehta.
        // ==========================================================

        (function () {

            var RULES = {
                filterStatusId: [
                    ['filterAssignedTo', 'withUser'],
                    ['filterPriorityId', 'withPriority']
                ],
                filterAssignedTo: [
                    ['filterStatusId', 'withStatus'],
                    ['filterPriorityId', 'withPriority']
                ],
                filterPriorityId: [
                    ['filterStatusId', 'withStatus'],
                    ['filterAssignedTo', 'withUser']
                ]
            };

            function liveSelects() {

                return Array.prototype.slice.call(
                    document.querySelectorAll('select[data-ds-cascade]'));
            }

            // "1,5,6" me value hai ya nahi.
            // Khaali attr = us relation me kuch nahi -> match nahi.
            // (Parent khali ho to isAllowed rule skip karta hai.)
            function inList(csv, value) {

                if (!csv) {
                    return false;
                }

                return csv.split(',').indexOf(value) !== -1;
            }

            // Original list snapshot — element pe cache.
            function snapshotOf(sel) {

                if (!sel.__dsSnapshot) {

                    sel.__dsSnapshot =
                        Array.prototype.slice.call(
                            sel.querySelectorAll('option')).map(
                                function (opt) {

                                    return {
                                        value: opt.value,
                                        text: opt.textContent,
                                        withUser: opt.getAttribute('data-with-user') || '',
                                        withStatus: opt.getAttribute('data-with-status') || '',
                                        withPriority: opt.getAttribute('data-with-priority') || ''
                                    };
                                });
                }

                return sel.__dsSnapshot;
            }

            function isAllowed(opt, rules, current) {

                // "All ..." hamesha allowed.
                if (opt.value === '') {
                    return true;
                }

                for (var i = 0; i < rules.length; i++) {

                    var parentValue = current[rules[i][0]];

                    // Parent khali = koi constraint nahi.
                    if (!parentValue) {
                        continue;
                    }

                    if (!inList(opt[rules[i][1]], parentValue)) {
                        return false;
                    }
                }

                return true;
            }

            function currentSelection(selects) {

                var out = {};

                selects.forEach(function (sel) {

                    if (sel.value) {
                        out[sel.id] = sel.value;
                    }
                });

                return out;
            }

            function prune() {

                var selects = liveSelects();

                if (selects.length === 0) {
                    return;
                }

                var current = currentSelection(selects);

                selects.forEach(function (sel) {

                    var items = snapshotOf(sel);

                    var rules = RULES[sel.id] || [];

                    var previous = sel.value;

                    sel.innerHTML = '';

                    items.forEach(function (item) {

                        var opt = document.createElement('option');

                        opt.value = item.value;
                        opt.textContent = item.text;

                        if (item.withUser) {
                            opt.setAttribute('data-with-user', item.withUser);
                        }

                        if (item.withStatus) {
                            opt.setAttribute('data-with-status', item.withStatus);
                        }

                        if (item.withPriority) {
                            opt.setAttribute('data-with-priority', item.withPriority);
                        }

                        if (!isAllowed(item, rules, current)) {
                            opt.hidden = true;
                            opt.disabled = true;
                        }

                        sel.appendChild(opt);
                    });

                    // Purani selection ab allowed nahi to "All" pe reset.
                    if (previous !== '') {

                        var found = false;

                        for (var i = 0; i < sel.options.length; i++) {

                            if (sel.options[i].value === previous &&
                                !sel.options[i].hidden) {
                                found = true;
                                break;
                            }
                        }

                        sel.value = found ? previous : '';
                    }
                });
            }

            // Delegated listener — ek hi baar. Soft-nav safe.
            if (!window.__dsCascadeBound) {

                window.__dsCascadeBound = true;

                document.addEventListener('change', function (e) {

                    var sel = e.target.closest(
                        'select[data-ds-cascade]');

                    if (!sel) {
                        return;
                    }

                    prune();
                });
            }

            document.addEventListener(
                'DOMContentLoaded',
                prune);

            // Pehla pass (agar DOM pehle se ready ho).
            prune();

        })();

    </script>
}