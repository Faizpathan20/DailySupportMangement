@model Master.Models.DailySupportViewModel

@{
    ViewData["Title"] = "Daily Support";
    int totalRecords = Model.TotalRecords;

    var staticOptions = ViewBag.StaticOptions as Dictionary<string, string[]>
        ?? new Dictionary<string, string[]>();

    var dropdowns = ViewBag.Dropdowns as Dictionary<string, List<LookupOptionViewModel>>
        ?? new Dictionary<string, List<LookupOptionViewModel>>();

    var gridColumns = Model.Fields
        .Where(f => f.ShowInTable)
        .Select(f => new
        {
            f.Name,
            f.Display,
            f.Control,
            f.MaxLength,
            f.SortType,
            f.InputType,
            Sort = f.InputType == "time" ? "time" : f.SortType,
            Nowrap = !(f.Control == "textarea" || (f.MaxLength ?? 0) > 150)
        })
        .ToArray();

    string GetVal(string name)
        => Model.GetFormValue(name);

    string GetErr(string name)
        => Model.FieldError(name);

    string StatusPillClass(string status)
    {
        return status == "Completed"
            ? "badge-completed"
            : status == "Open"
                ? "badge-open"
                : status == "In Progress"
                    ? "badge-inprogress"
                    : status == "Pending"
                        ? "badge-pending"
                        : status == "Cancelled"
                            ? "badge-cancelled"
                            : "badge-default";
    }

    var placeholders = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["Subject"] = "Short subject",
        ["Description"] = "Client problem / request",
        ["Remarks"] = "Voice to text - click Mic and speak..."
    };
}


<div class="page-header">

    <div>

        <h1>
            Daily Support
        </h1>

        <p>
            Manage daily support records
        </p>

    </div>

</div>


<!-- ================= KPI CARDS ================= -->

<div class="dashboard-cards">


    <div class="dashboard-card">

        <div class="card-content">

            <p>
                Total Records
            </p>

            <h2 data-kpi="total">
                @Model.TotalRecords
            </h2>

        </div>

        <div class="card-icon">
            📊
        </div>

    </div>


    <div class="dashboard-card">

        <div class="card-content">

            <p>
                Open
            </p>

            <h2 data-kpi="open">
                @Model.OpenCount
            </h2>

        </div>

        <div class="card-icon">
            🔄
        </div>

    </div>


    <div class="dashboard-card">

        <div class="card-content">

            <p>
                In Progress
            </p>

            <h2 data-kpi="in-progress">
                @Model.InProgressCount
            </h2>

        </div>

        <div class="card-icon">
            ⏳
        </div>

    </div>


    <div class="dashboard-card">

        <div class="card-content">

            <p>
                Completed
            </p>

            <h2 data-kpi="completed">
                @Model.CompletedCount
            </h2>

        </div>

        <div class="card-icon">
            ✅
        </div>

    </div>


</div>


<!-- ================= MESSAGES ================= -->

@if (TempData["Success"] != null)
{
    <div class="success-message">

        @TempData["Success"]

    </div>
}


@if (TempData["Error"] != null)
{
    <div class="error-message">

        @Html.Raw(TempData["Error"])

    </div>
}


<!-- ================= SUPPORT SECTION ================= -->

<div class="state-section">




    <!-- ================= TABLE TOOLBAR ================= -->

    <div class="table-toolbar">

        <div class="toolbar-left">

            <select id="recordsPerPage"
                    onchange="changeRecordsPerPage()">

                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>

            </select>

            <span class="toolbar-label">
                records per page
            </span>

        </div>


        <div class="toolbar-center">

            <button type="button"
                    class="export-btn excel-btn"
                    onclick="exportExcel()">

                Excel

            </button>

            <button type="button"
                    class="export-btn csv-btn"
                    onclick="exportCSV()">

                CSV

            </button>

            <button type="button"
                    class="export-btn print-btn"
                    onclick="printTable()">

                Print

            </button>

        </div>


        <div class="toolbar-right">

            <span class="toolbar-label">
                Search:
            </span>

            <input type="text"
                   id="tableSearch"
                   placeholder="Search..."
                   oninput="filterTable()" />

            <a href="@Url.Action("Create", "DailySupport")"
               class="primary-btn">

                + Add Support

            </a>

        </div>

    </div>


    <!-- ================= TABLE ================= -->

    <div class="table-container support-table">

        <table id="dataTable">


            <thead>

                <tr>

                    @for (int i = 0; i < gridColumns.Length; i++)
                    {
                        var col = gridColumns[i];

                        string colClass =
                            col.Nowrap
                                ? "col-nowrap"
                                : "col-wrap";

                        <th class="sortable @colClass"
                            data-sort="@col.Sort"
                            onclick="sortTable(this)">

                            <span class="th-text">
                                @col.Display
                            </span>

                            <span class="sort-indicator">
                                <span class="sort-up"></span>
                                <span class="sort-down"></span>
                            </span>

                        </th>
                    }

                    <th class="actions-col">
                        Actions
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (Model.Supports.Count == 0)
                {
                    <tr class="no-data-row"
                        data-search="">

                        <td colspan="@(gridColumns.Length + 1)"
                            class="empty-state">

                            No Records Found on this filter.

                        </td>

                    </tr>
                }
                else
                {
                    @foreach (var support in Model.Supports)
                    {
                        var searchText = string.Join(
                            " ",
                            gridColumns.Select(
                                c => support.Get(c.Name)));

                        var statusValue = support.Get("Status");

                        string statusClass =
                            StatusPillClass(statusValue);

                        <tr data-search="@searchText">

                            @foreach (var col in gridColumns)
                            {
                                string tdClass =
                                    col.Nowrap
                                        ? "col-nowrap"
                                        : "col-wrap";

                                <td class="@tdClass">

                                    @if (col.Name == "Status")
                                    {
                                        <span class="status-pill @statusClass">
                                            @support.Get(col.Name)
                                        </span>
                                    }
                                    else
                                    {
                                        @support.Get(col.Name)
                                    }

                                </td>
                            }

                            <td>

                                <div class="action-cell">

                                    @{
                                        var rowJson =
                                            System.Text.Json
                                                .JsonSerializer
                                                .Serialize(
                                                    support.Values);
                                    }

                                    <button type="button"
                                            class="edit-btn action-btn"
                                            title="Edit"
                                            data-json="@rowJson"
                                            onclick="openEditModal(this)">

                                        ✎

                                    </button>

                                    <form asp-controller="DailySupport"
                                          asp-action="Delete"
                                          method="post"
                                          onsubmit="return masterConfirmAndSubmit(
                                              this,
                                              'Are you sure you want to delete this support record?'
                                          );">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@support.Get("Id")" />

                                        <button type="submit"
                                                class="delete-btn action-btn"
                                                title="Delete">

                                            ✕

                                        </button>

                                    </form>


                                </div>

                            </td>

                        </tr>
                    }
                }

                <!-- Client-side empty row: shown when the
                     search filter matches no rows. -->
                <tr id="noRecordsRow"
                    class="no-data-row"
                    data-search=""
                    style="display: none;">

                    <td colspan="@(gridColumns.Length + 1)"
                        class="empty-state">

                        No Records Found on this filter.

                    </td>

                </tr>

            </tbody>

        </table>

    </div>


    <!-- ================= TABLE FOOTER ================= -->

    <div class="table-footer">

        <div class="footer-left"
             id="tableInfo">

            Showing 1 to 10 of @totalRecords entries

        </div>


        <div class="footer-right"
             id="pagination">

        </div>

    </div>

</div>


<!-- ================= ADD / EDIT MODAL ================= -->

<div id="supportModal"
     class="modal">

    <div class="modal-content modal-wide">


        <div class="modal-header">

            <h2 id="modalTitle">
                Edit Support
            </h2>


            <button type="button"
                    class="modal-close"
                    onclick="closeModal()">

                &times;

            </button>

        </div>


        <form id="supportForm"
              method="post"
              action="@Url.Action("Create", "DailySupport")"
              novalidate>

            @Html.AntiForgeryToken()

            <input type="hidden"
                   id="editId"
                   name="id"
                   value="@GetVal("Id")" />


            <div class="form-grid">

                @foreach (var field in Model.FormFields)
                {
                    var options = field.Type == "options"
                        && staticOptions.TryGetValue(
                            field.Name,
                            out var opts)
                        ? opts
                        : Array.Empty<string>();

                    var hasOther = options.Contains(
                        "Other",
                        StringComparer.OrdinalIgnoreCase);

                    string fullClass =
                        field.Control == "textarea"
                            ? "form-group form-group-full"
                            : "form-group";

                    var placeholder =
                        placeholders.TryGetValue(
                            field.Name,
                            out var ph)
                        ? ph
                        : "";

                    if (field.Type == "options")
                    {
                        var onChange = new List<string>();

                        if (hasOther)
                        {
                            onChange.Add(
                                "toggleOtherField(this)");
                        }

                        if (field.Name == "Status")
                        {
                            onChange.Add(
                                "updateCurrentStatus()");
                        }

                        string onChangeAttr =
                            string.Join("; ", onChange);

                        <div class="@fullClass">

                            <label>
                                @field.Display
                            </label>

                            <select name="@field.Name"
                                    id="edit_@field.Name"
                                    onchange="@onChangeAttr"
                                    @(field.Required ? "required" : null)>

                                <option value=""
                                        disabled
                                        selected="@(string.IsNullOrWhiteSpace(GetVal(field.Name)))">
                                    -- Select @field.Display --
                                </option>

                                @foreach (var option in options)
                                {
                                    <option value="@option"
                                            selected="@(GetVal(field.Name) == option)">
                                        @option
                                    </option>
                                }

                            </select>

                            @if (!string.IsNullOrWhiteSpace(GetErr(field.Name)))
                            {
                                <span class="field-error">
                                    @GetErr(field.Name)
                                </span>
                            }

                            @if (hasOther)
                            {
                                <div id="other@(field.Name)Group"
                                     style="@(GetVal(field.Name) == "Other" ? "" : "display:none")">

                                    <label class="sub-label">
                                        Other @field.Display
                                    </label>

                                    <input type="text"
                                           name="Other@(field.Name)"
                                           id="edit_Other@(field.Name)"
                                           maxlength="92"
                                           placeholder="Specify other @field.Display.ToLower()"
                                           value="@GetVal("Other" + field.Name)"
                                           @(GetVal(field.Name) == "Other" ? "required" : null) />

                                    @if (!string.IsNullOrWhiteSpace(GetErr("Other" + field.Name)))
                                    {
                                        <span class="field-error">
                                            @GetErr("Other" + field.Name)
                                        </span>
                                    }

                                </div>
                            }

                            @if (field.Name == "Status")
                            {
                                <div class="status-tracker">

                                    <div class="status-tracker-row">

                                        <span class="status-tracker-label">
                                            Previous Status
                                        </span>

                                        <span id="prevStatusBadge"
                                              class="status-pill @StatusPillClass(Model.EditPreviousStatus)">
                                            @(string.IsNullOrWhiteSpace(Model.EditPreviousStatus) ? "—" : Model.EditPreviousStatus)
                                        </span>

                                    </div>

                                    <div class="status-tracker-row">

                                        <span class="status-tracker-label">
                                            Current Status
                                        </span>

                                        <span id="curStatusBadge"
                                              class="status-pill @StatusPillClass(GetVal("Status"))">
                                            @(string.IsNullOrWhiteSpace(GetVal("Status")) ? "—" : GetVal("Status"))
                                        </span>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else if (field.Control == "select")
                    {
                        var lookupOptions =
                            field.LookupKey != null
                            && dropdowns.TryGetValue(
                                field.LookupKey,
                                out var lopts)
                            ? lopts
                            : new List<LookupOptionViewModel>();

                        <div class="@fullClass">

                            <label>
                                @field.Display
                            </label>

                            <select name="@field.Name"
                                    id="edit_@field.Name"
                                    @(field.Required ? "required" : null)>

                                <option value=""
                                        disabled
                                        selected="@(string.IsNullOrWhiteSpace(GetVal(field.Name)))">
                                    -- Select @field.Display --
                                </option>

                                @foreach (var option in lookupOptions)
                                {
                                    <option value="@option.Id"
                                            selected="@(GetVal(field.Name) == option.Id.ToString())">
                                        @option.Name
                                    </option>
                                }

                            </select>

                            @if (!string.IsNullOrWhiteSpace(GetErr(field.Name)))
                            {
                                <span class="field-error">
                                    @GetErr(field.Name)
                                </span>
                            }

                        </div>
                    }
                    else if (field.Control == "textarea")
                    {
                        <div class="@fullClass">

                            <label>
                                @field.Display
                            </label>

                            <textarea id="edit_@field.Name"
                                      name="@field.Name"
                                      rows="2"
                                      placeholder="@placeholder"
                                      @(field.Required ? "required" : null)>@GetVal(field.Name)</textarea>

                            @if (!string.IsNullOrWhiteSpace(GetErr(field.Name)))
                            {
                                <span class="field-error">
                                    @GetErr(field.Name)
                                </span>
                            }

                            @if (field.Name == "Remarks")
                            {
                                <div class="voice-controls">

                                    <button type="button"
                                            class="voice-btn mic-btn"
                                            id="voiceMicBtn"
                                            onclick="startVoice()">

                                        Mic

                                    </button>

                                    <button type="button"
                                            class="voice-btn voice-stop"
                                            onclick="stopVoice()">

                                        Stop

                                    </button>

                                    <button type="button"
                                            class="voice-btn voice-reset"
                                            onclick="resetRemarks()">

                                        Reset

                                    </button>

                                </div>

                                <span class="voice-status"
                                      id="voiceStatus"></span>

                                <span class="voice-hint">
                                    Voice to Text: Mic se bolen, text Remarks ke end me jude ga. Mic tab tak open rahega jab tak Stop nahi click karte.
                                </span>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="@fullClass">

                            <label>
                                @field.Display
                            </label>

                            <input type="@field.InputType"
                                   id="edit_@field.Name"
                                   name="@field.Name"
                                   value="@GetVal(field.Name)"
                                   placeholder="@placeholder"
                                   @(field.Required ? "required" : null) />

                            @if (!string.IsNullOrWhiteSpace(GetErr(field.Name)))
                            {
                                <span class="field-error">
                                    @GetErr(field.Name)
                                </span>
                            }

                        </div>
                    }
                }

            </div>


            <span class="voice-hint auto-time-hint">
                Status rules: Open = optional fields. In Progress = Start Time required. Pending = Start + Remarks required, End Time blank. Completed = Start + End + Remarks required. Cancelled = Remarks required.
            </span>


            <div class="modal-actions">

                <button type="submit"
                        id="btnSubmit"
                        class="save-btn">

                    Save

                </button>

                <button type="button"
                        class="cancel-btn"
                        onclick="closeModal()">

                    Cancel

                </button>

            </div>

        </form>

    </div>

</div>


@if (Model.OpenEditModal)
{
    <script>

        // Modal ko server-side rendered values
        // + field errors ke saath auto open karo
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                var form =
                    document.getElementById(
                        "supportForm"
                    );

                form.action = editUrl;

                document.getElementById(
                    "modalTitle"
                ).innerText = "Edit Support";

                document.getElementById(
                    "btnSubmit"
                ).innerText = "Update";

                document.getElementById(
                    "supportModal"
                ).style.display = "flex";

            }
        );

    </script>
}


@section Scripts
{
    <script>

        // ==========================================
        // DAILY SUPPORT
        // ==========================================

        var currentPage = 1;
        var recordsPerPage = 10;
        var totalRecords = @totalRecords;

        var editUrl =
            "@Url.Action("Edit", "DailySupport")";


        // ==========================================
        // FILTER TABLE
        // ==========================================

        function filterTable() {

            currentPage = 1;

            renderTable();

        }


        // ==========================================
        // CHANGE RECORDS PER PAGE
        // ==========================================

        function changeRecordsPerPage() {

            recordsPerPage = parseInt(
                document.getElementById(
                    "recordsPerPage"
                ).value
            );

            currentPage = 1;

            renderTable();

        }


        // ==========================================
        // GO TO PAGE
        // ==========================================

        function goToPage(page) {

            currentPage = page;

            renderTable();

        }


        // ==========================================
        // RENDER TABLE
        // ==========================================

        function renderTable() {

            var searchValue =
                document.getElementById(
                    "tableSearch"
                ).value
                .toLowerCase()
                .trim();


            var rows =
                document.querySelectorAll(
                    "#dataTable tbody tr"
                );


            var filteredRows = [];


            for (var i = 0; i < rows.length; i++) {

                // Skip the "no records" placeholder rows;
                // they are never real data rows.
                if (
                    rows[i].classList.contains(
                        "no-data-row"
                    )
                ) {
                    continue;
                }

                var searchData =
                    rows[i]
                        .getAttribute(
                            "data-search"
                        )
                        .toLowerCase();


                if (
                    searchData.indexOf(
                        searchValue
                    ) !== -1
                ) {
                    filteredRows.push(rows[i]);
                }

            }


            totalRecords = filteredRows.length;


            var totalPages =
                Math.ceil(
                    totalRecords / recordsPerPage
                );


            if (currentPage > totalPages) {
                currentPage =
                    totalPages > 0
                        ? totalPages
                        : 1;
            }


            var startIndex =
                (currentPage - 1)
                * recordsPerPage;


            var endIndex =
                startIndex + recordsPerPage;


            if (endIndex > totalRecords) {
                endIndex = totalRecords;
            }


            for (var j = 0; j < rows.length; j++) {
                rows[j].style.display = "none";
            }


            for (
                var k = startIndex;
                k < endIndex;
                k++
            ) {
                filteredRows[k].style.display = "";
            }


            // "No Records Found on this filter" message
            // when the search filter matches nothing.

            var noRecordsRow =
                document.getElementById(
                    "noRecordsRow"
                );

            if (noRecordsRow) {

                noRecordsRow.style.display =
                    filteredRows.length === 0
                        ? ""
                        : "none";

            }


            updateTableInfo(
                startIndex + 1,
                endIndex,
                totalRecords
            );


            renderPagination(totalPages);

        }


        // ==========================================
        // UPDATE TABLE INFO
        // ==========================================

        function updateTableInfo(
            start,
            end,
            total
        ) {

            var infoElement =
                document.getElementById(
                    "tableInfo"
                );


            if (total === 0) {
                infoElement.innerText =
                    "Showing 0 to 0 of 0 entries";
            } else {
                infoElement.innerText =
                    "Showing "
                    + start
                    + " to "
                    + end
                    + " of "
                    + total
                    + " entries";
            }

        }


        // ==========================================
        // RENDER PAGINATION
        // ==========================================

        function renderPagination(
            totalPages
        ) {

            var paginationElement =
                document.getElementById(
                    "pagination"
                );


            var html = "";


            // PREVIOUS BUTTON

            if (currentPage === 1) {
                html +=
                    '<button class="page-btn" disabled>← Previous</button>';
            } else {
                html +=
                    '<button class="page-btn" onclick="goToPage('
                    + (currentPage - 1)
                    + ')">← Previous</button>';
            }


            // PAGE NUMBERS

            for (
                var i = 1;
                i <= totalPages;
                i++
            ) {

                if (i === currentPage) {
                    html +=
                        '<button class="page-btn active">'
                        + i
                        + '</button>';
                } else {
                    html +=
                        '<button class="page-btn" onclick="goToPage('
                        + i
                        + ')">'
                        + i
                        + '</button>';
                }

            }


            // NEXT BUTTON

            if (
                currentPage === totalPages
                || totalPages === 0
            ) {
                html +=
                    '<button class="page-btn" disabled>Next →</button>';
            } else {
                html +=
                    '<button class="page-btn" onclick="goToPage('
                    + (currentPage + 1)
                    + ')">Next →</button>';
            }


            paginationElement.innerHTML = html;

        }


        // ==========================================
        // SORT TABLE
        // ==========================================

        function sortTable(th) {

            masterSortTable(th);

            currentPage = 1;

            renderTable();

        }


        // ==========================================
        // INIT
        // ==========================================

        document.addEventListener(
            "DOMContentLoaded",
            function () {
                renderTable();
            }
        );


        // ==========================================
        // EXPORT EXCEL
        // ==========================================

        function exportExcel() {

            var table =
                document.getElementById(
                    "dataTable"
                );

            var rows =
                table.querySelectorAll("tr");

            var data = [];


            for (var i = 0; i < rows.length; i++) {

                if (
                    rows[i].style.display === "none"
                ) {
                    continue;
                }


                var cells =
                    rows[i].querySelectorAll(
                        "th, td"
                    );

                var rowData = [];


                for (
                    var j = 0;
                    j < cells.length;
                    j++
                ) {

                    if (
                        j === cells.length - 1
                    ) {
                        continue;
                    }


                    rowData.push(
                        cells[j].innerText.trim()
                    );

                }


                if (rowData.length > 0) {
                    data.push(rowData);
                }

            }


            var worksheet =
                XLSX.utils.aoa_to_sheet(data);


            var workbook =
                XLSX.utils.book_new();


            XLSX.utils.book_append_sheet(
                workbook,
                worksheet,
                "Supports"
            );


            XLSX.writeFile(
                workbook,
                "Supports_Data.xlsx"
            );

        }


        // ==========================================
        // EXPORT CSV
        // ==========================================

        function exportCSV() {

            var table =
                document.getElementById(
                    "dataTable"
                );

            var rows =
                table.querySelectorAll("tr");

            var csvContent = "";


            for (var i = 0; i < rows.length; i++) {

                if (
                    rows[i].style.display === "none"
                ) {
                    continue;
                }


                var cells =
                    rows[i].querySelectorAll(
                        "th, td"
                    );

                var rowData = [];


                for (
                    var j = 0;
                    j < cells.length;
                    j++
                ) {

                    if (
                        j === cells.length - 1
                    ) {
                        continue;
                    }


                    var text =
                        cells[j].innerText
                            .trim();

                    text = text.replace(
                        /"/g,
                        '""'
                    );

                    rowData.push(
                        '"' + text + '"'
                    );

                }


                if (rowData.length > 0) {
                    csvContent +=
                        rowData.join(",")
                        + "\r\n";
                }

            }


            var blob = new Blob(
                [csvContent],
                {
                    type:
                        "text/csv;charset=utf-8;"
                }
            );


            var link =
                document.createElement("a");


            link.href =
                URL.createObjectURL(blob);


            link.download =
                "Supports_Data.csv";


            link.click();

        }


        // ==========================================
        // PRINT TABLE
        // ==========================================

        function printTable() {

            var table =
                document.getElementById(
                    "dataTable"
                );


            var printWindow =
                window.open("", "_blank");


            printWindow.document.write(
                '<html><head>'
                + '<title>Daily Support Data</title>'
                + '<style>'
                + 'body { font-family: Arial, sans-serif; padding: 20px; }'
                + 'h1 { font-size: 22px; margin-bottom: 15px; }'
                + 'table { width: 100%; border-collapse: collapse; }'
                + 'th, td { padding: 10px; text-align: left; border-bottom: 1px solid #ddd; }'
                + 'th { background: #f3f4f6; font-size: 13px; }'
                + 'td { font-size: 13px; }'
                + '</style>'
                + '</head><body>'
            );


            printWindow.document.write(
                '<h1>Daily Support Data</h1>'
            );


            printWindow.document.write(
                '<table>'
            );


            // THEAD

            var thead =
                table.querySelector("thead");


            if (thead) {

                printWindow.document.write(
                    "<thead>"
                    + thead.innerHTML
                    + "</thead>"
                );

            }


            // TBODY - only visible rows

            printWindow.document.write(
                "<tbody>"
            );


            var tbodyRows =
                table.querySelectorAll(
                    "tbody tr"
                );


            for (
                var i = 0;
                i < tbodyRows.length;
                i++
            ) {

                if (
                    tbodyRows[i].style.display
                    !== "none"
                ) {

                    var cells =
                        tbodyRows[i]
                            .querySelectorAll("td");

                    var filteredCells = [];


                    for (
                        var j = 0;
                        j < cells.length;
                        j++
                    ) {

                        var cellButtons =
                            cells[j]
                                .querySelector(
                                    "button"
                                );


                        if (
                            cellButtons === null
                        ) {
                            filteredCells.push(
                                "<td>"
                                + cells[j]
                                    .innerHTML
                                + "</td>"
                            );
                        }

                    }


                    printWindow.document.write(
                        "<tr>"
                        + filteredCells
                            .join("")
                        + "</tr>"
                    );

                }

            }


            printWindow.document.write(
                "</tbody></table>"
            );


            printWindow.document.write(
                "</body></html>"
            );


            printWindow.document.close();


            printWindow.print();

        }


        // ==========================================
        // AUTO DISMISS MESSAGES
        // ==========================================

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                var messages =
                    document.querySelectorAll(
                        ".success-message, .error-message"
                    );


                for (
                    var i = 0;
                    i < messages.length;
                    i++
                ) {

                    (function (message) {

                        setTimeout(
                            function () {

                                message.style.transition =
                                    "opacity 0.5s ease";

                                message.style.opacity = "0";


                                setTimeout(
                                    function () {
                                        message.remove();
                                    },
                                    500
                                );

                            },
                            3000
                        );

                    })(messages[i]);

                }

            }
        );


        // ==========================================
        // VOICE TO TEXT - REMARKS
        // ==========================================

        var recognition = null;
        var isRecording = false;
        var speechBaseText = "";
        var speechFinal = "";


        function speechSupported() {

            return (
                "webkitSpeechRecognition" in window
                || "SpeechRecognition" in window
            );

        }


        function setListening(on) {

            var micBtn =
                document.getElementById(
                    "voiceMicBtn"
                );

            var status =
                document.getElementById(
                    "voiceStatus"
                );


            if (micBtn) {

                if (on) {
                    micBtn.classList.add(
                        "is-recording"
                    );
                } else {
                    micBtn.classList.remove(
                        "is-recording"
                    );
                }

            }


            if (status) {

                if (on) {
                    status.innerText =
                        "● Listening... Stop click karne tak mic open rahega";
                    status.classList.add("visible");
                } else {
                    status.classList.remove("visible");
                }

            }

        }


        function statusPillClass(status) {

            switch (status) {

                case "Completed":
                    return "badge-completed";

                case "Open":
                    return "badge-open";

                case "In Progress":
                    return "badge-inprogress";

                case "Pending":
                    return "badge-pending";

                case "Cancelled":
                    return "badge-cancelled";

                default:
                    return "badge-default";

            }

        }


        function setStatusBadge(el, status) {

            if (!el) {
                return;
            }

            el.className =
                "status-pill " + statusPillClass(status);

            el.innerText =
                (status && status.length > 0)
                    ? status
                    : "—";

        }


        function updateCurrentStatus() {

            var select =
                document.getElementById("edit_Status");

            var badge =
                document.getElementById("curStatusBadge");

            if (!select || !badge) {
                return;
            }

            setStatusBadge(badge, select.value || "");

        }


        // ==========================================
        // GENERIC "OTHER" OPTION TOGGLES
        // ==========================================

        function hasOtherOption(element) {

            for (
                var i = 0;
                i < element.options.length;
                i++
            ) {

                if (
                    element.options[i].value === "Other"
                ) {
                    return true;
                }

            }

            return false;

        }


        function toggleOtherField(select) {

            var name = select.id.replace(
                /^edit_/,
                ""
            );

            var group =
                document.getElementById(
                    "other" + name + "Group"
                );

            var input =
                document.getElementById(
                    "edit_Other" + name
                );

            var isOther =
                select !== null
                && select.value === "Other";

            if (group) {

                group.style.display =
                    isOther ? "" : "none";

            }

            if (input) {

                input.required = isOther ? true : false;

            }

        }


        function fillOtherOption(element, rawValue) {

            var otherValue = "";
            var otherPrefix = "Other - ";

            if (
                rawValue.indexOf(otherPrefix) === 0
            ) {

                otherValue =
                    rawValue.substring(
                        otherPrefix.length
                    );

                rawValue = "Other";

            } else {

                var knownOption = false;

                for (
                    var i = 0;
                    i < element.options.length;
                    i++
                ) {

                    if (
                        element.options[i].value
                            === rawValue
                    ) {
                        knownOption = true;
                        break;
                    }

                }

                if (!knownOption
                    && rawValue.length > 0) {

                    otherValue = rawValue;

                    rawValue = "Other";

                }

            }

            element.value = rawValue;

            var name = element.id.replace(
                /^edit_/,
                ""
            );

            var otherInput =
                document.getElementById(
                    "edit_Other" + name
                );

            if (otherInput) {

                otherInput.value = otherValue;

            }

            toggleOtherField(element);

        }


        function applySpeechText(textarea, interim) {

            var parts = [];

            if (speechBaseText.length > 0) {
                parts.push(speechBaseText);
            }

            if (speechFinal.trim().length > 0) {
                parts.push(speechFinal.trim());
            }

            if (interim.trim().length > 0) {
                parts.push(interim.trim());
            }

            textarea.value = parts.join(" ");

        }


        function startVoice() {

            var textarea =
                document.getElementById(
                    "edit_Remarks"
                );


            if (!speechSupported()) {

                alert(
                    "Speech Recognition is not supported in this browser. " +
                    "Please use Google Chrome."
                );

                return;

            }


            var SpeechRecognition =
                window.SpeechRecognition
                || window.webkitSpeechRecognition;

            recognition =
                new SpeechRecognition();

            recognition.lang = "en-IN";

            recognition.interimResults = true;

            recognition.continuous = true;

            recognition.maxAlternatives = 1;


            recognition.onstart = function () {

                isRecording = true;

                speechBaseText =
                    textarea.value.trim();

                speechFinal = "";

                setListening(true);

                textarea.focus();

            };


            recognition.onresult = function (event) {

                var interimText = "";


                for (
                    var i = event.resultIndex;
                    i < event.results.length;
                    i++
                ) {

                    var result = event.results[i];

                    if (result.isFinal) {
                        speechFinal +=
                            " " + result[0].transcript;
                    } else {
                        interimText +=
                            result[0].transcript;
                    }

                }


                applySpeechText(
                    textarea,
                    interimText
                );

            };


            recognition.onerror = function (event) {

                if (
                    event.error === "not-allowed"
                    || event.error ===
                        "service-not-allowed"
                ) {

                    alert(
                        "Microphone permission denied. " +
                        "Please allow microphone access."
                    );

                } else if (
                    event.error === "no-speech"
                ) {

                    alert(
                        "No speech detected. " +
                        "Please try again."
                    );

                } else {

                    alert(
                        "Speech recognition error: "
                        + event.error
                    );

                }

                isRecording = false;

                setListening(false);

            };


            recognition.onend = function () {

                isRecording = false;

                setListening(false);

            };


            try {

                recognition.start();

            } catch (error) {

                alert(
                    "Could not start speech recognition: "
                    + error.message
                );

            }

        }


        function stopVoice() {

            if (recognition) {

                recognition.stop();

            }

            isRecording = false;

            setListening(false);

        }


        function resetRemarks() {

            if (
                !confirm(
                    "Are you sure you want to clear remarks?"
                )
            ) {
                return;
            }

            // Speech bhi stop ho jaye
            if (recognition) {

                recognition.stop();

            }

            isRecording = false;

            setListening(false);

            speechBaseText = "";
            speechFinal = "";

            document.getElementById(
                "edit_Remarks"
            ).value = "";

        }


        // ==========================================
        // MODAL
        // ==========================================

        function toDateInputValue(value) {

            if (!value) {
                return "";
            }

            var trimmed = String(value).trim();

            if (/^\d{4}-\d{2}-\d{2}$/.test(trimmed)) {
                return trimmed;
            }

            var match =
                trimmed.match(
                    /^(\d{2})\/(\d{2})\/(\d{4})/
                );

            return match
                ? match[3] + "-" + match[2] + "-" + match[1]
                : "";

        }


        function toTimeInputValue(value) {

            var match =
                value.match(
                    /^(\d{1,2}):(\d{2})\s*([AP]M)$/i
                );

            if (!match) {
                return "";
            }

            var hours =
                parseInt(match[1], 10) % 12;

            if (/pm/i.test(match[3])) {
                hours += 12;
            }

            return (
                (hours < 10 ? "0" + hours : hours)
                + ":"
                + match[2]
            );

        }


        function openEditModal(btn) {

            var data =
                JSON.parse(
                    btn.getAttribute("data-json")
                );


            document.getElementById(
                "modalTitle"
            ).innerText = "Edit Support";


            document.getElementById(
                "btnSubmit"
            ).innerText = "Update";


            var form =
                document.getElementById(
                    "supportForm"
                );

            form.action = editUrl;

            form.reset();


            var elements =
                form.querySelectorAll(
                    "input[name], select[name], textarea[name]"
                );


            for (
                var i = 0;
                i < elements.length;
                i++
            ) {

                var element = elements[i];

                var name =
                    element.getAttribute(
                        "name"
                    );

                if (!name) {
                    continue;
                }


                var key = null;

                for (var fieldName in data) {

                    if (
                        data.hasOwnProperty(fieldName)
                        && fieldName.toLowerCase()
                           === name.toLowerCase()
                    ) {
                        key = fieldName;
                        break;
                    }

                }


                if (!key) {
                    continue;
                }

                var rawValue = data[key];


                // Selects expose the raw id as a *_key value;
                // prefer it over the joined display name.
                if (element.tagName === "SELECT") {

                    var keyVariant = name.toLowerCase() + "_key";

                    for (var f in data) {

                        if (
                            data.hasOwnProperty(f)
                            && f.toLowerCase()
                               === keyVariant
                        ) {
                            rawValue = data[f];
                            break;
                        }

                    }

                }


                if (
                    element.tagName === "SELECT"
                    && hasOtherOption(element)
                ) {

                    fillOtherOption(
                        element,
                        rawValue
                    );

                    continue;

                }


                if (element.type === "date") {

                    element.value =
                        toDateInputValue(rawValue);

                } else if (element.type === "time") {

                    element.value =
                        toTimeInputValue(rawValue);

                } else {

                    element.value = rawValue;

                }

            }


            setStatusBadge(
                document.getElementById(
                    "prevStatusBadge"
                ),
                data["Status"] || ""
            );

            updateCurrentStatus();

            document.getElementById(
                "supportModal"
            ).style.display = "flex";

        }


        function closeModal() {

            stopVoice();

            document.getElementById(
                "supportModal"
            ).style.display = "none";

        }


        window.onclick = function (event) {

            const modal =
                document.getElementById(
                    "supportModal"
                );


            if (event.target === modal) {

                closeModal();

            }

        };


        masterBindModalSubmit(
            "supportForm",
            closeModal
        );

    </script>
}