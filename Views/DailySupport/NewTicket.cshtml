@model Master.Models.TicketCreateViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "New Ticket";

    // Premium page look: gray canvas + floating white cards.
    ViewData["BodyClass"] = "nt-page-body";

    var clientsJson = ViewData["ClientsJson"] as string ?? "[]";
}

<div class="page-header nt-head">

    <a href="@Url.Action("Index", "DailySupport")"
       class="nt-back-btn"
       title="Back to Daily Support"
       aria-label="Back to Daily Support">

        &larr;

    </a>

    <div>

        <h1>New Support Ticket</h1>

        <p>
            Fill the details below &mdash; Ticket No is generated automatically
        </p>

    </div>

</div>


@if (TempData["Error"] != null)
{
    <div class="error-message">

        @Html.Raw(TempData["Error"])

    </div>
}


<div class="state-section nt-wrap w-full">

    <form method="post"
          id="ticketCreateForm"
          action="@Url.Action("NewTicket", "DailySupport")"
          novalidate>

        @Html.AntiForgeryToken()


        <!-- ================= INFO CHIPS ================= -->

        <div class="nt-chips">

            <div class="nt-chip">

                <span class="nt-chip-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" aria-hidden="true">
                        <path d="M2 9a3 3 0 0 1 0 6v3a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-3a3 3 0 0 1 0-6V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z" />
                        <path d="M13 5v2M13 17v2M13 11v2" />
                    </svg>
                </span>

                <span class="nt-chip-text">

                    <span class="nt-chip-label">Auto Ticket No</span>

                    <span class="nt-chip-value">@Model.TicketNo</span>

                </span>

            </div>

            <div class="nt-chip">

                <span class="nt-chip-icon amber">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="18" rx="2" />
                        <path d="M16 2v4M8 2v4M3 10h18" />
                    </svg>
                </span>

                <span class="nt-chip-text">

                    <span class="nt-chip-label">Today</span>

                    <span class="nt-chip-value">
                        @Model.SupportDate.ToString("dd/MM/yyyy")
                    </span>

                </span>

            </div>

            <div class="nt-chip">

                <span class="nt-chip-icon green">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" />
                        <circle cx="12" cy="12" r="2.5" />
                    </svg>
                </span>

                <span class="nt-chip-text">

                    <span class="nt-chip-label">Status</span>

                    <span class="nt-chip-value">
                        <span class="nt-chip-dot"></span>Open
                    </span>

                </span>

            </div>

        </div>

        <!-- Hidden: Call Date (aaj) + Status (Open) -->
        <input type="hidden"
               name="SupportDate"
               value="@Model.SupportDate.ToString("yyyy-MM-dd")" />

        <input type="hidden"
               name="StatusId"
               id="edit_StatusId"
               value="@Model.StatusId" />


        <!-- ================= CUSTOMER ================= -->

        <div class="call-form-section nt-section accent-blue">

            <div class="form-section-title">
                <span class="nt-sec-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                </span>
                CUSTOMER
            </div>

            <div class="form-grid">

                <div class="form-group form-group-full client-select-wrapper">

                    <label>
                        Select Client <span class="nt-req">*</span>
                    </label>

                    <input type="hidden"
                           name="ClientId"
                           id="clientIdField"
                           value="@Model.ClientId" />

                    <div class="nt-clear-wrap">

                        <span class="nt-search-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round" aria-hidden="true">
                                <circle cx="11" cy="11" r="8" />
                                <path d="m21 21-4.3-4.3" />
                            </svg>
                        </span>

                        <input type="text"
                               id="clientSearchInput"
                               placeholder="Search client by name or mobile"
                               autocomplete="off" />

                        <button type="button"
                                class="nt-clear-client"
                                id="clientClearBtn"
                                title="Clear selected client"
                                style="display:none;">

                            &times;

                        </button>

                    </div>

                    <div class="select-dropdown"
                         id="clientDropdown">

                    </div>

                    <small id="selectedClientChip"
                           class="nt-client-chip"
                           style="display:none;">

                    </small>

                </div>


                <div class="form-group">

                    <label>
                        Mobile <span class="nt-req">*</span>
                    </label>

                    <input type="text"
                           name="Mobile"
                           id="mobileField"
                           maxlength="20"
                           value="@Model.Mobile"
                           placeholder="Mobile No."
                           required />

                </div>


                <div class="form-group">

                    <label>
                        Caller Name
                    </label>

                    <div class="nt-input-with-badge">

                        <input type="text"
                               name="CallerName"
                               id="callerNameField"
                               maxlength="150"
                               value="@Model.CallerName"
                               placeholder="Caller Name" />

                        <span class="nt-field-id"
                              id="clientIdBadge"
                              @(Model.ClientId.HasValue && Model.ClientId.Value > 0 ? "" : "hidden")>[ID: @(Model.ClientId.HasValue ? Model.ClientId.Value.ToString() : "—")]</span>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================= PROBLEM ================= -->

        <div class="call-form-section nt-section accent-purple">

            <div class="form-section-title">
                <span class="nt-sec-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                    </svg>
                </span>
                PROBLEM
            </div>

            <div class="form-grid">

                <div class="form-group form-group-full">

                    <label>
                        Issue (Subject) <span class="nt-req">*</span>
                    </label>

                    <input type="text"
                           name="Subject"
                           id="edit_Subject"
                           maxlength="300"
                           value="@Model.Subject"
                           placeholder="Short issue title"
                           required />

                </div>


                <div class="form-group form-group-full">

                    <label>
                        Description <span class="nt-req">*</span>
                    </label>

                    <div class="tkt-input-wrap nt-desc-wrap">

                        <textarea name="Description"
                                  id="edit_Description"
                                  rows="3"
                                  maxlength="1000"
                                  placeholder="Describe the client's problem / request"
                                  required>@Model.Description</textarea>

                        <span class="tkt-btn-row">

                            <button type="button"
                                    class="tkt-mic-btn"
                                    id="descMicBtn"
                                    title="Start voice input"
                                    aria-label="Start voice input"
                                    onclick="toggleVoice(this, 'edit_Description')">

                                <svg class="ico-mic" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round" aria-hidden="true">
                                    <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z" />
                                    <path d="M19 10v2a7 7 0 0 1-14 0v-2" />
                                    <line x1="12" y1="19" x2="12" y2="23" />
                                </svg>

                                <svg class="ico-stop" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round" aria-hidden="true">
                                    <rect x="6" y="6" width="12" height="12" rx="2" />
                                </svg>

                            </button>

                            <button type="button"
                                    class="tkt-clear-btn"
                                    id="descClearBtn"
                                    title="Clear description"
                                    aria-label="Clear description"
                                    onclick="clearDescription()">

                                <svg class="ico-trash" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round" aria-hidden="true">
                                    <polyline points="3 6 5 6 21 6" />
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                </svg>

                            </button>

                        </span>

                        <span class="tkt-count" id="cnt_Description">0/1000</span>

                        <span class="tkt-voice-status"
                              id="voiceStatus_Description">

                            <span class="tkt-voice-dot"></span>
                            Listening&hellip; speak now

                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- ================= CLASSIFICATION ================= -->

        <div class="call-form-section nt-section accent-teal">

            <div class="form-section-title">
                <span class="nt-sec-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" aria-hidden="true">
                        <path d="m12 2 9 5-9 5-9-5 9-5Z" />
                        <path d="m3 12 9 5 9-5" />
                        <path d="m3 17 9 5 9-5" />
                    </svg>
                </span>
                CLASSIFICATION
            </div>

            <div class="form-grid">

                <div class="form-group">

                    <label>
                        Channel <span class="nt-req">*</span>
                    </label>

                    <select name="ChannelId"
                            id="edit_ChannelId"
                            required>

                        <option value="">
                            -- Select Channel --
                        </option>

                        @foreach (var c in Model.Channels)
                        {
                            <option value="@c.Id"
                                    selected="@(Model.ChannelId == c.Id)">

                                @c.Name

                            </option>
                        }

                    </select>

                </div>


                <div class="form-group">

                    <label>
                        Call Type <span class="nt-req">*</span>
                    </label>

                    <select name="CallTypeId"
                            id="edit_CallTypeId"
                            required>

                        <option value="">
                            -- Select Call Type --
                        </option>

                        @foreach (var c in Model.CallTypes)
                        {
                            <option value="@c.Id"
                                    selected="@(Model.CallTypeId == c.Id)">

                                @c.Name

                            </option>
                        }

                    </select>

                </div>


                <div class="form-group">

                    <label>
                        Category <span class="nt-req">*</span>
                    </label>

                    <select name="CategoryId"
                            id="edit_CategoryId"
                            required>

                        <option value="">
                            -- Select Category --
                        </option>

                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.Id"
                                    selected="@(Model.CategoryId == c.Id)">

                                @c.Name

                            </option>
                        }

                    </select>

                </div>


                <div class="form-group">

                    <label>
                        Sub Category <span class="nt-req">*</span>
                    </label>

                    <select name="SubCategoryId"
                            id="edit_SubCategoryId"
                            required>

                        <option value="">
                            -- Select Sub Category --
                        </option>

                    </select>

                    <small class="nt-hint">
                        Changes after selecting a category
                    </small>

                </div>


                <div class="form-group">

                    <label>
                        Priority <span class="nt-req">*</span>
                    </label>

                    <select name="PriorityId"
                            id="edit_PriorityId"
                            required>

                        <option value="">
                            -- Select Priority --
                        </option>

                        @foreach (var p in Model.Priorities)
                        {
                            <option value="@p.Id"
                                    selected="@(Model.PriorityId == p.Id)">

                                @p.Name

                            </option>
                        }

                    </select>

                </div>


                <div class="form-group">

                    <label>
                        Assigned To <span class="nt-req">*</span>
                    </label>

                    <div class="nt-assign-row">

                        <select name="AssignedTo"
                                id="edit_AssignedTo"
                                required>

                            <option value="">
                                -- Select User --
                            </option>

                            @foreach (var u in Model.Users)
                            {
                                <option value="@u.Id"
                                        selected="@(Model.AssignedTo == u.Id)">

                                    @u.Name

                                </option>
                            }

                        </select>

                        <label class="nt-check" id="assignToMeChip">

                            <input type="checkbox"
                                   id="assignToMe"
                                   checked />

                            Assign to me

                        </label>

                    </div>

                    <small class="nt-hint" id="assignToMeHint">
                        Assigned to you (logged in)
                    </small>

                </div>

            </div>

        </div>


        <div class="nt-footer">

            <button type="button"
                    class="cancel-btn"
                    id="clearFormBtn">

                Clear

            </button>

            <button type="submit"
                    class="save-btn">

                Create Ticket

            </button>

        </div>

    </form>

</div>


@section Scripts
{
    <script>

        var clients = @Html.Raw(clientsJson);

        var subCategories = [
            @foreach (var s in Model.SubCategories)
            {
                <text>{ id: @s.Id, name: "@Html.Raw(s.Name.Replace("\"", "\\\""))", parentId: @s.ParentId },</text>
            }
        ];

        var selectedSubCategoryId = "@(Model.SubCategoryId?.ToString() ?? "")";

        var mobileTimer = null;

        // ==========================================
        // CLIENT SEARCH
        // ==========================================

        function setClient(id, name, mobile) {

            document.getElementById('clientIdField').value = id || '';

            document.getElementById('clientSearchInput').value =
                name || '';

            // Always refresh mobile + caller name for the newly chosen client.
            document.getElementById('mobileField').value = mobile || '';

            document.getElementById('callerNameField').value = name || '';

            // Show a small confirmation chip with the selected client.
            var chip = document.getElementById('selectedClientChip');

            if (chip && name) {
                var extra = mobile ? ' &middot; ' + mobile : '';
                var idExtra = id
                    ? ' <span class="chip-id">&middot; [ID: ' + id + ']</span>'
                    : '';
                chip.innerHTML = '&#10003; ' + name + extra + idExtra;
                chip.style.display = 'inline-block';
            }

            // Caller Name field ke paas client ID badge.
            var idBadge = document.getElementById('clientIdBadge');

            if (idBadge) {
                if (id) {
                    idBadge.innerText = '[ID: ' + id + ']';
                    idBadge.hidden = false;
                } else {
                    idBadge.innerText = '[ID: —]';
                    idBadge.hidden = true;
                }
            }

            var clearBtn = document.getElementById('clientClearBtn');
            if (clearBtn) {
                clearBtn.style.display = name ? 'inline-flex' : 'none';
            }

            // Heads-up if this mobile already has an open ticket.
            if (mobile) {
                checkDuplicate(mobile);
            }

            hideClientDropdown();
        }

        // Clears the selected client and the fields it auto-filled.
        function clearClient() {

            document.getElementById('clientIdField').value = '';
            document.getElementById('clientSearchInput').value = '';
            document.getElementById('mobileField').value = '';
            document.getElementById('callerNameField').value = '';

            var chip = document.getElementById('selectedClientChip');
            if (chip) {
                chip.innerHTML = '';
                chip.style.display = 'none';
            }

            // Caller Name field wala ID badge bhi hatao.
            var idBadge = document.getElementById('clientIdBadge');
            if (idBadge) {
                idBadge.innerText = '[ID: —]';
                idBadge.hidden = true;
            }

            var clearBtn = document.getElementById('clientClearBtn');
            if (clearBtn) {
                clearBtn.style.display = 'none';
            }

            hideClientDropdown();
        }

        // ---- Searchable client dropdown (name OR mobile, paged) ----

        var CLIENT_PAGE_SIZE = 20;
        var clientMatches = [];
        var clientShown = 0;

        function clientLabel(c) {
            return c.text || c.name || '';
        }

        function renderClientDropdown(matches) {

            var dd = document.getElementById('clientDropdown');

            if (!matches || matches.length === 0) {
                dd.style.display = 'none';
                dd.innerHTML = '';
                return;
            }

            clientMatches = matches;
            clientShown = 0;

            dd.innerHTML = '';
            appendClientPage();
        }

        // Renders the next page of matches + a "Load more" row.
        function appendClientPage() {

            var dd = document.getElementById('clientDropdown');

            // Remove an existing "load more" row before appending.
            var old = dd.querySelector('.select-more');
            if (old) {
                old.remove();
            }

            var end = Math.min(
                clientShown + CLIENT_PAGE_SIZE, clientMatches.length);

            var html = '';

            for (var i = clientShown; i < end; i++) {

                var c = clientMatches[i];

                html += '<div class="select-option" '
                    + 'data-id="' + c.id + '" '
                    + 'data-name="' + (c.name || '') + '" '
                    + 'data-mobile="' + (c.mobile || '') + '">'
                    + '<span class="select-option-main">'
                    + clientLabel(c)
                    + '</span>'
                    + '<span class="select-option-id">[ID: '
                    + (c.id || '')
                    + ']</span>'
                    + '</div>';
            }

            dd.insertAdjacentHTML('beforeend', html);

            clientShown = end;

            if (clientShown < clientMatches.length) {

                var remaining = clientMatches.length - clientShown;

                dd.insertAdjacentHTML(
                    'beforeend',
                    '<div class="select-more" id="clientLoadMore">'
                    + 'Load more (' + remaining + ' left)'
                    + '</div>');

                document.getElementById('clientLoadMore')
                    .addEventListener('click', function (e) {
                        e.stopPropagation();
                        appendClientPage();
                    });
            }

            bindClientOptions();
            dd.style.display = 'block';
        }

        function bindClientOptions() {

            var dd = document.getElementById('clientDropdown');
            var opts = dd.querySelectorAll('.select-option');

            for (var j = 0; j < opts.length; j++) {

                if (opts[j].getAttribute('data-bound') === '1') {
                    continue;
                }

                opts[j].setAttribute('data-bound', '1');

                opts[j].addEventListener('click', function () {
                    setClient(
                        this.getAttribute('data-id'),
                        this.getAttribute('data-name'),
                        this.getAttribute('data-mobile'));
                });
            }
        }

        function hideClientDropdown() {

            var dd = document.getElementById('clientDropdown');

            if (dd) {
                dd.style.display = 'none';
                dd.innerHTML = '';
            }
        }

        // Matches against name AND mobile number.
        function filterClients(term) {

            var t = (term || '').trim().toLowerCase();

            if (!t) {
                return clients.slice(0, CLIENT_PAGE_SIZE);
            }

            var res = [];

            for (var i = 0; i < clients.length; i++) {

                var c = clients[i];

                var name = (c.name || '').toLowerCase();
                var mob = (c.mobile || '').toLowerCase();

                if (name.indexOf(t) >= 0 || mob.indexOf(t) >= 0) {

                    res.push({
                        id: c.id,
                        name: c.name,
                        mobile: c.mobile,
                        text: c.mobile ? (c.name + ' \u00B7 ' + c.mobile) : c.name
                    });
                }
            }

            return res;
        }

        // ==========================================
        // DUPLICATE TICKET CHECK
        // ==========================================

        function checkDuplicate(mobile) {

            if (!mobile || mobile.length < 6) {
                return;
            }

            fetch('@Url.Action("CheckDuplicate","DailySupport")'
                + '?mobile=' + encodeURIComponent(mobile),
                { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.json())
                .then(data => {

                    if (data && data.hasDuplicate) {

                        var nums = data.tickets
                            .map(t => t.ticketNo)
                            .join(', ');

                        masterShowToast(
                            'Warning: is mobile ka pehle se open ticket hai — '
                            + nums,
                            'error');
                    }
                });
        }

        // ==========================================
        // SUBCATEGORY CASCADE
        // ==========================================

        function loadSubCategories(categoryId, keepSelection) {

            var sel =
                document.getElementById('edit_SubCategoryId');

            sel.innerHTML =
                '<option value="">-- Select Sub Category --</option>';

            for (var i = 0; i < subCategories.length; i++) {

                var s = subCategories[i];

                if (categoryId && s.parentId !== parseInt(categoryId)) {
                    continue;
                }

                var opt = document.createElement('option');
                opt.value = s.id;
                opt.text = s.name;

                if (keepSelection
                    && selectedSubCategoryId === String(s.id)) {
                    opt.selected = true;
                }

                sel.appendChild(opt);
            }
        }

        // ==========================================
        // INIT
        // ==========================================

        document.addEventListener('DOMContentLoaded', function () {

            var clientSearchInput =
                document.getElementById('clientSearchInput');

            clientSearchInput.addEventListener('input', function () {
                renderClientDropdown(filterClients(this.value));
            });

            clientSearchInput.addEventListener('focus', function () {
                renderClientDropdown(filterClients(this.value));
            });

            document.addEventListener('click', function (e) {

                var dd = document.getElementById('clientDropdown');

                if (!clientSearchInput.contains(e.target)
                    && dd && !dd.contains(e.target)) {
                    hideClientDropdown();
                }
            });

            // Duplicate check when a mobile number is typed manually.
            var mobileField = document.getElementById('mobileField');

            mobileField.addEventListener('blur', function () {
                checkDuplicate(this.value.trim());
            });

            // Clear the selected client + auto-filled fields.
            var clearClientBtn = document.getElementById('clientClearBtn');

            if (clearClientBtn) {
                clearClientBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    clearClient();
                });
            }

            // Category -> SubCategory cascade
            document.getElementById('edit_CategoryId')
                .addEventListener('change', function () {
                    loadSubCategories(this.value, false);
                });

            // Initial
            loadSubCategories(
                document.getElementById('edit_CategoryId').value,
                true);

            // Description: live counter + clear button.
            var descField = document.getElementById('edit_Description');

            if (descField) {
                descField.addEventListener('input', refreshDescUi);
                refreshDescUi();
            }

            // "Assign to me" -> dropdown lock / unlock.
            var assignToMe = document.getElementById('assignToMe');

            var assignee = document.getElementById('edit_AssignedTo');

            if (assignToMe) {
                assignToMe.addEventListener('change', syncAssignToMe);
            }

            if (assignee) {

                // Locked hone par bhi value current user hi rahe.
                assignee.addEventListener('change', function () {

                    if (assignToMe && assignToMe.checked
                        && currentUserId) {

                        var meOption = this.querySelector(
                            'option[value="' + currentUserId + '"]');

                        if (meOption) {
                            this.value = currentUserId;
                        }
                    }
                });
            }

            syncAssignToMe();

            // Mic tabhide hota hai jahan voice input kaam nahi karta
            // (plain http, non-localhost).
            if (!window.isSecureContext) {
                document.querySelectorAll('.tkt-mic-btn')
                    .forEach(function (b) {
                        b.style.display = 'none';
                    });
            }

            // Clear
            document.getElementById('clearFormBtn')
                .addEventListener('click', function () {

                    var form =
                        document.getElementById('ticketCreateForm');

                    form.reset();

                    clearClient();

                    loadSubCategories('', false);

                    refreshDescUi();

                    syncAssignToMe();
                });

            // Submit validation
            document.getElementById('ticketCreateForm')
                .addEventListener('submit', function (event) {

                    event.preventDefault();

                    var clientId =
                        document.getElementById('clientIdField').value;

                    var subject =
                        document.getElementById('edit_Subject')
                            .value.trim();

                    var desc =
                        document.getElementById('edit_Description')
                            .value.trim();

                    var priority =
                        document.getElementById('edit_PriorityId').value;

                    var mobile =
                        document.getElementById('mobileField')
                            .value.trim();

                    var channel =
                        document.getElementById('edit_ChannelId').value;

                    var callType =
                        document.getElementById('edit_CallTypeId').value;

                    var category =
                        document.getElementById('edit_CategoryId').value;

                    var subCategory =
                        document.getElementById('edit_SubCategoryId').value;

                    var assignedTo =
                        document.getElementById('edit_AssignedTo').value;

                    if (!clientId) {
                        masterShowToast(
                            'Please select a client.', 'error');
                        return;
                    }

                    if (!mobile) {
                        masterShowToast(
                            'Mobile number is required.', 'error');
                        return;
                    }

                    if (!subject) {
                        masterShowToast(
                            'Issue (Subject) is required.', 'error');
                        return;
                    }

                    if (!desc) {
                        masterShowToast(
                            'Description is required.', 'error');
                        return;
                    }

                    if (!channel) {
                        masterShowToast(
                            'Please select a channel.', 'error');
                        return;
                    }

                    if (!callType) {
                        masterShowToast(
                            'Please select a call type.', 'error');
                        return;
                    }

                    if (!category) {
                        masterShowToast(
                            'Please select a category.', 'error');
                        return;
                    }

                    if (!subCategory) {
                        masterShowToast(
                            'Please select a sub category.', 'error');
                        return;
                    }

                    if (!priority) {
                        masterShowToast(
                            'Please select a priority.', 'error');
                        return;
                    }

                    if (!assignedTo) {
                        masterShowToast(
                            'Please select who to assign this ticket to.',
                            'error');
                        return;
                    }

                    this.submit();
                });
        });

        // ==========================================
        // VOICE TO TEXT
        // ==========================================

        // ==========================================
        // ASSIGN TO ME  (dropdown lock / unlock)
        // ==========================================

        var currentUserId = '@(Model.CurrentUserId?.ToString() ?? "")';

        function syncAssignToMe() {

            var chk = document.getElementById('assignToMe');
            var sel = document.getElementById('edit_AssignedTo');
            var chip = document.getElementById('assignToMeChip');
            var hint = document.getElementById('assignToMeHint');

            if (!chk || !sel) {
                return;
            }

            if (chk.checked) {

                // Locked to the logged-in user.
                if (currentUserId) {

                    var meOption = sel.querySelector(
                        'option[value="' + currentUserId + '"]');

                    if (meOption) {
                        sel.value = currentUserId;
                    }
                }

                sel.style.pointerEvents = 'none';
                sel.style.opacity = '.75';

                if (chip) {
                    chip.classList.remove('off');
                }

                if (hint) {
                    hint.textContent = 'Assigned to you (logged in).';
                }

            } else {

                sel.style.pointerEvents = '';
                sel.style.opacity = '';

                if (chip) {
                    chip.classList.add('off');
                }

                if (hint) {
                    hint.textContent = 'Pick who will handle this ticket.';
                }
            }
        }

        // ==========================================
        // VOICE TO TEXT (mic + clear inside the box)
        // ==========================================

        var voiceRec = null;
        var voiceTarget = null;
        var voiceBase = '';
        var voiceFinal = '';
        var voiceSupported = false;

        function speechSupported() {

            voiceSupported =
                ('webkitSpeechRecognition' in window
                    || 'SpeechRecognition' in window);

            return voiceSupported;
        }

        // Keeps the character counter + clear button in sync.
        function refreshDescUi() {

            var field = document.getElementById('edit_Description');

            if (!field) {
                return;
            }

            var wrap = field.closest('.tkt-input-wrap');

            var count = document.getElementById('cnt_Description');

            if (count) {
                count.textContent = field.value.length + '/1000';
            }

            if (wrap) {
                wrap.classList.toggle(
                    'has-text', field.value.length > 0);
            }
        }

        // Clear button (inside the description box).
        function clearDescription() {

            var field = document.getElementById('edit_Description');

            if (!field || !field.value) {
                return;
            }

            if (confirm('Clear the description?')) {
                field.value = '';
                refreshDescUi();
            }
        }

        function setVoiceStatus(fieldId, on) {

            var status =
                document.getElementById('voiceStatus_' + fieldId);

            if (!status) {
                return;
            }

            if (on) {
                status.classList.add('visible');
            } else {
                status.classList.remove('visible');
            }
        }

        // Drops Devanagari (Hindi) characters so only English / Hinglish
        // (Roman) text is kept. Hindi words get removed word-level.
        function stripDevanagari(text) {
            return (text || '')
                .replace(/[\u0900-\u097F]+/g, '')
                .replace(/\s{2,}/g, ' ')
                .trim();
        }

        // Mic button -> start / stop voice input.
        function toggleVoice(btn, fieldId) {

            if (!speechSupported()) {
                masterShowToast(
                    'Voice input is not supported in this browser.',
                    'error');
                return;
            }

            // Same button pressed again -> stop.
            if (voiceRec && voiceTarget === fieldId) {
                stopVoice();
                return;
            }

            stopVoice();

            var SR = window.SpeechRecognition
                || window.webkitSpeechRecognition;

            voiceRec = new SR();
            voiceRec.lang = 'en-IN';
            voiceRec.continuous = true;
            voiceRec.interimResults = true;

            voiceTarget = fieldId;

            var field = document.getElementById(fieldId);

            voiceBase = (field.value || '').trim();
            voiceFinal = '';

            voiceRec.onstart = function () {
                setVoiceStatus(fieldId, true);
            };

            // Rebuilds the field from base + final + live interim text,
            // so the user sees the words as they speak.
            function paint(interim) {

                var parts = [];

                if (voiceBase) parts.push(voiceBase);
                if (voiceFinal) parts.push(voiceFinal);
                if (interim) parts.push(interim);

                field.value = parts.join(' ');

                refreshDescUi();
            }

            voiceRec.onresult = function (e) {

                var interim = '';

                for (var i = e.resultIndex; i < e.results.length; i++) {

                    var raw = e.results[i][0].transcript;

                    if (e.results[i].isFinal) {

                        var clean = stripDevanagari(raw);

                        // Skip empty (all-Hindi) and duplicate results.
                        if (!clean) continue;
                        if (voiceFinal
                            && voiceFinal.indexOf(clean) !== -1) continue;

                        voiceFinal += ' ' + clean;

                    } else {
                        interim += stripDevanagari(raw) + ' ';
                    }
                }

                paint(interim.trim());
            };

            voiceRec.onerror = function () {
                stopVoice();
                masterShowToast('Could not capture voice.', 'error');
            };

            voiceRec.onend = function () {
                if (voiceRec) stopVoice();
            };

            try {
                voiceRec.start();
            } catch (e) {
                masterShowToast(
                    'Could not start voice input.', 'error');
                return;
            }

            btn.classList.add('recording');
            setVoiceStatus(fieldId, true);
        }

        function stopVoice() {

            var btn =
                document.querySelector('.tkt-mic-btn.recording');

            if (btn) {
                btn.classList.remove('recording');
            }

            if (voiceTarget) {
                setVoiceStatus(voiceTarget, false);
            }

            if (voiceRec) {
                try { voiceRec.stop(); } catch (e) { }
            }

            voiceRec = null;
            voiceTarget = null;
            voiceBase = '';
            voiceFinal = '';
        }

    </script>
}
