@model Master.Models.TicketCreateViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "New Ticket";

    var clientsJson = ViewData["ClientsJson"] as string ?? "[]";
}

<div class="page-header">

    <a href="@Url.Action("Index", "DailySupport")"
       class="back-link">

        &larr; Back to Daily Support

    </a>

    <div>

        <h1>
            New Support Ticket
        </h1>

        <p>
            Fill the details below &mdash; Ticket No is generated automatically
        </p>

    </div>

</div>


@if (TempData["Error"] != null)
{
    <div class="error-message">

        @Html.Raw(TempData["Error"])

    </div>
}


<div class="state-section nt-wrap">

    <form method="post"
          id="ticketCreateForm"
          action="@Url.Action("NewTicket", "DailySupport")"
          novalidate>

        @Html.AntiForgeryToken()


        <!-- ================= TICKET INFO ================= -->

        <div class="call-form-section nt-section">

            <div class="form-section-title">
                &#127915; TICKET INFO
            </div>

            <div class="form-grid form-grid-3">

                <div class="form-group">

                    <label>
                        Priority <span class="nt-req">*</span>
                    </label>

                    <select name="PriorityId"
                            id="edit_PriorityId"
                            required>

                        <option value="">
                            -- Select Priority --
                        </option>

                        @foreach (var p in Model.Priorities)
                        {
                            <option value="@p.Id"
                                    selected="@(Model.PriorityId == p.Id)">

                                @p.Name

                            </option>
                        }

                    </select>

                </div>


                <div class="form-group">

                    <label>
                        Call Date
                    </label>

                    <input type="text"
                           class="call-date-input"
                           value="@DateTime.Today.ToString("dd/MM/yyyy")"
                           readonly />

                    <input type="hidden"
                           name="SupportDate"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")" />

                </div>


                <div class="form-group">

                    <label>
                        Status
                    </label>

                    <select name="StatusId" id="edit_StatusId">

                        @foreach (var s in Model.Statuses)
                        {
                            <option value="@s.Id"
                                    selected="@(Model.StatusId == s.Id)">

                                @s.Name

                            </option>
                        }

                    </select>

                </div>

            </div>

        </div>


        <!-- ================= CUSTOMER ================= -->

        <div class="call-form-section nt-section">

            <div class="form-section-title">
                &#128100; CUSTOMER
            </div>

            <div class="form-grid">

                <div class="form-group client-select-wrapper">

                    <label>
                        Select Client <span class="nt-req">*</span>
                    </label>

                    <input type="hidden"
                           name="ClientId"
                           id="clientIdField"
                           value="@Model.ClientId" />

                    <div class="nt-clear-wrap">

                        <input type="text"
                               id="clientSearchInput"
                               placeholder="Search client by name or mobile"
                               autocomplete="off" />

                        <button type="button"
                                class="nt-clear-client"
                                id="clientClearBtn"
                                title="Clear selected client"
                                style="display:none;">

                            &times;

                        </button>

                    </div>

                    <div class="select-dropdown"
                         id="clientDropdown">

                    </div>

                    <small id="selectedClientChip"
                           class="nt-client-chip"
                           style="display:none;">

                    </small>

                </div>


                <div class="form-group">

                    <label>
                        Mobile <span class="nt-req">*</span>
                    </label>

                    <input type="text"
                           name="Mobile"
                           id="mobileField"
                           maxlength="20"
                           value="@Model.Mobile"
                           placeholder="Mobile No."
                           required />

                </div>


                <div class="form-group">

                    <label>
                        Caller Name
                    </label>

                    <input type="text"
                           name="CallerName"
                           id="callerNameField"
                           maxlength="150"
                           value="@Model.CallerName"
                           placeholder="Caller Name" />

                </div>

            </div>

        </div>


        <!-- ================= CLASSIFICATION ================= -->

        <div class="call-form-section nt-section">

            <div class="form-section-title">
                &#128193; CLASSIFICATION
            </div>

            <div class="form-grid">

                <div class="form-group">

                    <label>
                        Channel
                    </label>

                    <select name="ChannelId" id="edit_ChannelId">

                        <option value="">
                            -- Select Channel --
                        </option>

                        @foreach (var c in Model.Channels)
                        {
                            <option value="@c.Id"
                                    selected="@(Model.ChannelId == c.Id)">

                                @c.Name

                            </option>
                        }

                    </select>

                </div>


                <div class="form-group">

                    <label>
                        Call Type
                    </label>

                    <select name="CallTypeId" id="edit_CallTypeId">

                        <option value="">
                            -- Select Call Type --
                        </option>

                        @foreach (var c in Model.CallTypes)
                        {
                            <option value="@c.Id"
                                    selected="@(Model.CallTypeId == c.Id)">

                                @c.Name

                            </option>
                        }

                    </select>

                </div>


                <div class="form-group">

                    <label>
                        Category
                    </label>

                    <select name="CategoryId" id="edit_CategoryId">

                        <option value="">
                            -- Select Category --
                        </option>

                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.Id"
                                    selected="@(Model.CategoryId == c.Id)">

                                @c.Name

                            </option>
                        }

                    </select>

                </div>


                <div class="form-group">

                    <label>
                        Sub Category
                    </label>

                    <select name="SubCategoryId"
                            id="edit_SubCategoryId">

                        <option value="">
                            -- Select Sub Category --
                        </option>

                    </select>

                    <small class="nt-hint">
                        Changes after selecting a category
                    </small>

                </div>

            </div>

        </div>


        <!-- ================= PROBLEM ================= -->

        <div class="call-form-section nt-section">

            <div class="form-section-title">
                &#128221; PROBLEM
            </div>

            <div class="form-grid">

                <div class="form-group form-group-full">

                    <label>
                        Issue (Subject) <span class="nt-req">*</span>
                    </label>

                    <input type="text"
                           name="Subject"
                           id="edit_Subject"
                           maxlength="300"
                           value="@Model.Subject"
                           placeholder="Short issue title"
                           required />

                </div>


                <div class="form-group form-group-full">

                    <label>
                        Description <span class="nt-req">*</span>
                    </label>

                    <textarea name="Description"
                              id="edit_Description"
                              rows="4"
                              placeholder="Describe the client's problem / request"
                              required>@Model.Description</textarea>


                    <div class="voice-controls">

                        <button type="button"
                                class="voice-btn mic-btn"
                                id="voiceMicBtn_Description"
                                onclick="startVoice('Description')">

                            Mic

                        </button>

                        <button type="button"
                                class="voice-btn voice-stop"
                                onclick="stopVoice()">

                            Stop

                        </button>

                        <button type="button"
                                class="voice-btn voice-reset"
                                onclick="resetVoice('Description')">

                            Reset

                        </button>

                    </div>

                    <span class="voice-status"
                          id="voiceStatus_Description"></span>

                </div>

            </div>

        </div>


        <div class="nt-footer">

            <button type="button"
                    class="cancel-btn"
                    id="clearFormBtn">

                Clear

            </button>

            <button type="submit"
                    class="save-btn">

                Create Ticket

            </button>

        </div>

    </form>

</div>


@section Scripts
{
    <script>

        var clients = @Html.Raw(clientsJson);

        var subCategories = [
            @foreach (var s in Model.SubCategories)
            {
                <text>{ id: @s.Id, name: "@Html.Raw(s.Name.Replace("\"", "\\\""))", parentId: @s.ParentId },</text>
            }
        ];

        var selectedSubCategoryId = "@(Model.SubCategoryId?.ToString() ?? "")";

        var mobileTimer = null;

        // ==========================================
        // CLIENT SEARCH
        // ==========================================

        function setClient(id, name, mobile) {

            document.getElementById('clientIdField').value = id || '';

            document.getElementById('clientSearchInput').value =
                name || '';

            // Always refresh mobile + caller name for the newly chosen client.
            document.getElementById('mobileField').value = mobile || '';

            document.getElementById('callerNameField').value = name || '';

            // Show a small confirmation chip with the selected client.
            var chip = document.getElementById('selectedClientChip');

            if (chip && name) {
                var extra = mobile ? ' &middot; ' + mobile : '';
                chip.innerHTML = '&#10003; ' + name + extra;
                chip.style.display = 'inline-block';
            }

            var clearBtn = document.getElementById('clientClearBtn');
            if (clearBtn) {
                clearBtn.style.display = name ? 'inline-flex' : 'none';
            }

            // Heads-up if this mobile already has an open ticket.
            if (mobile) {
                checkDuplicate(mobile);
            }

            hideClientDropdown();
        }

        // Clears the selected client and the fields it auto-filled.
        function clearClient() {

            document.getElementById('clientIdField').value = '';
            document.getElementById('clientSearchInput').value = '';
            document.getElementById('mobileField').value = '';
            document.getElementById('callerNameField').value = '';

            var chip = document.getElementById('selectedClientChip');
            if (chip) {
                chip.innerHTML = '';
                chip.style.display = 'none';
            }

            var clearBtn = document.getElementById('clientClearBtn');
            if (clearBtn) {
                clearBtn.style.display = 'none';
            }

            hideClientDropdown();
        }

        // ---- Searchable client dropdown (name OR mobile, paged) ----

        var CLIENT_PAGE_SIZE = 20;
        var clientMatches = [];
        var clientShown = 0;

        function clientLabel(c) {
            return c.text || c.name || '';
        }

        function renderClientDropdown(matches) {

            var dd = document.getElementById('clientDropdown');

            if (!matches || matches.length === 0) {
                dd.style.display = 'none';
                dd.innerHTML = '';
                return;
            }

            clientMatches = matches;
            clientShown = 0;

            dd.innerHTML = '';
            appendClientPage();
        }

        // Renders the next page of matches + a "Load more" row.
        function appendClientPage() {

            var dd = document.getElementById('clientDropdown');

            // Remove an existing "load more" row before appending.
            var old = dd.querySelector('.select-more');
            if (old) {
                old.remove();
            }

            var end = Math.min(
                clientShown + CLIENT_PAGE_SIZE, clientMatches.length);

            var html = '';

            for (var i = clientShown; i < end; i++) {

                var c = clientMatches[i];

                html += '<div class="select-option" '
                    + 'data-id="' + c.id + '" '
                    + 'data-name="' + (c.name || '') + '" '
                    + 'data-mobile="' + (c.mobile || '') + '">'
                    + clientLabel(c)
                    + '</div>';
            }

            dd.insertAdjacentHTML('beforeend', html);

            clientShown = end;

            if (clientShown < clientMatches.length) {

                var remaining = clientMatches.length - clientShown;

                dd.insertAdjacentHTML(
                    'beforeend',
                    '<div class="select-more" id="clientLoadMore">'
                    + 'Load more (' + remaining + ' left)'
                    + '</div>');

                document.getElementById('clientLoadMore')
                    .addEventListener('click', function (e) {
                        e.stopPropagation();
                        appendClientPage();
                    });
            }

            bindClientOptions();
            dd.style.display = 'block';
        }

        function bindClientOptions() {

            var dd = document.getElementById('clientDropdown');
            var opts = dd.querySelectorAll('.select-option');

            for (var j = 0; j < opts.length; j++) {

                if (opts[j].getAttribute('data-bound') === '1') {
                    continue;
                }

                opts[j].setAttribute('data-bound', '1');

                opts[j].addEventListener('click', function () {
                    setClient(
                        this.getAttribute('data-id'),
                        this.getAttribute('data-name'),
                        this.getAttribute('data-mobile'));
                });
            }
        }

        function hideClientDropdown() {

            var dd = document.getElementById('clientDropdown');

            if (dd) {
                dd.style.display = 'none';
                dd.innerHTML = '';
            }
        }

        // Matches against name AND mobile number.
        function filterClients(term) {

            var t = (term || '').trim().toLowerCase();

            if (!t) {
                return clients.slice(0, CLIENT_PAGE_SIZE);
            }

            var res = [];

            for (var i = 0; i < clients.length; i++) {

                var c = clients[i];

                var name = (c.name || '').toLowerCase();
                var mob = (c.mobile || '').toLowerCase();

                if (name.indexOf(t) >= 0 || mob.indexOf(t) >= 0) {

                    res.push({
                        id: c.id,
                        name: c.name,
                        mobile: c.mobile,
                        text: c.mobile ? (c.name + ' \u00B7 ' + c.mobile) : c.name
                    });
                }
            }

            return res;
        }

        // ==========================================
        // DUPLICATE TICKET CHECK
        // ==========================================

        function checkDuplicate(mobile) {

            if (!mobile || mobile.length < 6) {
                return;
            }

            fetch('@Url.Action("CheckDuplicate","DailySupport")'
                + '?mobile=' + encodeURIComponent(mobile),
                { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(r => r.json())
                .then(data => {

                    if (data && data.hasDuplicate) {

                        var nums = data.tickets
                            .map(t => t.ticketNo)
                            .join(', ');

                        masterShowToast(
                            'Warning: is mobile ka pehle se open ticket hai — '
                            + nums,
                            'error');
                    }
                });
        }

        // ==========================================
        // SUBCATEGORY CASCADE
        // ==========================================

        function loadSubCategories(categoryId, keepSelection) {

            var sel =
                document.getElementById('edit_SubCategoryId');

            sel.innerHTML =
                '<option value="">-- Select Sub Category --</option>';

            for (var i = 0; i < subCategories.length; i++) {

                var s = subCategories[i];

                if (categoryId && s.parentId !== parseInt(categoryId)) {
                    continue;
                }

                var opt = document.createElement('option');
                opt.value = s.id;
                opt.text = s.name;

                if (keepSelection
                    && selectedSubCategoryId === String(s.id)) {
                    opt.selected = true;
                }

                sel.appendChild(opt);
            }
        }

        // ==========================================
        // INIT
        // ==========================================

        document.addEventListener('DOMContentLoaded', function () {

            var clientSearchInput =
                document.getElementById('clientSearchInput');

            clientSearchInput.addEventListener('input', function () {
                renderClientDropdown(filterClients(this.value));
            });

            clientSearchInput.addEventListener('focus', function () {
                renderClientDropdown(filterClients(this.value));
            });

            document.addEventListener('click', function (e) {

                var dd = document.getElementById('clientDropdown');

                if (!clientSearchInput.contains(e.target)
                    && dd && !dd.contains(e.target)) {
                    hideClientDropdown();
                }
            });

            // Duplicate check when a mobile number is typed manually.
            var mobileField = document.getElementById('mobileField');

            mobileField.addEventListener('blur', function () {
                checkDuplicate(this.value.trim());
            });

            // Clear the selected client + auto-filled fields.
            var clearClientBtn = document.getElementById('clientClearBtn');

            if (clearClientBtn) {
                clearClientBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    clearClient();
                });
            }

            // Category -> SubCategory cascade
            document.getElementById('edit_CategoryId')
                .addEventListener('change', function () {
                    loadSubCategories(this.value, false);
                });

            // Initial
            loadSubCategories(
                document.getElementById('edit_CategoryId').value,
                true);

            // Clear
            document.getElementById('clearFormBtn')
                .addEventListener('click', function () {

                    var form =
                        document.getElementById('ticketCreateForm');

                    form.reset();

                    clearClient();

                    loadSubCategories('', false);
                });

            // Submit validation
            document.getElementById('ticketCreateForm')
                .addEventListener('submit', function (event) {

                    event.preventDefault();

                    var clientId =
                        document.getElementById('clientIdField').value;

                    var subject =
                        document.getElementById('edit_Subject')
                            .value.trim();

                    var desc =
                        document.getElementById('edit_Description')
                            .value.trim();

                    var priority =
                        document.getElementById('edit_PriorityId').value;

                    var mobile =
                        document.getElementById('mobileField')
                            .value.trim();

                    if (!clientId) {
                        masterShowToast(
                            'Please select a client.', 'error');
                        return;
                    }

                    if (!mobile) {
                        masterShowToast(
                            'Mobile number is required.', 'error');
                        return;
                    }

                    if (!priority) {
                        masterShowToast(
                            'Please select a priority.', 'error');
                        return;
                    }

                    if (!subject) {
                        masterShowToast(
                            'Issue (Subject) is required.', 'error');
                        return;
                    }

                    if (!desc) {
                        masterShowToast(
                            'Description is required.', 'error');
                        return;
                    }

                    this.submit();
                });
        });

        // ==========================================
        // VOICE TO TEXT
        // ==========================================

        var recognition = null;
        var voiceField = 'Description';

        function speechSupported() {
            return ('webkitSpeechRecognition' in window
                || 'SpeechRecognition' in window);
        }

        function setListening(on) {

            var micBtn =
                document.getElementById('voiceMicBtn_' + voiceField);
            var status =
                document.getElementById('voiceStatus_' + voiceField);

            if (micBtn) {
                if (on) micBtn.classList.add('is-recording');
                else micBtn.classList.remove('is-recording');
            }

            if (status) {
                if (on) {
                    status.innerHTML =
                        '<span class="tkt-voice-dot"></span>'
                        + 'Listening\u2026 speak now';
                    status.classList.add('visible');
                } else {
                    status.classList.remove('visible');
                }
            }
        }

        // Drops Devanagari (Hindi) characters so only English / Hinglish
        // (Roman) text is kept. Hindi words get removed word-level.
        function stripDevanagari(text) {
            return (text || '')
                .replace(/[\u0900-\u097F]+/g, '')
                .replace(/\s{2,}/g, ' ')
                .trim();
        }

        var speechBaseText = '';
        var speechFinal = '';

        function startVoice(fieldName) {

            if (fieldName) voiceField = fieldName;

            var textarea =
                document.getElementById('edit_' + voiceField);

            if (!speechSupported()) {
                alert('Speech Recognition is not supported. Use Chrome.');
                return;
            }

            var SpeechRecognition =
                window.SpeechRecognition
                || window.webkitSpeechRecognition;

            recognition = new SpeechRecognition();
            recognition.lang = 'en-IN';
            recognition.interimResults = true;
            recognition.continuous = true;

            recognition.onstart = function () {
                speechBaseText = textarea.value.trim();
                speechFinal = '';
                setListening(true);
                textarea.focus();
            };

            recognition.onresult = function (event) {

                var interim = '';

                for (var i = event.resultIndex;
                     i < event.results.length; i++) {

                    var raw = event.results[i][0].transcript;

                    if (event.results[i].isFinal) {

                        var clean = stripDevanagari(raw);

                        // Skip all-Hindi and duplicate results.
                        if (!clean) continue;
                        if (speechFinal
                            && speechFinal.indexOf(clean) !== -1) continue;

                        speechFinal += ' ' + clean;

                    } else {
                        interim += stripDevanagari(raw) + ' ';
                    }
                }

                var parts = [];

                if (speechBaseText) parts.push(speechBaseText);
                if (speechFinal.trim()) parts.push(speechFinal.trim());
                if (interim.trim()) parts.push(interim.trim());

                textarea.value = parts.join(' ');
            };

            recognition.onerror = function (event) {
                if (event.error === 'not-allowed') {
                    alert('Microphone permission denied.');
                }
                setListening(false);
            };

            recognition.onend = function () {
                setListening(false);
            };

            try {
                recognition.start();
            } catch (e) {
                alert('Could not start: ' + e.message);
            }
        }

        function stopVoice() {
            if (recognition) recognition.stop();
            setListening(false);
        }

        function resetVoice(fieldName) {

            if (fieldName) voiceField = fieldName;

            if (!confirm('Clear ' + voiceField + '?')) return;

            if (recognition) recognition.stop();
            setListening(false);

            speechBaseText = '';
            speechFinal = '';

            document.getElementById('edit_' + voiceField).value = '';
        }

    </script>
}
