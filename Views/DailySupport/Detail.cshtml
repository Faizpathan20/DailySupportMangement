@model Master.Models.TicketDetailViewModel

@{
    ViewData["Title"] = "Ticket " + Model.TicketNo;

    string Badge(string? name, string prefix) =>
        $"tkt-badge {prefix}-" + (string.IsNullOrWhiteSpace(name)
            ? "default"
            : name!.ToLower().Replace(" ", ""));

    string Dash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "&mdash;" : value!;

    // Duration formatter: "48m" | "4h 48m" | "1d 4h 48m"
    string FormatDuration(int minutes) =>
        Master.Configurations.TicketService.FormatDuration(minutes);

    var lastActivity = Model.Timeline.Count > 0
        ? Model.Timeline.Max(t => t.At)
        : (DateTime?)null;

    var staleDays = lastActivity.HasValue
        ? (Master.Configurations.TicketService.NowIst - lastActivity.Value).TotalDays
        : 0;

    bool isStale = staleDays >= 2
        && !Model.IsClosedByName
        && Model.Timeline.Count > 0;

    // Option A: when the ticket is "Open", hide "Open" from the work
    // status dropdown (adding work auto-moves it to In Progress).
    // All other statuses stay visible so the current one can be kept.
    bool isOpenTicket =
        string.Equals(Model.StatusName, "Open",
            StringComparison.OrdinalIgnoreCase);

    var workStatusOptions = isOpenTicket
        ? Model.StatusOptions
            .Where(s => !string.Equals(
                s.Name, "Open", StringComparison.OrdinalIgnoreCase))
            .ToList()
        : Model.StatusOptions;

    // ---- Timeline ko do layers me split ----
    // Work Log = aapka kaam (KindKey "work" / "note").
    // System Activity = automatic events (created / status / assign / ...).
    var workLog = Model.Timeline
        .Where(t => t.KindKey == "work" || t.KindKey == "note")
        .OrderByDescending(t => t.At)
        .ToList();

    var systemLog = Model.Timeline
        .Where(t => t.KindKey != "work" && t.KindKey != "note")
        .OrderByDescending(t => t.At)
        .ToList();

    // ============================================================
    // STEPPER — 5 steps
    // Open > In Progress > Waiting > Resolved > Closed
    //
    // DB me 6 statuses hain. "On Hold" aur "Pending Review"
    // dono WAITING step pe map hote hain.
    // ============================================================

    var stepDefs = new (string Label, string[] Match)[]
    {
        ("Open",        new[] { "Open" }),
        ("In Progress", new[] { "In Progress" }),
        ("Waiting",     new[] { "On Hold", "Pending Review" }),
        ("Resolved",    new[] { "Resolved" }),
        ("Closed",      new[] { "Closed" })
    };

    int currentStepIndex = -1;

    for (int i = 0; i < stepDefs.Length; i++)
    {
        if (stepDefs[i].Match.Any(m => string.Equals(
            m, Model.StatusName,
            StringComparison.OrdinalIgnoreCase)))
        {
            currentStepIndex = i;
            break;
        }
    }

    // ---- Stepper track geometry ----
    // Grid me n columns hain, to dot ke centers 0.5/n, 1.5/n, ... (n-0.5)/n
    // par padte hain. Track line in dono ke beech hi honi chahiye, aur
    // progress line current dot ke center tak pahunchni chahiye.
    int stepCount = stepDefs.Length;

    // left / right inset (%) — pehle aur last dot ke center tak
    int stepTrackInsetPct = (int)Math.Round(50.0 / stepCount);

    // kitna % track bhara hua (current dot ke center tak)
    int stepProgressPct = currentStepIndex < 0
        ? 0
        : (int)Math.Round(currentStepIndex * 100.0 / stepCount);

    // Days the ticket has been sitting in the current status.
    var stageSince = Model.Timeline
        .Where(t => t.KindKey == "status"
                    && string.Equals(t.NewStatus, Model.StatusName,
                        StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(t => t.At)
        .Select(t => (DateTime?)t.At)
        .FirstOrDefault();

    var stageDays = stageSince.HasValue
        ? Math.Max(0, (int)(Master.Configurations.TicketService.NowIst
            - stageSince.Value).TotalDays)
        : 0;

    // ---- Assignment logic (header) ----
    // CreatedBy = jisne assign kiya, AssignedTo = jise kiya.
    bool isSelfAssigned =
        Model.CreatedBy.HasValue
        && Model.AssignedTo.HasValue
        && Model.CreatedBy.Value == Model.AssignedTo.Value;

    // ---- Aaj ka time (aaj ki work updates ka total) ----
    var todayDate = Master.Configurations.TicketService.NowIst.Date;

    int todayMinutes = Model.Updates
        .Where(u => u.WorkDate.Date == todayDate)
        .Sum(u => u.TimeSpent ?? 0);

    // Review card me "sent by" — assignee ya creator.
    string reviewSentBy =
        string.IsNullOrWhiteSpace(Model.AssignedToName)
            ? Model.CreatedByName
            : Model.AssignedToName;
}


@* ============================================================
   TICKET DETAIL — REDESIGN (Tailwind)
   1. Sticky header  2. Stepper  3. Body grid
   4. Work logs      5. Bottom (Review / Activity / Tickets)
   ============================================================ *@


@if (TempData["Success"] != null)
{
    <div class="success-message">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="error-message">
        @Html.Raw(TempData["Error"])
    </div>
}

@* Anti-forgery token for AJAX posts *@
@Html.AntiForgeryToken()


<!-- ================= NOTIFICATION STRIP (is ticket ka latest) ================= -->

<div id="detailNotifList"
     class="tkt-notif-strip-wrap"
     data-ticket="@Model.Id"
     style="display:none;"></div>


@* ================= 1. STICKY HEADER ================= *@

<header class="sticky top-0 z-50 bg-white border-b border-gray-200 px-6 py-4 shadow-sm">

    <div class="flex items-start justify-between gap-6 flex-wrap">

        <!-- ---------- LEFT ---------- -->
        <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 min-w-0">

            <a href="@Url.Action("Index", "DailySupport")"
               class="shrink-0 w-10 h-10 inline-flex items-center justify-center rounded-xl border border-gray-200 bg-white text-blue-600 hover:bg-blue-600 hover:border-blue-600 hover:text-white transition"
               title="Back to Daily Support"
               aria-label="Back to Daily Support">

                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.2" stroke-linecap="round"
                     stroke-linejoin="round" class="w-5 h-5">
                    <path d="m15 18-6-6 6-6" />
                </svg>

            </a>

            <div class="min-w-0">

                <div class="flex items-center gap-2.5 flex-wrap">

                    <h1 class="text-xl font-bold text-gray-900 leading-none">
                        @Model.TicketNo
                    </h1>

                    @* Red dot = is ticket ka aapke liye unread notification *@
                    @if (Model.HasUnreadNotification)
                    {
                        <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-pulse"
                              title="Aapke liye unread notification hai"></span>
                    }

                    <span class="@Badge(Model.StatusName, "tkt-b")">
                        @Model.StatusName
                    </span>

                    @if (!string.IsNullOrWhiteSpace(Model.PriorityName))
                    {
                        <span class="@Badge(Model.PriorityName, "tkt-b")">
                            @Model.PriorityName
                        </span>
                    }

                    @if (isStale)
                    {
                        <span class="text-xs font-medium text-amber-700 bg-amber-50 border border-amber-200 rounded-full px-2.5 py-1">
                            @((int)staleDays) din se koi activity nahi
                        </span>
                    }

                </div>

                @* ---------- Assignment logic ---------- *@
                <div class="mt-2 text-sm text-gray-600 flex items-center gap-2 flex-wrap">

                    @if (isSelfAssigned)
                    {
                        <span class="inline-flex items-center gap-1.5 font-medium text-gray-700">
                            <span class="w-2 h-2 rounded-full bg-green-500"></span>
                            Self Assigned &bull; @Model.AssignedToName
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center gap-1.5">
                            Assigned By:
                            <strong class="font-semibold text-gray-800">
                                @Model.CreatedByName
                            </strong>
                        </span>

                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2.5" stroke-linecap="round"
                             stroke-linejoin="round"
                             class="w-4 h-4 text-gray-400">
                            <path d="M5 12h14" />
                            <path d="m12 5 7 7-7 7" />
                        </svg>

                        <span class="inline-flex items-center gap-1.5">
                            Assigned To:
                            <strong class="font-semibold text-gray-800">
                                @Model.AssignedToName
                            </strong>
                        </span>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.ClientName))
                    {
                        <span class="text-gray-300">&bull;</span>

                        <span class="font-medium text-gray-700">
                            @Model.ClientName
                        </span>
                    }

                </div>

            </div>

        </div>


        <!-- ---------- RIGHT ---------- -->
        <div class="flex items-center gap-3 sm:gap-5 flex-wrap w-full sm:w-auto justify-start sm:justify-end">

            <div class="text-right">
                <div class="text-[11px] uppercase tracking-wide text-gray-500">
                    Total Time
                </div>
                <div class="text-lg font-bold text-gray-900 leading-tight">
                    @FormatDuration(Model.TimeSpentMinutes)
                </div>
            </div>

            <div class="flex items-center gap-2 flex-wrap w-full sm:w-auto justify-start sm:justify-end">

                @if (!Model.IsReadOnly && Model.CanAddWork)
                {
                    <button type="button"
                            class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 transition"
                            onclick="openUpdateModal()">

                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round" class="w-4 h-4">
                            <path d="M12 5v14M5 12h14" />
                        </svg>

                        Add Work Log

                    </button>
                }

                @if (!Model.IsReadOnly && Model.CanAssign)
                {
                    <button type="button"
                            class="inline-flex items-center gap-2 rounded-xl border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50 transition"
                            onclick="openAssignModal()">

                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round" class="w-4 h-4">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M22 11h-6" />
                        </svg>

                        Re-Assign

                    </button>
                }

                @if (Model.CanClose)
                {
                    <button type="button"
                            class="inline-flex items-center gap-2 rounded-xl bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-700 transition"
                            onclick="openCloseConfirm()">

                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round" class="w-4 h-4">
                            <path d="M20 6 9 17l-5-5" />
                        </svg>

                        Close Ticket

                    </button>
                }

                @if (Model.IsReadOnly)
                {
                    <span class="tkt-readonly">Ticket Closed &ndash; View Only</span>
                }

            </div>

        </div>

    </div>

</header>


@* ================= 2. STEPPER ================= *@

<div class="bg-white border-b border-gray-200 px-6 py-5">

    @* Track line: pehle dot ke CENTER (10%) se last dot ke CENTER (90%)
       tak. Isliye line dots ke neeche se aati hai aur perfectly
       connected lagti hai — pehle/last dot ke bahar nahi nikalti. *@
    <div class="relative">

        <div class="absolute top-[18px] h-[4px] bg-gray-200 rounded-full"
             style="left:@(stepTrackInsetPct)%; right:@(stepTrackInsetPct)%"></div>

        @if (stepProgressPct > 0)
        {
            <div class="absolute top-[18px] h-[4px] bg-blue-500 rounded-full"
                 style="left:@(stepTrackInsetPct)%; width:@(stepProgressPct)%"></div>
        }

        <div class="relative grid grid-cols-5">

            @for (int i = 0; i < stepDefs.Length; i++)
            {
                var step = stepDefs[i];

                bool isCurrent = (i == currentStepIndex);
                bool isDone = (currentStepIndex >= 0 && i < currentStepIndex);

                <div class="flex flex-col items-center gap-2.5 text-center">

                    <div class="w-10 h-10 rounded-full flex items-center justify-center text-base font-bold border-2
                                @(isCurrent ? "bg-blue-600 border-blue-600 text-white shadow-md shadow-blue-200"
                                  : isDone ? "bg-blue-500 border-blue-500 text-white"
                                  : "bg-white border-gray-300 text-gray-400")">

                        @if (isDone)
                        {
                            @Html.Raw("&#10003;")
                        }
                        else
                        {
                            @(i + 1)
                        }

                    </div>

                    <div class="text-xs font-semibold leading-tight
                                @(isCurrent ? "text-blue-700"
                                  : isDone ? "text-gray-700"
                                  : "text-gray-400")">
                        @step.Label
                    </div>

                </div>
            }

        </div>

    </div>

    @if (currentStepIndex >= 0)
    {
        <div class="mt-4 text-xs text-gray-500 text-center">
            Now at <strong class="text-gray-700">@Model.StatusName</strong>
            @if (stageDays > 0)
            {
                <span>&middot; @stageDays @(stageDays == 1 ? "day" : "days") in this stage</span>
            }
        </div>
    }

</div>


@* ================= 3. BODY (3 TOP CARDS + FULL WIDTH ISSUE) ================= *@

<div class="p-6">

    <!-- ---------- TOP 3 CARDS ---------- -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">

        <!-- Client Info -->
        <div class="h-[160px] bg-white rounded-2xl border border-gray-200 shadow-sm p-5 flex flex-col overflow-hidden">

            <div class="flex items-center gap-2 mb-3">
                <span class="w-7 h-7 rounded-lg bg-green-50 text-green-600 inline-flex items-center justify-center shrink-0">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" class="w-3.5 h-3.5">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                </span>
                <h2 class="text-[11px] font-bold uppercase tracking-widest text-gray-500">
                    Client Info
                </h2>
            </div>

            <div class="space-y-2 text-sm">

                <div class="flex items-start justify-between gap-3">
                    <span class="text-gray-500 shrink-0">Name</span>
                    <span class="font-semibold text-gray-900 text-right">
                        @Model.ClientName
                    </span>
                </div>

                <div class="flex items-start justify-between gap-3">
                    <span class="text-gray-500 shrink-0">Phone</span>
                    <span class="text-right">
                        @if (!string.IsNullOrWhiteSpace(Model.Mobile))
                        {
                            <a href="tel:@Model.Mobile"
                               class="font-semibold text-blue-600 hover:underline">
                                @Model.Mobile
                            </a>
                        }
                        else
                        {
                            <span class="text-gray-400">&mdash;</span>
                        }
                    </span>
                </div>

                <div class="flex items-start justify-between gap-3">
                    <span class="text-gray-500 shrink-0">Email</span>
                    <span class="text-right min-w-0">
                        @if (!string.IsNullOrWhiteSpace(Model.ClientEmail))
                        {
                            <a href="mailto:@Model.ClientEmail"
                               title="@Model.ClientEmail"
                               class="block text-[11px] font-medium text-blue-600 hover:underline truncate">
                                @Model.ClientEmail
                            </a>
                        }
                        else
                        {
                            <span class="text-gray-400">&mdash;</span>
                        }
                    </span>
                </div>

            </div>

        </div>


        <!-- Classification -->
        <div class="h-[160px] bg-white rounded-2xl border border-gray-200 shadow-sm p-5 flex flex-col">

            <div class="flex items-center gap-2 mb-3">
                <span class="w-7 h-7 rounded-lg bg-violet-50 text-violet-600 inline-flex items-center justify-center shrink-0">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" class="w-3.5 h-3.5">
                        <path d="m12 2 9 5-9 5-9-5 9-5Z" />
                        <path d="m3 12 9 5 9-5" />
                        <path d="m3 17 9 5 9-5" />
                    </svg>
                </span>
                <h2 class="text-[11px] font-bold uppercase tracking-widest text-gray-500">
                    Classification
                </h2>
            </div>

            <div class="space-y-2 text-sm">

                <div class="flex items-center justify-between gap-3">
                    <span class="text-gray-500">Channel</span>
                    <span class="font-semibold text-gray-900 text-right">
                        @Html.Raw(Dash(Model.ChannelName))
                    </span>
                </div>

                <div class="flex items-center justify-between gap-3">
                    <span class="text-gray-500">Priority</span>
                    <span class="font-semibold text-gray-900 text-right">
                        @if (!string.IsNullOrWhiteSpace(Model.PriorityName))
                        {
                            <span class="@Badge(Model.PriorityName, "tkt-b")">
                                @Model.PriorityName
                            </span>
                        }
                        else
                        {
                            <text>&mdash;</text>
                        }
                    </span>
                </div>

                <div class="flex items-center justify-between gap-3">
                    <span class="text-gray-500">Category</span>
                    <span class="font-semibold text-gray-900 text-right">
                        @Html.Raw(Dash(Model.CategoryName))
                    </span>
                </div>

            </div>

        </div>


        <!-- Time Card -->
        <div class="h-[160px] bg-white rounded-2xl border border-gray-200 shadow-sm p-5 flex flex-col">

            <div class="flex items-center gap-2 mb-3">
                <span class="w-7 h-7 rounded-lg bg-amber-50 text-amber-600 inline-flex items-center justify-center shrink-0">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" class="w-3.5 h-3.5">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 7v5l3 2" />
                    </svg>
                </span>
                <h2 class="text-[11px] font-bold uppercase tracking-widest text-gray-500">
                    Time
                </h2>
            </div>

            <div class="space-y-2 text-sm">

                <div class="flex items-center justify-between gap-3">
                    <span class="text-gray-500">Today</span>
                    <span class="font-bold text-gray-900">
                        @FormatDuration(todayMinutes)
                    </span>
                </div>

                <div class="flex items-center justify-between gap-3">
                    <span class="text-gray-500">Total</span>
                    <span class="font-bold text-blue-600">
                        @FormatDuration(Model.TimeSpentMinutes)
                    </span>
                </div>

            </div>

        </div>

    </div>


    <!-- ---------- ISSUE CARD (FULL WIDTH) ---------- -->
    <div class="mt-6 bg-white rounded-2xl border border-gray-200 shadow-sm p-4 sm:p-6">

        <div class="flex items-center gap-3 flex-wrap">

            <span class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 inline-flex items-center justify-center shrink-0">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round" class="w-5 h-5">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                </svg>
            </span>

            <h2 class="text-xs font-bold uppercase tracking-widest text-gray-500">
                Issue
            </h2>

            @* Chhota category tag — [software] *@
            @if (!string.IsNullOrWhiteSpace(Model.CategoryName))
            {
                <span class="rounded-full bg-gray-100 px-2.5 py-1 text-[11px] font-semibold text-gray-700 lowercase">
                    @Model.CategoryName
                </span>
            }
            else if (!string.IsNullOrWhiteSpace(Model.ChannelName))
            {
                <span class="rounded-full bg-gray-100 px-2.5 py-1 text-[11px] font-semibold text-gray-700 lowercase">
                    @Model.ChannelName
                </span>
            }

        </div>

        <div class="text-lg font-bold text-gray-900 leading-snug mt-4">
            @Model.Subject
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="mt-4 rounded-xl bg-gray-50 border border-gray-100 p-4 text-gray-600 leading-relaxed whitespace-pre-line">
                @Model.Description
            </div>
        }

    </div>

</div>


@* ================= 4. WORK LOGS (collapsible, closed by default) ================= *@

<details id="tktWorkLogs"
         class="group mx-6 mt-2 bg-gray-50 rounded-2xl border border-gray-200 overflow-hidden">

    <summary class="flex items-center justify-between gap-4 flex-wrap px-6 py-4 cursor-pointer select-none hover:bg-white transition list-none">

        <div class="flex items-center gap-3 min-w-0">

            <span class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 inline-flex items-center justify-center shrink-0">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round"
                     stroke-linejoin="round" class="w-5 h-5">
                    <path d="M12 20h9" />
                    <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                </svg>
            </span>

            <div class="min-w-0">
                <h2 class="text-base font-bold text-gray-900">
                    Work Logs (@workLog.Count)
                </h2>
                <p class="text-xs text-gray-500 mt-1">
                    Total: <span class="font-bold text-blue-600">@FormatDuration(Model.TimeSpentMinutes)</span>
                </p>
            </div>

        </div>

        <div class="flex items-center gap-3 shrink-0">

            @if (!Model.IsReadOnly && Model.CanAddWork)
            {
                <button type="button"
                        class="inline-flex items-center gap-2 rounded-xl bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 transition"
                        onclick="event.preventDefault(); event.stopPropagation(); openUpdateModal();">

                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" class="w-4 h-4">
                        <path d="M12 5v14M5 12h14" />
                    </svg>

                    Add Work Log

                </button>
            }

            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.5" stroke-linecap="round"
                 stroke-linejoin="round"
                 class="w-5 h-5 text-gray-400 group-open:rotate-180 transition shrink-0">
                <path d="m6 9 6 6 6-6" />
            </svg>

        </div>

    </summary>

    <div class="px-6 pb-6 pt-5 border-t border-gray-100">

    @if (workLog.Count == 0)
    {
        <div class="text-sm text-gray-500">
            Abhi tak koi work update nahi likha.
        </div>
    }
    else
    {
        <div class="relative pl-10">

            @* Vertical line *@
            <div class="absolute left-[15px] top-2 bottom-2 w-0.5 bg-gray-200"></div>

            @foreach (var item in workLog.OrderBy(t => t.At))
            {
                var kindKey = string.IsNullOrWhiteSpace(item.KindKey)
                    ? "work"
                    : item.KindKey;

                bool hasNext = !string.IsNullOrWhiteSpace(item.NextAction);
                bool hasWaiting = !string.IsNullOrWhiteSpace(item.WaitingOn);

                string initial = string.IsNullOrWhiteSpace(item.ByName)
                    ? "?"
                    : item.ByName.Trim().Substring(0, 1).ToUpperInvariant();

                <div class="relative mb-4">

                    @* Avatar circle *@
                    <div class="absolute -left-10 top-3 w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center text-sm font-bold shadow-sm">
                        @initial
                    </div>

                    <div class="rounded-xl border shadow-sm p-4
                                @(hasWaiting ? "bg-orange-50 border-orange-200"
                                  : hasNext ? "bg-blue-50 border-blue-200"
                                  : "bg-white border-gray-200")">

                        <div class="flex items-center justify-between gap-3 flex-wrap">

                            <div class="flex items-center gap-2 flex-wrap">

                                <span class="text-sm font-bold text-gray-900">
                                    @item.ByName
                                </span>

                                <span class="text-xs text-gray-500">
                                    @item.At.ToString("dd MMM yyyy, hh:mm tt")
                                </span>

                                @if (item.WorkDate.HasValue)
                                {
                                    <span class="text-[11px] rounded-full bg-white border border-gray-200 px-2 py-0.5 text-gray-500">
                                        Work for @item.WorkDate.Value.ToString("dd MMM")
                                    </span>
                                }

                            </div>

                            @if (item.TimeSpent.HasValue && item.TimeSpent.Value > 0)
                            {
                                <span class="text-sm font-bold text-blue-600">
                                    @FormatDuration(item.TimeSpent.Value)
                                </span>
                            }

                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.Body))
                        {
                            <div class="mt-2 text-sm text-gray-700 leading-relaxed whitespace-pre-line">
                                @item.Body
                            </div>
                        }

                        @if (hasNext)
                        {
                            <div class="mt-3 rounded-lg bg-white border border-blue-200 px-3 py-2 text-sm text-blue-800">
                                <strong class="font-semibold">Next Step:</strong>
                                @item.NextAction
                            </div>
                        }

                        @if (hasWaiting)
                        {
                            <div class="mt-2 rounded-lg bg-white border border-orange-200 px-3 py-2 text-sm text-orange-800">
                                <strong class="font-semibold">Waiting On:</strong>
                                @item.WaitingOn
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(item.ResolutionNote))
                        {
                            <div class="mt-2 rounded-lg bg-white border border-green-200 px-3 py-2 text-sm text-green-800">
                                <strong class="font-semibold">Resolution:</strong>
                                @item.ResolutionNote
                            </div>
                        }

                        @if (item.FollowUpDate.HasValue)
                        {
                            <div class="mt-2 text-xs text-gray-500">
                                &#128197; Follow-up:
                                @item.FollowUpDate.Value.ToString("dd MMM yyyy")
                            </div>
                        }

                    </div>

                </div>
            }

        </div>
    }

    </div>

</details>


@* ================= 5. BOTTOM SECTION ================= *@

<div class="p-6 space-y-6">

    @* ---------- REVIEW CARD ---------- *@
    @if (Model.IsPendingReview || Model.Reviews.Count > 0)
    {
        <div id="tktReviewCard"
             class="bg-white rounded-2xl border border-gray-200 border-l-4 border-l-green-500 shadow-sm p-6">

            <div class="flex items-center gap-3 mb-5">

                <span class="w-9 h-9 rounded-xl bg-green-50 text-green-600 inline-flex items-center justify-center shrink-0">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" class="w-5 h-5">
                        <path d="M21.8 10A10 10 0 1 1 17 3.34" />
                        <path d="m9 11 3 3L22 4" />
                    </svg>
                </span>

                <h2 class="text-xs font-bold uppercase tracking-widest text-gray-500">
                    Review
                </h2>

                @if (Model.IsPendingReview)
                {
                    <span class="tkt-review-state pending">pending with admin</span>
                }
                else if (Model.Reviews.Count > 0)
                {
                    var last = Model.Reviews[0];
                    bool ok = string.Equals(last.ReviewAction, "Approved",
                        StringComparison.OrdinalIgnoreCase);

                    <span class="tkt-review-state @(ok ? "ok" : "no")">
                        @(ok ? "approved" : "rejected")
                    </span>
                }

            </div>

            @if (Model.IsPendingReview)
            {
                if (Model.IsAdmin)
                {
                    @* Admin: accept / reject + rating + message (mic) *@
                    <form id="reviewForm"
                          class="tkt-review-form"
                          data-ticket="@Model.Id"
                          onsubmit="return submitReview(event);">

                        <input type="hidden" name="ticketId" value="@Model.Id" />

                        @Html.AntiForgeryToken()

                        <div class="tkt-review-sent">
                            Sent for review by
                            <strong>@reviewSentBy</strong>
                        </div>

                        <div class="tkt-review-actions">

                            <label class="tkt-review-pick">
                                <input type="radio" name="action" value="accept" checked />
                                <span>&#9989; Accept</span>
                            </label>

                            <label class="tkt-review-pick">
                                <input type="radio" name="action" value="reject" />
                                <span>&#10060; Reject</span>
                            </label>

                        </div>

                        <div class="tkt-review-rate">
                            <span class="tkt-review-rate-label">Rating</span>

                            <div class="tkt-star-row" id="reviewStars">
                                @for (int s = 1; s <= 5; s++)
                                {
                                    <button type="button"
                                            class="tkt-star text-3xl"
                                            data-value="@s">&#9734;</button>
                                }
                            </div>

                            <input type="hidden" name="rating" id="reviewRating" value="" />
                        </div>

                        <div class="tkt-review-msg">
                            <label>Message</label>

                            <div class="tkt-input-wrap">

                                <div class="tkt-voice-wrap">
                                    <textarea name="remarks"
                                              id="reviewMessage"
                                              rows="3"
                                              maxlength="500"
                                              placeholder="Kya theek hai / kya dobara chahiye..."></textarea>

                                    <button type="button"
                                            class="tkt-mic-btn tkt-voice-btn"
                                            id="reviewVoiceBtn"
                                            title="Voice input"
                                            onclick="toggleVoice(this, 'reviewMessage')">&#127908;</button>
                                </div>

                                <span class="tkt-btn-row">
                                    <button type="button"
                                            class="tkt-clear-btn"
                                            title="Clear"
                                            onclick="clearField('reviewMessage')">&#128465;</button>
                                </span>

                                <span class="tkt-count" id="cnt_reviewMessage">0/500</span>

                                <span class="tkt-voice-status" id="voiceStatus_reviewMessage">
                                    <span class="tkt-voice-dot"></span>
                                    Listening&hellip; speak now
                                </span>

                            </div>
                        </div>

                        <div class="tkt-review-buttons">
                            <button type="submit" class="primary-btn">
                                Submit review
                            </button>
                        </div>

                    </form>
                }
                else
                {
                    <div class="tkt-review-wait">
                        &#9203; Aapka review admin ke paas pending hai.
                    </div>
                }
            }

            @if (Model.Reviews.Count > 0)
            {
                @* ---- Review history: dropdown + 10-at-a-time list ---- *@
                @* Latest review sabse upar (Model.Reviews already DESC). *@
                @* Pehle sirf 10 dikhte hain, "Load more" se +10.        *@

                <details id="tktReviewHistory"
                         class="group mt-2 rounded-xl border border-gray-200 overflow-hidden">

                    <summary class="flex items-center justify-between gap-3 px-4 py-3 cursor-pointer select-none bg-gray-50 hover:bg-gray-100 transition list-none">

                        <div class="flex items-center gap-2 min-w-0">

                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2.5" stroke-linecap="round"
                                 stroke-linejoin="round"
                                 class="w-4 h-4 text-gray-400 group-open:rotate-180 transition shrink-0">
                                <path d="m6 9 6 6 6-6" />
                            </svg>

                            <span class="text-xs font-bold uppercase tracking-widest text-gray-500">
                                Review History
                            </span>

                            <span class="tkt-sec-count">&mdash; @Model.Reviews.Count</span>

                        </div>

                        <span id="tktReviewCounter"
                              class="text-[11px] text-gray-500 shrink-0">
                            Showing @Math.Min(10, Model.Reviews.Count) of @Model.Reviews.Count
                        </span>

                    </summary>

                    <div class="px-4 py-3 border-t border-gray-100">

                        <div id="tktReviewList"
                             class="max-h-[320px] overflow-y-auto space-y-2 pr-1">

                            @for (int ri = 0; ri < Model.Reviews.Count; ri++)
                            {
                                var rv = Model.Reviews[ri];
                                bool ok = string.Equals(rv.ReviewAction, "Approved",
                                    StringComparison.OrdinalIgnoreCase);

                                bool isLatest = ri == 0;

                                @* 11th review se aage hidden — "Load more" par dikhta hai *@
                                bool isBeyondFirstPage = ri >= 10;

                                <div data-tkt-review-row
                                     class="flex items-start gap-3 rounded-xl border border-gray-200 bg-white px-3 py-2.5 @(ok ? "border-l-4 border-l-green-500" : "border-l-4 border-l-red-500") @(isLatest ? "shadow-sm ring-1 ring-green-100" : "") @(isBeyondFirstPage ? "hidden" : "")">

                                    <span class="text-xs font-bold shrink-0 mt-0.5 @(ok ? "text-green-600" : "text-red-600")">
                                        @Html.Raw(ok ? "&#9989;" : "&#10060;")
                                    </span>

                                    <div class="min-w-0 flex-1">

                                        <div class="flex items-center gap-2 flex-wrap">

                                            <span class="text-xs font-bold text-gray-900">
                                                @(ok ? "Accepted" : "Rejected")
                                            </span>

                                            <span class="text-[10px] font-bold uppercase tracking-wide rounded-full px-2 py-0.5 border @(ok ? "bg-blue-50 text-blue-700 border-blue-200" : "bg-orange-50 text-orange-700 border-orange-200")">
                                                @(ok ? "Resolved" : "Reopened")
                                            </span>

                                            @if (rv.Rating.HasValue)
                                            {
                                                <span class="text-yellow-400 tracking-tight text-sm">
                                                    @for (int s = 1; s <= 5; s++)
                                                    {
                                                        @Html.Raw(s <= rv.Rating.Value ? "&#9733;" : "&#9734;")
                                                    }
                                                </span>
                                            }

                                        </div>

                                        <div class="text-[11px] text-gray-500 mt-1">
                                            @(string.IsNullOrWhiteSpace(rv.ReviewedByName)
                                                ? "Admin"
                                                : rv.ReviewedByName)
                                            &middot;
                                            @rv.ReviewedAt.ToString("dd MMM yyyy, h:mm tt")
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(rv.Remarks))
                                        {
                                            <div class="text-xs text-gray-700 leading-relaxed mt-1 line-clamp-2">
                                                @rv.Remarks
                                            </div>
                                        }

                                    </div>

                                </div>
                            }

                        </div>

                        @if (Model.Reviews.Count > 10)
                        {
                            <div class="mt-3 flex justify-center" id="tktReviewMoreWrap">
                                <button type="button"
                                        id="tktReviewMore"
                                        class="inline-flex items-center gap-2 rounded-xl border border-gray-300 bg-white px-4 py-2 text-xs font-semibold text-gray-700 shadow-sm hover:bg-gray-50 transition"
                                        onclick="showMoreReviews();">
                                    Load more
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2.5" stroke-linecap="round"
                                         stroke-linejoin="round" class="w-3.5 h-3.5">
                                        <path d="m6 9 6 6 6-6" />
                                    </svg>
                                </button>
                            </div>
                        }

                    </div>

                </details>
            }

        </div>
    }


    @* ---------- SYSTEM ACTIVITY (collapsible, closed by default) ---------- *@
    <details id="tktSystemActivity"
             class="group bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">

        <summary class="flex items-center justify-between gap-4 px-6 py-4 cursor-pointer select-none hover:bg-gray-50 transition list-none">

            <div class="flex items-center gap-3 min-w-0">

                <span class="w-9 h-9 rounded-xl bg-slate-100 text-slate-600 inline-flex items-center justify-center shrink-0">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" class="w-5 h-5">
                        <circle cx="12" cy="12" r="9" />
                        <path d="M12 7v5l3 2" />
                    </svg>
                </span>

                <h2 class="text-xs font-bold uppercase tracking-widest text-gray-500">
                    System Activity
                </h2>

                <span class="tkt-sec-count">&mdash; @systemLog.Count</span>

            </div>

            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.5" stroke-linecap="round"
                 stroke-linejoin="round"
                 class="w-5 h-5 text-gray-400 group-open:rotate-180 transition shrink-0">
                <path d="m6 9 6 6 6-6" />
            </svg>

        </summary>

        <div class="px-6 pb-6 pt-4 border-t border-gray-100">

        @if (systemLog.Count == 0)
        {
            <div class="text-sm text-gray-500">
                No system activity yet.
            </div>
        }
        else
        {
            <div class="tkt-rail tkt-rail-muted">

                @foreach (var item in systemLog)
                {
                    var kindKey = string.IsNullOrWhiteSpace(item.KindKey)
                        ? "work"
                        : item.KindKey;

                    <div class="tkt-rail-item ic-@kindKey">

                        <div class="tkt-rail-marker">
                            <span class="tkt-rail-dot"></span>
                        </div>

                        <div class="tkt-rail-body">

                            <div class="tkt-rail-head">

                                <span class="tkt-rail-title">
                                    @Html.Raw(string.IsNullOrWhiteSpace(item.Icon)
                                        ? "&#128221;"
                                        : item.Icon)
                                    @item.Title
                                </span>

                                @if (!string.IsNullOrWhiteSpace(item.OldStatus)
                                    && !string.IsNullOrWhiteSpace(item.NewStatus))
                                {
                                    <span class="tkt-tl-old">
                                        @item.OldStatus
                                    </span>

                                    <span class="tkt-tl-arrow">&rarr;</span>

                                    <span class="@Badge(item.NewStatus, "tkt-b")">
                                        @item.NewStatus
                                    </span>
                                }

                                <span class="tkt-rail-date">
                                    @item.At.ToString("dd MMM yyyy, HH:mm")
                                </span>

                            </div>

                            @if (!string.IsNullOrWhiteSpace(item.Body))
                            {
                                <div class="tkt-rail-text">
                                    @item.Body
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(item.ByName))
                            {
                                <div class="tkt-rail-meta">
                                    <span>&#128100; @item.ByName</span>
                                </div>
                            }

                        </div>

                    </div>
                }

            </div>
        }

        </div>

    </details>


    @* ---------- CLIENT TICKETS (collapsed accordion) ---------- *@
    <details id="clientTickets"
             class="group bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">

        <summary class="flex items-center justify-between gap-4 px-6 py-4 cursor-pointer select-none hover:bg-gray-50 transition">

            <div class="flex items-center gap-3 min-w-0">

                <span class="w-9 h-9 rounded-xl bg-indigo-50 text-indigo-600 inline-flex items-center justify-center shrink-0">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" class="w-5 h-5">
                        <path d="M8 6h13M8 12h13M8 18h13" />
                        <path d="M3 6h.01M3 12h.01M3 18h.01" />
                    </svg>
                </span>

                <div class="min-w-0">
                    <h2 class="text-sm font-bold text-gray-900">
                        @Model.ClientName &mdash; Tickets
                    </h2>
                    <p class="text-xs text-gray-500 mt-0.5">
                        Total @Model.ClientTotalTickets
                        (@Model.ClientOpenTickets open,
                        @Model.ClientClosedTickets closed)
                    </p>
                </div>

            </div>

            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.5" stroke-linecap="round"
                 stroke-linejoin="round"
                 class="w-5 h-5 text-gray-400 group-open:rotate-180 transition shrink-0">
                <path d="m6 9 6 6 6-6" />
            </svg>

        </summary>

        <div class="px-6 pb-6 pt-1 border-t border-gray-100">

            @if (Model.ClientTickets.Count == 0)
            {
                <div class="text-sm text-gray-500 pt-4">
                    Is client ka koi ticket nahi mila.
                </div>
            }
            else
            {
                <div class="table-container tkt-client-table mt-4">

                    <table>

                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Ticket No</th>
                                <th>Date</th>
                                <th>Issue</th>
                                <th>Category</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Assigned</th>
                                <th>Time</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{ int rowNo = 0; }

                            @foreach (var t in Model.ClientTickets)
                            {
                                rowNo++;

                                bool isCurrent = t.Id == Model.Id;

                                <tr class="@(isCurrent ? "tkt-current-row" : "")">

                                    <td>@rowNo</td>

                                    <td class="col-nowrap">
                                        <a href="@Url.Action("Detail", "DailySupport", new { id = t.Id })"
                                           class="tkt-link">

                                            @t.TicketNo

                                        </a>

                                        @if (isCurrent)
                                        {
                                            <span class="tkt-current-tag">current</span>
                                        }
                                    </td>

                                    <td class="col-nowrap">
                                        @t.SupportDate.ToString("dd/MM/yy")
                                    </td>

                                    <td class="col-wrap">
                                        @t.Subject
                                    </td>

                                    <td class="col-wrap">
                                        @t.CategoryName

                                        @if (!string.IsNullOrWhiteSpace(t.SubCategoryName))
                                        {
                                            <span class="text-gray-400">
                                                &rsaquo; @t.SubCategoryName
                                            </span>
                                        }
                                    </td>

                                    <td class="col-nowrap">
                                        @if (!string.IsNullOrWhiteSpace(t.PriorityName))
                                        {
                                            <span class="@Badge(t.PriorityName, "tkt-b")">
                                                @t.PriorityName
                                            </span>
                                        }
                                        else
                                        {
                                            <text>&mdash;</text>
                                        }
                                    </td>

                                    <td class="col-nowrap">
                                        <span class="@Badge(t.StatusName, "tkt-b")">
                                            @t.StatusName
                                        </span>
                                    </td>

                                    <td class="col-nowrap">
                                        @Html.Raw(Dash(t.AssignedToName))
                                    </td>

                                    <td class="col-nowrap">
                                        @Master.Configurations.TicketService.FormatDuration(t.TimeSpentMinutes)
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </details>

</div>



<!-- ================= ADD WORK MODAL ================= -->

<div id="updateModal" class="modal">

    <div class="modal-content modal-compact">

        <div class="modal-header">

            <h2 id="updateModalTitle">
                Add Today's Work
            </h2>

            <button type="button"
                    class="modal-close"
                    onclick="closeUpdateModal()">

                &times;

            </button>

        </div>

        <div class="form-grid">

            <input type="hidden" id="upd_UpdateId" value="" />

            <div class="form-group">
                <label>
                    Work Date <span style="color:#dc2626;">*</span>
                </label>
                <input type="date"
                       id="upd_WorkDate"
                       value="@DateTime.Today.ToString("yyyy-MM-dd")"
                       required />
            </div>

            <div class="form-group">
                <label>
                    Status <span style="color:#dc2626;">*</span>
                </label>
                <select id="upd_StatusId" required onchange="toggleStatusFields()">
                    @foreach (var s in workStatusOptions)
                    {
                        <option value="@s.Id"
                                selected="@(s.Id == Model.StatusId)">
                            @s.Name
                        </option>
                    }
                </select>
            </div>

            <div class="form-group"></div>

            <!-- Only shown when the status is "On Hold" -->
            <div class="form-group form-group-full" id="upd_WaitingOnGroup" style="display:none;">
                <label>
                    Waiting on <span style="color:#dc2626;">*</span>
                </label>
                <div class="tkt-input-wrap">
                    <input type="text"
                           id="upd_WaitingOn"
                           maxlength="200"
                           placeholder="Kis cheez pe hold hai? (client reply, vendor...)" />
                    <span class="tkt-count" id="cnt_WaitingOn">0/200</span>
                    <span class="tkt-btn-row">
                        <button type="button" class="tkt-clear-btn" title="Clear"
                                onclick="clearField('upd_WaitingOn')">&#128465;</button>
                        <button type="button" class="tkt-mic-btn" title="Voice input"
                                onclick="toggleVoice(this, 'upd_WaitingOn')">&#127908;</button>
                    </span>
                </div>
                <span class="tkt-voice-status" id="voiceStatus_upd_WaitingOn">
                    <span class="tkt-voice-dot"></span>
                    Listening&hellip; speak now
                </span>
            </div>

            <!-- Only shown when the status is "Resolved" -->
            <div class="form-group form-group-full" id="upd_ResolutionNoteGroup" style="display:none;">
                <label>
                    Resolution Note <span style="color:#dc2626;">*</span>
                </label>
                <div class="tkt-input-wrap">
                    <textarea id="upd_ResolutionNote"
                              rows="2"
                              maxlength="500"
                              placeholder="Kaise solve hua?"></textarea>
                    <span class="tkt-count" id="cnt_ResolutionNote">0/500</span>
                    <span class="tkt-btn-row">
                        <button type="button" class="tkt-clear-btn" title="Clear"
                                onclick="clearField('upd_ResolutionNote')">&#128465;</button>
                        <button type="button" class="tkt-mic-btn" title="Voice input"
                                onclick="toggleVoice(this, 'upd_ResolutionNote')">&#127908;</button>
                    </span>
                </div>
                <span class="tkt-voice-status" id="voiceStatus_upd_ResolutionNote">
                    <span class="tkt-voice-dot"></span>
                    Listening&hellip; speak now
                </span>
            </div>

            <div class="form-group form-group-full">
                <label>
                    Work Done <span style="color:#dc2626;">*</span>
                </label>
                <div class="tkt-input-wrap">
                    <textarea id="upd_WorkDone"
                              rows="3"
                              maxlength="1000"
                              placeholder="What did you do today?"
                              required></textarea>
                    <span class="tkt-count" id="cnt_WorkDone">0/1000</span>
                    <span class="tkt-btn-row">
                        <button type="button" class="tkt-clear-btn" title="Clear"
                                onclick="clearField('upd_WorkDone')">&#128465;</button>
                        <button type="button" class="tkt-mic-btn" title="Voice input"
                                onclick="toggleVoice(this, 'upd_WorkDone')">&#127908;</button>
                    </span>
                </div>
                <span class="tkt-voice-status" id="voiceStatus_upd_WorkDone">
                    <span class="tkt-voice-dot"></span>
                    Listening&hellip; speak now
                </span>
            </div>

            <div class="form-group form-group-full">
                <label>
                    Time Spent
                </label>

                <div class="tkt-time-split">
                    <div class="tkt-time-box">
                        <input type="number"
                               id="upd_TimeHours"
                               min="0"
                               max="24"
                               placeholder="0" />
                        <span>hours</span>
                    </div>

                    <div class="tkt-time-box">
                        <input type="number"
                               id="upd_TimeMinutes"
                               min="0"
                               max="59"
                               placeholder="0" />
                        <span>minutes</span>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>
                    Follow-up Date
                </label>
                <input type="date" id="upd_FollowUpDate" />
            </div>

            <div class="form-group form-group-full">
                <label>
                    Next Action
                </label>
                <div class="tkt-input-wrap">
                    <input type="text"
                           id="upd_NextAction"
                           maxlength="500"
                           placeholder="What is next?" />
                    <span class="tkt-count" id="cnt_NextAction">0/500</span>
                    <span class="tkt-btn-row">
                        <button type="button" class="tkt-clear-btn" title="Clear"
                                onclick="clearField('upd_NextAction')">&#128465;</button>
                        <button type="button" class="tkt-mic-btn" title="Voice input"
                                onclick="toggleVoice(this, 'upd_NextAction')">&#127908;</button>
                    </span>
                </div>
                <span class="tkt-voice-status" id="voiceStatus_upd_NextAction">
                    <span class="tkt-voice-dot"></span>
                    Listening&hellip; speak now
                </span>
            </div>

        </div>

        <div class="modal-actions">

            <button type="button"
                    class="save-btn"
                    onclick="saveUpdate()">

                Save Work

            </button>

            <button type="button"
                    class="cancel-btn"
                    onclick="closeUpdateModal()">

                Cancel

            </button>

        </div>

    </div>

</div>


<!-- ================= ASSIGN MODAL ================= -->

<div id="assignModal" class="modal">

    <div class="modal-content modal-compact">

        <div class="modal-header">

            <h2>
                Assign / Reassign
            </h2>

            <button type="button"
                    class="modal-close"
                    onclick="closeAssignModal()">

                &times;

            </button>

        </div>

        <div class="form-grid form-grid-single">

            <div class="form-group">

                <label>
                    Assign To
                </label>

                <select id="assign_UserId">

                    @foreach (var u in Model.Users)
                    {
                        <option value="@u.Id"
                                selected="@(Model.AssignedTo == u.Id)">

                            @u.Name

                        </option>
                    }

                </select>

            </div>

            @* Reassign reason — timeline me dikhta hai *@
            <div class="form-group">

                <label>
                    Reason
                </label>

                <textarea id="assign_Reason"
                          rows="3"
                          maxlength="300"
                          placeholder="Kyu reassign kiya... (timeline me dikhega)"></textarea>

                <span class="tkt-count" id="cnt_assign_Reason">0/300</span>

            </div>

        </div>

        <div class="modal-actions">

            <button type="button"
                    class="save-btn"
                    onclick="saveAssign()">

                Assign

            </button>

            <button type="button"
                    class="cancel-btn"
                    onclick="closeAssignModal()">

                Cancel

            </button>

        </div>

    </div>

</div>


<!-- ================= EDIT WORK CONFIRM ================= -->

<div id="editWorkConfirm" class="tkt-confirm-backdrop">

    <div class="tkt-confirm-box">

        <div class="tkt-confirm-icon">&#9999;&#65039;</div>

        <h3>Do you want to edit this work?</h3>

        <p>
            Ye update edit ho jaayega &mdash; naya update add nahi hoga.
        </p>

        <div class="tkt-confirm-actions">

            <button type="button"
                    class="tkt-btn"
                    onclick="closeEditWorkConfirm()">
                Cancel
            </button>

            <button type="button"
                    class="tkt-btn tkt-confirm-yes"
                    onclick="confirmEditWork()">
                Yes, Edit
            </button>

        </div>

    </div>

</div>


<!-- ================= CLOSE TICKET CONFIRM ================= -->

<div id="closeConfirm" class="tkt-confirm-backdrop">

    <div class="tkt-confirm-box">

        <div class="tkt-confirm-icon">&#9888;&#65039;</div>

        <h3>Do you confirm to close this ticket?</h3>

        <p>
            If you close this, it will be final &mdash; the ticket
            becomes read-only and no further work can be added.
        </p>

        @* Close reason — timeline me dikhta hai *@
        <div class="tkt-confirm-field">

            <label for="close_Remarks">
                Reason / Remarks
            </label>

            <textarea id="close_Remarks"
                      rows="3"
                      maxlength="300"
                      placeholder="Kyu close kiya... (timeline me dikhega)"></textarea>

            <span class="tkt-count" id="cnt_close_Remarks">0/300</span>

        </div>

        <div class="tkt-confirm-actions">

            <button type="button"
                    class="tkt-btn"
                    onclick="closeCloseConfirm()">
                Cancel
            </button>

            <button type="button"
                    class="tkt-btn tkt-confirm-yes tkt-confirm-danger"
                    id="closeConfirmYes"
                    onclick="confirmCloseTicket()">
                Yes, Close
            </button>

        </div>

    </div>

</div>


@section Styles
{
    @* Tailwind build (npm run css). Sirf is page pe load hota hai
         taaki baaki pages Tailwind ke classes se affect na hon. *@
    <link rel="stylesheet"
          href="~/css/tailwind.css?v=3" />
}

@section Scripts
{
    <script>

        var ticketId = @Model.Id;

        var token = document.querySelector(
            'input[name="__RequestVerificationToken"]').value;

        var currentStatusId = @Model.StatusId;

        // ==========================================
        // TIMELINE — CLICK AN ENTRY TO START WORK
        // ==========================================

        // Work Log me kisi row pe click -> confirm -> edit mode me modal.
        // Naya update add nahi hota; wahi row update hota hai.
        var pendingEditRow = null;

        function selectTimelineEntry(row) {

            var rows = document.querySelectorAll('.tkt-rail-item');

            for (var i = 0; i < rows.length; i++) {
                rows[i].classList.remove('selected');
            }

            row.classList.add('selected');

            pendingEditRow = row;

            // Confirm popup -> phir edit modal.
            var box = document.getElementById('editWorkConfirm');

            if (box) {
                box.classList.add('open');
            } else {
                confirmEditWork();
            }
        }

        function closeEditWorkConfirm() {

            var box = document.getElementById('editWorkConfirm');

            if (box) {
                box.classList.remove('open');
            }
        }

        function confirmEditWork() {

            closeEditWorkConfirm();

            var row = pendingEditRow;

            if (!row) {
                return;
            }

            openUpdateModal(true);

            // Purani values pre-fill (edit mode).
            var updateId = row.getAttribute('data-update-id') || '';
            var body = row.getAttribute('data-body') || '';
            var timeSpent = parseInt(
                row.getAttribute('data-time') || '0', 10) || 0;
            var nextAction = row.getAttribute('data-next') || '';
            var waitingOn = row.getAttribute('data-waiting') || '';
            var resolution = row.getAttribute('data-resolution') || '';
            var followUp = row.getAttribute('data-followup') || '';

            document.getElementById('upd_UpdateId').value = updateId;

            if (body) {
                document.getElementById('upd_WorkDone').value = body;
            }

            // minutes -> hours + minutes
            document.getElementById('upd_TimeHours').value =
                timeSpent > 0 ? Math.floor(timeSpent / 60) : '';

            document.getElementById('upd_TimeMinutes').value =
                timeSpent > 0 ? (timeSpent % 60) : '';

            document.getElementById('upd_NextAction').value = nextAction;

            var waitField = document.getElementById('upd_WaitingOn');
            if (waitField) { waitField.value = waitingOn; }

            var resField = document.getElementById('upd_ResolutionNote');
            if (resField) { resField.value = resolution; }

            if (followUp) {
                document.getElementById('upd_FollowUpDate').value = followUp;
            }

            refreshFieldUi('upd_WorkDone');
            refreshFieldUi('upd_NextAction');
            refreshFieldUi('upd_WaitingOn');
            refreshFieldUi('upd_ResolutionNote');
        }

        // ==========================================
        // WORK UPDATE
        // ==========================================

        // isEdit = true -> edit mode (title + hidden UpdateId).
        // isEdit = false/undefined -> naya work add.
        function openUpdateModal(isEdit) {

            var editMode = isEdit === true;

            document.getElementById('upd_UpdateId').value = '';

            var title = document.getElementById('updateModalTitle');

            if (title) {
                title.textContent = editMode
                    ? 'Edit Work Update'
                    : "Add Today's Work";
            }

            document.getElementById('upd_WorkDate').value =
                '@DateTime.Today.ToString("yyyy-MM-dd")';

            // Default to the ticket's current status. If that option is
            // not available (e.g. "Open" is hidden while the ticket is
            // Open), fall back to the first option (In Progress).
            var statusSel = document.getElementById('upd_StatusId');

            statusSel.value = currentStatusId;

            if (!statusSel.value && statusSel.options.length > 0) {
                statusSel.selectedIndex = 0;
            }

            // Edit mode me confirmEditWork() fields bhar deta hai,
            // isliye yahan sirf add mode me clear karo.
            if (!editMode) {
                document.getElementById('upd_WorkDone').value = '';
                document.getElementById('upd_TimeHours').value = '';
                document.getElementById('upd_TimeMinutes').value = '';
                document.getElementById('upd_NextAction').value = '';
                document.getElementById('upd_WaitingOn').value = '';
                document.getElementById('upd_ResolutionNote').value = '';
                document.getElementById('upd_FollowUpDate').value = '';

                // Reset counters + hide the clear buttons.
                ['upd_WaitingOn', 'upd_ResolutionNote',
                    'upd_WorkDone', 'upd_NextAction']
                    .forEach(refreshFieldUi);
            }

            // Show only the fields the selected status needs.
            toggleStatusFields();

            document.getElementById('updateModal').style.display = 'flex';
        }

        // Keeps a field's character counter and clear button in sync
        // with its value.
        function refreshFieldUi(fieldId) {

            var field = document.getElementById(fieldId);
            if (!field) return;

            var wrap = field.closest('.tkt-input-wrap');

            var count = document.getElementById(
                'cnt_' + fieldId.replace('upd_', ''));

            if (count) {
                count.textContent =
                    field.value.length + '/' + field.maxLength;
            }

            if (wrap) {
                wrap.classList.toggle('has-text', field.value.length > 0);
            }
        }

        // Wire live updates for every field that has a counter.
        document.addEventListener('DOMContentLoaded', function () {

            ['upd_WaitingOn', 'upd_ResolutionNote',
                'upd_WorkDone', 'upd_NextAction', 'reviewMessage',
                'assign_Reason', 'close_Remarks']
                .forEach(function (id) {
                    var field = document.getElementById(id);
                    if (field) {
                        field.addEventListener('input',
                            function () { refreshFieldUi(id); });
                    }
                });
        });

        // Shows "Waiting on" only for On Hold and "Resolution Note"
        // only for Resolved. Both become required while visible.
        function toggleStatusFields() {

            var sel = document.getElementById('upd_StatusId');

            var text = sel.options[sel.selectedIndex]
                ? sel.options[sel.selectedIndex].text.trim().toLowerCase()
                : '';

            var isHold = text === 'on hold';
            var isResolved = text === 'resolved';

            var holdGroup =
                document.getElementById('upd_WaitingOnGroup');
            var resGroup =
                document.getElementById('upd_ResolutionNoteGroup');

            holdGroup.style.display = isHold ? '' : 'none';
            resGroup.style.display = isResolved ? '' : 'none';

            document.getElementById('upd_WaitingOn').required = isHold;
            document.getElementById('upd_ResolutionNote').required =
                isResolved;
        }

        // ---- Voice input (Web Speech API) ----
        // Only works on https:// or localhost; the mic button is
        // hidden automatically when the browser/site cannot use it.
        var voiceRec = null;
        var voiceTarget = null;
        var voiceBase = '';
        var voiceFinal = '';
        var voiceSupported =
            ('webkitSpeechRecognition' in window)
            || ('SpeechRecognition' in window);

        // Drops Devanagari (Hindi) characters so only English / Hinglish
        // (Roman) text is kept. Anything Hindi gets removed word-level.
        function stripDevanagari(text) {
            return (text || '')
                .replace(/[\u0900-\u097F]+/g, '')
                .replace(/\s{2,}/g, ' ')
                .trim();
        }

        // Shows / hides the little "Recording..." chip tied to a field.
        function setVoiceStatus(fieldId, on) {

            var chip = document.getElementById('voiceStatus_' + fieldId);

            if (!chip) return;

            if (on) chip.classList.add('visible');
            else chip.classList.remove('visible');
        }

        function toggleVoice(btn, fieldId) {

            if (!voiceSupported) {
                masterShowToast(
                    'Voice input is not supported in this browser.',
                    'error');
                return;
            }

            // Same button pressed again -> stop.
            if (voiceRec && voiceTarget === fieldId) {
                stopVoice();
                return;
            }

            stopVoice();

            var SR = window.SpeechRecognition
                || window.webkitSpeechRecognition;

            voiceRec = new SR();
            voiceRec.lang = 'en-IN';
            voiceRec.continuous = true;
            voiceRec.interimResults = true;

            voiceTarget = fieldId;

            var field = document.getElementById(fieldId);

            voiceBase = (field.value || '').trim();
            voiceFinal = '';

            voiceRec.onstart = function () {
                setVoiceStatus(fieldId, true);
            };

            // Rebuilds the field from base + final + live interim text,
            // so the user can see words appearing as they speak.
            function paint(interim) {

                var parts = [];

                if (voiceBase) parts.push(voiceBase);
                if (voiceFinal) parts.push(voiceFinal);
                if (interim) parts.push(interim);

                field.value = parts.join(' ');
                refreshFieldUi(fieldId);
            }

            voiceRec.onresult = function (e) {

                var interim = '';

                for (var i = e.resultIndex; i < e.results.length; i++) {

                    var raw = e.results[i][0].transcript;

                    if (e.results[i].isFinal) {

                        var clean = stripDevanagari(raw);

                        // Skip empty (all-Hindi) and duplicate results.
                        if (!clean) continue;
                        if (voiceFinal
                            && voiceFinal.indexOf(clean) !== -1) continue;

                        voiceFinal = voiceFinal
                            ? (voiceFinal + ' ' + clean)
                            : clean;

                    } else {
                        interim += stripDevanagari(raw) + ' ';
                    }
                }

                paint(interim.trim());
            };

            voiceRec.onerror = function () {
                stopVoice();
                masterShowToast('Could not capture voice.', 'error');
            };

            voiceRec.onend = function () {
                if (voiceRec) stopVoice();
            };

            voiceRec.start();

            btn.classList.add('recording');
            btn.innerHTML = '&#9899;'; // stop square
            setVoiceStatus(fieldId, true);
        }

        function stopVoice() {

            var btn = document.querySelector('.tkt-mic-btn.recording');

            if (btn) {
                btn.classList.remove('recording');
                btn.innerHTML = '&#127908;';
            }

            if (voiceTarget) {
                setVoiceStatus(voiceTarget, false);
            }

            if (voiceRec) {
                try { voiceRec.stop(); } catch (e) { }
            }

            voiceRec = null;
            voiceTarget = null;
            voiceBase = '';
            voiceFinal = '';
        }

        // Clears a text field (with a confirm so it is not lost by
        // accident).
        function clearField(fieldId) {            var field = document.getElementById(fieldId);
            if (!field || !field.value) return;
            if (confirm('Clear this field?')) {
                field.value = '';
                refreshFieldUi(fieldId);
            }
        }

        // Hide mic buttons where voice input cannot work (e.g. plain
        // http on a non-localhost host) so nothing looks broken.
        document.addEventListener('DOMContentLoaded', function () {
            var canUse =
                window.isSecureContext || voiceSupported === false;

            if (!window.isSecureContext) {
                document.querySelectorAll('.tkt-mic-btn')
                    .forEach(function (b) { b.style.display = 'none'; });
            }
        });

        // ==========================================
        // REVIEW (admin: accept / reject + rating + message)
        // ==========================================

        (function () {

            var stars = document.getElementById('reviewStars');

            if (!stars) {
                return;
            }

            var ratingInput = document.getElementById('reviewRating');

            function paint(value) {

                var btns = stars.querySelectorAll('.tkt-star');

                for (var i = 0; i < btns.length; i++) {

                    var on = (i + 1) <= value;

                    btns[i].textContent = on ? '\u2605' : '\u2606';

                    btns[i].classList.toggle('on', on);
                }
            }

            stars.addEventListener('click', function (e) {

                var btn = e.target.closest('.tkt-star');

                if (!btn) {
                    return;
                }

                // Same star clicked twice -> clear rating.
                var value = parseInt(btn.getAttribute('data-value'), 10);

                if (ratingInput.value === String(value)) {
                    ratingInput.value = '';
                    paint(0);
                    return;
                }

                ratingInput.value = String(value);
                paint(value);
            });

        })();

        function submitReview(e) {

            e.preventDefault();

            var form = document.getElementById('reviewForm');

            if (!form) return false;

            var ticketId = form.getAttribute('data-ticket');

            var action = form.querySelector(
                'input[name="action"]:checked');

            var remarks =
                document.getElementById('reviewMessage').value.trim();

            var rating = document.getElementById('reviewRating').value;

            if (!action) {
                masterShowToast('Choose Accept or Reject.', 'error');
                return false;
            }

            if (action.value === 'reject' && !remarks) {
                masterShowToast(
                    'Reject ke liye message likhna zaruri hai.', 'error');
                return false;
            }

            stopVoice();

            var body = new URLSearchParams();
            body.append('ticketId', ticketId);
            body.append('action', action.value);
            body.append('rating', rating || '');
            body.append('remarks', remarks);
            body.append(
                '__RequestVerificationToken',
                getAntiForgeryToken());

            fetch('@Url.Action("Review", "DailySupport")', {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: body.toString()
            })
                .then(function (r) { return r.json(); })
                .then(function (res) {

                    if (!res.success) {
                        masterShowToast(res.message || 'Review failed.', 'error');
                        return;
                    }

                    masterShowToast(res.message || 'Review saved.', 'success');

                    if (typeof refreshSupportBadge === 'function') {
                        refreshSupportBadge();
                    }

                    setTimeout(function () { location.reload(); }, 700);
                })
                .catch(function () {
                    masterShowToast('Could not save review.', 'error');
                });

            return false;
        }

        // ==========================================
        // REVIEW HISTORY — 10 AT A TIME ("Load more")
        // ==========================================
        //
        // Server saari reviews render karta hai (latest pehle).
        // Sirf pehle 10 dikhte hain — baaki hidden hain.
        // "Load more" click par agle 10 reveal hote hain aur
        // counter ("Showing N of M") update ho jata hai.

        var TKT_REVIEW_PAGE = 10;

        function showMoreReviews() {

            var list = document.getElementById('tktReviewList');

            if (!list) return;

            var rows = list.querySelectorAll('[data-tkt-review-row]');

            var shown = 0;
            var i;

            for (i = 0; i < rows.length; i++) {
                if (!rows[i].classList.contains('hidden')) {
                    shown++;
                }
            }

            var revealed = 0;

            for (i = 0; i < rows.length && revealed < TKT_REVIEW_PAGE; i++) {
                if (rows[i].classList.contains('hidden')) {
                    rows[i].classList.remove('hidden');
                    shown++;
                    revealed++;
                }
            }

            var counter = document.getElementById('tktReviewCounter');

            if (counter) {
                counter.textContent =
                    'Showing ' + shown + ' of ' + rows.length;
            }

            // Sab dikh gaya -> button hata do.
            if (shown >= rows.length) {
                var wrap = document.getElementById('tktReviewMoreWrap');
                if (wrap) {
                    wrap.style.display = 'none';
                }
            }
        }


        // ==========================================
        // CLOSE TICKET (Resolved -> Closed, owner/admin)
        // ==========================================

        function openCloseConfirm() {

            var box = document.getElementById('close_Remarks');

            if (box) {
                box.value = '';
                refreshFieldUi('close_Remarks');
            }

            document.getElementById('closeConfirm').classList.add('open');

            if (box) { box.focus(); }
        }

        function closeCloseConfirm() {
            document.getElementById('closeConfirm').classList.remove('open');
        }

        function confirmCloseTicket() {

            var remarksField = document.getElementById('close_Remarks');

            var remarks = remarksField
                ? remarksField.value.trim()
                : '';

            if (remarks.length < 3) {
                masterShowToast(
                    'Close karne ki wajah (reason) likhna zaruri hai.',
                    'error');

                if (remarksField) { remarksField.focus(); }
                return;
            }

            var btn = document.getElementById('closeConfirmYes');

            if (btn) { btn.disabled = true; }

            var body = new URLSearchParams();
            body.append('ticketId', '@Model.Id');
            body.append('action', 'close');
            body.append('remarks', remarks);
            body.append(
                '__RequestVerificationToken', getAntiForgeryToken());

            fetch('@Url.Action("ChangeStatus", "DailySupport")', {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: body.toString()
            })
                .then(function (r) { return r.json(); })
                .then(function (res) {

                    if (!res.success) {
                        masterShowToast(res.message || 'Close failed.', 'error');
                        if (btn) { btn.disabled = false; }
                        return;
                    }

                    masterShowToast('Ticket closed.', 'success');

                    if (typeof refreshSupportBadge === 'function') {
                        refreshSupportBadge();
                    }

                    markActivityFocus();

                    setTimeout(function () { location.reload(); }, 700);
                })
                .catch(function () {
                    masterShowToast('Could not close ticket.', 'error');
                    if (btn) { btn.disabled = false; }
                });
        }

        // ==========================================
        // SYSTEM ACTIVITY — REASSIGN / CLOSE KE BAAD
        // ==========================================
        //
        // Reload ke baad timeline dropdown khud khul jata hai
        // aur newest entry highlight + scroll hoti hai, taaki
        // "kisko, kyu" turant dikhe.

        function markActivityFocus() {
            try {
                sessionStorage.setItem('tktFocusActivity', '1');
            } catch (e) { /* private mode */ }
        }

        (function () {

            function focusActivity() {

                var flag = null;

                try {
                    flag = sessionStorage.getItem('tktFocusActivity');
                    sessionStorage.removeItem('tktFocusActivity');
                } catch (e) { /* ignore */ }

                if (!flag) { return; }

                var box = document.getElementById('tktSystemActivity');

                if (!box) { return; }

                box.open = true;

                var first = box.querySelector('.tkt-rail-item');

                if (first) {
                    first.classList.add('tkt-rail-flash');
                }

                setTimeout(function () {
                    box.scrollIntoView({
                        behavior: 'smooth',
                        block: 'center'
                    });
                }, 150);

                setTimeout(function () {
                    if (first) {
                        first.classList.remove('tkt-rail-flash');
                    }
                }, 6000);
            }

            if (document.readyState === 'loading') {
                document.addEventListener(
                    'DOMContentLoaded', focusActivity);
            } else {
                focusActivity();
            }

        })();

        // Anti-forgery token (page ke kisi form se).
        function getAntiForgeryToken() {

            var el = document.querySelector('input[name="__RequestVerificationToken"]');

            return el ? el.value : '';
        }

        function closeUpdateModal() {
            stopVoice();
            document.getElementById('updateModal').style.display = 'none';
        }

        function saveUpdate() {

            stopVoice();

            var updateId = document.getElementById('upd_UpdateId').value;
            var isEdit = !!updateId;

            var workDate = document.getElementById('upd_WorkDate').value;
            var statusId = document.getElementById('upd_StatusId').value;
            var workDone = document.getElementById('upd_WorkDone')
                .value.trim();

            // Hours + minutes -> total minutes.
            var hours = parseInt(
                document.getElementById('upd_TimeHours').value || '0', 10) || 0;
            var mins = parseInt(
                document.getElementById('upd_TimeMinutes').value || '0', 10) || 0;
            var timeSpent = (hours * 60) + mins;

            var nextAction = document.getElementById('upd_NextAction')
                .value.trim();
            var waitingOn = document.getElementById('upd_WaitingOn')
                .value.trim();
            var resolutionNote = document.getElementById('upd_ResolutionNote')
                .value.trim();
            var followUpDate = document.getElementById('upd_FollowUpDate')
                .value;

            if (!workDone) {
                masterShowToast('Please write the work done.', 'error');
                return;
            }

            var sel = document.getElementById('upd_StatusId');
            var statusText = sel.options[sel.selectedIndex]
                ? sel.options[sel.selectedIndex].text.trim().toLowerCase()
                : '';

            if (statusText === 'on hold' && !waitingOn) {
                masterShowToast('Please say what you are waiting on.',
                    'error');
                return;
            }

            if (statusText === 'resolved' && !resolutionNote) {
                masterShowToast('Please add a resolution note.', 'error');
                return;
            }

            var url = isEdit
                ? '@Url.Action("EditUpdate","DailySupport")'
                : '@Url.Action("AddUpdate","DailySupport")';

            var headers = { 'X-Requested-With': 'XMLHttpRequest' };
            headers['RequestVerificationToken'] = token;

            var body = new URLSearchParams();
            body.append('__RequestVerificationToken', token);

            if (isEdit) {
                body.append('updateId', updateId);
                body.append('workDate', workDate);
                body.append('workDone', workDone);
                body.append('timeSpent', timeSpent || '');
                body.append('nextAction', nextAction);
                body.append('waitingOn', waitingOn);
                body.append('resolutionNote', resolutionNote);
                body.append('followUpDate', followUpDate);
            } else {
                body.append('ticketId', ticketId);
                body.append('workDate', workDate);
                body.append('statusId', statusId);
                body.append('workDone', workDone);
                body.append('timeSpent', timeSpent || '');
                body.append('nextAction', nextAction);
                body.append('waitingOn', waitingOn);
                body.append('resolutionNote', resolutionNote);
                body.append('followUpDate', followUpDate);
            }

            fetch(url, { method: 'POST', headers: headers, body: body })
                .then(r => r.json())
                .then(function (res) {

                    if (!res.success) {
                        masterShowToast(res.message, 'error');
                        return;
                    }

                    closeUpdateModal();

                    masterShowToast(res.message, 'success');

                    setTimeout(function () {
                        window.location.reload();
                    }, 600);
                });
        }

        // ==========================================
        // ASSIGN
        // ==========================================

        function openAssignModal() {

            var reason = document.getElementById('assign_Reason');

            if (reason) {
                reason.value = '';
                refreshFieldUi('assign_Reason');
            }

            document.getElementById('assignModal').style.display = 'flex';

            if (reason) { reason.focus(); }
        }

        function closeAssignModal() {
            document.getElementById('assignModal').style.display = 'none';
        }

        function saveAssign() {

            var userId = document.getElementById('assign_UserId').value;

            var reasonField = document.getElementById('assign_Reason');

            var reason = reasonField
                ? reasonField.value.trim()
                : '';

            if (reason.length < 3) {
                masterShowToast(
                    'Reassign ki wajah (reason) likhna zaruri hai.',
                    'error');

                if (reasonField) { reasonField.focus(); }
                return;
            }

            postAction('@Url.Action("Assign","DailySupport")', {
                ticketId: ticketId,
                userId: userId,
                reason: reason
            });
        }

        // ==========================================
        // SHARED POST
        // ==========================================

        function postAction(url, data) {

            var headers = { 'X-Requested-With': 'XMLHttpRequest' };
            headers['RequestVerificationToken'] = token;

            var body = new URLSearchParams();
            body.append('__RequestVerificationToken', token);

            for (var key in data) {
                body.append(key, data[key]);
            }

            fetch(url, { method: 'POST', headers: headers, body: body })
                .then(r => r.json())
                .then(function (res) {

                    masterShowToast(
                        res.message,
                        res.success ? 'success' : 'error');

                    if (res.success) {

                        // Reload ke baad System Activity khud khule.
                        markActivityFocus();

                        setTimeout(function () {
                            window.location.reload();
                        }, 700);
                    }
                });
        }

        // ==========================================
        // NOTIFICATION FOCUS (?focus=review)
        // Notification se aaye ho to REVIEW section khud
        // expand + highlight + scroll ho jata hai — review
        // alag feel nahi hota.
        // ==========================================

        (function () {

            function focusReview() {

                var params = new URLSearchParams(
                    window.location.search);

                if (params.get('focus') !== 'review') {
                    return;
                }

                var card = document.getElementById('tktReviewCard');

                if (!card) {
                    return;
                }

                card.classList.remove('collapsed');

                card.classList.add('tkt-review-focus');

                // Review history dropdown bhi khul jata hai,
                // warna review history andar hi chhupi rehti.
                var history = document.getElementById('tktReviewHistory');

                if (history) {
                    history.open = true;
                }

                setTimeout(function () {
                    card.scrollIntoView({
                        behavior: 'smooth',
                        block: 'center'
                    });
                }, 150);

                setTimeout(function () {
                    card.classList.remove('tkt-review-focus');
                }, 6000);
            }

            if (document.readyState === 'loading') {
                document.addEventListener(
                    'DOMContentLoaded', focusReview);
            } else {
                focusReview();
            }

        })();

    </script>
}
