@model Master.Models.TicketDetailViewModel

@{
    ViewData["Title"] = "Ticket " + Model.TicketNo;

    string Badge(string? name, string prefix) =>
        $"tkt-badge {prefix}-" + (string.IsNullOrWhiteSpace(name)
            ? "default"
            : name!.ToLower().Replace(" ", ""));

    string Dash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "&mdash;" : value!;

    // Relative time: "2 hours ago", "yesterday", "3 days ago".
    string TimeAgo(DateTime at)
    {
        var diff = Master.Configurations.TicketService.NowIst - at;

        if (diff.TotalSeconds < 60) return "just now";
        if (diff.TotalMinutes < 60)
            return $"{(int)diff.TotalMinutes} min ago";
        if (diff.TotalHours < 24)
            return $"{(int)diff.TotalHours} hours ago";
        if (diff.TotalDays < 2) return "yesterday";
        if (diff.TotalDays < 30)
            return $"{(int)diff.TotalDays} days ago";

        return at.ToString("dd MMM yyyy");
    }

    var lastActivity = Model.Timeline.Count > 0
        ? Model.Timeline.Max(t => t.At)
        : (DateTime?)null;

    var staleDays = lastActivity.HasValue
        ? (Master.Configurations.TicketService.NowIst - lastActivity.Value).TotalDays
        : 0;

    bool isStale = staleDays >= 2
        && !Model.IsClosedByName
        && Model.Timeline.Count > 0;

    // Option A: when the ticket is "Open", hide "Open" from the work
    // status dropdown (adding work auto-moves it to In Progress).
    // All other statuses stay visible so the current one can be kept.
    bool isOpenTicket =
        string.Equals(Model.StatusName, "Open",
            StringComparison.OrdinalIgnoreCase);

    var workStatusOptions = isOpenTicket
        ? Model.StatusOptions
            .Where(s => !string.Equals(
                s.Name, "Open", StringComparison.OrdinalIgnoreCase))
            .ToList()
        : Model.StatusOptions;

    // ---- Layout 5: split the timeline into two layers ----
    // Work Log = the work YOU logged (KindKey "work" / "note").
    // System Activity = automatic events (created / status / assign / ...).
    var workLog = Model.Timeline
        .Where(t => t.KindKey == "work" || t.KindKey == "note")
        .OrderByDescending(t => t.At)
        .ToList();

    var systemLog = Model.Timeline
        .Where(t => t.KindKey != "work" && t.KindKey != "note")
        .OrderByDescending(t => t.At)
        .ToList();

    // ---- Layout 5: stage bar stages + current index ----
    // "On Hold" is a side-branch, not a pipeline step: a ticket can
    // jump In Progress -> Pending Review without ever being on hold.
    // Keeping it in the bar makes it show as "done" (✓) on that jump.
    // So the bar shows only the main pipeline, and On Hold is shown
    // separately as a chip when the ticket really is on hold.
    var allStages = Model.StatusOptions.ToList();

    var stages = allStages
        .Where(s => !string.Equals(
            s.Name, "On Hold", StringComparison.OrdinalIgnoreCase))
        .ToList();

    bool isOnHold = string.Equals(
        Model.StatusName, "On Hold",
        StringComparison.OrdinalIgnoreCase);

    int currentStageIndex = stages.FindIndex(s =>
        string.Equals(s.Name, Model.StatusName,
            StringComparison.OrdinalIgnoreCase));

    // A stage counts as "done" only when the ticket actually passed
    // through it (per the status history), not merely because it sits
    // earlier in the master list.
    var visitedStatuses = new HashSet<string>(
        Model.Timeline
            .Where(t => t.KindKey == "status")
            .SelectMany(t => new[] { t.OldStatus, t.NewStatus })
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Select(s => s!)
            .Concat(new[] { Model.StatusName }),
        StringComparer.OrdinalIgnoreCase);

    // Days the ticket has been sitting in the current status.
    var stageSince = Model.Timeline
        .Where(t => t.KindKey == "status"
                    && string.Equals(t.NewStatus, Model.StatusName,
                        StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(t => t.At)
        .Select(t => (DateTime?)t.At)
        .FirstOrDefault();

    var stageDays = stageSince.HasValue
        ? Math.Max(0, (int)(Master.Configurations.TicketService.NowIst
            - stageSince.Value).TotalDays)
        : 0;
}

<div class="page-header">

    <a href="@Url.Action("Index", "DailySupport")"
       class="back-link">

        &larr; Back to Daily Support

    </a>

    <!-- ===== Summary header (compact, split) ===== -->
    <div class="tkt-summary">

        <div class="tkt-summary-main">

            <div class="tkt-summary-top">

                <h1>
                    @Model.TicketNo
                </h1>

                <span class="@Badge(Model.StatusName, "tkt-b")">
                    @Model.StatusName
                </span>

                @if (!string.IsNullOrWhiteSpace(Model.PriorityName))
                {
                    <span class="@Badge(Model.PriorityName, "tkt-b")">
                        @Model.PriorityName
                    </span>
                }

            </div>

            <div class="tkt-summary-meta">

                <span>
                    <strong>@Model.ClientName</strong>
                </span>

                @if (!string.IsNullOrWhiteSpace(Model.Mobile))
                {
                    <span>&middot; &#128241; @Model.Mobile</span>
                }

                @if (!string.IsNullOrWhiteSpace(Model.CreatedByName))
                {
                    <span>&middot; Assigned By: <strong>@Model.CreatedByName</strong></span>
                }

                @if (!string.IsNullOrWhiteSpace(Model.AssignedToName))
                {
                    <span>&middot; Assigned To: <strong>@Model.AssignedToName</strong></span>
                }

                <span>&middot; &#9201; @Model.TimeSpentDisplay</span>

                @if (lastActivity.HasValue)
                {
                    <span>&middot; Last activity: @TimeAgo(lastActivity.Value)</span>
                }

            </div>

            @if (isStale)
            {
                <div class="tkt-stale">
                    &#9888; @((int)staleDays) din se koi activity nahi &mdash;
                    follow-up karein.
                </div>
            }

        </div>

        <!-- ===== Quick actions (compact side panel) ===== -->
        <div class="tkt-summary-aside">

            <span class="tkt-aside-title">
                Quick Actions
            </span>

            @if (!Model.IsReadOnly && Model.CanAddWork)
            {
                <button type="button"
                        class="tkt-btn tkt-btn-dark tkt-btn-sm"
                        onclick="openUpdateModal()">

                    &#10133; Add Today's Work

                </button>
            }

            @if (!Model.IsReadOnly && Model.CanAssign)
            {
                <button type="button"
                        class="tkt-btn tkt-btn-sm"
                        onclick="openAssignModal()">

                    &#128100; Assign / Reassign

                </button>
            }

            @if (Model.CanClose)
            {
                <button type="button"
                        class="tkt-btn tkt-btn-close tkt-btn-sm"
                        onclick="openCloseConfirm()">

                    &#9989; Close Ticket

                </button>
            }

            @if (Model.IsReadOnly)
            {
                <span class="tkt-readonly">Ticket Closed – View Only</span>
            }

        </div>

    </div>

</div>


@if (TempData["Success"] != null)
{
    <div class="success-message">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="error-message">
        @Html.Raw(TempData["Error"])
    </div>
}

@* Anti-forgery token for AJAX posts *@
@Html.AntiForgeryToken()


<!-- ================= NOTIFICATION STRIP (is ticket ka latest) ================= -->

<div id="detailNotifList"
     class="tkt-notif-strip-wrap"
     data-ticket="@Model.Id"
     style="display:none;"></div>


<!-- ================= TICKET INFORMATION ================= -->

<div class="tkt-info-wrap">

    <!-- Ticket Details -->
    <div class="state-section tkt-info-card">

        <div class="form-section-title">
            &#127915; TICKET DETAILS
        </div>

        <div class="tkt-info-list">

            <div class="tkt-info-row">
                <span class="tkt-info-key">Ticket No</span>
                <span class="tkt-info-val">@Model.TicketNo</span>
            </div>

            <div class="tkt-info-row">
                <span class="tkt-info-key">Support Date</span>
                <span class="tkt-info-val">
                    @Model.SupportDate.ToString("dd MMM yyyy, hh:mm tt")
                </span>
            </div>

            <div class="tkt-info-row">
                <span class="tkt-info-key">Status</span>
                <span class="tkt-info-val">
                    <span class="@Badge(Model.StatusName, "tkt-b")">
                        @Model.StatusName
                    </span>
                </span>
            </div>

            <div class="tkt-info-row">
                <span class="tkt-info-key">Priority</span>
                <span class="tkt-info-val">
                    @if (!string.IsNullOrWhiteSpace(Model.PriorityName))
                    {
                        <span class="@Badge(Model.PriorityName, "tkt-b")">
                            @Model.PriorityName
                        </span>
                    }
                    else
                    {
                        <text>&mdash;</text>
                    }
                </span>
            </div>

            <div class="tkt-info-row">
                <span class="tkt-info-key">Assigned To</span>
                <span class="tkt-info-val">@Html.Raw(Dash(Model.AssignedToName))</span>
            </div>

            <div class="tkt-info-row">
                <span class="tkt-info-key">Time Spent</span>
                <span class="tkt-info-val">@Model.TimeSpentDisplay</span>
            </div>

        </div>

    </div>


    <!-- Classification -->
    <div class="state-section tkt-info-card">

        <div class="form-section-title">
            &#128193; CLASSIFICATION
        </div>

        <div class="tkt-info-list">

            <div class="tkt-info-row">
                <span class="tkt-info-key">Channel</span>
                <span class="tkt-info-val">@Html.Raw(Dash(Model.ChannelName))</span>
            </div>

            <div class="tkt-info-row">
                <span class="tkt-info-key">Call Type</span>
                <span class="tkt-info-val">@Html.Raw(Dash(Model.CallTypeName))</span>
            </div>

            <div class="tkt-info-row">
                <span class="tkt-info-key">Category</span>
                <span class="tkt-info-val">@Html.Raw(Dash(Model.CategoryName))</span>
            </div>

            <div class="tkt-info-row">
                <span class="tkt-info-key">Sub Category</span>
                <span class="tkt-info-val">@Html.Raw(Dash(Model.SubCategoryName))</span>
            </div>

            <div class="tkt-info-row">
                <span class="tkt-info-key">Caller Name</span>
                <span class="tkt-info-val">@Html.Raw(Dash(Model.CallerName))</span>
            </div>

        </div>

    </div>


    <!-- Resolved / Closed -->
    <div class="state-section tkt-info-card">

        <div class="form-section-title">
            &#9200; TIMELINE
        </div>

        <div class="tkt-info-list">

            <div class="tkt-info-row">
                <span class="tkt-info-key">Resolved On</span>
                <span class="tkt-info-val">
                    @(Model.ResolvedOn.HasValue
                        ? Model.ResolvedOn.Value.ToString("dd MMM yyyy, hh:mm tt")
                        : "—")
                </span>
            </div>

            <div class="tkt-info-row">
                <span class="tkt-info-key">Closed On</span>
                <span class="tkt-info-val">
                    @(Model.ClosedOn.HasValue
                        ? Model.ClosedOn.Value.ToString("dd MMM yyyy, hh:mm tt")
                        : "—")
                </span>
            </div>

        </div>

    </div>

</div>


<!-- ================= ISSUE / DESCRIPTION ================= -->

<div class="state-section tkt-issue-block">

    <div class="form-section-title">
        &#128221; ISSUE
    </div>

    <div class="tkt-issue-subject">
        @Model.Subject
    </div>

    <div class="tkt-issue-body">
        @Model.Description
    </div>

</div>


<!-- ================= STAGE BAR (pipeline: kahan hai) ================= -->

@if (stages.Count > 0)
{
    <div class="state-section tkt-stage-card">

        <div class="form-section-title">
            &#128202; PROGRESS
        </div>

        <div class="tkt-stage-bar">

            @for (int i = 0; i < stages.Count; i++)
            {
                var st = stages[i];
                var isCurrent = currentStageIndex == i;

                // Done = the ticket actually passed through this stage.
                var isDone = !isCurrent
                    && visitedStatuses.Contains(st.Name);

                <div class="tkt-stage @(isDone ? "done" : "")
                            @(isCurrent ? "current" : "")">

                    <div class="tkt-stage-dot">
                        @(isDone ? "✓" : isCurrent ? "●" : "")
                    </div>

                    <div class="tkt-stage-label">
                        @st.Name
                    </div>

                </div>
            }

        </div>

        @if (isOnHold)
        {
            <div class="tkt-stage-onhold">
                &#9208; On Hold
            </div>
        }

        @if (currentStageIndex >= 0 || isOnHold)
        {
            <div class="tkt-stage-caption">
                Now at <strong>@Model.StatusName</strong>
                @if (stageDays > 0)
                {
                    <span>&middot; @stageDays
                        @(stageDays == 1 ? "day" : "days")</span>
                }
            </div>
        }

    </div>
}


<!-- ================= WORK LOG (aapka kaam) ================= -->

<div class="state-section tkt-collapsible tkt-worklog">

    <div class="form-section-title"
         onclick="toggleSection(this)">

        &#128203; WORK LOG
        <span class="tkt-sec-count">
            &mdash; @workLog.Count
            @(workLog.Count == 1 ? "update" : "updates")
        </span>

        <button type="button" class="tkt-sec-toggle"
                title="Show / hide"
                onclick="event.stopPropagation(); toggleSection(this)">&minus;</button>

    </div>

    @if (workLog.Count == 0)
    {
        <p style="color:#64748b; font-size:14px;">
            Abhi tak koi work update nahi likha.
        </p>
    }
    else
    {
        <div class="tkt-rail">

            @foreach (var item in workLog.OrderBy(t => t.At))
            {
                var kindKey = string.IsNullOrWhiteSpace(item.KindKey)
                    ? "work"
                    : item.KindKey;

                <div class="tkt-rail-item ic-@kindKey"
                     tabindex="0"
                     title="Click to start work on this ticket"
                     data-body="@(item.Body ?? string.Empty)"
                     onclick="selectTimelineEntry(this)">

                    <div class="tkt-rail-marker">
                        <span class="tkt-rail-dot"></span>
                    </div>

                    <div class="tkt-rail-body">

                        <div class="tkt-rail-head">

                            <span class="tkt-rail-title">
                                @item.Title
                            </span>

                            @if (item.TimeSpent.HasValue
                                && item.TimeSpent.Value > 0)
                            {
                                <span class="tkt-rail-time">
                                    &#9201; @(item.TimeSpent.Value)m
                                </span>
                            }

                            <span class="tkt-rail-date">
                                @item.At.ToString("dd MMM yyyy")
                            </span>

                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.Body))
                        {
                            <div class="tkt-rail-text">
                                @item.Body
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(item.NextAction))
                        {
                            <div class="tkt-tl-next">
                                &#10132; Next: @item.NextAction
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(item.WaitingOn))
                        {
                            <div class="tkt-tl-wait">
                                &#9208; Waiting on: @item.WaitingOn
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(item.ResolutionNote))
                        {
                            <div class="tkt-tl-resolved">
                                &#9989; Resolution: @item.ResolutionNote
                            </div>
                        }

                        <div class="tkt-rail-meta">

                            @if (!string.IsNullOrWhiteSpace(item.ByName))
                            {
                                <span>&#128100; @item.ByName</span>
                            }

                            @if (item.WorkDate.HasValue)
                            {
                                <span>Work for @item.WorkDate.Value.ToString("dd MMM")</span>
                            }

                            @if (item.FollowUpDate.HasValue)
                            {
                                <span>&#128197; Follow-up: @item.FollowUpDate.Value.ToString("dd MMM")</span>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>


<!-- ================= REVIEW (admin ka decision) ================= -->

@if (Model.IsPendingReview || Model.Reviews.Count > 0)
{
    <div class="state-section tkt-review-card tkt-collapsible">

        <div class="form-section-title"
             onclick="toggleSection(this)">

            &#128269; REVIEW
            @if (Model.IsPendingReview)
            {
                <span class="tkt-review-state pending">pending with admin</span>
            }
            else if (Model.Reviews.Count > 0)
            {
                var last = Model.Reviews[0];
                bool ok = string.Equals(last.ReviewAction, "Approved",
                    StringComparison.OrdinalIgnoreCase);

                <span class="tkt-review-state @(ok ? "ok" : "no")">
                    @(ok ? "approved" : "rejected")
                </span>
            }

            <button type="button" class="tkt-sec-toggle"
                    title="Show / hide"
                    onclick="event.stopPropagation(); toggleSection(this)">&minus;</button>

        </div>

        @if (Model.IsPendingReview)
        {
            if (Model.IsAdmin)
            {
                <!-- Admin: accept / reject + rating + message (mic) -->
                <form id="reviewForm"
                      class="tkt-review-form"
                      data-ticket="@Model.Id"
                      onsubmit="return submitReview(event);">

                    <input type="hidden" name="ticketId" value="@Model.Id" />

                    @Html.AntiForgeryToken()

                    <div class="tkt-review-sent">
                        Sent for review by
                        <strong>@(string.IsNullOrWhiteSpace(Model.AssignedToName) ? Model.CreatedByName : Model.AssignedToName)</strong>
                    </div>

                    <div class="tkt-review-actions">

                        <label class="tkt-review-pick">
                            <input type="radio" name="action" value="accept" checked />
                            <span>&#9989; Accept</span>
                        </label>

                        <label class="tkt-review-pick">
                            <input type="radio" name="action" value="reject" />
                            <span>&#10060; Reject</span>
                        </label>

                    </div>

                    <div class="tkt-review-rate">
                        <span class="tkt-review-rate-label">Rating</span>

                        <div class="tkt-star-row" id="reviewStars">
                            @for (int s = 1; s <= 5; s++)
                            {
                                <button type="button"
                                        class="tkt-star"
                                        data-value="@s">&#9734;</button>
                            }
                        </div>

                        <input type="hidden" name="rating" id="reviewRating" value="" />
                    </div>

                    <div class="tkt-review-msg">
                        <label>Message</label>

                        <div class="tkt-input-wrap">

                            <div class="tkt-voice-wrap">
                                <textarea name="remarks"
                                          id="reviewMessage"
                                          rows="3"
                                          maxlength="500"
                                          placeholder="Kya theek hai / kya dobara chahiye..."></textarea>

                                <button type="button"
                                        class="tkt-mic-btn tkt-voice-btn"
                                        id="reviewVoiceBtn"
                                        title="Voice input"
                                        onclick="toggleVoice(this, 'reviewMessage')">&#127908;</button>
                            </div>

                            <span class="tkt-btn-row">
                                <button type="button"
                                        class="tkt-clear-btn"
                                        title="Clear"
                                        onclick="clearField('reviewMessage')">&#128465;</button>
                            </span>

                            <span class="tkt-count" id="cnt_reviewMessage">0/500</span>

                            <span class="tkt-voice-status" id="voiceStatus_reviewMessage">
                                <span class="tkt-voice-dot"></span>
                                Listening&hellip; speak now
                            </span>

                        </div>
                    </div>

                    <div class="tkt-review-buttons">
                        <button type="submit" class="primary-btn">
                            Submit review
                        </button>
                    </div>

                </form>
            }
            else
            {
                <div class="tkt-review-wait">
                    &#9203; Aapka review admin ke paas pending hai.
                </div>
            }
        }

        @if (Model.Reviews.Count > 0)
        {
            <div class="tkt-decisions">

                <div class="tkt-decisions-title">
                    Review Decision
                </div>

                @for (int ri = 0; ri < Model.Reviews.Count; ri++)
                {
                    var rv = Model.Reviews[ri];
                    bool ok = string.Equals(rv.ReviewAction, "Approved",
                        StringComparison.OrdinalIgnoreCase);

                    bool isLatest = ri == 0;

                    if (ri > 0)
                    {
                        <div class="tkt-decision-sep"></div>
                    }

                    <div class="tkt-decision @(ok ? "ok" : "no")
                                @(isLatest ? "latest" : "")">

                        <div class="tkt-decision-head">

                            <span class="tkt-decision-verdict">
                                @(ok ? "\u2705 Accepted" : "\u274C Rejected")
                            </span>

                            <span class="tkt-decision-badge">
                                @(ok ? "Resolved" : "Reopened")
                            </span>

                            @if (rv.Rating.HasValue)
                            {
                                <span class="tkt-decision-stars">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        @(s <= rv.Rating.Value ? "\u2605" : "\u2606")
                                    }
                                </span>
                            }

                        </div>

                        <div class="tkt-decision-who">
                            @(string.IsNullOrWhiteSpace(rv.ReviewedByName)
                                ? "Admin"
                                : rv.ReviewedByName)
                            &middot;
                            @rv.ReviewedAt.ToString("dd MMM yyyy, h:mm tt")
                        </div>

                        @if (!string.IsNullOrWhiteSpace(rv.Remarks))
                        {
                            <div class="tkt-decision-msg">
                                @rv.Remarks
                            </div>
                        }

                    </div>
                }

            </div>
        }

    </div>
}


<!-- ================= SYSTEM ACTIVITY (system ka record) ================= -->

<div class="state-section tkt-collapsible tkt-sysact collapsed">

    <div class="form-section-title"
         onclick="toggleSection(this)">

        &#9881; SYSTEM ACTIVITY
        <span class="tkt-sec-count">
            &mdash; @systemLog.Count
        </span>

        <button type="button" class="tkt-sec-toggle"
                title="Show / hide"
                onclick="event.stopPropagation(); toggleSection(this)">+</button>

    </div>

    @if (systemLog.Count == 0)
    {
        <p style="color:#64748b; font-size:14px;">
            No system activity yet.
        </p>
    }
    else
    {
        <div class="tkt-rail tkt-rail-muted">

            @foreach (var item in systemLog)
            {
                var kindKey = string.IsNullOrWhiteSpace(item.KindKey)
                    ? "work"
                    : item.KindKey;

                <div class="tkt-rail-item ic-@kindKey">

                    <div class="tkt-rail-marker">
                        <span class="tkt-rail-dot"></span>
                    </div>

                    <div class="tkt-rail-body">

                        <div class="tkt-rail-head">

                            <span class="tkt-rail-title">
                                @(string.IsNullOrWhiteSpace(item.Icon)
                                    ? "\U0001F4DD"
                                    : item.Icon)
                                @item.Title
                            </span>

                            @if (!string.IsNullOrWhiteSpace(item.OldStatus)
                                && !string.IsNullOrWhiteSpace(item.NewStatus))
                            {
                                <span class="tkt-tl-old">
                                    @item.OldStatus
                                </span>

                                <span class="tkt-tl-arrow">&rarr;</span>

                                <span class="@Badge(item.NewStatus, "tkt-b")">
                                    @item.NewStatus
                                </span>
                            }

                            <span class="tkt-rail-date">
                                @item.At.ToString("dd MMM yyyy, HH:mm")
                            </span>

                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.ByName))
                        {
                            <div class="tkt-rail-meta">
                                <span>&#128100; @item.ByName</span>
                            </div>
                        }

                    </div>

                </div>
            }

        </div>
    }

</div>


<!-- ================= CLIENT TICKETS (full table) ================= -->

<div class="state-section tkt-collapsible" id="clientTickets">

    <div class="form-section-title"
         onclick="toggleSection(this)">

        &#128196; @Model.ClientName &mdash; TICKETS

        <span class="tkt-client-count">
            Total @Model.ClientTotalTickets
            (@Model.ClientOpenTickets open, @Model.ClientClosedTickets closed)
        </span>

        <button type="button" class="tkt-sec-toggle"
                title="Show / hide"
                onclick="event.stopPropagation(); toggleSection(this)">−</button>

    </div>

    @if (Model.ClientTickets.Count == 0)
    {
        <p style="color:#64748b; font-size:14px;">
            Is client ka koi ticket nahi mila.
        </p>
    }
    else
    {
        <div class="table-container tkt-client-table">

            <table>

                <thead>
                    <tr>
                        <th>#</th>
                        <th>Ticket No</th>
                        <th>Date</th>
                        <th>Issue</th>
                        <th>Category</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Assigned</th>
                        <th>Time</th>
                    </tr>
                </thead>

                <tbody>
                    @{ int rowNo = 0; }

                    @foreach (var t in Model.ClientTickets)
                    {
                        rowNo++;

                        bool isCurrent = t.Id == Model.Id;

                        <tr class="@(isCurrent ? "tkt-current-row" : "")">

                            <td>@rowNo</td>

                            <td class="col-nowrap">
                                <a href="@Url.Action("Detail", "DailySupport", new { id = t.Id })"
                                   class="tkt-link">

                                    @t.TicketNo

                                </a>

                                @if (isCurrent)
                                {
                                    <span class="tkt-current-tag">current</span>
                                }
                            </td>

                            <td class="col-nowrap">
                                @t.SupportDate.ToString("dd/MM/yy")
                            </td>

                            <td class="col-wrap">
                                @t.Subject
                            </td>

                            <td class="col-nowrap">
                                @Html.Raw(Dash(t.CategoryName))
                                @if (!string.IsNullOrWhiteSpace(t.SubCategoryName))
                                {
                                    <small class="cell-sub">
                                        @t.SubCategoryName
                                    </small>
                                }
                            </td>

                            <td class="col-nowrap">
                                @if (!string.IsNullOrWhiteSpace(t.PriorityName))
                                {
                                    <span class="@Badge(t.PriorityName, "tkt-b")">
                                        @t.PriorityName
                                    </span>
                                }
                                else
                                {
                                    <text>&mdash;</text>
                                }
                            </td>

                            <td class="col-nowrap">
                                <span class="@Badge(t.StatusName, "tkt-b")">
                                    @t.StatusName
                                </span>
                            </td>

                            <td class="col-nowrap">
                                @Html.Raw(Dash(t.AssignedToName))
                            </td>

                            <td class="col-nowrap">
                                @t.TimeSpentDisplay
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>


