@model Master.Models.ClientVisitingViewModel

@{
    ViewData["Title"] = "Client Visiting";
    int totalRecords = Model.TotalRecords;

    var nowrapCols = new HashSet<string>
    {
        "Id",
        "PreviousMeetingId",
        "VisitDate",
        "ClientName",
        "VisitType",
        "UserName",
        "FollowUpDate",
        "EntryOn",
        "Status"
    };

    var gridColumns = new[]
    {
        new { Name = "Id",          Display = "Meeting ID",    Width = 9,  Sort = "num" },
        new { Name = "PreviousMeetingId", Display = "Previous",   Width = 9,  Sort = "num" },
        new { Name = "VisitDate",   Display = "Visit Date",    Width = 9,  Sort = "date" },
        new { Name = "ClientName",  Display = "Client",        Width = 13, Sort = "text" },
        new { Name = "VisitType",   Display = "Visit Type",    Width = 10, Sort = "text" },
        new { Name = "PersonMet",   Display = "Person Met",    Width = 10, Sort = "text" },
        new { Name = "Subject",     Display = "Subject",       Width = 14, Sort = "text" },
        new { Name = "Status",      Display = "Status",        Width = 8,  Sort = "status" },
        new { Name = "UserName",    Display = "User",          Width = 9,  Sort = "text" },
        new { Name = "FollowUpDate",Display = "Follow-Up",     Width = 9,  Sort = "date" },
        new { Name = "EntryOn",     Display = "Entry On",      Width = 10, Sort = "date" }
    }
        .Where(col =>
            col.Name == "ClientName"
            || col.Name == "UserName"
            || Model.AvailableColumns.Contains(col.Name))
        .ToArray();

    string[] statuses =
    {
        "Planned",
        "Completed",
        "Cancelled"
    };

    string[] visitTypes =
    {
        "New Client",
        "Follow Up",
        "Support Visit",
        "Sales Visit",
        "Service Visit",
        "Collection Visit",
        "Other"
    };

    string GetVal(string name)
        => Model.GetFormValue(name);

    string GetErr(string name)
        => Model.FieldError(name);

    string MtgId(string raw)
    {
        return int.TryParse(raw, out int value)
            ? $"MTG-{value:D3}"
            : (raw ?? "");
    }

    bool showOtherVisitType =
        GetVal("VisitType") == "Other";

    string StatusPillClass(string status)
    {
        return status == "Planned"
            ? "badge-pending"
            : status == "Completed"
                ? "badge-completed"
                : status == "Cancelled"
                    ? "badge-cancelled"
                    : "badge-default";
    }
}


<div class="page-header">

    <div>

        <h1>
            Client Visiting
        </h1>

        <p>
            Manage client visit records
        </p>

    </div>

</div>


<!-- ================= KPI CARDS ================= -->

<div class="dashboard-cards">


    <div class="dashboard-card">

        <div class="card-content">

            <p>
                Total Records
            </p>

            <h2 data-kpi="total">
                @Model.TotalRecords
            </h2>

        </div>

        <div class="card-icon">
            📊
        </div>

    </div>


    <div class="dashboard-card">

        <div class="card-content">

            <p>
                Planned
            </p>

            <h2 data-kpi="planned">
                @Model.PlannedCount
            </h2>

        </div>

        <div class="card-icon">
            📅
        </div>

    </div>


    <div class="dashboard-card">

        <div class="card-content">

            <p>
                Completed
            </p>

            <h2 data-kpi="completed">
                @Model.CompletedCount
            </h2>

        </div>

        <div class="card-icon">
            ✅
        </div>

    </div>


    <div class="dashboard-card">

        <div class="card-content">

            <p>
                Cancelled
            </p>

            <h2 data-kpi="cancelled">
                @Model.CancelledCount
            </h2>

        </div>

        <div class="card-icon">
            ⏸️
        </div>

    </div>


</div>


<!-- ================= MESSAGES ================= -->

@if (TempData["Success"] != null)
{
    <div class="success-message">

        @TempData["Success"]

    </div>
}


@if (TempData["Error"] != null)
{
    <div class="error-message">

        @Html.Raw(TempData["Error"])

    </div>
}


<!-- ================= VISIT SECTION ================= -->

<div class="state-section">




    <!-- ================= TABLE TOOLBAR ================= -->

    <div class="table-toolbar">

        <div class="toolbar-left">

            <select id="recordsPerPage"
                    onchange="changeRecordsPerPage()">

                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>

            </select>

            <span class="toolbar-label">
                records per page
            </span>

        </div>


        <div class="toolbar-center">

            <button type="button"
                    class="export-btn excel-btn"
                    onclick="exportExcel()">

                Excel

            </button>

            <button type="button"
                    class="export-btn csv-btn"
                    onclick="exportCSV()">

                CSV

            </button>

            <button type="button"
                    class="export-btn print-btn"
                    onclick="printTable()">

                Print

            </button>

        </div>


        <div class="toolbar-right">

            <span class="toolbar-label">
                Search:
            </span>

            <input type="text"
                   id="tableSearch"
                   placeholder="Search..."
                   oninput="filterTable()" />

            <a href="@Url.Action("Create", "ClientVisiting")"
               class="primary-btn">

                + Add Visit

            </a>

        </div>

    </div>


    <!-- ================= TABLE ================= -->

    <div class="table-container support-table">

        <table id="dataTable">


            <thead>

                <tr>

                    @for (int i = 0; i < gridColumns.Length; i++)
                    {
                        var col = gridColumns[i];

                        string colClass =
                            nowrapCols.Contains(col.Name)
                                ? "col-nowrap"
                                : "col-wrap";

                        <th class="sortable @colClass"
                            data-sort="@col.Sort"
                            onclick="sortTable(this)">

                            <span class="th-text">
                                @col.Display
                            </span>

                            <span class="sort-indicator">
                                <span class="sort-up"></span>
                                <span class="sort-down"></span>
                            </span>

                        </th>
                    }

                    <th class="actions-col">
                        Actions
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (Model.Visits.Count == 0)
                {
                    <tr class="no-data-row"
                        data-search="">

                        <td colspan="@(gridColumns.Length + 1)"
                            class="empty-state">

                            No Records Found on this filter.

                        </td>

                    </tr>
                }
                else
                {
                    @foreach (var visit in Model.Visits)
                    {
                        var searchText = string.Join(
                            " ",
                            gridColumns.Select(
                                c => visit.Get(c.Name)))
                            + " " + MtgId(visit.Get("Id"))
                            + " " + MtgId(visit.Get("PreviousMeetingId"));

                        var statusValue = visit.Get("Status");

                        string statusClass =
                            statusValue == "Planned"
                                ? "badge-pending"
                                : statusValue == "Completed"
                                    ? "badge-completed"
                                    : statusValue == "Cancelled"
                                        ? "badge-cancelled"
                                        : "badge-default";

                        <tr data-search="@searchText">

                            @foreach (var col in gridColumns)
                            {
                                string tdClass =
                                    nowrapCols.Contains(col.Name)
                                        ? "col-nowrap"
                                        : "col-wrap";

                                <td class="@tdClass">

                                    @if (col.Name == "Status")
                                    {
                                        <span class="status-pill @statusClass">
                                            @visit.Get(col.Name)
                                        </span>
                                    }
                                    else if (col.Name == "Id")
                                    {
                                        @MtgId(visit.Get(col.Name))
                                    }
                                    else if (col.Name == "PreviousMeetingId")
                                    {
                                        var prevId = visit.Get(col.Name);

                                        if (string.IsNullOrWhiteSpace(prevId)
                                            || prevId == "0")
                                        {
                                            <span class="prev-dash" title="Start of meeting chain">
                                                —
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="prev-ref" title="Linked to meeting">
                                                @MtgId(prevId)
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        @visit.Get(col.Name)
                                    }

                                </td>
                            }

                            <td>

                                <div class="action-cell">

                                    @{
                                        var rowJson =
                                            System.Text.Json
                                                .JsonSerializer
                                                .Serialize(
                                                    visit.Values);
                                    }

                                    <button type="button"
                                            class="edit-btn action-btn"
                                            title="Edit"
                                            data-json="@rowJson"
                                            onclick="openEditModal(this)">

                                        ✎

                                    </button>

                                    <form asp-controller="ClientVisiting"
                                          asp-action="Delete"
                                          method="post"
                                          onsubmit="return masterConfirmAndSubmit(
                                              this,
                                              'Are you sure you want to delete this visit record?'
                                          );">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@visit.Get("Id")" />

                                        <button type="submit"
                                                class="delete-btn action-btn"
                                                title="Delete">

                                            ✕

                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }
                }

                <!-- Client-side empty row: shown when the
                     search filter matches no rows. -->
                <tr id="noRecordsRow"
                    class="no-data-row"
                    data-search=""
                    style="display: none;">

                    <td colspan="@(gridColumns.Length + 1)"
                        class="empty-state">

                        No Records Found on this filter.

                    </td>

                </tr>

            </tbody>

        </table>

    </div>


    <!-- ================= TABLE FOOTER ================= -->

    <div class="table-footer">

        <div class="footer-left"
             id="tableInfo">

            Showing 1 to 10 of @totalRecords entries

        </div>


        <div class="footer-right"
             id="pagination">

        </div>

    </div>

</div>


<!-- ================= ADD / EDIT MODAL ================= -->

<div id="visitModal"
     class="modal">

    <div class="modal-content modal-wide">


        <div class="modal-header">

            <h2 id="modalTitle">
                Edit Visit
            </h2>


            <button type="button"
                    class="modal-close"
                    onclick="closeModal()">

                &times;

            </button>

        </div>


        <form id="visitForm"
              method="post"
              action="@Url.Action("Create", "ClientVisiting")"
              novalidate>

            @Html.AntiForgeryToken()

            <input type="hidden"
                   id="editId"
                   name="id"
                   value="@GetVal("Id")" />


            <div class="form-grid">

                @if (Model.AvailableColumns.Contains("PreviousMeetingId"))
                {
                <div class="form-group form-group-full">

                    <label>
                        Meeting
                    </label>

                    <select name="MeetingMode"
                            id="edit_MeetingMode"
                            onchange="toggleMeetingMode()">

                        <option value="New Meeting"
                                selected="@(string.IsNullOrWhiteSpace(GetVal("MeetingMode")) || GetVal("MeetingMode") == "New Meeting")">
                            New Meeting
                        </option>

                        <option value="Add to Existing Meeting"
                                selected="@(GetVal("MeetingMode") == "Add to Existing Meeting")">
                            Add to Existing Meeting
                        </option>

                    </select>

                    <span class="voice-hint">
                        New Meeting: ye visit apni nayi meeting chain start karega.
                        Add to Existing: is visit ko pehle banaye gaye meeting ke sath link karega.
                    </span>

                    @if (!string.IsNullOrWhiteSpace(GetErr("PreviousMeetingId")))
                    {
                        <span class="field-error">
                            @GetErr("PreviousMeetingId")
                        </span>
                    }

                    <div id="existingMeetingGroup"
                         style="@(GetVal("MeetingMode") == "Add to Existing Meeting" ? "" : "display:none")">

                        <label class="sub-label">
                            Existing Meeting
                        </label>

                        <select name="PreviousMeetingId"
                                id="edit_PreviousMeetingId"
                                @(GetVal("MeetingMode") == "Add to Existing Meeting" ? "required" : null)>

                            <option value="">
                                -- Select Meeting --
                            </option>

                            @foreach (var meeting in Model.Meetings)
                            {
                                var isCurrentRecord =
                                    !string.IsNullOrWhiteSpace(GetVal("Id"))
                                    && GetVal("Id") == meeting.Id.ToString();

                                <option value="@meeting.Id"
                                        selected="@(GetVal("PreviousMeetingId") == meeting.Id.ToString())"
                                        disabled="@isCurrentRecord">
                                    @meeting.Name@(isCurrentRecord ? " (current)" : "")
                                </option>
                            }

                        </select>

                    </div>

                </div>
                }

                @if (Model.AvailableColumns.Contains("VisitDate"))
                {
                <div class="form-group">

                    <label>
                        Visit Date
                    </label>

                    <input type="date"
                           id="edit_VisitDate"
                           name="VisitDate"
                           value="@GetVal("VisitDate")"
                           required />

                    @if (!string.IsNullOrWhiteSpace(GetErr("VisitDate")))
                    {
                        <span class="field-error">
                            @GetErr("VisitDate")
                        </span>
                    }

                </div>
                }

                @if (Model.AvailableColumns.Contains("ClientId"))
                {
                <div class="form-group">

                    <label>
                        Client
                    </label>

                    <select name="ClientId"
                            id="edit_ClientId"
                            required>

                        <option value=""
                                disabled
                                selected="@(string.IsNullOrWhiteSpace(GetVal("ClientId")))">
                            -- Select Client --
                        </option>

                        @foreach (var client in Model.Clients)
                        {
                            <option value="@client.Id"
                                    selected="@(GetVal("ClientId") == client.Id.ToString())">
                                @client.Name
                            </option>
                        }

                    </select>

                    @if (!string.IsNullOrWhiteSpace(GetErr("ClientId")))
                    {
                        <span class="field-error">
                            @GetErr("ClientId")
                        </span>
                    }

                </div>
                }

                @if (Model.AvailableColumns.Contains("VisitType"))
                {
                <div class="form-group">

                    <label>
                        Visit Type
                    </label>

                    <select name="VisitType"
                            id="edit_VisitType"
                            onchange="toggleOtherVisitType()"
                            required>

                        <option value=""
                                disabled
                                selected="@(string.IsNullOrWhiteSpace(GetVal("VisitType")))">
                            -- Select Visit Type --
                        </option>

                        @foreach (var visitType in visitTypes)
                        {
                            <option value="@visitType"
                                    selected="@(GetVal("VisitType") == visitType)">
                                @visitType
                            </option>
                        }

                    </select>

                    @if (!string.IsNullOrWhiteSpace(GetErr("VisitType")))
                    {
                        <span class="field-error">
                            @GetErr("VisitType")
                        </span>
                    }

                    <div id="otherVisitTypeGroup"
                         style="@(showOtherVisitType ? "" : "display:none")">

                        <label class="sub-label">
                            Other Visit Type
                        </label>

                        <input type="text"
                               name="OtherVisitType"
                               id="edit_OtherVisitType"
                               maxlength="92"
                               placeholder="Specify other visit type"
                               value="@GetVal("OtherVisitType")"
                               @(showOtherVisitType ? "required" : null) />

                        @if (!string.IsNullOrWhiteSpace(GetErr("OtherVisitType")))
                        {
                            <span class="field-error">
                                @GetErr("OtherVisitType")
                            </span>
                        }

                    </div>

                </div>
                }

                @if (Model.AvailableColumns.Contains("PersonMet"))
                {
                <div class="form-group">

                    <label>
                        Person Met
                    </label>

                    <input type="text"
                           id="edit_PersonMet"
                           name="PersonMet"
                           value="@GetVal("PersonMet")"
                           placeholder="Person met at the visit" />

                </div>
                }

                @if (Model.AvailableColumns.Contains("Subject"))
                {
                <div class="form-group form-group-full">

                    <label>
                        Subject
                    </label>

                    <input type="text"
                           id="edit_Subject"
                           name="Subject"
                           value="@GetVal("Subject")"
                           placeholder="Short subject of the visit"
                           required />

                    @if (!string.IsNullOrWhiteSpace(GetErr("Subject")))
                    {
                        <span class="field-error">
                            @GetErr("Subject")
                        </span>
                    }

                </div>
                }

                @if (Model.AvailableColumns.Contains("Status"))
                {
                <div class="form-group">

                    <label>
                        Status
                    </label>

                    <select name="Status"
                            id="edit_Status"
                            onchange="updateCurrentStatus()"
                            required>

                        <option value=""
                                disabled
                                selected="@(string.IsNullOrWhiteSpace(GetVal("Status")))">
                            -- Select Status --
                        </option>

                        @foreach (var status in statuses)
                        {
                            <option value="@status"
                                    selected="@(GetVal("Status") == status)">
                                @status
                            </option>
                        }

                    </select>

                    <div class="status-tracker">

                        <div class="status-tracker-row">

                            <span class="status-tracker-label">
                                Current Status
                            </span>

                            <span id="curStatusBadge"
                                  class="status-pill @StatusPillClass(GetVal("Status"))">
                                @(string.IsNullOrWhiteSpace(GetVal("Status")) ? "—" : GetVal("Status"))
                            </span>

                        </div>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(GetErr("Status")))
                    {
                        <span class="field-error">
                            @GetErr("Status")
                        </span>
                    }

                </div>
                }

                @if (Model.AvailableColumns.Contains("Discussion"))
                {
                <div class="form-group form-group-full">

                    <label>
                        Discussion
                    </label>

                    <textarea id="edit_Discussion"
                              name="Discussion"
                              rows="2"
                              placeholder="Discussion during the visit">@GetVal("Discussion")</textarea>

                </div>
                }

                @if (Model.AvailableColumns.Contains("Outcome"))
                {
                <div class="form-group form-group-full">

                    <label>
                        Outcome
                    </label>

                    <textarea id="edit_Outcome"
                              name="Outcome"
                              rows="2"
                              placeholder="Result / outcome of the visit">@GetVal("Outcome")</textarea>

                </div>
                }

                @if (Model.AvailableColumns.Contains("NextAction"))
                {
                <div class="form-group form-group-full">

                    <label>
                        Next Action
                    </label>

                    <textarea id="edit_NextAction"
                              name="NextAction"
                              rows="2"
                              placeholder="Next action to be taken">@GetVal("NextAction")</textarea>

                </div>
                }

                @if (Model.AvailableColumns.Contains("FollowUpDate"))
                {
                <div class="form-group">

                    <label>
                        Follow Up Date
                    </label>

                    <input type="date"
                           id="edit_FollowUpDate"
                           name="FollowUpDate"
                           value="@GetVal("FollowUpDate")" />

                    @if (!string.IsNullOrWhiteSpace(GetErr("FollowUpDate")))
                    {
                        <span class="field-error">
                            @GetErr("FollowUpDate")
                        </span>
                    }

                </div>
                }

                @if (Model.AvailableColumns.Contains("Remarks"))
                {
                <div class="form-group form-group-full">

                    <label>
                        Remarks
                    </label>

                    <textarea id="edit_Remarks"
                              name="Remarks"
                              rows="3"
                              placeholder="Voice to text - click Mic and speak...">@GetVal("Remarks")</textarea>

                    <div class="voice-controls">

                        <button type="button"
                                class="voice-btn mic-btn"
                                id="voiceMicBtn"
                                onclick="startVoice()">

                            Mic

                        </button>

                        <button type="button"
                                class="voice-btn voice-stop"
                                onclick="stopVoice()">

                            Stop

                        </button>

                        <button type="button"
                                class="voice-btn voice-reset"
                                onclick="resetRemarks()">

                            Reset

                        </button>

                    </div>

                    <span class="voice-status"
                          id="voiceStatus"></span>

                    <span class="voice-hint">
                        Voice to Text: Mic se bolen, text Remarks ke end me jude ga. Mic tab tak open rahega jab tak Stop nahi click karte.
                    </span>

                    @if (!string.IsNullOrWhiteSpace(GetErr("Remarks")))
                    {
                        <span class="field-error">
                            @GetErr("Remarks")
                        </span>
                    }

                </div>
                }

            </div>


            <div class="modal-actions">

                <button type="submit"
                        id="btnSubmit"
                        class="save-btn">

                    Save

                </button>

                <button type="button"
                        class="cancel-btn"
                        onclick="closeModal()">

                    Cancel

                </button>

            </div>

        </form>

    </div>

</div>


@if (Model.OpenModalMode == "Edit")
{
    <script>

        // Modal ko server-side rendered values
        // + field errors ke saath auto open karo
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                document.getElementById(
                    "modalTitle"
                ).innerText = "Edit Visit";

                document.getElementById(
                    "btnSubmit"
                ).innerText = "Update";

                document.getElementById(
                    "visitForm"
                ).action = editUrl;

                updateCurrentStatus();

                toggleOtherVisitType();

                toggleMeetingMode();

                document.getElementById(
                    "visitModal"
                ).style.display = "flex";

            }
        );

    </script>
}


@section Scripts
{
    <script>

        // ==========================================
        // CLIENT VISITING
        // ==========================================

        var currentPage = 1;
        var recordsPerPage = 10;
        var totalRecords = @totalRecords;

        var editUrl =
            "@Url.Action("Edit", "ClientVisiting")";


        // ==========================================
        // FILTER TABLE
        // ==========================================

        function filterTable() {

            currentPage = 1;

            renderTable();

        }


        // ==========================================
        // CHANGE RECORDS PER PAGE
        // ==========================================

        function changeRecordsPerPage() {

            recordsPerPage = parseInt(
                document.getElementById(
                    "recordsPerPage"
                ).value
            );

            currentPage = 1;

            renderTable();

        }


        // ==========================================
        // GO TO PAGE
        // ==========================================

        function goToPage(page) {

            currentPage = page;

            renderTable();

        }


        // ==========================================
        // RENDER TABLE
        // ==========================================

        function renderTable() {

            var searchValue =
                document.getElementById(
                    "tableSearch"
                ).value
                .toLowerCase()
                .trim();


            var rows =
                document.querySelectorAll(
                    "#dataTable tbody tr"
                );


            var filteredRows = [];


            for (var i = 0; i < rows.length; i++) {

                // Skip the "no records" placeholder rows;
                // they are never real data rows.
                if (
                    rows[i].classList.contains(
                        "no-data-row"
                    )
                ) {
                    continue;
                }

                var searchData =
                    rows[i]
                        .getAttribute(
                            "data-search"
                        )
                        .toLowerCase();


                if (
                    searchData.indexOf(
                        searchValue
                    ) !== -1
                ) {
                    filteredRows.push(rows[i]);
                }

            }


            totalRecords = filteredRows.length;


            var totalPages =
                Math.ceil(
                    totalRecords / recordsPerPage
                );


            if (currentPage > totalPages) {
                currentPage =
                    totalPages > 0
                        ? totalPages
                        : 1;
            }


            var startIndex =
                (currentPage - 1)
                * recordsPerPage;


            var endIndex =
                startIndex + recordsPerPage;


            if (endIndex > totalRecords) {
                endIndex = totalRecords;
            }


            for (var j = 0; j < rows.length; j++) {
                rows[j].style.display = "none";
            }


            for (
                var k = startIndex;
                k < endIndex;
                k++
            ) {
                filteredRows[k].style.display = "";
            }


            // "No Records Found on this filter" message
            // when the search filter matches nothing.

            var noRecordsRow =
                document.getElementById(
                    "noRecordsRow"
                );

            if (noRecordsRow) {

                noRecordsRow.style.display =
                    filteredRows.length === 0
                        ? ""
                        : "none";

            }


            updateTableInfo(
                startIndex + 1,
                endIndex,
                totalRecords
            );


            renderPagination(totalPages);

        }


        // ==========================================
        // UPDATE TABLE INFO
        // ==========================================

        function updateTableInfo(
            start,
            end,
            total
        ) {

            var infoElement =
                document.getElementById(
                    "tableInfo"
                );


            if (total === 0) {
                infoElement.innerText =
                    "Showing 0 to 0 of 0 entries";
            } else {
                infoElement.innerText =
                    "Showing "
                    + start
                    + " to "
                    + end
                    + " of "
                    + total
                    + " entries";
            }

        }


        // ==========================================
        // RENDER PAGINATION
        // ==========================================

        function renderPagination(
            totalPages
        ) {

            var paginationElement =
                document.getElementById(
                    "pagination"
                );


            var html = "";


            if (currentPage === 1) {
                html +=
                    '<button class="page-btn" disabled>← Previous</button>';
            } else {
                html +=
                    '<button class="page-btn" onclick="goToPage('
                    + (currentPage - 1)
                    + ')">← Previous</button>';
            }


            for (
                var i = 1;
                i <= totalPages;
                i++
            ) {

                if (i === currentPage) {
                    html +=
                        '<button class="page-btn active">'
                        + i
                        + '</button>';
                } else {
                    html +=
                        '<button class="page-btn" onclick="goToPage('
                        + i
                        + ')">'
                        + i
                        + '</button>';
                }

            }


            if (
                currentPage === totalPages
                || totalPages === 0
            ) {
                html +=
                    '<button class="page-btn" disabled>Next →</button>';
            } else {
                html +=
                    '<button class="page-btn" onclick="goToPage('
                    + (currentPage + 1)
                    + ')">Next →</button>';
            }


            paginationElement.innerHTML = html;

        }


        // ==========================================
        // SORT TABLE
        // ==========================================

        var sortColumn = -1;
        var sortDirection = "asc";


        function sortTable(th) {

            var headers =
                Array.from(
                    th.parentNode.children
                );

            var colIndex =
                headers.indexOf(th);

            var type =
                th.getAttribute("data-sort")
                || "text";


            if (sortColumn === colIndex) {
                sortDirection =
                    sortDirection === "asc"
                        ? "desc"
                        : "asc";
            } else {
                sortDirection = "asc";
                sortColumn = colIndex;
            }


            var tbody =
                document.querySelector(
                    "#dataTable tbody"
                );


            var rows =
                Array.from(tbody.querySelectorAll("tr"));


            rows.sort(function (a, b) {

                var aVal =
                    a.querySelectorAll("td")[
                        colIndex
                    ].innerText.trim();

                var bVal =
                    b.querySelectorAll("td")[
                        colIndex
                    ].innerText.trim();


                var aNum, bNum;


                if (type === "num") {

                    aNum =
                        parseInt(
                            String(aVal).replace(/[^0-9]/g, "")
                        ) || 0;
                    bNum =
                        parseInt(
                            String(bVal).replace(/[^0-9]/g, "")
                        ) || 0;

                    return sortDirection === "asc"
                        ? aNum - bNum
                        : bNum - aNum;

                } else if (type === "date") {

                    aNum =
                        new Date(aVal).getTime() || 0;
                    bNum =
                        new Date(bVal).getTime() || 0;

                    return sortDirection === "asc"
                        ? aNum - bNum
                        : bNum - aNum;

                } else if (type === "status") {

                    aNum =
                        aVal === "Active" ? 1 : 0;
                    bNum =
                        bVal === "Active" ? 1 : 0;

                    return sortDirection === "asc"
                        ? aNum - bNum
                        : bNum - aNum;

                } else {

                    return sortDirection === "asc"
                        ? aVal.localeCompare(bVal)
                        : bVal.localeCompare(aVal);

                }

            });


            for (
                var i = 0;
                i < rows.length;
                i++
            ) {
                tbody.appendChild(rows[i]);
            }


            updateSortArrows(colIndex);


            currentPage = 1;

            renderTable();

        }


        function updateSortArrows(colIndex) {

            var headers =
                document.querySelectorAll(
                    "#dataTable th"
                );


            for (
                var i = 0;
                i < headers.length;
                i++
            ) {

                headers[i].classList.remove(
                    "sort-asc",
                    "sort-desc"
                );

            }


            headers[colIndex].classList.add(
                sortDirection === "asc"
                    ? "sort-asc"
                    : "sort-desc"
            );

        }


        // ==========================================
        // INIT
        // ==========================================

        document.addEventListener(
            "DOMContentLoaded",
            function () {
                renderTable();
            }
        );


        // ==========================================
        // EXPORT EXCEL
        // ==========================================

        function exportExcel() {

            var table =
                document.getElementById(
                    "dataTable"
                );

            var rows =
                table.querySelectorAll("tr");

            var data = [];


            for (var i = 0; i < rows.length; i++) {

                if (
                    rows[i].style.display === "none"
                ) {
                    continue;
                }


                var cells =
                    rows[i].querySelectorAll(
                        "th, td"
                    );

                var rowData = [];


                for (
                    var j = 0;
                    j < cells.length;
                    j++
                ) {

                    if (
                        j === cells.length - 1
                    ) {
                        continue;
                    }


                    rowData.push(
                        cells[j].innerText.trim()
                    );

                }


                if (rowData.length > 0) {
                    data.push(rowData);
                }

            }


            var worksheet =
                XLSX.utils.aoa_to_sheet(data);


            var workbook =
                XLSX.utils.book_new();


            XLSX.utils.book_append_sheet(
                workbook,
                worksheet,
                "Visits"
            );


            XLSX.writeFile(
                workbook,
                "Visits_Data.xlsx"
            );

        }


        // ==========================================
        // EXPORT CSV
        // ==========================================

        function exportCSV() {

            var table =
                document.getElementById(
                    "dataTable"
                );

            var rows =
                table.querySelectorAll("tr");

            var csvContent = "";


            for (var i = 0; i < rows.length; i++) {

                if (
                    rows[i].style.display === "none"
                ) {
                    continue;
                }


                var cells =
                    rows[i].querySelectorAll(
                        "th, td"
                    );

                var rowData = [];


                for (
                    var j = 0;
                    j < cells.length;
                    j++
                ) {

                    if (
                        j === cells.length - 1
                    ) {
                        continue;
                    }


                    var text =
                        cells[j].innerText
                            .trim();

                    text = text.replace(
                        /"/g,
                        '""'
                    );

                    rowData.push(
                        '"' + text + '"'
                    );

                }


                if (rowData.length > 0) {
                    csvContent +=
                        rowData.join(",")
                        + "\r\n";
                }

            }


            var blob = new Blob(
                [csvContent],
                {
                    type:
                        "text/csv;charset=utf-8;"
                }
            );


            var link =
                document.createElement("a");


            link.href =
                URL.createObjectURL(blob);


            link.download =
                "Visits_Data.csv";


            link.click();

        }


        // ==========================================
        // PRINT TABLE
        // ==========================================

        function printTable() {

            var table =
                document.getElementById(
                    "dataTable"
                );


            var printWindow =
                window.open("", "_blank");


            printWindow.document.write(
                '<html><head>'
                + '<title>Client Visiting Data</title>'
                + '<style>'
                + 'body { font-family: Arial, sans-serif; padding: 20px; }'
                + 'h1 { font-size: 22px; margin-bottom: 15px; }'
                + 'table { width: 100%; border-collapse: collapse; }'
                + 'th, td { padding: 10px; text-align: left; border-bottom: 1px solid #ddd; }'
                + 'th { background: #f3f4f6; font-size: 13px; }'
                + 'td { font-size: 13px; }'
                + '.status-pill { display: inline-block; }'
                + '</style>'
                + '</head><body>'
            );


            printWindow.document.write(
                '<h1>Client Visiting Data</h1>'
            );


            printWindow.document.write(
                '<table>'
            );


            var thead =
                table.querySelector("thead");


            if (thead) {

                printWindow.document.write(
                    "<thead>"
                    + thead.innerHTML
                    + "</thead>"
                );

            }


            printWindow.document.write(
                "<tbody>"
            );


            var tbodyRows =
                table.querySelectorAll(
                    "tbody tr"
                );


            for (
                var i = 0;
                i < tbodyRows.length;
                i++
            ) {

                if (
                    tbodyRows[i].style.display
                    !== "none"
                ) {

                    var cells =
                        tbodyRows[i]
                            .querySelectorAll("td");

                    var filteredCells = [];


                    for (
                        var j = 0;
                        j < cells.length;
                        j++
                    ) {

                        var cellButtons =
                            cells[j]
                                .querySelector(
                                    "button"
                                );


                        if (
                            cellButtons === null
                        ) {
                            filteredCells.push(
                                "<td>"
                                + cells[j]
                                    .innerHTML
                                + "</td>"
                            );
                        }

                    }


                    printWindow.document.write(
                        "<tr>"
                        + filteredCells
                            .join("")
                        + "</tr>"
                    );

                }

            }


            printWindow.document.write(
                "</tbody></table>"
            );


            printWindow.document.write(
                "</body></html>"
            );


            printWindow.document.close();


            printWindow.print();

        }


        // ==========================================
        // AUTO DISMISS MESSAGES
        // ==========================================

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                var messages =
                    document.querySelectorAll(
                        ".success-message, .error-message"
                    );


                for (
                    var i = 0;
                    i < messages.length;
                    i++
                ) {

                    (function (message) {

                        setTimeout(
                            function () {

                                message.style.transition =
                                    "opacity 0.5s ease";

                                message.style.opacity = "0";


                                setTimeout(
                                    function () {
                                        message.remove();
                                    },
                                    500
                                );

                            },
                            3000
                        );

                    })(messages[i]);

                }

            }
        );


        // ==========================================
        // VOICE TO TEXT - REMARKS
        // ==========================================

        var recognition = null;
        var isRecording = false;
        var speechBaseText = "";
        var speechFinal = "";


        function speechSupported() {

            return (
                "webkitSpeechRecognition" in window
                || "SpeechRecognition" in window
            );

        }


        function setListening(on) {

            var micBtn =
                document.getElementById(
                    "voiceMicBtn"
                );

            var status =
                document.getElementById(
                    "voiceStatus"
                );


            if (micBtn) {

                if (on) {
                    micBtn.classList.add(
                        "is-recording"
                    );
                } else {
                    micBtn.classList.remove(
                        "is-recording"
                    );
                }

            }


            if (status) {

                if (on) {
                    status.innerText =
                        "● Listening... Stop click karne tak mic open rahega";
                    status.classList.add("visible");
                } else {
                    status.classList.remove("visible");
                }

            }

        }


        function statusPillClass(status) {

            switch (status) {

                case "Completed":
                    return "badge-completed";

                case "Planned":
                    return "badge-pending";

                case "Cancelled":
                    return "badge-cancelled";

                default:
                    return "badge-default";

            }

        }


        function setStatusBadge(el, status) {

            if (!el) {
                return;
            }

            el.className =
                "status-pill " + statusPillClass(status);

            el.innerText =
                (status && status.length > 0)
                    ? status
                    : "—";

        }


        function updateCurrentStatus() {

            var select =
                document.getElementById("edit_Status");

            var badge =
                document.getElementById("curStatusBadge");

            if (!select || !badge) {
                return;
            }

            setStatusBadge(badge, select.value || "");

        }


        function toggleOtherVisitType() {

            var select =
                document.getElementById(
                    "edit_VisitType"
                );

            var group =
                document.getElementById(
                    "otherVisitTypeGroup"
                );

            var input =
                document.getElementById(
                    "edit_OtherVisitType"
                );

            var isOther =
                select !== null
                    && select.value === "Other";

            if (group) {

                group.style.display =
                    isOther ? "" : "none";

            }

            if (input) {

                input.required = isOther ? true : false;

            }

        }


        function toggleMeetingMode() {

            var modeSelect =
                document.getElementById(
                    "edit_MeetingMode"
                );

            var group =
                document.getElementById(
                    "existingMeetingGroup"
                );

            var prevSelect =
                document.getElementById(
                    "edit_PreviousMeetingId"
                );

            var isExisting =
                modeSelect !== null
                && modeSelect.value
                   === "Add to Existing Meeting";

            if (group) {

                group.style.display =
                    isExisting ? "" : "none";

            }

            if (prevSelect) {

                prevSelect.required =
                    isExisting ? true : false;

            }

        }


        function applySpeechText(textarea, interim) {

            var parts = [];

            if (speechBaseText.length > 0) {
                parts.push(speechBaseText);
            }

            if (speechFinal.trim().length > 0) {
                parts.push(speechFinal.trim());
            }

            if (interim.trim().length > 0) {
                parts.push(interim.trim());
            }

            textarea.value = parts.join(" ");

        }


        function startVoice() {

            var textarea =
                document.getElementById(
                    "edit_Remarks"
                );


            if (!speechSupported()) {

                alert(
                    "Speech Recognition is not supported in this browser. " +
                    "Please use Google Chrome."
                );

                return;

            }


            var SpeechRecognition =
                window.SpeechRecognition
                || window.webkitSpeechRecognition;

            recognition =
                new SpeechRecognition();

            recognition.lang = "en-IN";

            recognition.interimResults = true;

            recognition.continuous = true;

            recognition.maxAlternatives = 1;


            recognition.onstart = function () {

                isRecording = true;

                speechBaseText =
                    textarea.value.trim();

                speechFinal = "";

                setListening(true);

                textarea.focus();

            };


            recognition.onresult = function (event) {

                var interimText = "";


                for (
                    var i = event.resultIndex;
                    i < event.results.length;
                    i++
                ) {

                    var result = event.results[i];

                    if (result.isFinal) {
                        speechFinal +=
                            " " + result[0].transcript;
                    } else {
                        interimText +=
                            result[0].transcript;
                    }

                }


                applySpeechText(
                    textarea,
                    interimText
                );

            };


            recognition.onerror = function (event) {

                if (
                    event.error === "not-allowed"
                    || event.error ===
                        "service-not-allowed"
                ) {

                    alert(
                        "Microphone permission denied. " +
                        "Please allow microphone access."
                    );

                } else if (
                    event.error === "no-speech"
                ) {

                    alert(
                        "No speech detected. " +
                        "Please try again."
                    );

                } else {

                    alert(
                        "Speech recognition error: "
                        + event.error
                    );

                }

                isRecording = false;

                setListening(false);

            };


            recognition.onend = function () {

                isRecording = false;

                setListening(false);

            };


            try {

                recognition.start();

            } catch (error) {

                alert(
                    "Could not start speech recognition: "
                    + error.message
                );

            }

        }


        function stopVoice() {

            if (recognition) {

                recognition.stop();

            }

            isRecording = false;

            setListening(false);

        }


        function resetRemarks() {

            if (
                !confirm(
                    "Are you sure you want to clear remarks?"
                )
            ) {
                return;
            }

            if (recognition) {

                recognition.stop();

            }

            isRecording = false;

            setListening(false);

            speechBaseText = "";
            speechFinal = "";

            document.getElementById(
                "edit_Remarks"
            ).value = "";

        }


        // ==========================================
        // MODAL
        // ==========================================

        function toDateInputValue(value) {

            if (!value) {
                return "";
            }

            var trimmed = String(value).trim();

            if (/^\d{4}-\d{2}-\d{2}$/.test(trimmed)) {
                return trimmed;
            }

            var match =
                trimmed.match(
                    /^(\d{2})\/(\d{2})\/(\d{4})/
                );

            return match
                ? match[3] + "-" + match[2] + "-" + match[1]
                : "";

        }


        function fillOtherVisitType(element, rawValue) {

            var otherValue = "";
            var otherPrefix = "Other - ";

            if (
                rawValue.indexOf(otherPrefix) === 0
            ) {

                otherValue =
                    rawValue.substring(
                        otherPrefix.length
                    );

                rawValue = "Other";

            } else {

                var knownOption = false;
                var option;

                for (
                    option = 0;
                    option < element.options.length;
                    option++
                ) {

                    if (
                        element.options[option].value
                            === rawValue
                    ) {
                        knownOption = true;
                        break;
                    }

                }

                if (!knownOption
                    && rawValue.length > 0) {

                    otherValue = rawValue;

                    rawValue = "Other";

                }

            }

            element.value = rawValue;

            document.getElementById(
                "edit_OtherVisitType"
            ).value = otherValue;

            toggleOtherVisitType();

        }


        function openEditModal(btn) {

            var data =
                JSON.parse(
                    btn.getAttribute("data-json")
                );

            var form =
                document.getElementById(
                    "visitForm"
                );

            form.action = editUrl;

            document.getElementById(
                "modalTitle"
            ).innerText = "Edit Visit";

            document.getElementById(
                "btnSubmit"
            ).innerText = "Update";

            form.reset();


            var elements =
                form.querySelectorAll(
                    "input[name], select[name], textarea[name]"
                );


            for (
                var i = 0;
                i < elements.length;
                i++
            ) {

                var element = elements[i];

                var name =
                    element.getAttribute(
                        "name"
                    );

                if (!name) {
                    continue;
                }


                var key = null;

                for (var fieldName in data) {

                    if (
                        data.hasOwnProperty(fieldName)
                        && fieldName.toLowerCase()
                           === name.toLowerCase()
                    ) {
                        key = fieldName;
                        break;
                    }

                }


                if (!key) {
                    continue;
                }

                var rawValue = data[key];


                if (name.toLowerCase() === "visittype") {

                    fillOtherVisitType(
                        element,
                        rawValue
                    );

                    continue;

                }


                if (element.type === "date") {

                    var isoRaw = rawValue;

                    for (var f in data) {

                        if (
                            data.hasOwnProperty(f)
                            && f.toLowerCase()
                               === name.toLowerCase() + "iso"
                        ) {
                            isoRaw = data[f];
                            break;
                        }

                    }

                    element.value =
                        toDateInputValue(isoRaw);

                } else {

                    element.value = rawValue;

                }

            }


            var meetingMode =
                document.getElementById(
                    "edit_MeetingMode"
                );

            var previousMeetingId =
                document.getElementById(
                    "edit_PreviousMeetingId"
                );

            if (meetingMode && previousMeetingId) {

                var currentId =
                    document.getElementById(
                        "editId"
                    ).value
                    || "";

                var prevRaw =
                    data["PreviousMeetingId"]
                    || "";

                var isExisting =
                    prevRaw !== ""
                    && prevRaw !== "0";

                meetingMode.value =
                    isExisting
                        ? "Add to Existing Meeting"
                        : "New Meeting";

                previousMeetingId.value =
                    isExisting ? prevRaw : "";

                for (
                    var optionIndex = 0;
                    optionIndex < previousMeetingId.options.length;
                    optionIndex++
                ) {

                    var option =
                        previousMeetingId.options[optionIndex];

                    if (option.value === currentId) {

                        option.disabled = true;

                        option.text =
                            option.text + " (current)";

                    }

                }

                toggleMeetingMode();

            }


            setStatusBadge(
                document.getElementById(
                    "curStatusBadge"
                ),
                data["Status"] || ""
            );

            updateCurrentStatus();

            document.getElementById(
                "visitModal"
            ).style.display = "flex";

        }


        function closeModal() {

            stopVoice();

            document.getElementById(
                "visitModal"
            ).style.display = "none";

        }


        window.onclick = function (event) {

            const modal =
                document.getElementById(
                    "visitModal"
                );


            if (event.target === modal) {

                closeModal();

            }

        };


        masterBindModalSubmit(
            "visitForm",
            closeModal
        );

    </script>
}