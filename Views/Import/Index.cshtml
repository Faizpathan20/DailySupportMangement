@model ImportController.ImportViewModel
@using Master.Controllers

@{
    ViewData["Title"] = "Import Data";

    var token = Context
        .RequestServices
        .GetRequiredService<
            Microsoft.AspNetCore.Antiforgery.IAntiforgery>()
        .GetAndStoreTokens(
            Context).RequestToken!;
}

<link rel="stylesheet"
      href="~/css/import.css?v=20" />


<div class="import-page">

<!-- Icon set. Kept inline as a sprite so the page needs
     no extra request and no icon font, and so every icon
     inherits colour from the text around it. -->
<svg class="ip-sprite"
     width="0"
     height="0"
     aria-hidden="true"
     focusable="false">

    <symbol id="i-import" viewBox="0 0 24 24">
        <path d="M4 22h14a2 2 0 0 0 2-2V7l-5-5H6a2 2 0 0 0-2 2v4"/>
        <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
        <path d="M2 15h10"/>
        <path d="m9 18 3-3-3-3"/>
    </symbol>

    <symbol id="i-upload" viewBox="0 0 24 24">
        <path d="M4 14.9A7 7 0 1 1 15.7 8h1.8a4.5 4.5 0 0 1 2.5 8.2"/>
        <path d="M12 12v9"/>
        <path d="m16 16-4-4-4 4"/>
    </symbol>

    <symbol id="i-sheet" viewBox="0 0 24 24">
        <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"/>
        <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
        <path d="M8 13h8"/>
        <path d="M8 17h8"/>
        <path d="M8 9h2"/>
    </symbol>

    <symbol id="i-file" viewBox="0 0 24 24">
        <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"/>
        <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
        <path d="M10 9H8"/>
        <path d="M16 13H8"/>
        <path d="M16 17H8"/>
    </symbol>

    <symbol id="i-database" viewBox="0 0 24 24">
        <ellipse cx="12" cy="5" rx="9" ry="3"/>
        <path d="M3 5v14a9 3 0 0 0 18 0V5"/>
        <path d="M3 12a9 3 0 0 0 18 0"/>
    </symbol>

    <symbol id="i-eye" viewBox="0 0 24 24">
        <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
        <circle cx="12" cy="12" r="3"/>
    </symbol>

    <symbol id="i-alert" viewBox="0 0 24 24">
        <path d="m21.7 18-8-14a2 2 0 0 0-3.5 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.7-3Z"/>
        <path d="M12 9v4"/>
        <path d="M12 17h.01"/>
    </symbol>

    <symbol id="i-x" viewBox="0 0 24 24">
        <path d="M18 6 6 18"/>
        <path d="m6 6 12 12"/>
    </symbol>

    <symbol id="i-check" viewBox="0 0 24 24">
        <path d="M20 6 9 17l-5-5"/>
    </symbol>

    <symbol id="i-warn" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10"/>
        <path d="M12 8v4"/>
        <path d="M12 16h.01"/>
    </symbol>

    <symbol id="i-edit" viewBox="0 0 24 24">
        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
        <path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4Z"/>
    </symbol>

</svg>

<!-- The boxes below show and hide with the "hidden"
     attribute, but the class rules in import.css set a
     display value, and an author rule beats the
     browser's own [hidden] rule. This puts the
     attribute back in charge for this page only. -->

<style>
    .import-page [hidden] {
        display: none !important;
    }

    /* The file input must stay laid out (Firefox,
       Safari and newer Chrome builds refuse to open the
       picker when it is display:none), so it is moved
       out of sight instead of being hidden. */
    .import-page .file-input {
        position: absolute;

        width: 1px;
        height: 1px;

        padding: 0;
        margin: -1px;

        overflow: hidden;

        clip: rect(0 0 0 0);
        clip-path: inset(50%);

        white-space: nowrap;

        border: 0;
    }
</style>


<!-- ================= PAGE HEADER ================= -->

<div class="page-header import-page-header">

    <span class="iph-badge" aria-hidden="true">
        <svg class="ip-ico" viewBox="0 0 24 24"><use href="#i-import"></use></svg>
    </span>

    <div>
        <h1>Import Data</h1>
        <p>
            Load an Excel or CSV file, check the rows in
            the table below, then save it to the database.
        </p>
    </div>

    <div class="ip-chips">
        <span class="ip-chip">
            <kbd>Ctrl</kbd> + <kbd>S</kbd> &mdash; save
        </span>
        <span class="ip-chip">
            <kbd>Esc</kbd> &mdash; clear
        </span>
        <span class="ip-chip">
            double-click a cell &mdash; edit
        </span>
    </div>

</div>


<!-- ================= STEPS ================= -->

<!-- A plain list of where the page is, so a long sheet
     does not leave the reader guessing how much is left
     to do. The ticks are painted by script as each step
     is reached. -->

<ol class="ip-steps" id="ipSteps">

    <li class="ip-step is-current" data-step="1">
        <span class="ip-step-num">1</span>
        <span class="ip-step-text">
            <span class="ip-step-name">Choose File</span>
            <span class="ip-step-note">Drop or browse</span>
        </span>
    </li>

    <li class="ip-step" data-step="2">
        <span class="ip-step-num">2</span>
        <span class="ip-step-text">
            <span class="ip-step-name">Check Rows</span>
            <span class="ip-step-note">
                Types, edits, ticks
            </span>
        </span>
    </li>

    <li class="ip-step" data-step="3">
        <span class="ip-step-num">3</span>
        <span class="ip-step-text">
            <span class="ip-step-name">Save</span>
            <span class="ip-step-note">
                Append or replace
            </span>
        </span>
    </li>

</ol>


<!-- ================= 1. FILE ================= -->

<div class="state-section">

    <div class="section-header">
        <div>
            <h2>Choose File</h2>
            <p>.xlsx, .xls and .csv &mdash; max 10 MB</p>
        </div>
    </div>

<div class="import-dropzone"
     id="dropzone">

    <input type="file"
           id="importFile"
           class="file-input"
           accept=".xlsx,.xls,.csv"
           tabindex="-1"
           aria-hidden="true" />

    <!-- A label that points at the file input opens the
         picker with no JavaScript at all, so this works
         in every browser even if a script fails to load. -->
    <label class="dz-idle"
           id="dzIdle"
           for="importFile">

        <span class="dz-icon" aria-hidden="true">
            <svg class="ip-ico" viewBox="0 0 24 24"><use href="#i-upload"></use></svg>
        </span>

        <span class="dz-title">
            Drop your file here
        </span>

        <span class="primary-btn dz-browse">
            Browse Files
        </span>

        <span class="dz-hint">
            Supports .xlsx, .xls and .csv up to 10 MB
        </span>

    </label>

    <div class="dz-loaded" id="dzLoaded" hidden>

        <div class="dz-file-icon" id="dzFileIcon">
            <svg class="ip-ico" viewBox="0 0 24 24"><use href="#i-sheet"></use></svg>
        </div>

        <div class="dz-file-meta">
            <p class="dz-file-name"
               id="dzFileName">
            </p>
            <p class="dz-file-info"
               id="dzFileInfo">
            </p>
        </div>

        <div class="dz-file-side">

            <select id="sheetPicker"
                    class="dz-sheet"
                    title="Sheet"
                    hidden></select>

            <button type="button"
                    class="icon-btn"
                    id="btnRemove"
                    title="Remove this file"
                    aria-label="Remove this file">
                <svg class="ip-ico" viewBox="0 0 24 24"><use href="#i-x"></use></svg>
            </button>

        </div>

    </div>

    <!-- Reading a large sheet takes a moment, and the
         bar is what keeps that moment from looking like
         a hang. The fill is indeterminate until the row
         count is known, then it becomes a real
         percentage. -->
    <div class="ip-progress" id="parseProgress" hidden>

        <div class="ip-progress-head">
            <span class="ip-progress-text"
                  id="progressLabel">Reading…</span>

            <button type="button"
                    class="ip-progress-cancel"
                    id="btnCancelLoad">
                Cancel
            </button>
        </div>

        <div class="ip-progress-track">
            <div class="ip-progress-fill"
                 id="progressFill"></div>
        </div>

    </div>

</div>

</div>


<!-- ================= 2. PREVIEW ================= -->

<div class="state-section"
     id="previewSection"
     hidden>

    <div class="section-header">
        <div>
            <h2>Preview Data</h2>
            <p id="previewSub"></p>
        </div>
    </div>

    <div class="import-banner"
         id="importBanner"
         hidden>
        <span class="ib-icon" id="bannerIcon">
            <svg class="ip-ico" viewBox="0 0 24 24"><use href="#i-eye"></use></svg>
        </span>
        <span class="ib-text" id="bannerText"></span>
    </div>

    <div class="import-stats" id="importStats"></div>

    <!-- Three more counts, shown only while a file is
         open rather than when a saved table is being
         looked at. -->
    <div class="import-stats" id="importStatsLive" hidden></div>


    <!-- ================= COLUMN TYPES ================= -->

    <!-- The type of each column is guessed from the
         values under it. That is right most of the time
         and wrong in the usual ways, so the guess can be
         corrected here. It matters because a column
         created as the wrong type stays that way once the
         rows are in. -->
    <div class="ip-typemap" id="typeMap" hidden>

        <button type="button"
                class="ip-typemap-toggle"
                id="typeMapToggle"
                aria-expanded="false"
                aria-controls="typeMapBody">
            &#9656; Column types
        </button>

        <div class="ip-typemap-body"
             id="typeMapBody"
             hidden>

            <table class="ip-typemap-table">

                <thead>
                    <tr>
                        <th>Column</th>
                        <th class="col-type">SQL Type</th>
                        <th class="col-sample">First value</th>
                    </tr>
                </thead>

                <tbody id="typeMapRows"></tbody>
            </table>

            <div class="ip-typemap-foot">
                <button type="button"
                        class="cancel-btn"
                        id="btnResetTypes">
                    Reset to detected
                </button>
            </div>

        </div>

    </div>

    <div class="table-toolbar import-toolbar">

        <div class="toolbar-left">
            <span class="toolbar-label">
                Show
            </span>

            <select id="recordsPerPage">
                <option value="10">10</option>
                <option value="25" selected>25</option>
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="200">200</option>
            </select>

            <span class="toolbar-label">
                rows
            </span>
        </div>

        <div class="toolbar-right">
            <span class="toolbar-label">Search:</span>
            <input type="text"
                   id="tableSearch"
                   placeholder="Search all columns..." />
        </div>

    </div>

    <!-- How many rows will actually be written, and the
         two buttons that change that number. Kept out of
         the toolbar above because it wraps on a narrow
         screen and this line should not. -->
    <div class="ip-selbar" id="selectionBar" hidden>

        <span class="ip-sel-info" id="selectionInfo"></span>

        <span class="ip-sel-actions">
            <button type="button"
                    class="ip-mini-btn"
                    id="selAll">
                Select all
            </button>
            <button type="button"
                    class="ip-mini-btn"
                    id="selNone">
                Select none
            </button>
        </span>

    </div>

    <div class="table-container master-table import-table">

        <table id="dataTable">
            <thead id="dataHead"></thead>
            <tbody id="dataBody"></tbody>
        </table>

    </div>

    <div class="table-footer">

        <div class="footer-left" id="tableInfo"></div>

        <div class="footer-right" id="pagination"></div>

    </div>

</div>


<!-- ================= 3. SAVE ================= -->

<div class="state-section"
     id="saveSection"
     hidden>

    <div class="section-header">
        <div>
            <h2>Save to Database</h2>
            <p>
                A new table is created if the name is not
                used yet, otherwise the rows are added to
                the existing table.
            </p>
        </div>
    </div>

    <div class="import-save-bar">

        <!-- Append or replace. The two do very different
             things to a table that already has rows in it,
             so they are named plainly rather than left to
             a single checkbox. -->
        <div class="ip-modes" id="modeGroup">

            <span class="ip-modes-label"
                  id="modeLabel">
                Write Mode
            </span>

            <div class="ip-modes-row"
                 role="radiogroup"
                 aria-labelledby="modeLabel">

                <label class="ip-mode">
                    <input type="radio"
                           name="importMode"
                           value="append"
                           checked />
                    <span class="ip-mode-body">
                        <span class="ip-mode-name">
                            Append
                        </span>
                        <span class="ip-mode-note">
                            Keep what is there and add
                            the selected rows
                        </span>
                    </span>
                </label>

                <label class="ip-mode">
                    <input type="radio"
                           name="importMode"
                           value="replace" />
                    <span class="ip-mode-body">
                        <span class="ip-mode-name">
                            Replace
                        </span>
                        <span class="ip-mode-note">
                            Delete every existing row,
                            then write the selected rows
                        </span>
                    </span>
                </label>

                <!-- Only shown when a saved table has been
                     opened with Update. It is the one mode
                     that writes back onto rows already
                     stored, so it is never offered for a
                     file that is still being imported. -->
                <label class="ip-mode ip-mode-update"
                       id="modeUpdateOption"
                       hidden>
                    <input type="radio"
                           name="importMode"
                           value="update" />
                    <span class="ip-mode-body">
                        <span class="ip-mode-name">
                            Update
                        </span>
                        <span class="ip-mode-note">
                            Write the changes back onto
                            the rows they came from
                        </span>
                    </span>
                </label>

            </div>

        </div>

        <div class="isb-field">

            <label for="tableName">
                Table Name
            </label>

            <input type="text"
                   id="tableName"
                   list="existingTables"
                   placeholder="e.g. ClientMaster"
                   autocomplete="off"
                   spellcheck="false" />

            <datalist id="existingTables">
                @foreach (var t in Model.Tables)
                {
                    <option value="@t"></option>
                }
            </datalist>

            <p class="isb-hint" id="tableHint"></p>

        </div>

        <div class="isb-actions">

            <button type="button"
                    class="cancel-btn"
                    id="btnClear">
                Clear
            </button>

            <button type="button"
                    class="save-btn"
                    id="btnSave">
                Save to Database
            </button>

        </div>

    </div>

    <!-- The save button lives at the bottom of the page,
         which is a long scroll away once a sheet of rows
         is open. This repeats the two numbers that decide
         what happens and stays put while the grid is
         read. -->
    <div class="ip-sticky" id="stickyInfo" hidden>

        <span class="ip-sticky-item">
            <span class="ip-sticky-label">Rows</span>
            <span class="ip-sticky-value"
                  id="stickyRows">0</span>
        </span>

        <span class="ip-sticky-item">
            <span class="ip-sticky-label">Table</span>
            <span class="ip-sticky-value"
                  id="stickyTable">—</span>
        </span>

        <span class="ip-sticky-item">
            <span class="ip-sticky-label">Mode</span>
            <span class="ipm-tag is-append"
                  id="stickyMode">Append</span>
        </span>

        <button type="button"
                class="save-btn ip-sticky-btn"
                id="stickySave">
            Save to Database
        </button>

    </div>

    <div class="loading-wrap">
        <div class="loading-overlay"
             id="saveLoading">
            <div class="loading-card">
                <div class="spinner"></div>
                <span class="loading-text">
                    Saving to database<span class="loading-dots"></span>
                </span>
            </div>
        </div>
    </div>

</div>


<!-- ================= SAVED FILES ================= -->

<div class="state-section">

    <div class="section-header">
        <div>
            <h2>Saved Files</h2>
            <p>
                Every file that was written to the database.
                Use <strong>View</strong> to open one again.
            </p>
        </div>
    </div>

    <div class="table-toolbar import-toolbar">

        <div class="toolbar-left">
            <span class="toolbar-label">
                Show
            </span>

            <select id="historyRange">
                <option value="7">Last 7 days</option>
                <option value="30" selected>
                    Last 30 days
                </option>
                <option value="90">Last 90 days</option>
                <option value="all">All time</option>
            </select>
        </div>

        <div class="toolbar-right">
            <span class="toolbar-label">Search:</span>
            <input type="text"
                   id="historySearch"
                   placeholder="Table or file name..." />
        </div>

    </div>

    <!-- Ten rows at a time, then the list scrolls rather than
         pushing the rest of the page down. The heading stays
         put so a row can still be read against it. -->
    <div class="ip-history-scroll">
        <div class="table-container master-table">

        <table id="historyTable">

            <thead>
                <tr>
                    <th class="rs-sr">#</th>
                    <th>Table</th>
                    <th>File</th>
                    <th class="col-num">Rows</th>
                    <th class="col-num">Saved</th>
                    <th class="col-num">Failed</th>
                    <th>Mode</th>
                    <th>User</th>
                    <th>Date</th>
                    <th class="col-act">Action</th>
                </tr>
            </thead>

            <tbody id="historyBody">

                @if (Model.History.Count == 0)
                {
                    <tr class="no-data-row">
                        <td colspan="10" class="empty-state">
                            No files have been saved yet.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var h in Model.History)
                    {
                        <tr>

                            <td class="rs-sr">@h.Id</td>

                            <td>
                                <span class="hf-table">
                                    @h.TableName
                                </span>
                            </td>

                            <td class="hf-file">
                                @h.FileName
                            </td>

                            <td class="col-num">
                                @h.TotalRows
                            </td>

                            <td class="col-num">
                                <span class="badge-active">
                                    @h.ImportedRows
                                </span>
                            </td>

                            <td class="col-num">
                                @if (h.FailedRows > 0)
                                {
                                    <span class="badge-cancelled">
                                        @h.FailedRows
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-default">
                                        0
                                    </span>
                                }
                            </td>

                            <td class="col-mode">
                                @if (h.Mode == "replace")
                                {
                                    <span class="ipm-tag is-replace">
                                        Replace
                                    </span>
                                }
                                else if (h.Mode == "update")
                                {
                                    <span class="ipm-tag is-update">
                                        Update
                                    </span>
                                }
                                else
                                {
                                    <span class="ipm-tag is-append">
                                        Append
                                    </span>
                                }
                            </td>

                            <td>@h.UserName</td>

                            <td class="col-nowrap">
                                @h.ImportedOn.ToString(
                                    "dd MMM yyyy HH:mm")
                            </td>

                            <td class="col-act">
                                <div class="col-act-row">
                                    <button type="button"
                                            class="action-btn view-btn"
                                            data-table="@h.TableName"
                                            title="View @h.TableName"
                                            aria-label="View @h.TableName">
                                        <svg class="ip-ico"
                                             viewBox="0 0 24 24"
                                             aria-hidden="true">
                                            <use href="#i-eye"></use>
                                        </svg>
                                    </button>
                                    <button type="button"
                                            class="action-btn update-btn"
                                            data-table="@h.TableName"
                                            title="Update @h.TableName"
                                            aria-label="Update @h.TableName">
                                        <svg class="ip-ico"
                                             viewBox="0 0 24 24"
                                             aria-hidden="true">
                                            <use href="#i-edit"></use>
                                        </svg>
                                    </button>
                                </div>
                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

        </div>
    </div>

</div><!-- /.import-page -->


<!-- ================= FAILED ROWS ================= -->

<!-- A row the database refused is worth naming. The save
     itself has already gone through, so this is a report
     on what was skipped, not a second chance at it. -->
<div class="modal ip-modal"
     id="errorModal"
     role="dialog"
     aria-modal="true"
     aria-labelledby="errorTitle">

    <div class="modal-content">

        <div class="modal-header">
            <h3 id="errorTitle">
                Some rows were not saved
            </h3>
            <button type="button"
                    class="modal-close"
                    id="btnErrorClose"
                    aria-label="Close">
                &times;
            </button>
        </div>

        <div class="ip-modal-body">
            <p class="ip-modal-lead">
                Everything else was written. These rows
                were skipped:
            </p>

            <ul class="ip-error-list" id="errorBody"></ul>
        </div>

        <div class="modal-actions">
            <button type="button"
                    class="cancel-btn"
                    onclick="closeErrorModal()">
                Close
            </button>
            <button type="button"
                    class="primary-btn"
                    id="btnErrorCsv">
                Download as CSV
            </button>
        </div>

    </div>

</div>


@section Scripts {
    <script>
        window.IMPORT_TOKEN = "@token";
        window.IMPORT_MAX_ROWS = @ImportController.MaxRows;
    </script>

    <script src="~/js/import.js?v=20"></script>
}